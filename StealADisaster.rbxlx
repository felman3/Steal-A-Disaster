GameConfig.ZoneById = {}
GameConfig.ZoneIndex = {}
for i, z in ipairs(GameConfig.Zones) do
	z.index = i
	GameConfig.ZoneById[z.id] = z
	GameConfig.ZoneIndex[z.id] = i
end

-- core -> disaster reverse map & validation
GameConfig.CoreByDisaster = {}
for id, c in pairs(GameConfig.Cores) do
	c.id = id
	GameConfig.CoreByDisaster[c.disaster] = id
end
for id, d in pairs(GameConfig.Disasters) do
	d.id = id
	local coreId = GameConfig.CoreByDisaster[id]
	local c = coreId and GameConfig.Cores[coreId]
	d.rarity = c and c.rarity or "Common"
	d.zone = c and c.zone or "Suburb"
end

return GameConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">MonetizationConfig</string><ProtectedString name="Source"><![CDATA[--[[
	MonetizationConfig — every Game Pass and Developer Product in one place.

	`id` is the real Roblox asset id. It stays 0 until the item is created in the
	Creator Dashboard (see docs/MONETIZATION.md). While an id is 0:
	  * live servers hide the item and never sell it;
	  * Studio can run a mock purchase (MockInStudio) so the full grant path can be
	    tested without spending Robux.

	`intendedPrice` is documentation only. The shop shows the price returned by
	MarketplaceService:GetProductInfo, and Roblox charges whatever the item is set to.

	Fairness rules: nothing here touches PvP (shield, tag range, carry cap, steal
	protection), and nothing sells cores, disasters, zones or random rewards.

	Pure data (no Roblox types) so the headless tests can load it.
]]

local MonetizationConfig = {}

-- Studio only: items whose id is still 0 can be bought through a mock flow.
MonetizationConfig.MockInStudio = true

-- Processed Developer Product PurchaseIds kept per player (idempotency window).
MonetizationConfig.ReceiptHistorySize = 200

MonetizationConfig.Items = {
	TurboTreadmill = {
		type = "GamePass",
		id = 0,
		intendedPrice = 149,
		permanent = true,
		icon = "🏃",
		name = "Turbo Treadmill",
		benefit = "2× Speed from every treadmill step",
		description = "Permanently doubles the Speed you earn on your treadmill.",
	},
	DoubleCash = {
		type = "GamePass",
		id = 0,
		intendedPrice = 149,
		permanent = true,
		icon = "💰",
		name = "Double Cash",
		benefit = "2× income from your disasters",
		description = "Permanently doubles the money your displayed disasters earn.",
	},
	InstantHatch = {
		type = "DeveloperProduct",
		id = 0,
		intendedPrice = 29,
		permanent = false,
		icon = "🥚",
		name = "Instant Hatch",
		benefit = "Finishes one incubating pod now",
		description = "Hatches one pod immediately. Rarity, mutation chance and value are unchanged.",
	},
	SpeedBoost = {
		type = "DeveloperProduct",
		id = 0,
		intendedPrice = 49,
		permanent = false,
		icon = "⚡",
		name = "Speed Boost",
		benefit = "2× treadmill Speed for 15 minutes",
		description = "Counts down only while you play. Buying again adds time; it never raises the multiplier.",
		durationSeconds = 900,
	},
	CashPack = {
		type = "DeveloperProduct",
		id = 0,
		intendedPrice = 79,
		permanent = false,
		icon = "💵",
		name = "Cash Pack",
		benefit = "About 10 minutes of your income",
		description = "Scales with your progress: 10 minutes of your base income, with a minimum set by your highest unlocked zone.",
		incomeSeconds = 600,
		-- minimum = highest unlocked zone's common income × incomeSeconds × this
		minimumZoneIncomes = 2,
	},
}

-- Robux rows in the shop (Game Passes first, then one-time boosts). Speed Boost and
-- Instant Hatch are also sold on the treadmill console and on incubating pods.
MonetizationConfig.BoostsOrder = { "TurboTreadmill", "DoubleCash", "CashPack", "SpeedBoost", "InstantHatch" }

-- Treadmill Speed multiplier is additive: x1 base, x2 with Turbo OR a Boost, x3 with both.
MonetizationConfig.TurboSpeedBonus = 1
MonetizationConfig.BoostSpeedBonus = 1
MonetizationConfig.DoubleCashMult = 2

return MonetizationConfig
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000011"><Properties><string name="Name">Logic</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">CarryLogic</string><ProtectedString name="Source"><![CDATA[--[[
	CarryLogic — weight, slowdown, capacity, teleport heuristics.
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local C = Config.Carry
local CarryLogic = {}

function CarryLogic.coreWeight(coreId)
	local core = Config.Cores[coreId]
	if not core then
		return 1
	end
	return Config.Rarities[core.rarity].weight
end

function CarryLogic.totalWeight(coreIds)
	local w = 0
	for _, id in ipairs(coreIds) do
		w = w + CarryLogic.coreWeight(id)
	end
	return w
end

function CarryLogic.walkMultiplier(totalWeight)
	if totalWeight <= 0 then
		return 1
	end
	return math.max(C.MinWalkMult, 1 - C.PenaltyPerWeight * totalWeight)
end

function CarryLogic.capacityForLevel(level)
	return math.max(1, math.min(level or 1, Config.Upgrades.Carry.maxLevel))
end

function CarryLogic.canCarryMore(currentCount, carryLevel)
	return currentCount < CarryLogic.capacityForLevel(carryLevel)
end

-- Max plausible distance moved in `dt` seconds at walk speed `maxWalk`.
function CarryLogic.maxTravel(dt, maxWalk)
	return maxWalk * dt * C.TeleportFactor + C.TeleportSlack
end

-- Horizontal distance only: falling/jumping is not a teleport.
function CarryLogic.isTeleport(dx, dz, dt, maxWalk)
	local dist = math.sqrt(dx * dx + dz * dz)
	return dist > CarryLogic.maxTravel(dt, maxWalk)
end

--[[
	Movement budget for carriers. Character positions replicate in bursts, so a
	per-frame distance check would flag laggy players. Instead every frame adds
	allowance (maxWalk * dt * factor) up to a cap and every frame's movement
	spends it. A real teleport overdraws the budget; lag bursts don't.
]]
function CarryLogic.newBudget(maxWalk)
	return CarryLogic.budgetCap(maxWalk)
end

function CarryLogic.budgetCap(maxWalk)
	return maxWalk * 2.5 + 15
end

-- returns newBudget, isTeleport
function CarryLogic.spendBudget(budget, dist, dt, maxWalk)
	local cap = CarryLogic.budgetCap(maxWalk)
	budget = math.min(cap, budget + maxWalk * math.min(dt, 1) * C.TeleportFactor) - dist
	return budget, budget < -C.TeleportSlack
end

return CarryLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">DataSchema</string><ProtectedString name="Source"><![CDATA[--[[
	DataSchema — default player data and a strict sanitizer.

	Everything loaded from the DataStore goes through sanitize(), which drops
	unknown ids, clamps numbers, removes duplicate slots and enforces upgrade
	limits. That way corrupted, legacy or tampered data can never put the
	server in an invalid state.

	Shape (v1):
	{
		v = 1,
		money = number, speed = number, steps = number,
		upgrades = { Treadmill = n, Carry = n, Pods = n, Pedestals = n, Shield = n },
		pods = { { s = slot, c = coreId, m = mutation?, z = zoneIndex, p = progress } },
		storage = { { c = coreId, m = mutation?, z = zoneIndex } },
		disasters = { { s = slot, d = disasterId, m = mutation?, z = zoneIndex } },
		index = { [disasterId] = true },
		stats = { stolen = n, hatched = n, robbed = n },
		lastSeen = unixTime,
		passes = { [passKey] = true },   -- Game Pass entitlements (re-verified on join)
		boostSpeed = seconds,             -- Speed Boost play-time left
		hatchCredits = n,                 -- paid Instant Hatches waiting to be used
		receipts = { purchaseId, ... },   -- processed Developer Product receipts
	}
]]

local Config = require(script.Parent.Parent.Config.GameConfig)
local Util = require(script.Parent.Parent.Util)
local MConfig = require(script.Parent.Parent.Config.MonetizationConfig)

local DataSchema = {}

function DataSchema.default()
	local upgrades = {}
	for id, def in pairs(Config.Upgrades) do
		upgrades[id] = def.startLevel
	end
	return {
		v = Config.Data.SchemaVersion,
		money = Config.Economy.StartMoney,
		speed = 0,
		steps = 0,
		upgrades = upgrades,
		pods = {},
		storage = {},
		disasters = {},
		index = {},
		stats = { stolen = 0, hatched = 0, robbed = 0 },
		lastSeen = 0,
		passes = {},
		boostSpeed = 0,
		hatchCredits = 0,
		receipts = {},
	}
end

local function num(x, default, lo, hi)
	if not Util.isFiniteNumber(x) then
		return default
	end
	if lo and x < lo then
		x = lo
	end
	if hi and x > hi then
		x = hi
	end
	return x
end

local function validMutation(m)
	if m ~= nil and Config.Mutations[m] then
		return m
	end
	return nil
end

local function validZone(z)
	z = tonumber(z)
	if z and Config.Zones[math.floor(z)] then
		return math.floor(z)
	end
	return 1
end

function DataSchema.sanitize(raw)
	local data = DataSchema.default()
	if type(raw) ~= "table" then
		return data
	end

	data.money = num(raw.money, 0, 0, 1e18)
	data.speed = num(raw.speed, 0, 0, 1e15)
	data.steps = math.floor(num(raw.steps, 0, 0, 1e15))
	data.lastSeen = math.floor(num(raw.lastSeen, 0, 0, 1e11))

	if type(raw.upgrades) == "table" then
		for id, def in pairs(Config.Upgrades) do
			local lvl = math.floor(num(raw.upgrades[id], def.startLevel, def.startLevel, def.maxLevel))
			data.upgrades[id] = lvl
		end
	end

	-- pods: valid core, unique slot within unlocked pod count
	local podCount = data.upgrades.Pods
	local usedPods = {}
	if type(raw.pods) == "table" then
		for _, p in ipairs(raw.pods) do
			if type(p) == "table" and Config.Cores[p.c] then
				local s = math.floor(num(p.s, 0))
				if s >= 1 and s <= podCount and not usedPods[s] then
					usedPods[s] = true
					table.insert(data.pods, {
						s = s,
						c = p.c,
						m = validMutation(p.m),
						z = validZone(p.z),
						p = num(p.p, 0, 0, 1e7),
					})
				end
			end
		end
	end

	if type(raw.storage) == "table" then
		for _, c in ipairs(raw.storage) do
			if #data.storage >= Config.Data.MaxStoredCores then
				break
			end
			if type(c) == "table" and Config.Cores[c.c] then
				table.insert(data.storage, { c = c.c, m = validMutation(c.m), z = validZone(c.z) })
			end
		end
	end

	local pedCount = data.upgrades.Pedestals
	local usedPeds = {}
	if type(raw.disasters) == "table" then
		for _, d in ipairs(raw.disasters) do
			if type(d) == "table" and Config.Disasters[d.d] then
				local s = math.floor(num(d.s, 0))
				if s >= 1 and s <= pedCount and not usedPeds[s] then
					usedPeds[s] = true
					table.insert(data.disasters, { s = s, d = d.d, m = validMutation(d.m), z = validZone(d.z) })
				end
			end
		end
	end

	if type(raw.index) == "table" then
		for id, v in pairs(raw.index) do
			if v and Config.Disasters[id] then
				data.index[id] = true
			end
		end
	end
	for _, d in ipairs(data.disasters) do
		data.index[d.d] = true
	end

	if type(raw.stats) == "table" then
		data.stats.stolen = math.floor(num(raw.stats.stolen, 0, 0))
		data.stats.hatched = math.floor(num(raw.stats.hatched, 0, 0))
		data.stats.robbed = math.floor(num(raw.stats.robbed, 0, 0))
	end

	-- monetization: only known passes, bounded numbers, string receipt ids
	if type(raw.passes) == "table" then
		for key, item in pairs(MConfig.Items) do
			if item.type == "GamePass" and raw.passes[key] == true then
				data.passes[key] = true
			end
		end
	end
	data.boostSpeed = num(raw.boostSpeed, 0, 0, 1e7)
	data.hatchCredits = math.floor(num(raw.hatchCredits, 0, 0, 1000))
	if type(raw.receipts) == "table" then
		for _, id in ipairs(raw.receipts) do
			if type(id) == "string" and #id > 0 and #id <= 100 then
				table.insert(data.receipts, id)
			end
		end
		while #data.receipts > MConfig.ReceiptHistorySize do
			table.remove(data.receipts, 1)
		end
	end

	return data
end

-- helpers used by services ---------------------------------------------------

function DataSchema.freeSlot(list, maxSlots)
	local used = {}
	for _, e in ipairs(list) do
		used[e.s] = true
	end
	for s = 1, maxSlots do
		if not used[s] then
			return s
		end
	end
	return nil
end

function DataSchema.findBySlot(list, slot)
	for i, e in ipairs(list) do
		if e.s == slot then
			return e, i
		end
	end
	return nil, nil
end

return DataSchema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">EconomyLogic</string><ProtectedString name="Source"><![CDATA[--[[
	EconomyLogic — income and value of disaster collectibles.

	A disaster entry is { d = disasterId, m = mutationId|nil, z = originZoneIndex|nil }.
	`z` matters for the zone-agnostic Chaos Storm (its income scales with the zone it
	was stolen from); for other disasters the configured zone is used.
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local EconomyLogic = {}

function EconomyLogic.zoneIndexFor(entry)
	local d = Config.Disasters[entry.d]
	if not d then
		return 1
	end
	local idx = Config.ZoneIndex[d.zone]
	if idx then
		return idx
	end
	local z = tonumber(entry.z)
	if z and Config.Zones[z] then
		return z
	end
	return 1
end

function EconomyLogic.mutationMult(mutationId)
	local m = mutationId and Config.Mutations[mutationId]
	return m and m.mult or 1
end

function EconomyLogic.incomeFor(entry)
	local d = Config.Disasters[entry.d]
	if not d then
		return 0
	end
	local zone = Config.Zones[EconomyLogic.zoneIndexFor(entry)]
	local rarity = Config.Rarities[d.rarity]
	local income = zone.baseIncome * rarity.incomeMult * d.incomeFactor * EconomyLogic.mutationMult(entry.m)
	return math.floor(income * 10 + 0.5) / 10
end

function EconomyLogic.totalIncome(entries)
	local total = 0
	for _, e in ipairs(entries) do
		total = total + EconomyLogic.incomeFor(e)
	end
	return total
end

function EconomyLogic.valueFor(entry)
	return math.floor(EconomyLogic.incomeFor(entry) * Config.Economy.ValueSeconds)
end

-- Value of a core (shown in world): the value of the disaster it would become.
function EconomyLogic.coreValue(coreId, mutationId, zoneIndex)
	local c = Config.Cores[coreId]
	if not c then
		return 0
	end
	return EconomyLogic.valueFor({ d = c.disaster, m = mutationId, z = zoneIndex })
end

return EconomyLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">EventLogic</string><ProtectedString name="Source"><![CDATA[--[[
	EventLogic — the 5-minute refresh cycle with a 10-second Chaos Frenzy.

	Timeline for one cycle of length I (default 300 s), with t measured from
	server start:
	    [0, F)          Frenzy (begins exactly at each refresh)
	    [F, I - W)      Normal
	    [I - W, I)      Warning
	The very first cycle starts in Normal (no frenzy at t = 0).
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local EventLogic = {}

function EventLogic.phaseAt(t, cfg)
	cfg = cfg or Config.Events
	local I, W, F = cfg.Interval, cfg.Warning, cfg.FrenzyDuration
	if t < 0 then
		t = 0
	end
	local cycle = math.floor(t / I)
	local inCycle = t - cycle * I
	local toNext = I - inCycle
	if cycle >= 1 and inCycle < F then
		return { phase = "Frenzy", frenzyLeft = F - inCycle, toRefresh = toNext, cycle = cycle }
	end
	if inCycle >= I - W then
		return { phase = "Warning", frenzyLeft = 0, toRefresh = toNext, cycle = cycle }
	end
	return { phase = "Normal", frenzyLeft = 0, toRefresh = toNext, cycle = cycle }
end

-- Number of refreshes that happened in (t0, t1].
function EventLogic.refreshesBetween(t0, t1, cfg)
	cfg = cfg or Config.Events
	return math.max(0, math.floor(t1 / cfg.Interval) - math.floor(t0 / cfg.Interval))
end

return EventLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">IncubatorLogic</string><ProtectedString name="Source"><![CDATA[--[[
	IncubatorLogic — incubation timers and progress.

	A pod entry is { s = slot, c = coreId, m = mutation|nil, z = zoneIndex, p = progressSeconds }.
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local IncubatorLogic = {}

local ZONE_TIME_BONUS = 0.08 -- +8% incubation time per zone index

function IncubatorLogic.incubationTime(coreId, zoneIndex)
	local c = Config.Cores[coreId]
	if not c then
		return 15
	end
	local base = Config.Rarities[c.rarity].incubate
	local zi = Config.ZoneIndex[c.zone] or tonumber(zoneIndex) or 1
	return math.floor(base * (1 + ZONE_TIME_BONUS * (zi - 1)) + 0.5)
end

-- Advance a pod by dt seconds at `rate` (1 normally, Frenzy mult during frenzy).
-- Returns true when the pod has finished.
function IncubatorLogic.advance(pod, dt, rate)
	local total = IncubatorLogic.incubationTime(pod.c, pod.z)
	pod.p = math.min(total, (pod.p or 0) + math.max(0, dt) * (rate or 1))
	return pod.p >= total
end

function IncubatorLogic.fraction(pod)
	local total = IncubatorLogic.incubationTime(pod.c, pod.z)
	if total <= 0 then
		return 1
	end
	return math.min(1, (pod.p or 0) / total)
end

function IncubatorLogic.remaining(pod)
	return math.max(0, IncubatorLogic.incubationTime(pod.c, pod.z) - (pod.p or 0))
end

-- Mutation roll at hatch for cores that have none yet.
function IncubatorLogic.hatchMutation(existing, rng, mutationMult)
	if existing then
		return existing
	end
	local SpawnLogic = require(script.Parent.SpawnLogic)
	return SpawnLogic.rollMutation(rng, mutationMult)
end

return IncubatorLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">MonetizationLogic</string><ProtectedString name="Source"><![CDATA[--[[
	MonetizationLogic — pure rules for purchases (unit-tested headlessly).
]]

local Config = require(script.Parent.Parent.Config.GameConfig)
local MConfig = require(script.Parent.Parent.Config.MonetizationConfig)
local SpeedLogic = require(script.Parent.SpeedLogic)
local IncubatorLogic = require(script.Parent.IncubatorLogic)

local MonetizationLogic = {}

local function owns(data, key)
	return type(data) == "table" and type(data.passes) == "table" and data.passes[key] == true
end
MonetizationLogic.owns = owns

-- Treadmill Speed multiplier: additive, so it can never exceed x3.
function MonetizationLogic.speedMultiplier(data)
	local m = 1
	if owns(data, "TurboTreadmill") then
		m = m + MConfig.TurboSpeedBonus
	end
	if type(data) == "table" and (data.boostSpeed or 0) > 0 then
		m = m + MConfig.BoostSpeedBonus
	end
	return m
end

function MonetizationLogic.incomeMultiplier(data)
	if owns(data, "DoubleCash") then
		return MConfig.DoubleCashMult
	end
	return 1
end

-- Cash Pack: ~10 minutes of BASE income (Double Cash is not applied), with a
-- floor from the highest unlocked zone so it is useful at every stage.
function MonetizationLogic.cashPackAmount(baseIncome, speed)
	local item = MConfig.Items.CashPack
	local zone = Config.Zones[SpeedLogic.highestUnlockedZone(speed or 0)] or Config.Zones[1]
	local floorAmount = zone.baseIncome * item.incomeSeconds * item.minimumZoneIncomes
	local fromIncome = math.max(0, tonumber(baseIncome) or 0) * item.incomeSeconds
	return math.floor(math.max(fromIncome, floorAmount))
end

-- Pick the pod Instant Hatch finishes: the requested one if it is still
-- incubating, otherwise the incubating pod with the most time left.
-- `inTransit(slot)` excludes pods that are being stolen.
function MonetizationLogic.pickHatchPod(pods, preferredSlot, inTransit)
	local best, bestLeft
	for _, pod in ipairs(pods or {}) do
		local busy = inTransit and inTransit(pod.s)
		if not busy and IncubatorLogic.fraction(pod) < 1 then
			if pod.s == preferredSlot then
				return pod
			end
			local left = IncubatorLogic.remaining(pod)
			if not bestLeft or left > bestLeft then
				best, bestLeft = pod, left
			end
		end
	end
	return best
end

function MonetizationLogic.hasReceipt(list, purchaseId)
	for _, id in ipairs(list or {}) do
		if id == purchaseId then
			return true
		end
	end
	return false
end

function MonetizationLogic.addReceipt(list, purchaseId)
	table.insert(list, purchaseId)
	while #list > MConfig.ReceiptHistorySize do
		table.remove(list, 1)
	end
end

-- Lookup tables from Roblox id -> item key (only configured items).
function MonetizationLogic.keysById(itemType)
	local out = {}
	for key, item in pairs(MConfig.Items) do
		if item.type == itemType and type(item.id) == "number" and item.id > 0 then
			out[item.id] = key
		end
	end
	return out
end

return MonetizationLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">RateLimiter</string><ProtectedString name="Source"><![CDATA[--[[
	RateLimiter — token bucket per key. `clock` is injectable for tests.
]]

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(ratePerSecond, burst, clock)
	local self = setmetatable({}, RateLimiter)
	self.rate = ratePerSecond
	self.burst = burst
	self.clock = clock or os.clock
	self.buckets = {}
	return self
end

function RateLimiter:allow(key)
	local now = self.clock()
	local b = self.buckets[key]
	if not b then
		b = { tokens = self.burst, t = now }
		self.buckets[key] = b
	end
	b.tokens = math.min(self.burst, b.tokens + (now - b.t) * self.rate)
	b.t = now
	if b.tokens >= 1 then
		b.tokens = b.tokens - 1
		return true
	end
	return false
end

function RateLimiter:reset(key)
	self.buckets[key] = nil
end

return RateLimiter
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">SpawnLogic</string><ProtectedString name="Source"><![CDATA[--[[
	SpawnLogic — weighted core selection and mutation rolls.
	`rng` is a function returning a float in [0, 1).
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local SpawnLogic = {}

-- Returns a rarity -> weight table, boosted during Chaos Frenzy.
function SpawnLogic.effectiveWeights(zone, frenzy)
	local out = {}
	for rarity, w in pairs(zone.rarityWeights) do
		local rank = Config.Rarities[rarity].rank
		if frenzy then
			out[rarity] = w * Config.Events.FrenzyRareBoostPerRank ^ (rank - 1)
		else
			out[rarity] = w
		end
	end
	return out
end

function SpawnLogic.rollRarity(weights, rng)
	local total = 0
	-- iterate in a deterministic order so seeded tests are stable
	for _, rarity in ipairs(Config.RarityOrder) do
		total = total + (weights[rarity] or 0)
	end
	if total <= 0 then
		return nil
	end
	local roll = rng() * total
	local last = nil
	for _, rarity in ipairs(Config.RarityOrder) do
		local w = weights[rarity] or 0
		if w > 0 then
			last = rarity
			if roll < w then
				return rarity
			end
			roll = roll - w
		end
	end
	return last
end

-- Picks a core id for a zone. Zones list one core per rarity.
function SpawnLogic.pickCore(zone, rng, frenzy)
	local rarity = SpawnLogic.rollRarity(SpawnLogic.effectiveWeights(zone, frenzy), rng)
	local candidates = {}
	for _, coreId in ipairs(zone.cores) do
		if Config.Cores[coreId].rarity == rarity then
			table.insert(candidates, coreId)
		end
	end
	if #candidates == 0 then
		return zone.cores[1]
	end
	return candidates[math.floor(rng() * #candidates) + 1] or candidates[1]
end

function SpawnLogic.rollMutation(rng, mult)
	mult = mult or 1
	local roll = rng()
	local acc = 0
	-- rarest first so the rarest mutations aren't shadowed when mult is large
	for i = #Config.MutationOrder, 1, -1 do
		local id = Config.MutationOrder[i]
		acc = acc + Config.Mutations[id].chance * mult
		if roll < acc then
			return id
		end
	end
	return nil
end

return SpawnLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">SpeedLogic</string><ProtectedString name="Source"><![CDATA[--[[
	SpeedLogic — Speed stat math, treadmill step accounting, zone gating.
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local S = Config.Speed
local SpeedLogic = {}

function SpeedLogic.walkSpeedFor(speed)
	speed = math.max(0, speed or 0)
	local w = S.BaseWalkSpeed + S.WalkPerDoubling * math.log(1 + speed / S.WalkScale, 2)
	return math.min(w, S.MaxWalkSpeed)
end

function SpeedLogic.gainPerStep(treadmillLevel)
	local level = math.max(1, math.floor(treadmillLevel or 1))
	return math.floor(S.BaseGainPerStep * S.GainGrowth ^ (level - 1) + 0.5)
end

function SpeedLogic.canStealInZone(speed, zoneIndex)
	local zone = Config.Zones[zoneIndex]
	if not zone then
		return false
	end
	return (speed or 0) >= zone.speedReq
end

-- Highest zone index the player may steal in (always >= 1).
function SpeedLogic.highestUnlockedZone(speed)
	local best = 1
	for i, zone in ipairs(Config.Zones) do
		if (speed or 0) >= zone.speedReq then
			best = i
		end
	end
	return best
end

-- Next zone the player has NOT unlocked, or nil when all are unlocked.
function SpeedLogic.nextZone(speed)
	for _, zone in ipairs(Config.Zones) do
		if (speed or 0) < zone.speedReq then
			return zone
		end
	end
	return nil
end

--[[
	Step accumulator. The server calls tick() every Heartbeat for each player
	who is physically on their own treadmill belt and moving. It converts
	elapsed running time into whole steps at a capped rate, so frame rate or
	client spam can never produce extra steps.
]]
function SpeedLogic.newStepState()
	return { carry = 0 }
end

function SpeedLogic.tickSteps(state, dt, running)
	if not running or dt <= 0 then
		-- lose partial progress when stopping so tapping can't farm fractions
		state.carry = 0
		return 0
	end
	dt = math.min(dt, 0.5) -- ignore huge server hitches
	state.carry = state.carry + dt * S.StepsPerSecond
	local steps = math.floor(state.carry + 1e-6)
	state.carry = math.max(0, state.carry - steps)
	return steps
end

return SpeedLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">TravelLogic</string><ProtectedString name="Source"><![CDATA[--[[
	TravelLogic — pure rules for Quick Travel (HOME / STEAL / TRAIN / ZONES).

	Travel never skips progression: a zone is a valid destination only when the
	player's Speed lets them steal there, and nobody may travel while carrying a
	core (that would skip the run home).
]]

local Config = require(script.Parent.Parent.Config.GameConfig)
local SpeedLogic = require(script.Parent.SpeedLogic)
local WorldLayout = require(script.Parent.WorldLayout)
local Util = require(script.Parent.Parent.Util)

local TravelLogic = {}

TravelLogic.COOLDOWN = 4 -- seconds between trips (server-enforced)
TravelLogic.ENTRANCE_DEPTH = 14 -- studs inside a zone gate
TravelLogic.SPOT_OFFSETS = { 0, 5, -5, 9, -9 } -- sideways tries to avoid other players
TravelLogic.CLEAR_RADIUS = 4 -- min distance to another player's root

TravelLogic.Destinations = { Home = true, Steal = true, Train = true, Zone = true }

-- Highest zone the player may steal in (always at least 1).
function TravelLogic.stealZone(speed)
	return SpeedLogic.highestUnlockedZone(speed or 0)
end

function TravelLogic.zoneUnlocked(speed, index)
	index = tonumber(index)
	if not index or index ~= math.floor(index) or not Config.Zones[index] then
		return false
	end
	return SpeedLogic.canStealInZone(speed or 0, index)
end

-- Just inside a zone gate, on the clear central corridor. Returns {x, y, z}.
function TravelLogic.zoneEntrance(index)
	return { 0, 4, WorldLayout.zoneStartZ(index) + TravelLogic.ENTRANCE_DEPTH }
end

-- Validate a request. Returns ok, reason (reason is player-facing on failure).
-- `now` and `readyAt` are seconds; `carrying` is the number of carried cores.
function TravelLogic.check(dest, arg, speed, carrying, now, readyAt)
	if type(dest) ~= "string" or not TravelLogic.Destinations[dest] then
		return false, "Unknown destination."
	end
	if (carrying or 0) > 0 then
		return false, "You can't fast-travel while carrying a core — run it home!"
	end
	if readyAt and now < readyAt then
		return false, "Travel ready in " .. math.ceil(readyAt - now) .. "s."
	end
	if dest == "Zone" and not TravelLogic.zoneUnlocked(speed, arg) then
		local zone = Config.Zones[tonumber(arg) or 0]
		if zone then
			return false, zone.name .. " is locked — reach ⚡" .. Util.formatNumber(zone.speedReq) .. " Speed first."
		end
		return false, "Unknown zone."
	end
	return true, nil
end

-- Pick the first spot (base point shifted sideways by SPOT_OFFSETS) that is at
-- least CLEAR_RADIUS from every position in `others` ({x, z} pairs).
-- `side` is the unit sideways direction {x, z}. Returns the offset used.
function TravelLogic.clearOffset(base, side, others)
	for _, off in ipairs(TravelLogic.SPOT_OFFSETS) do
		local x = base[1] + side[1] * off
		local z = base[3] + side[2] * off
		local free = true
		for _, o in ipairs(others or {}) do
			if (o[1] - x) ^ 2 + (o[2] - z) ^ 2 < TravelLogic.CLEAR_RADIUS ^ 2 then
				free = false
				break
			end
		end
		if free then
			return off
		end
	end
	return TravelLogic.SPOT_OFFSETS[1]
end

return TravelLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">UpgradeLogic</string><ProtectedString name="Source"><![CDATA[--[[
	UpgradeLogic — costs and application of base upgrades (pure, data-only).
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local UpgradeLogic = {}

function UpgradeLogic.level(data, upgradeId)
	local def = Config.Upgrades[upgradeId]
	if not def then
		return 0
	end
	return (data.upgrades and data.upgrades[upgradeId]) or def.startLevel
end

-- Cost to go from `level` to `level + 1`; nil when maxed or unknown.
function UpgradeLogic.costFor(upgradeId, level)
	local def = Config.Upgrades[upgradeId]
	if not def or level >= def.maxLevel then
		return nil
	end
	if def.costs then
		return def.costs[level - def.startLevel + 1]
	end
	local steps = level - def.startLevel
	return math.floor(def.baseCost * def.growth ^ steps + 0.5)
end

function UpgradeLogic.nextCost(data, upgradeId)
	return UpgradeLogic.costFor(upgradeId, UpgradeLogic.level(data, upgradeId))
end

-- Returns ok, reasonOrCost
function UpgradeLogic.canBuy(data, upgradeId)
	if not Config.Upgrades[upgradeId] then
		return false, "Unknown upgrade"
	end
	local cost = UpgradeLogic.nextCost(data, upgradeId)
	if not cost then
		return false, "Maxed"
	end
	if (data.money or 0) < cost then
		return false, "Not enough money"
	end
	return true, cost
end

-- Mutates data. Returns ok, reasonOrCost
function UpgradeLogic.buy(data, upgradeId)
	local ok, res = UpgradeLogic.canBuy(data, upgradeId)
	if not ok then
		return false, res
	end
	data.money = data.money - res
	data.upgrades[upgradeId] = UpgradeLogic.level(data, upgradeId) + 1
	return true, res
end

function UpgradeLogic.shieldDuration(level)
	local d = Config.Upgrades.Shield.durations
	return d[math.max(1, math.min(#d, level or 1))]
end

return UpgradeLogic
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">WorldLayout</string><ProtectedString name="Source"><![CDATA[--[[
	WorldLayout — pure geometry for the map. Both the MapBuilder and the
	gameplay services use this so positions never drift apart.
	All positions are {x, y, z} arrays.
]]

local Config = require(script.Parent.Parent.Config.GameConfig)

local W = Config.World
local WorldLayout = {}

function WorldLayout.zoneStartZ(index)
	return W.RouteStartZ + (index - 1) * W.ZoneLength
end

function WorldLayout.zoneEndZ(index)
	return WorldLayout.zoneStartZ(index) + W.ZoneLength
end

function WorldLayout.zoneCenter(index)
	return { 0, W.GroundY, WorldLayout.zoneStartZ(index) + W.ZoneLength / 2 }
end

-- 0 = hub / bases, 1..n = zone index, -1 = out of bounds
function WorldLayout.zoneAt(x, z)
	if z < W.RouteStartZ then
		return 0
	end
	local idx = math.floor((z - W.RouteStartZ) / W.ZoneLength) + 1
	if idx > #Config.Zones then
		return -1
	end
	if math.abs(x) > W.ZoneWidth / 2 + 40 then
		return -1
	end
	return idx
end

function WorldLayout.nestCenter(index)
	return {
		0,
		W.GroundY,
		WorldLayout.zoneStartZ(index) + W.ZoneLength * Config.Spawning.NestDepth,
	}
end

function WorldLayout.nestPoints(index)
	local center = WorldLayout.nestCenter(index)
	local n = Config.Spawning.NestPointsPerZone
	local r = Config.Spawning.NestRadius
	local pts = {}
	for i = 1, n do
		local a = (i - 1) / n * math.pi * 2 + index * 0.4
		table.insert(pts, { center[1] + math.cos(a) * r, center[2], center[3] + math.sin(a) * r })
	end
	return pts
end

function WorldLayout.baseSlot(slotIndex)
	return Config.Bases.Slots[slotIndex]
end

-- Is (x, z) inside base `slotIndex`'s safe footprint?
function WorldLayout.inBase(slotIndex, x, z, margin)
	local slot = Config.Bases.Slots[slotIndex]
	if not slot then
		return false
	end
	local half = Config.Bases.Size / 2 + (margin or 0)
	return math.abs(x - slot.x) <= half and math.abs(z - slot.z) <= half
end

function WorldLayout.baseAt(x, z)
	for i = 1, #Config.Bases.Slots do
		if WorldLayout.inBase(i, x, z, 0) then
			return i
		end
	end
	return nil
end

--[[
	Base-local layout. Local space: origin at base center, +X local points from
	the back wall toward the avenue (the "front"). `face` flips X for the right
	column. Returned positions are world {x, y, z}.
]]
function WorldLayout.baseLocalToWorld(slotIndex, lx, ly, lz)
	local slot = Config.Bases.Slots[slotIndex]
	return { slot.x + lx * slot.face, ly, slot.z + lz * slot.face }
end

-- Incubator pods: row along the back wall.
function WorldLayout.podPosition(slotIndex, podIndex)
	local col = (podIndex - 1) % 4
	local row = math.floor((podIndex - 1) / 4)
	return WorldLayout.baseLocalToWorld(slotIndex, -24 + row * 10, 0, -18 + col * 12)
end

-- Display pedestals: 4x4 grid in the front half.
function WorldLayout.pedestalPosition(slotIndex, pedIndex)
	local col = (pedIndex - 1) % 4
	local row = math.floor((pedIndex - 1) / 4)
	return WorldLayout.baseLocalToWorld(slotIndex, -2 + row * 8, 0, -18 + col * 12)
end

function WorldLayout.treadmillPosition(slotIndex)
	return WorldLayout.baseLocalToWorld(slotIndex, -10, 0, 30)
end

function WorldLayout.spawnPosition(slotIndex)
	return WorldLayout.baseLocalToWorld(slotIndex, 31, 3, 22)
end

function WorldLayout.shieldButtonPosition(slotIndex)
	return WorldLayout.baseLocalToWorld(slotIndex, 31, 0, -28)
end

return WorldLayout
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000016"><Properties><string name="Name">Models</string></Properties><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">CoreModels</string><ProtectedString name="Source"><![CDATA[--[[
	CoreModels — builds the Disaster Core collectibles (the "eggs").

	Every core shares a readable silhouette — a glowing heart inside a
	containment shell held by two dark metal caps. The `shape` from config adds
	a distinct accent so cores read at a distance: Swirl rings, Crystal shards,
	Charged prongs, organic Pod leaves, Spiked shell, Flame petals, Cracked
	rock, Wave crest, Chaos gyro.

	Model contract:
	  * returns a Model whose PrimaryPart "Root" sits at the core's center
	  * all parts anchored, non-colliding, CanTouch false
	  * attributes: CoreId, Mutation, Rarity
	  * parts with attribute "Orbit" (rad/s) are spun around the Root's Y axis
	    by the client animator; the model carries the "Animated" tag
]]

local Config = require(script.Parent.Parent.Config.GameConfig)
local Kit = require(script.Parent.Kit)

local CoreModels = {}

local METAL = { 46, 48, 58 }

local function orbit(part, speed)
	part:SetAttribute("Orbit", speed)
	return part
end

local function ring(model, radius, count, size, color, material, tilt, speed, y)
	for i = 1, count do
		local a = (i - 1) / count * math.pi * 2
		local cf = CFrame.Angles(tilt or 0, 0, 0) * CFrame.new(math.cos(a) * radius, y or 0, math.sin(a) * radius)
		local p = Kit.part(model, {
			name = "Ring",
			size = Vector3.new(size, size * 0.5, size * 1.6),
			cf = cf * CFrame.Angles(0, -a, 0),
			color = color,
			material = material or Enum.Material.Neon,
			collide = false,
		})
		if speed then
			orbit(p, speed)
		end
	end
end

local accents = {}

function accents.Swirl(m, c)
	Kit.cylinder(m, { name = "Disk", height = 0.12, diameter = 3.6, color = c[3], material = Enum.Material.Neon, transparency = 0.55, collide = false })
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		local b = Kit.ball(m, {
			name = "Debris",
			diameter = 0.45,
			cf = CFrame.new(math.cos(a) * 1.9, 0.25 * (i - 2), math.sin(a) * 1.9),
			color = c[2],
			material = Enum.Material.Slate,
			collide = false,
		})
		orbit(b, 2.4)
	end
end

function accents.Crystal(m, c)
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		Kit.part(m, {
			name = "Shard",
			size = Vector3.new(0.5, 1.9, 0.5),
			cf = CFrame.new(math.cos(a) * 1.15, -0.1, math.sin(a) * 1.15) * CFrame.Angles(math.sin(a) * 0.5, a, math.cos(a) * 0.5),
			color = c[1],
			material = Enum.Material.Glass,
			transparency = 0.25,
			collide = false,
		})
	end
	Kit.part(m, { name = "Spire", size = Vector3.new(0.55, 1.6, 0.55), cf = CFrame.new(0, 1.7, 0) * CFrame.Angles(0, math.pi / 4, 0), color = c[3], material = Enum.Material.Neon, collide = false })
end

function accents.Charged(m, c)
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		Kit.part(m, {
			name = "Prong",
			size = Vector3.new(0.22, 1.6, 0.22),
			cf = CFrame.new(math.cos(a) * 1.1, 1.0, math.sin(a) * 1.1) * CFrame.Angles(math.sin(a) * 0.45, 0, -math.cos(a) * 0.45),
			color = METAL,
			material = Enum.Material.Metal,
			collide = false,
		})
		Kit.ball(m, { name = "Tip", diameter = 0.38, cf = CFrame.new(math.cos(a) * 1.45, 1.75, math.sin(a) * 1.45), color = c[3], material = Enum.Material.Neon, collide = false })
	end
	-- zig-zag arc
	local pts = { { -1.2, 0.2 }, { -0.4, 0.6 }, { 0.2, 0.0 }, { 1.1, 0.45 } }
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local p0, p1 = Vector3.new(a[1], a[2], 1.25), Vector3.new(b[1], b[2], 1.25)
		Kit.part(m, {
			name = "Arc",
			size = Vector3.new(0.12, 0.12, (p1 - p0).Magnitude),
			cf = CFrame.lookAt((p0 + p1) / 2, p1),
			color = c[3],
			material = Enum.Material.Neon,
			collide = false,
		})
	end
end

function accents.Pod(m, c)
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2
		Kit.part(m, {
			name = "Leaf",
			shape = "Wedge",
			size = Vector3.new(0.18, 1.4, 1.1),
			cf = CFrame.new(math.cos(a) * 1.0, -0.85, math.sin(a) * 1.0) * CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(-0.5, 0, 0),
			color = c[2],
			material = Enum.Material.Grass,
			collide = false,
		})
	end
	Kit.cylinder(m, { name = "Stem", height = 0.9, diameter = 0.3, cf = CFrame.new(0, 1.65, 0), color = c[2], material = Enum.Material.Grass, collide = false })
	Kit.ball(m, { name = "Bud", diameter = 0.55, cf = CFrame.new(0, 2.1, 0), color = c[3], material = Enum.Material.Neon, collide = false })
end

function accents.Spiked(m, c)
	local dirs = { { 1, 0, 0 }, { -1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 }, { 0, 0, -1 }, { 0.7, 0.7, 0.7 }, { -0.7, 0.7, -0.7 }, { 0.7, -0.5, -0.7 } }
	for _, d in ipairs(dirs) do
		local dir = Vector3.new(d[1], d[2], d[3]).Unit
		local pos = dir * 1.45
		Kit.part(m, {
			name = "Spike",
			size = Vector3.new(0.35, 0.35, 1.1),
			cf = CFrame.lookAt(pos, pos + dir),
			color = c[2],
			material = Enum.Material.Basalt,
			collide = false,
		})
		Kit.ball(m, { name = "SpikeTip", diameter = 0.24, cf = CFrame.new(dir * 2.0), color = c[3], material = Enum.Material.Neon, collide = false })
	end
end

function accents.Flame(m, c)
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		Kit.part(m, {
			name = "Petal",
			shape = "Wedge",
			size = Vector3.new(0.2, 1.5, 0.9),
			cf = CFrame.new(math.cos(a) * 0.55, 1.55, math.sin(a) * 0.55) * CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(0.35, 0, 0),
			color = c[3],
			material = Enum.Material.Neon,
			collide = false,
		})
	end
	local core = m:FindFirstChild("Heart")
	if core then
		Kit.particles(core, { color = c[3], color2 = c[1], size = 0.6, rate = 14, speed = 2.5, lifetime = 0.7, spread = 25, accel = Vector3.new(0, 5, 0) })
	end
end

function accents.Cracked(m, c)
	local shell = m:FindFirstChild("Shell")
	if shell then
		shell.Material = Enum.Material.Slate
		shell.Transparency = 0
		shell.Color = Kit.rgb(c[2])
	end
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		local dir = Vector3.new(math.cos(a), (i % 2 == 0) and 0.35 or -0.3, math.sin(a)).Unit
		Kit.part(m, {
			name = "Crack",
			size = Vector3.new(0.14, 0.9, 0.08),
			cf = CFrame.lookAt(dir * 1.2, dir * 2.4) * CFrame.Angles(0, 0, a),
			color = c[3],
			material = Enum.Material.Neon,
			collide = false,
		})
	end
end

function accents.Wave(m, c)
	for i = 1, 5 do
		local t = (i - 1) / 4
		local ang = -0.6 + t * 2.2
		Kit.part(m, {
			name = "Crest",
			size = Vector3.new(2.6 - t * 0.9, 0.3, 0.6),
			cf = CFrame.new(0, 0.8, 0) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, 0, -1.25),
			color = (i >= 4) and c[2] or c[1],
			material = (i >= 4) and Enum.Material.SmoothPlastic or Enum.Material.Glass,
			transparency = (i >= 4) and 0 or 0.2,
			collide = false,
		})
	end
	Kit.ball(m, { name = "Foam", diameter = 0.6, cf = CFrame.new(0.5, 1.9, 0.4), color = c[2], collide = false })
	Kit.ball(m, { name = "Foam", diameter = 0.45, cf = CFrame.new(-0.6, 1.8, 0.5), color = c[2], collide = false })
end

function accents.Chaos(m, c)
	ring(m, 1.9, 10, 0.32, c[1], Enum.Material.Neon, 0.5, 2.8)
	ring(m, 1.65, 8, 0.28, c[2], Enum.Material.Neon, -0.9, -3.4)
	local core = m:FindFirstChild("Heart")
	if core then
		Kit.particles(core, { color = c[1], color2 = c[2], size = 0.5, rate = 20, speed = 3, lifetime = 1 })
	end
end

local function mutationFx(m, root, mutationId)
	local mut = mutationId and Config.Mutations[mutationId]
	if not mut then
		return
	end
	local aura = Kit.ball(m, {
		name = "MutationAura",
		diameter = 4.2,
		color = mut.color,
		material = Enum.Material.ForceField,
		transparency = 0.15,
		collide = false,
		castShadow = false,
	})
	aura.CFrame = root.CFrame
	Kit.particles(root, { color = mut.color, size = 0.35, rate = 8, speed = 1.5, lifetime = 1.2, emission = 1 })
	if mutationId == "Golden" then
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Name == "Cap" then
				d.Color = Kit.rgb({ 255, 200, 40 })
				d.Material = Enum.Material.Foil
				d.Reflectance = 0.3
			end
		end
	end
end

--[[
	CoreModels.build(coreId, mutationId, sizeMult?) -> Model
]]
function CoreModels.build(coreId, mutationId, sizeMult)
	local def = Config.Cores[coreId]
	if not def then
		error("Unknown core " .. tostring(coreId))
	end
	local c = def.colors
	local rarity = Config.Rarities[def.rarity]
	local m = Instance.new("Model")
	m.Name = def.name

	local root = Kit.part(m, { name = "Root", size = Vector3.new(0.4, 0.4, 0.4), transparency = 1, collide = false })
	m.PrimaryPart = root

	local heart = Kit.ball(m, { name = "Heart", diameter = 1.5, color = c[3], material = Enum.Material.Neon, collide = false })
	Kit.light(heart, c[3], 10, 1.6)
	Kit.ball(m, { name = "Shell", diameter = 2.5, color = c[1], material = Enum.Material.Glass, transparency = 0.55, collide = false, castShadow = false })
	Kit.cylinder(m, { name = "Cap", height = 0.35, diameter = 1.7, cf = CFrame.new(0, 1.2, 0), color = METAL, material = Enum.Material.Metal, collide = false })
	Kit.cylinder(m, { name = "Cap", height = 0.35, diameter = 1.7, cf = CFrame.new(0, -1.2, 0), color = METAL, material = Enum.Material.Metal, collide = false })
	-- rarity band around the equator: readable rarity color from any angle
	Kit.cylinder(m, { name = "Band", height = 0.22, diameter = 2.62, color = rarity.color, material = Enum.Material.Neon, collide = false, castShadow = false })

	local accent = accents[def.shape] or accents.Swirl
	accent(m, c)
	mutationFx(m, root, mutationId)

	-- slight bigger cores for higher rarity
	local scale = (1 + (rarity.rank - 1) * 0.07) * (sizeMult or 1)
	if scale ~= 1 then
		m:ScaleTo(scale)
	end

	m:SetAttribute("CoreId", coreId)
	m:SetAttribute("Rarity", def.rarity)
	if mutationId then
		m:SetAttribute("Mutation", mutationId)
	end
	m:SetAttribute("AnimBob", 0.35)
	m:SetAttribute("AnimSpin", 0.8)
	Kit.setCollide(m, false)
	return m
end

return CoreModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">DisasterModels</string><ProtectedString name="Source"><![CDATA[--[[
	DisasterModels — builds the hatched disaster collectibles that sit on the
	display pedestals.

	Every disaster is a cute-but-dangerous mini creature built from plain parts.
	`def.archetype` picks the silhouette (Vortex funnel, puffy Cloud, anvil
	StormCloud, blocky Golem, S-curve Serpent, four-legged Beast, flame Wisp,
	ground Maw, cone Volcano, flaming Meteor, curling Wave, spread-wing Bird,
	floating Entity, BlackHole), and per-id tweaks make disasters that share an
	archetype read differently (debris, horns, tails, crests, palettes...).

	Model contract:
	  * returns a Model whose PrimaryPart "Root" (invisible) sits at the origin;
	    the bottom of the model is at y = 0 (it stands on a pedestal top), the
	    face looks toward -Z
	  * all parts anchored, non-colliding, CanTouch false
	  * height is set by rarity (Common ~4.6 studs ... Mythic ~8.6 studs)
	  * attributes: DisasterId, Rarity, Mutation (if any), AnimBob, AnimSpin;
	    parts may carry Orbit / SelfSpin (rad/s) for the client animator
]]

local Config = require(script.Parent.Parent.Config.GameConfig)
local Kit = require(script.Parent.Kit)

local DisasterModels = {}

local M = Enum.Material
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local PI = math.pi

local INK = { 22, 20, 30 }
local WHITE = { 255, 255, 255 }
local IVORY = { 245, 238, 220 }
local BLUSH = { 255, 140, 170 }

-- Target model height (studs) per rarity.
DisasterModels.Heights = {
	Common = 4.6,
	Uncommon = 5.3,
	Rare = 6.0,
	Epic = 6.7,
	Legendary = 7.6,
	Mythic = 8.6,
	Chaos = 8.9,
}

---------------------------------------------------------------------------
-- Part helpers (all non-colliding; positions are design-space and get
-- normalized to the rarity height afterwards)
---------------------------------------------------------------------------
local function toCF(at)
	if typeof(at) == "Vector3" then
		return CF(at)
	end
	return at or CF()
end

local function part(m, name, size, at, color, mat, tr, shape)
	return Kit.part(m, {
		name = name,
		size = size,
		cf = toCF(at),
		color = color,
		material = mat or M.SmoothPlastic,
		transparency = tr,
		shape = shape,
		collide = false,
	})
end

local function ball(m, name, d, at, color, mat, tr)
	return Kit.ball(m, { name = name, diameter = d, cf = toCF(at), color = color, material = mat or M.SmoothPlastic, transparency = tr, collide = false })
end

local function cyl(m, name, h, d, at, color, mat, tr)
	return Kit.cylinder(m, { name = name, height = h, diameter = d, cf = toCF(at), color = color, material = mat or M.SmoothPlastic, transparency = tr, collide = false })
end

-- Block spanning a -> b. Cross-section is w (local X) by wz (local Y).
local function seg(m, name, a, b, w, color, mat, tr, wz)
	local len = math.max((b - a).Magnitude, 0.05)
	return part(m, name, V(w, wz or w, len), CFrame.lookAt((a + b) / 2, b), color, mat, tr)
end

-- Round limb (cylinder) spanning a -> b.
local function rod(m, name, a, b, d, color, mat, tr)
	local len = math.max((b - a).Magnitude, 0.05)
	return part(m, name, V(len, d, d), CFrame.lookAt((a + b) / 2, b) * ANG(0, PI / 2, 0), color, mat, tr, "Cylinder")
end

local function orbit(p, speed)
	p:SetAttribute("Orbit", speed)
	return p
end

local function selfSpin(p, speed)
	p:SetAttribute("SelfSpin", speed)
	return p
end

-- Zig-zag chain of neon segments through `pts`.
local function bolt(m, pts, w, color)
	for i = 1, #pts - 1 do
		seg(m, "Bolt", pts[i], pts[i + 1], w, color, M.Neon)
	end
end

-- Front-surface z of a ball (for placing faces on round bodies).
local function ballZ(center, r)
	return function(y, x)
		local dx, dy = (x or 0) - center.X, y - center.Y
		return center.Z - math.sqrt(math.max(0, r * r - dx * dx - dy * dy))
	end
end

local function surfaceZ(z, y, x)
	if type(z) == "function" then
		return z(y, x)
	end
	return z
end

local function mouth(m, kind, pos, w, glow)
	if kind == "smile" then
		part(m, "Mouth", V(w, w * 0.16, w * 0.18), pos, INK)
		for s = -1, 1, 2 do
			part(m, "Mouth", V(w * 0.16, w * 0.32, w * 0.18), pos + V(s * w * 0.5, w * 0.1, 0), INK)
		end
	elseif kind == "o" then
		ball(m, "Mouth", w * 0.42, pos, INK)
	elseif kind == "fangs" then
		part(m, "Mouth", V(w, w * 0.26, w * 0.18), pos, INK)
		for s = -1, 1, 2 do
			part(m, "Tooth", V(w * 0.18, w * 0.18, w * 0.1), CF(pos + V(s * w * 0.28, -w * 0.13, -w * 0.07)) * ANG(0, 0, PI / 4), WHITE)
		end
	elseif kind == "grin" then
		part(m, "Mouth", V(w, w * 0.3, w * 0.18), pos, INK)
		part(m, "Tooth", V(w * 0.86, w * 0.1, w * 0.1), pos + V(0, w * 0.08, -w * 0.06), WHITE)
	elseif kind == "maw" then
		part(m, "Mouth", V(w, w * 0.36, w * 0.18), pos, INK)
		part(m, "MouthGlow", V(w * 0.7, w * 0.1, w * 0.1), pos + V(0, -w * 0.05, -w * 0.06), glow or { 255, 160, 60 }, M.Neon)
		for s = -1, 1, 2 do
			part(m, "Tooth", V(w * 0.16, w * 0.16, w * 0.1), CF(pos + V(s * w * 0.3, w * 0.16, -w * 0.07)) * ANG(0, 0, PI / 4), WHITE)
		end
	elseif kind == "line" then
		part(m, "Mouth", V(w, w * 0.12, w * 0.16), pos, INK)
	elseif kind == "glowline" then
		part(m, "Mouth", V(w, w * 0.1, w * 0.12), pos, glow or WHITE, M.Neon)
	end
end

--[[
	face(m, {
		y, d (eye diameter), gap (eye x offset), x = 0,
		z = number | function(y, x) -> front surface z,
		glow = color (glowing eyes) | nil (black eyes), shine = bool,
		brows = angle | nil, browColor, blush = color,
		mouth = "smile"|"o"|"fangs"|"grin"|"maw"|"line"|"glowline",
		mouthY, mouthZ, mouthW, mouthGlow,
	})
]]
local function face(m, o)
	local d, gap, x0, y = o.d, o.gap, o.x or 0, o.y
	for s = -1, 1, 2 do
		local ex = x0 + s * gap
		local p = V(ex, y, surfaceZ(o.z, y, ex) - d * 0.12)
		if o.glow then
			ball(m, "Eye", d, p, o.glow, M.Neon)
		else
			ball(m, "Eye", d, p, INK)
		end
		if o.shine ~= false then
			ball(m, "EyeShine", d * 0.36, p + V(d * 0.18, d * 0.2, -d * 0.34), WHITE, M.Neon)
		end
		if o.brows then
			local by = y + d * 0.74
			local bz = surfaceZ(o.z, by, ex) - d * 0.2
			part(m, "Brow", V(d * 1.1, d * 0.24, d * 0.32), CF(ex - s * d * 0.05, by, bz) * ANG(0, 0, s * o.brows), o.browColor or INK)
		end
		if o.blush then
			local bx = ex + s * d * 0.55
			local byy = y - d * 0.66
			part(m, "Blush", V(d * 0.62, d * 0.26, d * 0.1), V(bx, byy, surfaceZ(o.z, byy, bx) - d * 0.03), o.blush)
		end
	end
	if o.mouth then
		local my = o.mouthY or (y - d * 0.95)
		local mz = o.mouthZ or (surfaceZ(o.z, my, x0) - d * 0.06)
		mouth(m, o.mouth, V(x0, my, mz), o.mouthW or gap * 1.25, o.mouthGlow)
	end
end

---------------------------------------------------------------------------
-- Bounds / normalization
---------------------------------------------------------------------------
local function partExtent(p)
	local cf, s = p.CFrame, p.Size
	if p:IsA("Part") and p.Shape == Enum.PartType.Ball then
		local r = math.min(s.X, s.Y, s.Z) / 2
		return V(r, r, r)
	end
	local rv, uv, zv = cf.RightVector, cf.UpVector, cf.LookVector
	if p:IsA("Part") and p.Shape == Enum.PartType.Cylinder then
		local hx, r = s.X / 2, math.min(s.Y, s.Z) / 2
		local function ax(a)
			return math.abs(a) * hx + r * math.sqrt(math.max(0, 1 - a * a))
		end
		return V(ax(rv.X), ax(rv.Y), ax(rv.Z))
	end
	local hx, hy, hz = s.X / 2, s.Y / 2, s.Z / 2
	return V(
		math.abs(rv.X) * hx + math.abs(uv.X) * hy + math.abs(zv.X) * hz,
		math.abs(rv.Y) * hx + math.abs(uv.Y) * hy + math.abs(zv.Y) * hz,
		math.abs(rv.Z) * hx + math.abs(uv.Z) * hy + math.abs(zv.Z) * hz
	)
end

-- World-space AABB of every BasePart except `skip` (rotation aware).
local function bounds(m, skip)
	local lo, hi
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= skip then
			local e = partExtent(d)
			local pos = d.CFrame.Position
			local a, b = pos - e, pos + e
			lo = lo and lo:Min(a) or a
			hi = hi and hi:Max(b) or b
		end
	end
	return lo or Vector3.zero, hi or Vector3.zero
end
DisasterModels.bounds = bounds

-- Uniformly scale the design about the vertical axis so it is `targetH` tall
-- (or `maxW` wide, whichever is smaller) with its bottom at y = 0.
local function normalize(m, root, targetH, maxW)
	local lo, hi = bounds(m, root)
	local h = math.max(hi.Y - lo.Y, 0.1)
	local w = math.max(hi.X - lo.X, hi.Z - lo.Z, 0.1)
	local s = targetH / h
	if maxW and w * s > maxW then
		s = maxW / w
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local cf = d.CFrame
			local pos = cf.Position
			d.Size = d.Size * s
			d.CFrame = CF(pos.X * s, (pos.Y - lo.Y) * s, pos.Z * s) * cf.Rotation
		elseif d:IsA("PointLight") then
			d.Range = d.Range * s
		end
	end
	return bounds(m, root)
end

---------------------------------------------------------------------------
-- Archetype builders: builder(m, c, id) -> { bob = studs, spin = rad/s }
---------------------------------------------------------------------------
local A = {}

-- Stacked cylinder funnel. Returns the layer list { {y, d}, ... }.
local function funnel(m, o)
	local layers = {}
	for i = 1, o.layers do
		local t = (i - 1) / (o.layers - 1)
		local d = o.baseD + (o.topD - o.baseD) * (t ^ (o.curve or 1.5))
		local y = o.startY + (i - 1) * o.step
		local a = i * 1.7
		local wob = o.wobble or 0.1
		local p = cyl(m, "Layer", o.layerH, d, V(math.cos(a) * wob, y, math.sin(a) * wob), o.color(i, t), o.material(i), o.transparency or 0.08)
		orbit(p, o.speed(i, t))
		layers[i] = { y = y, d = d }
	end
	return layers
end

local function funnelZ(layers, layerH)
	return function(y)
		local r = 0
		for _, l in ipairs(layers) do
			if math.abs(y - l.y) <= layerH / 2 + 0.02 then
				r = math.max(r, l.d / 2)
			end
		end
		if r == 0 then
			r = layers[1].d / 2
		end
		return -r
	end
end

-- Maelstrom: a whirlpool funnel opening upward, with a foam rim and a dark eye.
local function maelstrom(m, c)
	local water, foam, glow = c[1], c[2], c[3]
	local deep = Kit.shade(water, 0.35)
	cyl(m, "Pool", 0.3, 3.8, V(0, 0.15, 0), water, M.Glass, 0.25)
	for i = 1, 4 do
		local a = i / 4 * PI * 2 + 0.4
		orbit(ball(m, "Splash", 0.5, V(math.cos(a) * 1.75, 0.32, math.sin(a) * 1.75), foam), 0.8)
	end
	local layerH = 0.7
	local layers = {}
	for i = 1, 6 do
		local t = (i - 1) / 5
		local d = 0.9 + 3.3 * (t ^ 1.2)
		local y = 0.55 + (i - 1) * 0.6
		local p = cyl(m, "Layer", layerH, d, V(0, y, 0), Kit.mix(deep, water, 0.35 + t * 0.65), M.Glass, 0.18)
		orbit(p, -(3.6 - 2 * t))
		layers[i] = { y = y, d = d }
	end
	local topY = layers[6].y + layerH / 2
	local topD = layers[6].d
	cyl(m, "Eye", 0.1, topD * 0.82, V(0, topY + 0.02, 0), deep)
	cyl(m, "Whirl", 0.12, 0.9, V(0, topY + 0.05, 0), glow, M.Neon)
	for i = 1, 3 do
		local a = i / 3 * PI * 2
		local p = part(m, "Streak", V(0.15, 0.06, 1.2), CF(math.cos(a) * 0.95, topY + 0.07, math.sin(a) * 0.95) * ANG(0, -a, 0), foam)
		orbit(p, -2.6)
	end
	for i = 1, 8 do
		local a = i / 8 * PI * 2
		orbit(ball(m, "Foam", 0.6, V(math.cos(a) * topD / 2, topY, math.sin(a) * topD / 2), foam), -1.2)
	end
	face(m, { y = 2.75, d = 0.55, gap = 0.45, z = funnelZ(layers, layerH), brows = 0.3, browColor = deep, mouth = "fangs" })
	Kit.particles(m:FindFirstChild("Whirl"), { color = foam, size = 0.35, rate = 8, speed = 1.5, lifetime = 1, spread = 40, accel = V(0, 2, 0) })
	return { bob = 0.1, spin = 0 }
end

function A.Vortex(m, c, id)
	if id == "Maelstrom" then
		return maelstrom(m, c)
	end
	local chaos = id == "ChaosStorm"
	local sandy = id == "DustDevil" or id == "Sandstorm"
	local wide = id == "Sandstorm"
	local layerH = 0.75
	local layers = funnel(m, {
		layers = 7,
		baseD = wide and 0.9 or 0.55,
		topD = wide and 4.4 or 3.7,
		layerH = layerH,
		startY = 0.38,
		step = 0.62,
		wobble = 0.1,
		color = function(i, t)
			if chaos then
				return c[(i - 1) % 3 + 1]
			end
			return Kit.mix(c[2], c[1], 0.3 + t * 0.7)
		end,
		material = function(i)
			if chaos then
				return (i % 2 == 0) and M.Neon or M.Glass
			end
			if sandy then
				return M.Sand
			end
			return M.SmoothPlastic
		end,
		transparency = chaos and 0.15 or 0.06,
		speed = function(i, t)
			local s = 4.2 - t * 2.4
			if chaos and i % 2 == 0 then
				return -s
			end
			return s
		end,
	})
	local zf = funnelZ(layers, layerH)
	local topY = layers[7].y + layerH / 2

	-- dust skirt at the touch-down point
	cyl(m, "Skirt", 0.2, wide and 2.8 or 1.8, V(0, 0.1, 0), c[2], sandy and M.Sand or M.SmoothPlastic, 0.45)

	if id == "MiniTornado" or chaos then
		local cap = chaos and c[1] or Kit.mix(c[1], WHITE, 0.25)
		ball(m, "Cloud", 1.7, V(-1.25, topY + 0.25, 0.1), cap)
		ball(m, "Cloud", 2.0, V(0, topY + 0.5, 0.05), chaos and c[2] or cap)
		ball(m, "Cloud", 1.7, V(1.25, topY + 0.25, 0.1), chaos and c[3] or cap)
	end

	if id == "DustDevil" then
		face(m, { y = 2.95, d = 0.58, gap = 0.42, z = zf, mouth = "smile", blush = BLUSH })
		local weed = ball(m, "Tumbleweed", 0.75, V(1.75, 1.6, 0.3), { 150, 110, 60 }, M.Grass)
		orbit(weed, 3.0)
		selfSpin(weed, 4)
		orbit(ball(m, "Pebble", 0.35, V(-1.6, 2.6, -0.4), c[2], M.Slate), 2.6)
		orbit(ball(m, "Pebble", 0.3, V(0.4, 3.7, 1.9), c[2], M.Slate), 2.2)
	elseif id == "MiniTornado" then
		face(m, { y = 2.95, d = 0.58, gap = 0.42, z = zf, brows = 0.35, mouth = "grin" })
		-- suburban debris: a fence plank, a roof piece and a mailbox
		local plank = part(m, "FencePlank", V(0.18, 0.45, 1.7), CF(2.15, 2.4, 0) * ANG(0.4, 0.3, 0.6), { 240, 235, 225 }, M.WoodPlanks)
		orbit(plank, 2.2)
		selfSpin(plank, 3)
		local roof = part(m, "RoofPiece", V(1.2, 0.45, 0.9), CF(-1.95, 3.3, 0.6) * ANG(0.3, 0.8, -0.4), { 170, 60, 50 }, M.Slate, nil, "Wedge")
		orbit(roof, 1.8)
		selfSpin(roof, -2)
		local box = part(m, "Mailbox", V(0.35, 0.35, 0.6), CF(0.3, 1.4, -1.9) * ANG(0, 0.6, 0.3), { 60, 90, 160 }, M.Metal)
		orbit(box, 2.6)
	elseif id == "Sandstorm" then
		face(m, { y = 2.95, d = 0.6, gap = 0.48, z = zf, brows = 0.45, mouth = "fangs" })
		orbit(cyl(m, "Cactus", 0.9, 0.35, CF(2.4, 2.8, 0) * ANG(0.5, 0, 0.4), { 80, 140, 70 }, M.Grass), 1.6)
		orbit(part(m, "Rock", V(0.5, 0.4, 0.45), CF(-2.2, 1.9, 0.4) * ANG(0.4, 0.5, 0.2), c[2], M.Slate), 2.4)
		orbit(part(m, "Rock", V(0.4, 0.35, 0.4), CF(0.6, 3.9, 2.3) * ANG(0.2, 0.9, 0.5), c[2], M.Slate), 2.0)
		Kit.particles(m:FindFirstChild("Skirt"), { color = c[1], color2 = c[2], size = 0.5, rate = 18, speed = 3, lifetime = 1.2, spread = 60, accel = V(0, 2, 0), emission = 0 })
	elseif chaos then
		face(m, { y = 2.95, d = 0.6, gap = 0.44, z = zf, glow = c[3], brows = 0.5, mouth = "grin" })
		for r = 1, 2 do
			local tilt = (r == 1) and 0.5 or -0.5
			for i = 1, 6 do
				local a = i / 6 * PI * 2
				local p = part(m, "ChaosRing", V(0.35, 0.35, 0.35), CF(0, 2.8, 0) * ANG(tilt, 0, 0) * CF(math.cos(a) * 2.6, 0, math.sin(a) * 2.6) * ANG(0.6, a, 0.6), c[r], M.Neon)
				orbit(p, (r == 1) and 2.6 or -2.6)
			end
		end
		bolt(m, { V(-0.9, topY + 0.1, -0.9), V(-0.5, topY - 0.5, -1.0), V(-0.8, topY - 1.0, -1.0) }, 0.16, c[3])
		Kit.particles(m:FindFirstChild("Cloud"), { color = c[1], color2 = c[2], size = 0.4, rate = 16, speed = 3, lifetime = 1 })
	else
		face(m, { y = 2.95, d = 0.58, gap = 0.42, z = zf, mouth = "smile" })
	end
	return { bob = 0.15, spin = 0 }
end

local CLOUD_PUFFS = {
	{ 0, 3.6, 0, 2.5 },
	{ -1.25, 3.3, 0.15, 1.85 },
	{ 1.25, 3.3, 0.15, 1.85 },
	{ -0.55, 4.35, 0.3, 1.75 },
	{ 0.6, 4.25, 0.25, 1.6 },
	{ 0, 3.4, 0.8, 2.0 },
}

function A.Cloud(m, c, id)
	for i, p in ipairs(CLOUD_PUFFS) do
		ball(m, (i == 1) and "Body" or "Puff", p[4], V(p[1], p[2], p[3]), Kit.mix(c[1], c[2], (i - 1) * 0.05))
	end
	local body = m:FindFirstChild("Body")
	local zf = ballZ(V(0, 3.6, 0), 1.25)
	if id == "HailSprite" then
		face(m, { y = 3.7, d = 0.52, gap = 0.46, z = zf, brows = 0.25, mouth = "grin" })
		-- icy crown
		for s = -1, 1, 2 do
			part(m, "Crown", V(0.3, 0.75, 0.3), CF(s * 0.35, 5.2, 0.3) * ANG(0, PI / 4, s * 0.35), c[3], M.Glass, 0.15)
		end
		local hail = { { -0.8, 1.9, -0.3, 0.38 }, { 0.5, 1.4, -0.1, 0.32 }, { 0.95, 2.25, 0.25, 0.3 }, { -0.3, 0.85, 0.1, 0.34 } }
		for _, h in ipairs(hail) do
			ball(m, "Hail", h[4], V(h[1], h[2], h[3]), c[3], M.Ice)
		end
		cyl(m, "SnowPatch", 0.16, 2.4, V(0, 0.08, 0), c[1], M.Snow)
		ball(m, "HailPile", 0.5, V(0.3, 0.3, 0), c[3], M.Ice)
		ball(m, "HailPile", 0.45, V(-0.25, 0.28, 0.2), c[3], M.Ice)
		ball(m, "HailPile", 0.4, V(0.05, 0.6, 0.1), c[3], M.Ice)
		Kit.particles(body, { color = c[3], size = 0.22, sizeEnd = 0.18, rate = 8, speed = 2, lifetime = 0.9, spread = 15, accel = V(0, -18, 0), emission = 0.2 })
	else -- SporeCloud
		face(m, { y = 3.7, d = 0.52, gap = 0.46, z = zf, mouth = "smile", blush = BLUSH })
		for s = -1, 1, 2 do
			part(m, "Sprout", V(0.12, 0.45, 0.7), CF(s * 0.3, 5.25, 0.3) * ANG(0, s * PI / 2, 0) * ANG(-0.5, 0, 0), c[2], M.Grass, nil, "Wedge")
		end
		cyl(m, "Moss", 0.2, 2.8, V(0, 0.1, 0), c[2], M.Grass)
		local shrooms = { { -0.75, 0.7, 0.75, 0.2 }, { 0.65, 0.5, 0.6, -0.1 }, { 0.05, 0.9, 0.85, 0.5 } }
		for _, s in ipairs(shrooms) do
			cyl(m, "Stem", s[2], 0.26, V(s[1], 0.2 + s[2] / 2, s[4]), { 240, 230, 210 })
			ball(m, "Cap", s[3], V(s[1], 0.2 + s[2] + s[3] * 0.2, s[4]), c[1])
		end
		ball(m, "Spore", 0.28, V(-0.7, 1.6, -0.3), c[3], M.Neon)
		ball(m, "Spore", 0.26, V(0.6, 2.05, 0), c[3], M.Neon)
		ball(m, "Spore", 0.22, V(0.15, 1.35, -0.5), c[3], M.Neon)
		Kit.particles(body, { color = c[3], color2 = c[1], size = 0.3, rate = 6, speed = 0.6, lifetime = 2.2, accel = V(0, 0.6, 0) })
	end
	return { bob = 0.35, spin = 0 }
end

function A.StormCloud(m, c, id)
	local ash = id == "AshCloud"
	local cell = id == "Supercell"
	local puffs = {
		{ 0, 3.3, 0, 2.7 },
		{ -1.45, 3.1, 0.1, 2.05 },
		{ 1.45, 3.1, 0.1, 2.05 },
		{ 0, 3.5, 0.85, 2.3 },
		{ -0.7, 4.1, 0.4, 1.9 },
		{ 0.75, 4.0, 0.4, 1.8 },
	}
	local mat = ash and M.Slate or M.SmoothPlastic
	for i, p in ipairs(puffs) do
		ball(m, (i == 1) and "Body" or "Puff", p[4], V(p[1], p[2], p[3]), Kit.mix(c[1], c[2], (i % 3) * 0.25), mat)
	end
	local body = m:FindFirstChild("Body")
	if ash then
		-- rising ash plume with embers
		ball(m, "Plume", 2.0, V(0.2, 4.75, 0.3), c[2], M.Slate)
		ball(m, "Plume", 1.4, V(-0.15, 5.65, 0.35), Kit.mix(c[1], c[2], 0.5), M.Slate)
		for i = 1, 3 do
			local a = i / 3 * PI * 2
			orbit(ball(m, "Ember", 0.3, V(math.cos(a) * 2.2, 3.0 + i * 0.6, math.sin(a) * 2.2), c[3], M.Neon), 1.4)
		end
	else
		-- flat anvil top
		local wideD = cell and 5.6 or 4.8
		cyl(m, "Anvil", 0.5, wideD, V(0, 4.85, 0.2), c[2])
		cyl(m, "Anvil", 0.3, wideD + 0.8, V(0, 5.2, 0.25), Kit.mix(c[1], c[2], 0.5))
	end
	local zf = ballZ(V(0, 3.3, 0), 1.35)
	face(m, { y = 3.45, d = 0.5, gap = 0.5, z = zf, glow = c[3], brows = 0.45, browColor = c[2], mouth = cell and "fangs" or "grin" })

	-- inner lightning flicker
	local flick = ball(m, "Flicker", 1.0, V(1.0, 2.8, -0.7), c[3], M.Neon, 0.1)
	Kit.light(flick, c[3], 10, 1.8)

	if cell then
		-- rotating wall cloud and a funnel touching down
		for i = 1, 6 do
			local a = i / 6 * PI * 2
			orbit(ball(m, "WallCloud", 1.0, V(math.cos(a) * 1.6, 2.2, math.sin(a) * 1.6), c[2]), 1.2)
		end
		local f = { { 2.0, 1.0 }, { 1.4, 0.75 }, { 0.8, 0.5 }, { 0.25, 0.32 } }
		for i, l in ipairs(f) do
			orbit(cyl(m, "Funnel", 0.65, l[2], V(0, l[1], -0.1), Kit.mix(c[1], WHITE, 0.25), M.SmoothPlastic, 0.1), 5 - i * 0.5)
		end
		bolt(m, { V(-1.4, 2.4, -0.6), V(-1.8, 1.7, -0.7), V(-1.5, 1.1, -0.7) }, 0.18, c[3])
		cyl(m, "Debris", 0.1, 1.2, V(0, 0.05, -0.1), Kit.shade(c[1], 0.6), M.Slate, 0.3)
	else
		bolt(m, { V(0.5, 2.1, -0.5), V(-0.25, 1.45, -0.55), V(0.3, 0.85, -0.55), V(-0.15, 0.15, -0.55) }, 0.2, c[3])
		if ash then
			ball(m, "Ember Rock", 0.8, V(-0.15, 0.4, -0.55), { 50, 40, 38 }, M.Basalt)
			part(m, "Crack", V(0.1, 0.5, 0.06), CF(-0.15, 0.45, -0.96) * ANG(0, 0, 0.5), c[3], M.Neon)
		else
			cyl(m, "Scorch", 0.08, 1.1, V(-0.15, 0.04, -0.55), { 30, 30, 34 })
			ball(m, "Spark", 0.3, V(-0.15, 0.15, -0.55), c[3], M.Neon)
		end
	end
	if ash then
		Kit.particles(body, { color = { 60, 55, 55 }, color2 = c[3], size = 0.35, rate = 10, speed = 1.2, lifetime = 1.6, accel = V(0, -2, 0), emission = 0.2 })
	else
		Kit.particles(body, { color = { 150, 180, 255 }, size = 0.12, sizeEnd = 0.1, rate = 14, speed = 3, lifetime = 0.6, spread = 10, accel = V(0, -25, 0), emission = 0 })
	end
	return { bob = 0.25, spin = 0 }
end

function A.Golem(m, c, id)
	local glow = c[3]
	local main, sec, mat, secMat = c[1], c[2], M.Slate, M.Slate
	if id == "BrambleQuake" then
		main, sec, mat, secMat = c[2], Kit.shade(c[2], 0.8), M.Wood, M.Wood
	elseif id == "AvalancheGolem" then
		mat, secMat = M.Snow, M.Slate
	elseif id == "GlacierTitan" then
		mat, secMat = M.Ice, M.Ice
	end
	local quake = id == "BrambleQuake" or id == "QuakeTitan"
	local b = 0
	if quake then
		cyl(m, "Slab", 0.3, 3.6, V(0, 0.15, 0), Kit.shade(c[2], 0.9), M.Slate)
		part(m, "Crack", V(0.12, 0.06, 1.4), CF(0.75, 0.31, -0.7) * ANG(0, 0.5, 0), glow, M.Neon)
		part(m, "Crack", V(0.12, 0.06, 1.2), CF(-0.85, 0.31, 0.3) * ANG(0, -0.9, 0), glow, M.Neon)
		b = 0.3
	end
	local fist = (id == "QuakeTitan") and 1.3 or 1.05
	for s = -1, 1, 2 do
		part(m, "Leg", V(0.9, 1.3, 0.95), V(s * 0.62, b + 0.65, 0), sec, secMat)
	end
	part(m, "Pelvis", V(2.0, 0.6, 1.25), V(0, b + 1.55, 0), sec, secMat)
	part(m, "Torso", V(2.7, 1.8, 1.6), V(0, b + 2.75, 0), main, mat)
	local head = part(m, "Head", V(1.4, 1.15, 1.25), V(0, b + 4.2, -0.12), main, mat)
	for s = -1, 1, 2 do
		if id == "AvalancheGolem" and s == 1 then
			-- right arm raised, holding a big snowball
			part(m, "Arm", V(0.85, 1.5, 0.85), CF(1.8, b + 4.0, 0) * ANG(0, 0, -0.15), main, mat)
			part(m, "Fist", V(fist, 1.0, fist), V(1.95, b + 4.95, -0.1), sec, secMat)
			ball(m, "Snowball", 1.3, V(1.95, b + 5.85, -0.1), WHITE, M.Snow)
		else
			part(m, "Arm", V(0.85, 1.5, 0.85), CF(s * 1.8, b + 2.9, 0) * ANG(0, 0, s * 0.12), main, mat)
			part(m, "Fist", V(fist, fist * 0.95, fist), V(s * (1.85 + fist * 0.1), b + 1.75, -0.1), sec, secMat)
		end
	end
	local gem = ball(m, "Gem", 0.7, V(0, b + 2.85, -0.75), glow, M.Neon)
	Kit.light(gem, glow, 8, 1.2)
	part(m, "Crack", V(0.1, 0.9, 0.06), CF(0.72, b + 2.4, -0.81) * ANG(0, 0, 0.4), glow, M.Neon)
	part(m, "Crack", V(0.1, 0.7, 0.06), CF(-0.68, b + 3.15, -0.81) * ANG(0, 0, -0.5), glow, M.Neon)
	face(m, { y = b + 4.3, d = 0.36, gap = 0.32, z = -0.745, glow = glow, brows = 0.45, browColor = Kit.shade(main, 0.5), mouth = "line", mouthY = b + 3.9, mouthW = 0.6 })

	if id == "BrambleQuake" then
		for s = -1, 1, 2 do
			part(m, "Moss", V(1.0, 0.35, 1.0), V(s * 1.8, b + 3.8, 0), c[1], M.Grass)
			part(m, "Thorn", V(0.22, 0.6, 0.22), CF(s * 1.9, b + 4.1, 0.15) * ANG(0, 0, -s * 0.5), Kit.shade(c[1], 0.6), M.Wood)
			part(m, "Leaf", V(0.15, 0.7, 0.6), CF(s * 0.35, b + 5.05, 0) * ANG(0, s * PI / 2, 0), c[1], M.Grass, nil, "Wedge")
		end
		part(m, "Thorn", V(0.25, 0.7, 0.25), CF(0.5, b + 3.1, 0.85) * ANG(0.7, 0, 0), Kit.shade(c[1], 0.6), M.Wood)
		part(m, "Thorn", V(0.25, 0.7, 0.25), CF(-0.5, b + 2.5, 0.85) * ANG(0.7, 0, 0), Kit.shade(c[1], 0.6), M.Wood)
		ball(m, "Flower", 0.4, V(-0.45, b + 4.85, 0.1), glow, M.Neon)
	elseif id == "QuakeTitan" then
		for s = -1, 1, 2 do
			ball(m, "Boulder", 1.15, V(s * 1.85, b + 3.85, 0.1), sec, M.Slate)
			part(m, "Crack", V(0.1, 0.8, 0.06), CF(s * 1.85, b + 2.7, -0.45) * ANG(0, 0, s * 0.3), glow, M.Neon)
		end
		part(m, "Spike", V(0.4, 0.9, 0.4), CF(0, b + 3.9, 0.55) * ANG(-0.5, PI / 4, 0), sec, M.Slate)
		Kit.particles(m:FindFirstChild("Slab"), { color = c[1], size = 0.4, rate = 6, speed = 1.5, lifetime = 0.8, spread = 50, emission = 0 })
	elseif id == "AvalancheGolem" then
		ball(m, "SnowCap", 1.1, V(0, b + 4.8, 0), WHITE, M.Snow)
		ball(m, "SnowShoulder", 0.9, V(-1.8, b + 3.75, 0), WHITE, M.Snow)
		part(m, "Icicle", V(0.2, 0.6, 0.2), CF(-1.8, b + 2.0, -0.2) * ANG(0, PI / 4, 0), glow, M.Glass, 0.2)
		part(m, "Icicle", V(0.18, 0.5, 0.18), CF(0.5, b + 3.4, -0.83) * ANG(0, PI / 4, 0), glow, M.Glass, 0.2)
		Kit.particles(head, { color = WHITE, size = 0.25, rate = 5, speed = 0.6, lifetime = 1.6, accel = V(0, -1.5, 0), emission = 0 })
	elseif id == "GlacierTitan" then
		local spikes = {
			{ CF(0.55, b + 3.7, 0.65) * ANG(-0.6, 0, -0.25), 1.4 },
			{ CF(-0.55, b + 3.6, 0.7) * ANG(-0.7, 0, 0.3), 1.2 },
			{ CF(1.85, b + 4.0, 0) * ANG(0, 0, -0.3), 1.2 },
			{ CF(-1.85, b + 4.0, 0) * ANG(0, 0, 0.3), 1.2 },
			{ CF(0, b + 5.0, 0) * ANG(0, PI / 4, 0), 0.9 },
			{ CF(0.45, b + 4.9, 0.05) * ANG(0, PI / 4, -0.35), 0.6 },
			{ CF(-0.45, b + 4.9, 0.05) * ANG(0, PI / 4, 0.35), 0.6 },
		}
		for _, sp in ipairs(spikes) do
			part(m, "IceSpike", V(0.42, sp[2], 0.42), sp[1], glow, M.Glass, 0.15)
		end
		Kit.particles(gem, { color = glow, size = 0.25, rate = 6, speed = 1, lifetime = 1.4, emission = 0.8 })
	end
	return { bob = 0.06, spin = 0 }
end

function A.Serpent(m, c, id)
	local main, sec, glow = c[1], c[2], c[3]
	local mat = (id == "VineSerpent") and M.Grass or M.SmoothPlastic
	local watery = id == "RiptideEel" or id == "UndertowLeviathan"
	local jet = id == "JetstreamDrake"
	-- coiled base
	for i = 1, 5 do
		local a = (i - 1) / 5 * PI * 2 + 0.6
		if jet then
			ball(m, "CloudBase", 1.25 - (i % 2) * 0.15, V(math.cos(a) * 1.0, 0.6, math.sin(a) * 1.0), sec)
		else
			ball(m, "Coil", 1.1, V(math.cos(a) * 1.05, 0.55 + i * 0.03, math.sin(a) * 1.05 + 0.1), (i % 2 == 0) and Kit.shade(main, 0.85) or main, mat)
		end
	end
	if watery then
		cyl(m, "Water", 0.15, 3.4, V(0, 0.075, 0.1), { 60, 150, 200 }, M.Glass, 0.35)
	end
	-- rising S-curve body
	local pts = {}
	for i = 1, 6 do
		local t = i / 6
		local p = V(math.sin(t * PI * 1.6) * 0.95, 0.9 + t * 3.3, 0.35 - t * 0.55)
		pts[i] = p
		ball(m, "Body", 1.15 - t * 0.3, p, (i % 2 == 0) and Kit.shade(main, 0.88) or main, mat)
	end
	local hp = V(pts[6].X * 0.4, 4.85, -0.4)
	ball(m, "Head", 1.55, hp, main, mat)
	part(m, "Snout", V(0.95, 0.55, 0.85), hp + V(0, -0.25, -0.72), main, mat)
	local zf = ballZ(hp, 0.775)
	local fo = { x = hp.X, y = hp.Y + 0.2, d = 0.4, gap = 0.34, z = zf, mouthY = hp.Y - 0.38, mouthZ = hp.Z - 1.17, mouthW = 0.55 }

	if id == "VineSerpent" then
		fo.mouth = "fangs"
		fo.blush = BLUSH
		for i = 2, 5 do
			local s = (i % 2 == 0) and 1 or -1
			part(m, "Leaf", V(0.15, 0.5, 0.75), CF(pts[i] + V(s * 0.55, 0.15, 0)) * ANG(0, s * PI / 2, 0) * ANG(-0.4, 0, 0), sec, M.Grass, nil, "Wedge")
		end
		for i = 1, 3 do
			local a = i / 3 * PI * 2
			ball(m, "Petal", 0.32, hp + V(math.cos(a) * 0.25 + 0.3, 0.75, math.sin(a) * 0.25), { 255, 150, 200 })
		end
		ball(m, "Pollen", 0.22, hp + V(0.3, 0.82, 0), { 255, 230, 90 }, M.Neon)
	elseif id == "InfernoDrake" then
		fo.mouth = "fangs"
		fo.brows = 0.45
		for s = -1, 1, 2 do
			seg(m, "Horn", hp + V(s * 0.35, 0.5, 0.1), hp + V(s * 0.6, 1.2, 0.7), 0.22, sec)
			part(m, "Wing", V(0.12, 1.3, 1.5), CF(pts[3] + V(s * 0.95, 0.45, 0.45)) * ANG(0.3, 0, -s * 0.55), sec, M.SmoothPlastic, 0.1)
			part(m, "WingBone", V(0.18, 1.5, 0.18), CF(pts[3] + V(s * 0.95, 0.5, -0.25)) * ANG(0, 0, -s * 0.55), Kit.shade(sec, 0.7))
		end
		for i = 3, 5 do
			part(m, "Flame", V(0.14, 0.55, 0.6), CF(pts[i] + V(0, 0.2, 0.45)) * ANG(0, PI / 2, 0), glow, M.Neon, nil, "Wedge")
		end
		for i = 2, 4 do
			ball(m, "Belly", 0.4, pts[i] + V(0, 0, -(1.15 - i / 6 * 0.3) / 2 + 0.08), glow, M.Neon)
		end
		Kit.particles(m:FindFirstChild("Snout"), { color = glow, color2 = main, size = 0.4, rate = 10, speed = 2, lifetime = 0.5, spread = 20, accel = V(0, 3, 0) })
	elseif id == "RiptideEel" then
		fo.mouth = "smile"
		fo.brows = 0.25
		for i = 2, 5 do
			part(m, "Fin", V(0.1, 0.45, 0.6), CF(pts[i] + V(0, 0.45, 0.25)) * ANG(0, PI / 2, 0), sec, M.Glass, 0.2, "Wedge")
			ball(m, "Spot", 0.22, pts[i] + V((i % 2 == 0) and 0.4 or -0.4, 0.1, -0.3), glow, M.Neon)
		end
		for i = 1, 3 do
			local a = i / 3 * PI * 2
			orbit(part(m, "Swirl", V(0.2, 0.15, 0.9), CF(math.cos(a) * 1.9, 0.4 + i * 0.25, math.sin(a) * 1.9) * ANG(0, -a, 0), { 160, 230, 255 }, M.Glass, 0.3), 2.2)
		end
	elseif id == "UndertowLeviathan" then
		fo.mouth = "fangs"
		fo.brows = 0.5
		fo.glow = glow
		for i = -1, 1 do
			part(m, "Crown", V(0.18, 0.7 - math.abs(i) * 0.2, 0.18), CF(hp + V(i * 0.32, 0.8, 0.15)) * ANG(0, PI / 4, i * 0.35), sec, M.Neon)
		end
		for s = -1, 1, 2 do
			part(m, "Fin", V(0.12, 0.6, 0.9), CF(hp + V(s * 0.75, 0, 0.25)) * ANG(0, s * PI / 2, 0), Kit.shade(main, 0.7), M.SmoothPlastic, nil, "Wedge")
		end
		for i = 1, 5 do
			ball(m, "Spot", 0.22, pts[i] + V((i % 2 == 0) and 0.42 or -0.42, 0.15, -0.28), glow, M.Neon)
		end
		Kit.particles(m:FindFirstChild("Water"), { color = glow, size = 0.2, rate = 6, speed = 0.8, lifetime = 2, accel = V(0, 1, 0) })
	elseif jet then
		fo.mouth = "smile"
		fo.brows = 0.2
		for s = -1, 1, 2 do
			for k = 1, 2 do
				local root = pts[3] + V(s * 0.45, 0.3, 0.2)
				seg(m, "Feather", root, root + V(s * (1.1 + k * 0.35), 0.5 + k * 0.45, 0.35), 0.12, sec, M.SmoothPlastic, nil, 0.45)
			end
			seg(m, "Horn", hp + V(s * 0.3, 0.55, 0.1), hp + V(s * 0.45, 1.05, 0.5), 0.16, glow, M.Neon)
		end
		for i = 1, 3 do
			local a = i / 3 * PI * 2
			orbit(part(m, "Wind", V(0.08, 0.08, 1.6), CF(math.cos(a) * 2.0, 1.4 + i * 0.8, math.sin(a) * 2.0) * ANG(0, -a, 0.2), glow, M.Neon, 0.3), 3)
		end
	end
	face(m, fo)
	return { bob = 0.12, spin = 0 }
end

local function mammoth(m, c)
	local fur, ice, glow = c[1], c[2], c[3]
	for _, x in ipairs({ -0.7, 0.7 }) do
		for _, z in ipairs({ -0.85, 0.95 }) do
			part(m, "Leg", V(0.75, 1.3, 0.75), V(x, 0.65, z), Kit.shade(fur, 0.85), M.Fabric)
		end
	end
	part(m, "Body", V(2.2, 1.8, 2.9), V(0, 2.15, 0.15), fur, M.Fabric)
	ball(m, "Hump", 1.9, V(0, 2.85, -0.35), fur, M.Fabric)
	part(m, "Head", V(1.6, 1.5, 1.3), V(0, 3.0, -1.55), fur, M.Fabric)
	for s = -1, 1, 2 do
		part(m, "Ear", V(0.2, 0.7, 0.6), CF(s * 0.9, 3.05, -1.3) * ANG(0, s * 0.3, 0), Kit.shade(fur, 0.75), M.Fabric)
		seg(m, "Tusk", V(s * 0.45, 2.45, -2.1), V(s * 0.75, 1.75, -2.75), 0.24, IVORY)
		seg(m, "Tusk", V(s * 0.75, 1.75, -2.75), V(s * 0.55, 2.35, -3.3), 0.2, IVORY)
	end
	seg(m, "Trunk", V(0, 2.6, -2.15), V(0, 1.8, -2.45), 0.5, fur, M.Fabric)
	seg(m, "Trunk", V(0, 1.8, -2.45), V(0, 1.1, -2.3), 0.42, fur, M.Fabric)
	seg(m, "Trunk", V(0, 1.1, -2.3), V(0, 0.95, -1.95), 0.34, fur, M.Fabric)
	-- glacier riding on its back
	part(m, "IceBack", V(1.8, 0.6, 2.2), V(0, 3.25, 0.6), ice, M.Glass, 0.2)
	part(m, "Icicle", V(0.3, 0.8, 0.3), CF(0.4, 3.85, 0.3) * ANG(0, PI / 4, -0.25), glow, M.Glass, 0.1)
	part(m, "Icicle", V(0.3, 0.9, 0.3), CF(-0.4, 3.9, 0.7) * ANG(0, PI / 4, 0.25), glow, M.Glass, 0.1)
	part(m, "Icicle", V(0.25, 0.6, 0.25), CF(0, 3.75, 1.3) * ANG(0.3, PI / 4, 0), glow, M.Glass, 0.1)
	ball(m, "SnowTuft", 0.75, V(0, 3.8, -1.55), ice, M.Snow)
	seg(m, "Tail", V(0, 2.4, 1.6), V(0, 1.7, 1.95), 0.2, Kit.shade(fur, 0.8), M.Fabric)
	face(m, { y = 3.25, d = 0.3, gap = 0.42, z = -2.2, brows = 0.2, browColor = Kit.shade(fur, 0.5) })
	Kit.particles(m:FindFirstChild("IceBack"), { color = glow, size = 0.2, rate = 6, speed = 0.8, lifetime = 1.5, emission = 0.5, accel = V(0, -1, 0) })
	return { bob = 0.05, spin = 0 }
end

function A.Beast(m, c, id)
	if id == "MammothGlacier" then
		return mammoth(m, c)
	end
	local fox = id == "WildfireFox"
	local main, sec, glow = c[1], c[2], c[3]
	local mat = fox and M.SmoothPlastic or M.Fabric
	local bodyW = fox and 1.6 or 1.9
	local paw = fox and { 70, 45, 35 } or sec
	for _, x in ipairs({ -0.55, 0.55 }) do
		for _, z in ipairs({ -0.85, 0.95 }) do
			part(m, "Leg", V(0.5, 1.1, 0.5), V(x * bodyW / 1.6, 0.85, z), main, mat)
			part(m, "Paw", V(0.58, 0.3, 0.68), V(x * bodyW / 1.6, 0.15, z - 0.06), paw, mat)
		end
	end
	part(m, "Body", V(bodyW, fox and 1.3 or 1.5, 2.6), V(0, 1.95, 0.1), main, mat)
	part(m, "Head", V(1.45, 1.25, 1.25), V(0, 2.95, -1.25), main, mat)
	part(m, "Muzzle", V(0.75, 0.5, 0.6), V(0, 2.62, -2.05), fox and sec or Kit.mix(main, WHITE, 0.4), mat)
	ball(m, "Nose", 0.26, V(0, 2.8, -2.36), INK)
	if fox then
		part(m, "Chest", V(1.1, 1.0, 0.3), V(0, 1.85, -1.18), sec, mat)
		for s = -1, 1, 2 do
			part(m, "Ear", V(0.2, 0.9, 0.55), CF(s * 0.45, 3.95, -1.25) * ANG(0, s * PI / 2, 0), main, mat, nil, "Wedge")
		end
		seg(m, "Tail", V(0, 2.1, 1.35), V(0, 2.75, 1.95), 0.55, main, mat)
		local tip = ball(m, "TailTip", 0.75, V(0, 2.95, 2.15), sec, mat)
		ball(m, "TailFlame", 0.8, V(0, 3.3, 2.25), { 255, 140, 30 }, M.Neon, 0.1)
		ball(m, "TailFlame", 0.6, V(0.05, 3.75, 2.35), glow, M.Neon, 0.1)
		ball(m, "TailFlame", 0.4, V(0.1, 4.12, 2.4), { 255, 240, 150 }, M.Neon, 0.1)
		part(m, "HeadFlame", V(0.12, 0.45, 0.5), CF(0, 3.75, -1.0) * ANG(0, PI / 2, 0), glow, M.Neon, nil, "Wedge")
		Kit.particles(tip, { color = glow, color2 = { 255, 90, 20 }, size = 0.45, rate = 14, speed = 2, lifetime = 0.6, spread = 25, accel = V(0, 5, 0) })
		face(m, { y = 3.1, d = 0.38, gap = 0.33, z = -1.875, brows = 0.3, mouth = "fangs", mouthY = 2.58, mouthZ = -2.36, mouthW = 0.45 })
	else
		for s = -1, 1, 2 do
			ball(m, "Ear", 0.45, V(s * 0.55, 3.62, -1.15), main, mat)
			part(m, "Stripe", V(0.06, 0.9, 0.3), CF(s * (bodyW / 2 + 0.01), 2.0, -0.3 + s * 0.1) * ANG(0.4, 0, 0), sec, mat)
			part(m, "Stripe", V(0.06, 0.8, 0.3), CF(s * (bodyW / 2 + 0.01), 2.0, 0.5 + s * 0.1) * ANG(0.4, 0, 0), sec, mat)
		end
		local shards = { { 0.25, -0.6, 0.3, 1.0 }, { -0.25, -0.1, -0.3, 1.2 }, { 0.2, 0.45, 0.25, 0.95 }, { -0.15, 0.95, -0.2, 0.7 } }
		for _, sh in ipairs(shards) do
			part(m, "IceShard", V(0.35, sh[4], 0.35), CF(sh[1], 2.7 + sh[4] * 0.35, sh[2]) * ANG(-0.25, PI / 4, sh[3]), glow, M.Glass, 0.15)
		end
		ball(m, "Tail", 0.9, V(0, 2.4, 1.55), Kit.mix(main, WHITE, 0.3), mat)
		Kit.particles(m:FindFirstChild("Muzzle"), { color = glow, size = 0.3, rate = 8, speed = 1.5, lifetime = 0.8, spread = 20, emission = 0.3 })
		face(m, { y = 3.1, d = 0.38, gap = 0.33, z = -1.875, brows = 0.45, browColor = sec, mouth = "fangs", mouthY = 2.58, mouthZ = -2.36, mouthW = 0.45 })
	end
	return { bob = 0.06, spin = 0 }
end

local function solar(m, c)
	local sun, flare, glow = c[1], c[2], c[3]
	cyl(m, "PlasmaPool", 0.12, 2.2, V(0, 0.06, 0), flare, M.Neon, 0.35)
	cyl(m, "PlasmaColumn", 1.8, 0.5, V(0, 0.95, 0), flare, M.Neon, 0.3)
	ball(m, "PlasmaKnot", 0.8, V(0, 1.95, 0), flare, M.Neon, 0.1)
	local ctr = V(0, 3.9, 0)
	local core = ball(m, "Core", 3.0, ctr, sun, M.Neon)
	ball(m, "Corona", 3.5, ctr, glow, M.Neon, 0.75)
	Kit.light(core, sun, 16, 2.5)
	for k = 0, 7 do
		local a = k * PI / 4
		local len = (k % 2 == 0) and 1.2 or 0.8
		local dir = V(math.cos(a), math.sin(a), 0)
		part(m, "Ray", V(0.5, len, 0.35), CF(ctr + dir * (1.55 + len / 2)) * ANG(0, 0, a - PI / 2), flare, M.Neon)
	end
	bolt(m, { V(-1.2, 5.05, -0.3), V(-1.9, 5.8, -0.3), V(-1.3, 6.3, -0.3), V(-0.6, 5.45, -0.3) }, 0.22, glow)
	bolt(m, { V(1.35, 4.6, -0.2), V(2.3, 4.9, -0.2), V(2.2, 3.9, -0.2), V(1.5, 3.4, -0.2) }, 0.2, glow)
	face(m, { y = 4.1, d = 0.55, gap = 0.5, z = ballZ(ctr, 1.5), brows = 0.45, browColor = { 150, 50, 10 }, mouth = "grin" })
	Kit.particles(core, { color = glow, color2 = flare, size = 0.5, rate = 14, speed = 2.5, lifetime = 1, emission = 1 })
	return { bob = 0.3, spin = 0 }
end

function A.Wisp(m, c, id)
	if id == "SolarStorm" then
		return solar(m, c)
	end
	local main, sec, glow = c[1], c[2], c[3]
	cyl(m, "GroundGlow", 0.1, 1.6, V(0, 0.05, 0), glow, M.Neon, 0.5)
	ball(m, "Tail", 0.55, V(-0.35, 0.35, 0.35), main, M.Neon, 0.25)
	ball(m, "Tail", 0.95, V(-0.15, 0.95, 0.2), main, M.Neon, 0.2)
	local core = ball(m, "Core", 1.5, V(0, 2.3, 0.05), glow, M.Neon)
	Kit.light(core, glow, 10, 1.6)
	ball(m, "Body", 2.5, V(0, 2.3, 0), main, M.Glass, 0.3)
	ball(m, "Flame", 1.7, V(0.1, 3.35, 0.15), main, M.Neon, 0.25)
	ball(m, "Flame", 1.1, V(0.3, 4.15, 0.3), sec, M.Neon, 0.2)
	ball(m, "Flame", 0.6, V(0.5, 4.75, 0.5), glow, M.Neon)
	for i = 1, 3 do
		local a = i / 3 * PI * 2
		orbit(ball(m, "Mote", 0.25, V(math.cos(a) * 1.8, 0.6 + i * 1.0, math.sin(a) * 1.8), glow, M.Neon), 1.6)
	end
	local zf = ballZ(V(0, 2.3, 0), 1.25)
	if id == "MirageWisp" then
		for s = -1, 1, 2 do
			ball(m, "Mirage", 2.0, V(s * 1.25, 2.5, 0.6), main, M.Neon, 0.82)
		end
		cyl(m, "SandRing", 0.15, 2.4, V(0, 0.075, 0), sec, M.Sand)
		face(m, { y = 2.45, d = 0.5, gap = 0.42, z = zf, brows = 0.25, browColor = { 150, 80, 20 }, mouth = "smile" })
		Kit.particles(core, { color = glow, size = 0.3, rate = 6, speed = 1, lifetime = 1.2, transparency = 0.5 })
	elseif id == "FrostWisp" then
		for i = 1, 3 do
			local a = i / 3 * PI * 2 + 0.5
			local pos = V(math.cos(a) * 1.9, 1.5 + i * 0.8, math.sin(a) * 1.9)
			for k = 0, 2 do
				orbit(part(m, "Snowflake", V(0.7, 0.1, 0.1), CF(pos) * ANG(0, -a, 0) * ANG(0, 0, k * PI / 3), WHITE, M.Neon), 1.2)
			end
		end
		part(m, "IceTip", V(0.3, 0.8, 0.3), CF(0.55, 5.1, 0.55) * ANG(0, PI / 4, -0.2), glow, M.Glass, 0.1)
		face(m, { y = 2.45, d = 0.5, gap = 0.42, z = zf, mouth = "o", blush = { 170, 210, 255 } })
		Kit.particles(core, { color = WHITE, size = 0.2, rate = 8, speed = 0.8, lifetime = 1.6, accel = V(0, -1.5, 0) })
	else -- RiftWisp
		bolt(m, { V(0.2, 0.6, 1.4), V(-0.35, 1.9, 1.4), V(0.3, 3.2, 1.4), V(-0.2, 4.6, 1.4) }, 0.3, glow)
		part(m, "Rift", V(0.9, 3.8, 0.05), V(0, 2.6, 1.48), Kit.shade(sec, 0.5), M.SmoothPlastic)
		for i = 1, 3 do
			local a = i / 3 * PI * 2
			local p = part(m, "Shard", V(0.3, 0.7, 0.3), CF(math.cos(a) * 1.9, 1.4 + i * 0.9, math.sin(a) * 1.9) * ANG(0.3, a, 0.3), glow, M.Glass, 0.15)
			orbit(p, -1.4)
			selfSpin(p, 2)
		end
		face(m, { y = 2.45, d = 0.5, gap = 0.42, z = zf, brows = 0.35, browColor = sec, mouth = "fangs" })
		Kit.particles(core, { color = glow, color2 = sec, size = 0.3, rate = 8, speed = 1, lifetime = 1.2 })
	end
	return { bob = 0.4, spin = 0 }
end

local function tarBlob(m, c)
	local tar, mud, glow = c[1], c[2], c[3]
	local puddle = cyl(m, "Puddle", 0.18, 3.8, V(0, 0.09, 0), tar)
	puddle.Reflectance = 0.2
	local lower = ball(m, "Body", 3.0, V(0, 1.45, 0), tar)
	lower.Reflectance = 0.15
	local upper = ball(m, "Blob", 2.3, V(0.05, 2.7, 0.05), tar)
	upper.Reflectance = 0.15
	ball(m, "Drip", 1.2, V(0.3, 3.65, 0.2), tar)
	ball(m, "Lump", 1.1, V(1.35, 0.7, -0.3), Kit.mix(tar, mud, 0.3))
	ball(m, "Lump", 0.9, V(-1.4, 0.55, 0.2), Kit.mix(tar, mud, 0.3))
	ball(m, "Bubble", 0.35, V(0.9, 2.95, -0.75), glow, M.Neon)
	ball(m, "Bubble", 0.28, V(-1.15, 1.9, -0.6), glow, M.Neon)
	ball(m, "Bubble", 0.4, V(-0.6, 3.6, 0.4), mud)
	-- a dino bone stuck in the tar
	seg(m, "Bone", V(-1.0, 2.55, 0.4), V(-1.85, 3.25, 0.6), 0.25, IVORY)
	ball(m, "BoneKnob", 0.35, V(-1.85, 3.38, 0.48), IVORY)
	ball(m, "BoneKnob", 0.35, V(-1.97, 3.2, 0.72), IVORY)
	face(m, { x = 0.05, y = 2.9, d = 0.5, gap = 0.45, z = ballZ(V(0.05, 2.7, 0.05), 1.15), glow = glow, brows = 0.3, browColor = mud })
	mouth(m, "maw", V(0, 1.6, -1.52), 1.4, glow)
	Kit.particles(upper, { color = mud, size = 0.3, rate = 4, speed = 0.4, lifetime = 1.8, accel = V(0, 0.8, 0), emission = 0 })
	return { bob = 0.04, spin = 0 }
end

function A.Maw(m, c, id)
	if id == "TarBlob" then
		return tarBlob(m, c)
	end
	local earth, pit, glow = c[1], c[2], c[3]
	cyl(m, "Ground", 0.25, 4.0, V(0, 0.125, 0), Kit.shade(earth, 0.9), M.Sand)
	for k = 0, 7 do
		local a = k * PI / 4
		local h = 0.95 + (k % 2) * 0.25
		part(m, "RimRock", V(0.8, h, 1.25), CF(math.cos(a) * 1.6, 0.2 + h / 2, math.sin(a) * 1.6) * ANG(0, -a, 0) * ANG(0, 0, -0.25), (k % 2 == 0) and earth or Kit.shade(earth, 0.8), M.Slate)
	end
	cyl(m, "Pit", 0.12, 2.6, V(0, 0.55, 0), pit)
	local deep = cyl(m, "DeepGlow", 0.1, 1.0, V(0, 0.6, 0), glow, M.Neon)
	Kit.light(deep, glow, 8, 1.5)
	for k = 0, 5 do
		local a = k * PI / 3 + 0.3
		part(m, "Tooth", V(0.25, 0.55, 0.25), CF(math.cos(a) * 1.12, 0.85, math.sin(a) * 1.12) * ANG(0, -a, 0) * ANG(0, 0, 0.5) * ANG(0, PI / 4, 0), WHITE)
	end
	-- eyes on stalks
	for s = -1, 1, 2 do
		rod(m, "Stalk", V(s * 0.6, 0.6, 0.55), V(s * 0.75, 3.0, 0.15), 0.32, Kit.shade(earth, 0.85))
		ball(m, "Sclera", 0.95, V(s * 0.75, 3.3, 0.1), { 250, 245, 235 })
	end
	face(m, { y = 3.3, d = 0.55, gap = 0.75, z = -0.12, brows = 0.45, browColor = pit })
	-- debris being sucked in: pebbles and a little road sign
	orbit(ball(m, "Pebble", 0.35, V(2.4, 1.4, 0), earth, M.Slate), -1.8)
	orbit(ball(m, "Pebble", 0.3, V(-2.3, 1.9, 0.5), earth, M.Slate), -1.8)
	orbit(part(m, "SignPost", V(0.12, 0.9, 0.12), CF(0.3, 2.0, 2.3) * ANG(0.3, 0, 0.5), { 120, 90, 60 }, M.Wood), -1.5)
	orbit(part(m, "Sign", V(0.7, 0.4, 0.08), CF(0.12, 2.38, 2.42) * ANG(0.3, 0, 0.5), { 240, 200, 40 }), -1.5)
	Kit.particles(deep, { color = earth, size = 0.3, rate = 8, speed = 1, lifetime = 1, spread = 40, emission = 0 })
	return { bob = 0.03, spin = 0 }
end

function A.Volcano(m, c, id)
	local big = id == "Supervolcano"
	local rock, lava, glow = c[1], c[2], c[3]
	local tiers = big and 6 or 5
	local baseD, topD, th, step = big and 5.0 or 4.0, big and 2.2 or 1.7, 0.8, 0.72
	local layers = {}
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local d = baseD + (topD - baseD) * t
		local y = th / 2 + (i - 1) * step
		cyl(m, "Cone", th, d, V(0, y, 0), Kit.shade(rock, 0.9 + 0.12 * (i % 2)), M.Basalt)
		layers[i] = { y = y, d = d }
	end
	local topY = layers[tiers].y + th / 2
	cyl(m, "Rim", 0.35, topD + 0.3, V(0, topY + 0.1, 0), Kit.shade(rock, 0.7), M.Basalt)
	local pool = cyl(m, "Lava", 0.12, topD - 0.2, V(0, topY + 0.22, 0), lava, M.Neon)
	Kit.light(pool, glow, 12, 2)
	ball(m, "LavaBlob", 0.6, V(0.15, topY + 0.38, 0.1), glow, M.Neon)
	local drips = big and { 0.2, 0.8, 1.25, 1.75, 2.3 } or { 0.25, 0.75, 1.2 }
	for _, f in ipairs(drips) do
		local a = f * PI
		local top = V(math.cos(a) * topD / 2, topY, math.sin(a) * topD / 2)
		local bot = V(math.cos(a) * (baseD / 2 - 0.15), 0.85, math.sin(a) * (baseD / 2 - 0.15))
		local n = V(math.cos(a), 0, math.sin(a)) * 0.12
		seg(m, "LavaDrip", top + n, bot + n, 0.25, lava, M.Neon)
	end
	local zf = funnelZ(layers, th)
	if big then
		face(m, { y = 2.4, d = 0.62, gap = 0.58, z = zf, glow = glow, brows = 0.5, browColor = { 30, 15, 12 }, mouth = "fangs" })
		for s = -1, 1, 2 do
			cyl(m, "Vent", 0.3, 0.6, CF(s * 1.75, 1.6, 0.7) * ANG(0, 0, -s * 0.5), Kit.shade(rock, 0.7), M.Basalt)
			local v = ball(m, "VentGlow", 0.35, V(s * 1.9, 1.75, 0.75), lava, M.Neon)
			Kit.particles(v, { color = { 70, 65, 65 }, size = 0.4, sizeEnd = 0.9, rate = 4, speed = 1.2, lifetime = 1.5, spread = 20, accel = V(0, 2, 0), emission = 0 })
		end
		local smoke = { { -0.4, 1.3, 0.3, 1.4 }, { 0.5, 1.6, 0.2, 1.1 }, { 0, 2.2, 0.4, 1.0 } }
		for _, s in ipairs(smoke) do
			ball(m, "AshCloud", s[4], V(s[1], topY + s[2], s[3]), { 70, 65, 65 }, M.Slate)
		end
		bolt(m, { V(0.6, topY + 2.3, -0.1), V(0.9, topY + 1.8, -0.2), V(0.6, topY + 1.35, -0.2) }, 0.14, { 255, 240, 120 })
		for i = 1, 2 do
			local a = i * PI
			orbit(ball(m, "LavaBomb", 0.35, V(math.cos(a) * 1.6, topY + 0.8, math.sin(a) * 1.6), glow, M.Neon), 1.5)
		end
	else
		face(m, { y = 2.0, d = 0.55, gap = 0.48, z = zf, mouth = "smile", blush = BLUSH })
		ball(m, "Puff", 0.8, V(0.3, topY + 0.9, 0.2), { 150, 145, 145 }, M.SmoothPlastic, 0.2)
	end
	Kit.particles(pool, { color = { 90, 85, 85 }, size = 0.5, sizeEnd = 1.2, rate = 5, speed = 1.5, lifetime = 2, spread = 15, accel = V(0, 1.5, 0), emission = 0 })
	Kit.particles(pool, { color = glow, color2 = lava, size = 0.25, rate = 6, speed = 4, lifetime = 0.8, spread = 25, accel = V(0, -8, 0), emission = 1 })
	return { bob = 0.05, spin = 0 }
end

function A.Meteor(m, c, id)
	local big = id == "ExtinctionAsteroid"
	local rock, fire, glow = c[1], c[2], c[3]
	local craterD = big and 3.6 or 3.0
	cyl(m, "Crater", 0.15, craterD, V(0, 0.075, 0), Kit.shade(rock, 0.5), M.Slate)
	cyl(m, "Molten", 0.1, 1.8, V(0, 0.13, 0), fire, M.Neon)
	local n = big and 8 or 6
	for k = 1, n do
		local a = k / n * PI * 2
		part(m, "RimRock", V(0.6, 0.4, 0.7), CF(math.cos(a) * (craterD / 2 - 0.1), 0.2, math.sin(a) * (craterD / 2 - 0.1)) * ANG(0.3 * (k % 2), -a, 0.2), Kit.shade(rock, 0.8), M.Slate)
	end
	local r = big and 1.5 or 1.25
	local ctr = V(0, r + 0.1, 0)
	local stone = ball(m, "Rock", r * 2, ctr, rock, M.Slate)
	local lumps = { V(0.7, 0.5, 0.4), V(-0.6, 0.7, 0.45), V(0.15, -0.25, 0.95), V(-0.85, -0.3, 0.3) }
	for _, l in ipairs(lumps) do
		ball(m, "Lump", r * 0.8, ctr + l.Unit * r * 0.8, Kit.shade(rock, 0.9), M.Slate)
	end
	local cracks = { V(0.8, -0.3, -0.5), V(-0.85, 0.15, -0.5), V(0.2, 0.85, -0.45) }
	if big then
		table.insert(cracks, V(-0.4, -0.6, -0.7))
		table.insert(cracks, V(0.9, 0.35, 0.25))
	end
	for i, d in ipairs(cracks) do
		local nrm = d.Unit
		local p = ctr + nrm * (r - 0.02)
		part(m, "Crack", V(0.1, r * 0.6, 0.08), CFrame.lookAt(p, p + nrm) * ANG(0, 0, i * 0.7), fire, M.Neon)
	end
	-- flame trail streaming up and back
	local T = V(0.25, 1, 0.75).Unit
	for k = 1, 4 do
		local d = (2.0 - k * 0.35) * (big and 1.15 or 1)
		ball(m, "Trail", d, ctr + T * (r * 0.6 + k * 0.85), Kit.mix(fire, glow, k / 4), M.Neon, 0.1 + k * 0.1)
	end
	Kit.particles(stone, { color = glow, color2 = fire, size = 0.6, rate = 16, speed = 3, lifetime = 0.7, spread = 30, accel = V(0, 6, 4) })
	Kit.light(stone, fire, 12, 1.8)
	face(m, { y = ctr.Y + 0.2, d = 0.5, gap = 0.45, z = ballZ(ctr, r), glow = big and glow or nil, brows = 0.45, mouth = big and "fangs" or "grin" })
	if big then
		for i = 1, 3 do
			local a = i / 3 * PI * 2
			orbit(ball(m, "Moonlet", 0.5, V(math.cos(a) * 2.5, 1.3 + i * 0.7, math.sin(a) * 2.5), Kit.shade(rock, 0.8), M.Slate), 1.0)
		end
		-- one very worried tiny dino
		ball(m, "Dino", 0.55, V(1.9, 0.33, -1.6), { 110, 190, 90 })
		ball(m, "DinoHead", 0.4, V(1.75, 0.78, -1.82), { 110, 190, 90 })
		seg(m, "DinoTail", V(2.05, 0.3, -1.35), V(2.3, 0.2, -0.95), 0.15, { 110, 190, 90 })
	end
	return { bob = 0.08, spin = 0 }
end

function A.Wave(m, c, id)
	local water, foam, glow = c[1], c[2], c[3]
	cyl(m, "Water", 0.35, 4.6, V(0, 0.175, 0), water, M.Glass, 0.25)
	part(m, "Body", V(3.4, 3.4, 1.8), V(0, 2.05, 0.5), water, M.SmoothPlastic, 0.05)
	for s = -1, 1, 2 do
		ball(m, "Shoulder", 1.8, V(s * 1.7, 1.75, 0.5), water, M.SmoothPlastic, 0.05)
		seg(m, "Arm", V(s * 1.9, 2.0, 0.2), V(s * 2.3, 1.45, -0.4), 0.7, water, M.SmoothPlastic, 0.05)
		ball(m, "Fist", 1.15, V(s * 2.35, 1.35, -0.55), Kit.mix(water, foam, 0.25), M.SmoothPlastic, 0.05)
	end
	part(m, "Swell", V(3.4, 3.2, 1.8), CF(0, 1.95, 2.2) * ANG(0, PI, 0), Kit.shade(water, 0.85), M.SmoothPlastic, 0.05, "Wedge")
	-- the curl, hooking over the face toward -Z
	local center, R = V(0, 3.9, -0.6), 1.05
	for k = 0, 7 do
		local a = -1.6 + k * 0.6
		local t = k / 7
		part(m, "Curl", V(3.4 - k * 0.17, 0.55, 0.85), CF(center) * ANG(-a, 0, 0) * CF(0, R, 0), Kit.mix(water, foam, t * t), M.SmoothPlastic, 0.08)
	end
	local foamAngles = { -0.2, 0.5, 1.2, 1.9, 2.6 }
	for i, a in ipairs(foamAngles) do
		local x = ((i % 2 == 0) and 0.9 or -0.9) * (1 - i * 0.08)
		ball(m, "Foam", 0.75 - i * 0.04, (CF(center) * ANG(-a, 0, 0) * CF(x, R + 0.35, 0)).Position, foam)
	end
	face(m, { y = 2.35, d = 0.55, gap = 0.55, z = -0.4, brows = 0.45, browColor = Kit.shade(water, 0.4), mouth = "grin", mouthY = 1.78 })
	local crest = m:FindFirstChild("Foam")
	Kit.particles(crest, { color = foam, color2 = glow, size = 0.35, rate = 12, speed = 2, lifetime = 0.8, spread = 60, accel = V(0, -4, 0), emission = 0 })
	return { bob = 0.12, spin = 0 }
end

function A.Bird(m, c, id)
	local gold, navy, glow = c[1], c[2], c[3]
	local cloud = Kit.mix(navy, WHITE, 0.3)
	ball(m, "Perch", 1.2, V(0, 0.55, 0.1), cloud)
	ball(m, "Perch", 1.0, V(-0.75, 0.5, 0.2), cloud)
	ball(m, "Perch", 1.0, V(0.75, 0.5, 0.0), cloud)
	for s = -1, 1, 2 do
		seg(m, "Leg", V(s * 0.35, 0.9, 0.05), V(s * 0.3, 1.65, 0.05), 0.18, Kit.shade(gold, 0.75))
	end
	ball(m, "Body", 2.0, V(0, 2.45, 0.1), gold)
	ball(m, "Belly", 1.5, V(0, 2.3, -0.35), Kit.mix(gold, WHITE, 0.45))
	local hc = V(0, 3.75, -0.25)
	ball(m, "Head", 1.4, hc, gold)
	part(m, "Beak", V(0.45, 0.42, 0.75), V(0, 3.58, -1.2), { 255, 170, 40 }, M.SmoothPlastic, nil, "Wedge")
	face(m, { y = 3.88, d = 0.34, gap = 0.3, z = ballZ(hc, 0.7), brows = 0.45, browColor = navy })
	-- lightning crest
	bolt(m, { V(0, 4.35, -0.1), V(0.25, 4.85, 0.0), V(-0.15, 5.15, 0.1), V(0.2, 5.7, 0.25) }, 0.22, glow)
	-- spread wings: a fan of flat feathers per side
	for s = -1, 1, 2 do
		local root = V(s * 1.0, 2.9, 0.25)
		for k = 0, 3 do
			local th = -0.35 + k * 0.42
			local L = 2.6 - math.abs(k - 1.5) * 0.25
			seg(m, "Feather", root, root + V(s * math.cos(th) * L, math.sin(th) * L, 0.1 + k * 0.05), 0.18, (k % 2 == 0) and navy or gold, M.SmoothPlastic, nil, 0.55)
		end
		seg(m, "WingBolt", root + V(s * 0.6, 0.15, -0.15), root + V(s * 2.0, 0.85, -0.18), 0.12, glow, M.Neon, nil, 0.2)
	end
	for i = -1, 1 do
		seg(m, "TailFeather", V(0, 2.0, 0.9), V(i * 0.45, 1.2 + math.abs(i) * 0.08, 1.95), 0.5, navy, M.SmoothPlastic, nil, 0.15)
	end
	local crest = m:FindFirstChild("Bolt")
	Kit.light(crest, glow, 10, 1.5)
	Kit.particles(crest, { color = glow, size = 0.25, rate = 10, speed = 3, lifetime = 0.3, emission = 1 })
	return { bob = 0.15, spin = 0 }
end

local function singularity(m, c)
	local core, dark, glow = c[1], c[2], c[3]
	cyl(m, "Well", 0.12, 3.2, V(0, 0.06, 0), dark)
	cyl(m, "WellGlow", 0.08, 2.2, V(0, 0.13, 0), glow, M.Neon, 0.4)
	cyl(m, "Beam", 2.6, 0.35, V(0, 1.43, 0), glow, M.Neon, 0.45)
	local ctr = V(0, 4.0, 0)
	local heart = ball(m, "Core", 2.2, ctr, core, M.Neon)
	ball(m, "Lens", 2.9, ctr, glow, M.Glass, 0.75)
	Kit.light(heart, glow, 16, 2.5)
	face(m, { y = 4.12, d = 0.42, gap = 0.38, z = ballZ(ctr, 1.1) })
	local rings = {
		{ r = 1.9, tilt = 0.5, roll = 0.2, speed = 2.2, color = dark },
		{ r = 2.4, tilt = -0.7, roll = -0.3, speed = -1.6, color = Kit.shade(dark, 0.6) },
		{ r = 2.9, tilt = 0.15, roll = 0.1, speed = 1.0, color = { 25, 0, 45 } },
	}
	for _, rg in ipairs(rings) do
		for i = 1, 8 do
			local a = i / 8 * PI * 2
			local glint = i == 1
			local p = part(m, "Ring", V(0.32, 0.32, 0.6), CF(ctr) * ANG(rg.tilt, 0, rg.roll) * CF(math.cos(a) * rg.r, 0, math.sin(a) * rg.r) * ANG(0, -a, 0), glint and glow or rg.color, glint and M.Neon or M.SmoothPlastic)
			orbit(p, rg.speed)
		end
	end
	Kit.particles(heart, { color = glow, color2 = core, size = 0.3, rate = 10, speed = 0.8, lifetime = 1.2, emission = 1 })
	return { bob = 0.25, spin = 0 }
end

function A.Entity(m, c, id)
	if id == "Singularity" then
		return singularity(m, c)
	end
	local robe, rune, glow = c[1], c[2], c[3]
	local tiers = { { 2.9, 0.55 }, { 2.4, 1.3 }, { 1.95, 2.05 }, { 1.6, 2.75 } }
	for i, t in ipairs(tiers) do
		cyl(m, "Robe", 0.85, t[1], V(0, t[2], 0), Kit.shade(robe, 1 + (i % 2) * 0.25), M.Fabric)
	end
	for k = 1, 5 do
		local a = k / 5 * PI * 2 + 0.3
		part(m, "Tatter", V(0.45, 0.45, 0.3), CF(math.cos(a) * 1.25, 0.25, math.sin(a) * 1.25) * ANG(0, -a + PI / 2, PI / 4), robe, M.Fabric)
	end
	cyl(m, "Belt", 0.14, 2.0, V(0, 2.1, 0), rune, M.Neon)
	ball(m, "Hood", 2.0, V(0, 3.75, 0.05), robe, M.Fabric)
	part(m, "HoodPeak", V(0.8, 0.9, 0.8), CF(0, 4.6, 0.45) * ANG(0.6, 0, 0), robe, M.Fabric)
	local void = ball(m, "Void", 1.5, V(0, 3.7, -0.38), { 5, 0, 10 })
	Kit.light(void, glow, 10, 1.5)
	face(m, { y = 3.82, d = 0.34, gap = 0.3, z = -1.0, glow = glow, shine = false, mouth = "glowline", mouthGlow = glow, mouthY = 3.45, mouthZ = -1.05, mouthW = 0.5 })
	for s = -1, 1, 2 do
		seg(m, "Sleeve", V(s * 0.8, 3.0, 0), V(s * 1.45, 2.2, -0.55), 0.65, robe, M.Fabric)
		ball(m, "Hand", 0.35, V(s * 1.55, 2.0, -0.65), glow, M.Neon)
	end
	local ys = { 1.6, 2.6, 3.4, 2.0 }
	for k = 1, 4 do
		local a = k * PI / 2 + 0.4
		local p = part(m, "Shard", V(0.32, 0.8, 0.32), CF(math.cos(a) * 2.1, ys[k], math.sin(a) * 2.1) * ANG(0.3, 0.5, 0.4), rune, M.Neon, 0.1)
		orbit(p, (k % 2 == 0) and -1.1 or 1.1)
		selfSpin(p, 2)
	end
	Kit.particles(m:FindFirstChild("Robe"), { color = rune, color2 = robe, size = 0.4, rate = 8, speed = 0.6, lifetime = 1.6, accel = V(0, -0.5, 0), emission = 0.6 })
	return { bob = 0.35, spin = 0 }
end

function A.BlackHole(m, c, id)
	local void, disk, glow = c[1], c[2], c[3]
	local ctr = V(0, 3.4, 0)
	cyl(m, "JetSplash", 0.1, 1.4, V(0, 0.05, 0), glow, M.Neon, 0.5)
	cyl(m, "Jet", 2.2, 0.32, V(0, 1.2, 0), glow, M.Neon, 0.35)
	cyl(m, "Jet", 2.1, 0.32, V(0, 5.55, 0), glow, M.Neon, 0.35)
	local hole = ball(m, "Hole", 2.2, ctr, void)
	-- photon ring: a glowing disk just behind the hole, seen as a halo from the front
	part(m, "PhotonRing", V(0.06, 2.8, 2.8), CF(ctr + V(0, 0, 0.3)) * ANG(0, PI / 2, 0), glow, M.Neon, nil, "Cylinder")
	local tiltCF = CF(ctr) * ANG(0.32, 0, 0.12)
	cyl(m, "AccretionDisk", 0.1, 5.4, tiltCF, disk, M.Neon, 0.3)
	cyl(m, "InnerDisk", 0.14, 3.6, tiltCF, glow, M.Neon, 0.1)
	for i = 1, 6 do
		local a = i / 6 * PI * 2
		local rr = 2.4 + (i % 3) * 0.25
		orbit(ball(m, "Matter", 0.25 + (i % 2) * 0.1, (tiltCF * CF(math.cos(a) * rr, 0.1, math.sin(a) * rr)).Position, disk, M.Neon), 1.8)
	end
	face(m, { y = ctr.Y + 0.25, d = 0.36, gap = 0.38, z = ballZ(ctr, 1.1), glow = glow })
	Kit.light(hole, disk, 14, 2)
	Kit.particles(hole, { color = disk, color2 = glow, size = 0.3, rate = 12, speed = 1, lifetime = 0.9, emission = 1 })
	return { bob = 0.25, spin = 0 }
end

---------------------------------------------------------------------------
-- Mutations
---------------------------------------------------------------------------
local FACE_PARTS = { Eye = true, EyeShine = true, Brow = true, Mouth = true, Tooth = true, Blush = true, MouthGlow = true }

local MUT_FX = {
	Charged = { size = 0.3, speed = 5, lifetime = 0.35, rate = 18, accel = V(0, 0, 0) },
	Frozen = { size = 0.35, speed = 1, lifetime = 1.6, rate = 10, accel = V(0, -3, 0) },
	Molten = { size = 0.4, speed = 1.5, lifetime = 1.2, rate = 12, accel = V(0, 5, 0) },
	Golden = { size = 0.3, speed = 0.8, lifetime = 1.4, rate = 10, accel = V(0, 1, 0) },
	Corrupted = { size = 0.5, speed = 0.8, lifetime = 1.8, rate = 10, accel = V(0, 2, 0) },
}

local TINTS = {
	Golden = { color = { 255, 200, 40 }, amount = 0.65 },
	Frozen = { color = { 170, 230, 255 }, amount = 0.25 },
	Corrupted = { color = { 70, 10, 110 }, amount = 0.35 },
}

local function mutationFx(m, root, mutationId, lo, hi)
	local mut = mutationId and Config.Mutations[mutationId]
	if not mut then
		return
	end
	local tint = TINTS[mutationId]
	if tint then
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d ~= root and not FACE_PARTS[d.Name] and d.Material ~= M.Neon then
				d.Color = Kit.mix(d.Color, tint.color, tint.amount)
				if mutationId == "Golden" and d.Material ~= M.Glass then
					d.Material = M.Foil
					d.Reflectance = 0.25
				elseif mutationId == "Frozen" and d.Material ~= M.Glass then
					d.Material = M.Ice
				end
			end
		end
	end
	local h = hi.Y - lo.Y
	local w = math.max(hi.X - lo.X, hi.Z - lo.Z)
	local diameter = math.min(math.max(h, w) * 1.08, h + 0.9)
	local aura = Kit.ball(m, {
		name = "MutationAura",
		diameter = diameter,
		cf = CF((lo.X + hi.X) / 2, h / 2, (lo.Z + hi.Z) / 2),
		color = mut.color,
		material = M.ForceField,
		transparency = 0.15,
		collide = false,
		castShadow = false,
	})
	local fx = MUT_FX[mutationId] or MUT_FX.Charged
	Kit.particles(aura, {
		color = mut.color,
		color2 = Kit.mix(mut.color, WHITE, 0.5),
		size = fx.size * h / 5,
		rate = fx.rate,
		speed = fx.speed,
		lifetime = fx.lifetime,
		accel = fx.accel,
		emission = 1,
	})
	Kit.light(aura, mut.color, h * 1.6, 1.2)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

--[[
	DisasterModels.build(disasterId, mutationId) -> Model
]]
function DisasterModels.build(disasterId, mutationId)
	local def = Config.Disasters[disasterId]
	if not def then
		error("Unknown disaster " .. tostring(disasterId))
	end
	local c = def.colors
	local m = Instance.new("Model")
	m.Name = def.name

	local root = Kit.part(m, { name = "Root", size = V(0.4, 0.4, 0.4), transparency = 1, collide = false })
	m.PrimaryPart = root

	local builder = A[def.archetype] or A.Golem
	local anim = builder(m, c, disasterId) or {}

	local rarity = def.rarity or "Common"
	local targetH = DisasterModels.Heights[rarity] or 5
	local lo, hi = normalize(m, root, targetH, targetH * 1.2 + 1.5)
	mutationFx(m, root, mutationId, lo, hi)

	m:SetAttribute("DisasterId", disasterId)
	m:SetAttribute("Rarity", rarity)
	if mutationId and Config.Mutations[mutationId] then
		m:SetAttribute("Mutation", mutationId)
	end
	m:SetAttribute("AnimBob", anim.bob or 0.15)
	m:SetAttribute("AnimSpin", anim.spin or 0)
	Kit.setCollide(m, false)
	return m
end

return DisasterModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">GuardianModels</string><ProtectedString name="Source"><![CDATA[--[[
	GuardianModels — builds the big zone guardians that patrol each core nest.

	One builder per `GameConfig.Zones[i].guardian.kind`: Hound (topiary hedge
	dog), Stalker (vine creature), Scorpion, Yeti, Wyrm (magma serpent-dragon),
	Angler (deep-sea anglerfish), Rex (T-rex), Roc (storm bird), Warden (void
	knight). Chunky silhouettes, glowing eyes.

	Model contract:
	  * returns a Model whose PrimaryPart "Root" (invisible) sits at the ground
	    center (origin); the bottom of the feet is at y = 0
	  * the guardian faces -Z (Root.CFrame.LookVector is forward)
	  * contains a part named "Head"; attributes GuardianKind (and ZoneIndex)
	  * all parts anchored, non-colliding, CanTouch false
	  * 10-18 studs tall
]]

local Kit = require(script.Parent.Kit)

local GuardianModels = {}

local M = Enum.Material
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local PI = math.pi

local INK = { 22, 20, 30 }
local WHITE = { 250, 250, 245 }

-- Target height (studs) per guardian kind.
GuardianModels.Heights = {
	Hound = 11,
	Stalker = 13,
	Scorpion = 10.5,
	Yeti = 14,
	Wyrm = 15,
	Angler = 12.5,
	Rex = 15,
	Roc = 16,
	Warden = 17,
}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function toCF(at)
	if typeof(at) == "Vector3" then
		return CF(at)
	end
	return at or CF()
end

local function part(m, name, size, at, color, mat, tr, shape)
	return Kit.part(m, {
		name = name,
		size = size,
		cf = toCF(at),
		color = color,
		material = mat or M.SmoothPlastic,
		transparency = tr,
		shape = shape,
		collide = false,
	})
end

local function ball(m, name, d, at, color, mat, tr)
	return Kit.ball(m, { name = name, diameter = d, cf = toCF(at), color = color, material = mat or M.SmoothPlastic, transparency = tr, collide = false })
end

-- Block spanning a -> b. Cross-section w (local X) by wz (local Y).
local function seg(m, name, a, b, w, color, mat, tr, wz)
	local len = math.max((b - a).Magnitude, 0.05)
	return part(m, name, V(w, wz or w, len), CFrame.lookAt((a + b) / 2, b), color, mat, tr)
end

-- Round limb spanning a -> b.
local function rod(m, name, a, b, d, color, mat, tr)
	local len = math.max((b - a).Magnitude, 0.05)
	return part(m, name, V(len, d, d), CFrame.lookAt((a + b) / 2, b) * ANG(0, PI / 2, 0), color, mat, tr, "Cylinder")
end

-- Diamond (45 degree) tooth: reads as a fang from the front.
local function tooth(m, at, s, color)
	return part(m, "Tooth", V(s, s, s * 0.7), toCF(at) * ANG(0, 0, PI / 4), color or WHITE)
end

-- Glowing eyes with angry brows. `pos` is the point between the eyes.
local function eyes(m, pos, gap, d, glow, browAngle, browColor)
	for s = -1, 1, 2 do
		local e = ball(m, "Eye", d, pos + V(s * gap, 0, 0), glow, M.Neon)
		if s == 1 then
			Kit.light(e, glow, d * 10, 1.4)
		end
		if browAngle then
			part(m, "Brow", V(d * 1.4, d * 0.32, d * 0.5), CF(pos + V(s * gap - s * d * 0.08, d * 0.75, -d * 0.1)) * ANG(0, 0, s * browAngle), browColor or INK)
		end
	end
end

local function orbit(p, speed)
	p:SetAttribute("Orbit", speed)
	return p
end

local function partExtent(p)
	local cf, s = p.CFrame, p.Size
	if p:IsA("Part") and p.Shape == Enum.PartType.Ball then
		local r = math.min(s.X, s.Y, s.Z) / 2
		return V(r, r, r)
	end
	local rv, uv, zv = cf.RightVector, cf.UpVector, cf.LookVector
	if p:IsA("Part") and p.Shape == Enum.PartType.Cylinder then
		local hx, r = s.X / 2, math.min(s.Y, s.Z) / 2
		local function ax(a)
			return math.abs(a) * hx + r * math.sqrt(math.max(0, 1 - a * a))
		end
		return V(ax(rv.X), ax(rv.Y), ax(rv.Z))
	end
	local hx, hy, hz = s.X / 2, s.Y / 2, s.Z / 2
	return V(
		math.abs(rv.X) * hx + math.abs(uv.X) * hy + math.abs(zv.X) * hz,
		math.abs(rv.Y) * hx + math.abs(uv.Y) * hy + math.abs(zv.Y) * hz,
		math.abs(rv.Z) * hx + math.abs(uv.Z) * hy + math.abs(zv.Z) * hz
	)
end

local function bounds(m, skip)
	local lo, hi
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= skip then
			local e = partExtent(d)
			local pos = d.CFrame.Position
			local a, b = pos - e, pos + e
			lo = lo and lo:Min(a) or a
			hi = hi and hi:Max(b) or b
		end
	end
	return lo or Vector3.zero, hi or Vector3.zero
end
GuardianModels.bounds = bounds

-- Scale the design about the vertical axis to `targetH`, feet at y = 0.
local function normalize(m, root, targetH)
	local lo, hi = bounds(m, root)
	local s = targetH / math.max(hi.Y - lo.Y, 0.1)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local cf = d.CFrame
			local pos = cf.Position
			d.Size = d.Size * s
			d.CFrame = CF(pos.X * s, (pos.Y - lo.Y) * s, pos.Z * s) * cf.Rotation
		elseif d:IsA("PointLight") then
			d.Range = d.Range * s
		end
	end
end

---------------------------------------------------------------------------
-- Builders (design space, forward = -Z; normalized afterwards)
---------------------------------------------------------------------------
local G = {}

-- Suburb: a giant topiary hedge dog with a collar and name tag.
function G.Hound(m)
	local hedge, light, dark = { 62, 128, 52 }, { 84, 154, 66 }, { 44, 96, 40 }
	local LM = M.LeafyGrass
	for _, x in ipairs({ -1.7, 1.7 }) do
		for _, z in ipairs({ -2.6, 2.6 }) do
			ball(m, "Paw", 2.3, V(x, 1.15, z), light, LM)
			part(m, "Leg", V(1.5, 3.2, 1.5), V(x, 3.4, z), hedge, LM)
		end
	end
	part(m, "Body", V(4.6, 3.4, 7.4), V(0, 6.3, 0), hedge, LM)
	ball(m, "Chest", 4.0, V(0, 6.6, -3.3), light, LM)
	ball(m, "Rump", 3.6, V(0, 6.9, 3.2), light, LM)
	part(m, "Neck", V(2.6, 2.4, 2.6), CF(0, 8.4, -3.7) * ANG(0.3, 0, 0), hedge, LM)
	local head = part(m, "Head", V(3.6, 3.2, 3.4), V(0, 10.0, -4.6), hedge, LM)
	part(m, "Snout", V(2.1, 1.6, 2.2), V(0, 9.2, -7.1), light, LM)
	ball(m, "Nose", 0.9, V(0, 9.75, -8.2), INK)
	for s = -1, 1, 2 do
		part(m, "Ear", V(0.9, 2.6, 1.7), CF(s * 2.15, 9.6, -4.4) * ANG(0, 0, s * 0.25), dark, LM)
	end
	eyes(m, V(0, 10.6, -6.35), 0.95, 0.9, { 255, 225, 70 }, 0.35, dark)
	part(m, "Mouth", V(1.9, 0.35, 0.3), V(0, 8.65, -8.15), INK)
	tooth(m, V(-0.55, 8.4, -8.25), 0.35)
	tooth(m, V(0.55, 8.4, -8.25), 0.35)
	-- red collar with a gold tag
	part(m, "Collar", V(3.0, 0.7, 3.0), CF(0, 8.0, -3.75) * ANG(0.3, 0, 0), { 200, 40, 45 }, M.Fabric)
	part(m, "Tag", V(0.15, 1.0, 1.0), CF(0, 7.0, -5.4) * ANG(0, PI / 2, 0), { 255, 200, 50 }, M.Foil, nil, "Cylinder")
	rod(m, "Tail", V(0, 7.4, 3.6), V(0, 9.6, 5.4), 0.8, dark, LM)
	ball(m, "TailPom", 1.9, V(0, 10.0, 5.7), light, LM)
	local flowers = { V(1.8, 8.05, 1.0), V(-1.6, 8.05, -1.5), V(0.6, 8.05, 2.6) }
	for _, p in ipairs(flowers) do
		ball(m, "Flower", 0.55, p, { 255, 140, 190 })
	end
	return head
end

-- Overgrowth: a hunched vine creature with a flytrap head.
function G.Stalker(m)
	local vine, dark, bark = { 58, 120, 46 }, { 40, 80, 34 }, { 92, 74, 44 }
	local jaw, glow, claw = { 190, 50, 60 }, { 170, 255, 90 }, { 220, 210, 170 }
	for s = -1, 1, 2 do
		local hip, knee, foot = V(s * 1.1, 5.2, 0.8), V(s * 1.6, 2.8, 0.2), V(s * 1.5, 0.45, 0.8)
		rod(m, "Leg", hip, knee, 1.0, bark, M.Wood)
		rod(m, "Leg", knee, foot, 0.9, bark, M.Wood)
		rod(m, "Root", foot, foot + V(s * 0.9, -0.2, -0.9), 0.5, bark, M.Wood)
		rod(m, "Root", foot, foot + V(-s * 0.3, -0.2, -1.1), 0.5, bark, M.Wood)
	end
	ball(m, "Pelvis", 2.2, V(0, 5.4, 0.8), dark, M.Grass)
	rod(m, "Vine", V(-0.5, 5.4, 0.9), V(0.4, 9.2, -0.6), 1.0, vine, M.Grass)
	rod(m, "Vine", V(0.5, 5.4, 0.9), V(-0.4, 9.2, -0.6), 1.0, vine, M.Grass)
	rod(m, "Vine", V(0, 5.6, 1.1), V(0, 9.0, 0.2), 0.9, dark, M.Grass)
	ball(m, "Chest", 3.0, V(0, 9.6, -0.6), vine, M.Grass)
	for s = -1, 1, 2 do
		local sh, el, hand = V(s * 1.6, 10.0, -0.6), V(s * 2.9, 7.2, -1.6), V(s * 2.7, 3.6, -2.6)
		rod(m, "Arm", sh, el, 0.75, vine, M.Grass)
		rod(m, "Arm", el, hand, 0.7, dark, M.Grass)
		for k = -1, 1, 2 do
			seg(m, "Claw", hand, hand + V(s * 0.25 + k * 0.35, -1.2, -0.5), 0.22, claw)
		end
		rod(m, "HangingVine", V(s * 1.4, 9.6, -0.2), V(s * 1.2, 6.6, -0.3), 0.3, dark, M.Grass)
		part(m, "Leaf", V(0.2, 1.2, 1.4), CF(s * 1.8, 10.9, 0) * ANG(0, s * PI / 2, 0) * ANG(-0.4, 0, 0), vine, M.Grass, nil, "Wedge")
		part(m, "Leaf", V(0.2, 1.0, 1.2), CF(s * 0.9, 7.6, 1.3) * ANG(0, s * PI / 2, 0) * ANG(-0.6, 0, 0), dark, M.Grass, nil, "Wedge")
	end
	local head = ball(m, "Head", 2.6, V(0, 11.4, -1.8), vine, M.Grass)
	-- open flytrap jaws
	local upper = CF(0, 12.5, -3.2) * ANG(0.55, 0, 0)
	local lower = CF(0, 10.6, -3.1) * ANG(-0.35, 0, 0)
	part(m, "Jaw", V(2.8, 0.45, 2.6), upper, vine, M.Grass)
	part(m, "JawInner", V(2.5, 0.15, 2.3), upper * CF(0, -0.28, 0), jaw)
	part(m, "Jaw", V(2.6, 0.5, 2.4), lower, vine, M.Grass)
	part(m, "JawInner", V(2.3, 0.15, 2.1), lower * CF(0, 0.3, 0), jaw)
	for _, x in ipairs({ -0.9, 0, 0.9 }) do
		part(m, "Tooth", V(0.22, 0.6, 0.22), upper * CF(x, -0.5, -1.15), WHITE)
		part(m, "Tooth", V(0.22, 0.55, 0.22), lower * CF(x, 0.5, -1.05), WHITE)
	end
	-- glowing eyes on stalks above the trap
	for s = -1, 1, 2 do
		rod(m, "EyeStalk", V(s * 0.5, 12.4, -1.5), V(s * 0.85, 13.7, -2.0), 0.3, dark, M.Grass)
	end
	eyes(m, V(0, 13.8, -2.05), 0.85, 0.8, glow)
	for i = 1, 3 do
		part(m, "Thorn", V(0.3, 0.8, 0.3), CF(0, 7.6 + i * 0.9, 1.0 - i * 0.25) * ANG(-0.6, PI / 4, 0), bark, M.Wood)
	end
	ball(m, "Bud", 0.8, V(0, 10.8, 0.95), { 255, 120, 200 }, M.Neon)
	return head
end

-- Droughtlands: a desert scorpion with its stinger raised over its back.
function G.Scorpion(m)
	local shell, dark, glow, sting = { 196, 150, 84 }, { 130, 90, 48 }, { 255, 70, 40 }, { 255, 150, 40 }
	part(m, "Body", V(4.2, 1.7, 3.4), V(0, 2.4, -0.6), shell, M.Sandstone)
	part(m, "Plate", V(3.6, 1.6, 2.6), V(0, 2.5, 2.0), dark, M.Sandstone)
	part(m, "Plate", V(2.9, 1.5, 2.2), V(0, 2.6, 4.1), shell, M.Sandstone)
	local head = part(m, "Head", V(3.2, 1.4, 2.2), V(0, 2.3, -3.2), shell, M.Sandstone)
	for s = -1, 1, 2 do
		ball(m, "Eye", 0.45, V(s * 0.45, 3.1, -4.15), glow, M.Neon)
		ball(m, "Eye", 0.38, V(s * 1.0, 2.95, -4.2), glow, M.Neon)
		part(m, "Mandible", V(0.4, 0.7, 0.5), CF(s * 0.5, 1.8, -4.45) * ANG(0, 0, s * 0.3), dark)
	end
	Kit.light(head, glow, 10, 1.2)
	-- eight legs
	for s = -1, 1, 2 do
		for _, z in ipairs({ -1.9, -0.7, 0.5, 1.7 }) do
			local base, knee, foot = V(s * 2.0, 2.3, z), V(s * 3.5, 3.4, z * 1.15), V(s * 4.6, 0.25, z * 1.35)
			rod(m, "Leg", base, knee, 0.5, dark)
			rod(m, "Leg", knee, foot, 0.45, dark)
		end
	end
	-- pincers
	for s = -1, 1, 2 do
		local sh, el, wr = V(s * 1.4, 2.4, -3.8), V(s * 2.7, 2.9, -5.4), V(s * 2.3, 2.7, -6.9)
		rod(m, "Arm", sh, el, 0.7, shell)
		rod(m, "Arm", el, wr, 0.65, shell)
		part(m, "Claw", V(1.5, 1.1, 1.6), wr + V(0, 0, -0.6), shell, M.Sandstone)
		part(m, "Pincer", V(0.45, 0.5, 1.5), CF(wr + V(s * 0.4, 0.15, -2.0)) * ANG(0, s * 0.25, 0), shell, M.Sandstone)
		part(m, "Pincer", V(0.4, 0.45, 1.3), CF(wr + V(-s * 0.35, 0.05, -1.9)) * ANG(0, -s * 0.3, 0), dark, M.Sandstone)
	end
	-- arched tail
	local pts = { V(0, 2.9, 5.0), V(0, 4.3, 6.3), V(0, 6.0, 6.7), V(0, 7.6, 6.2), V(0, 8.8, 5.0), V(0, 9.4, 3.5) }
	for i = 1, #pts - 1 do
		local w = 1.5 - i * 0.1
		seg(m, "Tail", pts[i], pts[i + 1], w, (i % 2 == 0) and dark or shell, M.Sandstone)
		if i > 1 then
			ball(m, "TailJoint", w + 0.1, pts[i], shell, M.Sandstone)
		end
	end
	local bulb = ball(m, "Stinger", 1.4, V(0, 9.3, 2.5), shell, M.Sandstone)
	seg(m, "Barb", V(0, 9.0, 2.0), V(0, 8.0, 1.0), 0.35, sting, M.Neon)
	ball(m, "Venom", 0.3, V(0, 7.8, 0.85), sting, M.Neon)
	Kit.light(bulb, sting, 12, 1.5)
	return head
end

-- Frostfall: a hulking frost yeti with curled horns.
function G.Yeti(m)
	local fur, skin, horn = { 236, 242, 250 }, { 112, 140, 178 }, { 222, 214, 196 }
	local glow, ice = { 110, 220, 255 }, { 170, 230, 255 }
	for s = -1, 1, 2 do
		part(m, "Foot", V(2.4, 0.9, 3.0), V(s * 1.5, 0.45, -0.3), skin)
		part(m, "Leg", V(2.1, 3.2, 2.2), V(s * 1.5, 2.5, 0.1), fur, M.Fabric)
		ball(m, "Shoulder", 3.4, V(s * 3.2, 8.4, 0.1), fur, M.Fabric)
		rod(m, "Arm", V(s * 3.6, 8.0, 0.1), V(s * 4.4, 4.6, -0.7), 2.2, fur, M.Fabric)
		part(m, "Hand", V(2.2, 2.4, 2.2), V(s * 4.5, 3.0, -0.9), skin)
		rod(m, "Horn", V(s * 1.6, 11.6, -0.4), V(s * 2.6, 12.4, 0.1), 0.8, horn)
		rod(m, "Horn", V(s * 2.6, 12.4, 0.1), V(s * 2.5, 13.6, 0.9), 0.6, horn)
		ball(m, "Tuft", 1.6, V(s * 0.9, 12.1, -0.3), fur, M.Fabric)
	end
	part(m, "Torso", V(6.2, 5.0, 4.2), V(0, 6.4, 0.2), fur, M.Fabric)
	part(m, "Belly", V(3.8, 3.4, 0.4), V(0, 6.0, -1.95), { 170, 195, 220 })
	local head = part(m, "Head", V(3.8, 3.4, 3.4), V(0, 10.4, -0.6), fur, M.Fabric)
	ball(m, "Tuft", 1.8, V(0, 12.3, 0), fur, M.Fabric)
	part(m, "FacePlate", V(2.8, 2.3, 0.4), V(0, 10.2, -2.35), skin)
	eyes(m, V(0, 10.65, -2.62), 0.7, 0.75, glow, 0.4, { 40, 50, 80 })
	local mouth = part(m, "Mouth", V(1.7, 0.6, 0.3), V(0, 9.5, -2.6), INK)
	tooth(m, V(-0.55, 9.3, -2.72), 0.45)
	tooth(m, V(0.55, 9.3, -2.72), 0.45)
	for i = -1, 1 do
		part(m, "IceSpike", V(0.6, 2.0, 0.6), CF(i * 1.2, 9.0 + (1 - math.abs(i)) * 0.6, 2.4) * ANG(-0.5, PI / 4, i * 0.3), ice, M.Glass, 0.15)
	end
	Kit.particles(mouth, { color = WHITE, size = 0.8, sizeEnd = 1.6, rate = 6, speed = 2, lifetime = 1, spread = 20, transparency = 0.5, emission = 0 })
	return head
end

-- Magma Basin: a magma serpent-dragon rising out of its coils.
function G.Wyrm(m)
	local rock, plate, lava, glow, horn = { 62, 38, 32 }, { 92, 52, 40 }, { 255, 110, 30 }, { 255, 200, 50 }, { 40, 28, 26 }
	for k = 0, 4 do
		local a = k / 5 * PI * 2 + 0.3
		ball(m, "Coil", 3.0, V(math.cos(a) * 2.6, 1.5, 2.6 + math.sin(a) * 2.6), rock, M.Basalt)
	end
	part(m, "LavaCrack", V(0.25, 0.25, 2.2), CF(-2.0, 2.75, 1.0) * ANG(0, 0.6, 0), lava, M.Neon)
	part(m, "LavaCrack", V(0.25, 0.25, 1.8), CF(1.4, 2.75, 4.5) * ANG(0, -0.4, 0), lava, M.Neon)
	local neck = { { 1.8, 3.4, 1.2, 3.0 }, { 2.2, 5.4, 0.4, 2.8 }, { 1.3, 7.3, -0.3, 2.6 }, { -0.4, 8.8, -0.7, 2.4 }, { -0.9, 10.3, -1.2, 2.2 }, { -0.1, 11.5, -1.8, 2.1 } }
	for i, n in ipairs(neck) do
		local p = V(n[1], n[2], n[3])
		ball(m, "Neck", n[4], p, (i % 2 == 0) and plate or rock, M.Basalt)
		if i >= 2 and i <= 5 then
			part(m, "Belly", V(1.4, 1.0, 0.3), p + V(0, 0, -n[4] / 2 + 0.05), lava, M.Neon)
		end
		if i <= 5 then
			part(m, "Spike", V(0.4, 1.2, 1.0), CF(p + V(0, n[4] * 0.42, n[4] * 0.32)) * ANG(-0.6, 0, 0), horn, M.Slate, nil, "Wedge")
		end
	end
	local head = part(m, "Head", V(3.0, 2.4, 3.2), V(0, 12.5, -2.9), plate, M.Basalt)
	part(m, "Snout", V(2.2, 1.5, 2.4), V(0, 12.1, -5.2), plate, M.Basalt)
	part(m, "Jaw", V(2.0, 0.6, 2.8), CF(0, 10.9, -4.6) * ANG(-0.3, 0, 0), rock, M.Basalt)
	local maw = part(m, "MouthGlow", V(1.7, 0.25, 2.2), V(0, 11.35, -4.7), lava, M.Neon)
	tooth(m, V(-0.6, 11.15, -6.3), 0.45)
	tooth(m, V(0.6, 11.15, -6.3), 0.45)
	for s = -1, 1, 2 do
		rod(m, "Horn", V(s * 1.0, 13.5, -2.2), V(s * 1.7, 14.6, -0.6), 0.7, horn)
		rod(m, "Horn", V(s * 1.7, 14.6, -0.6), V(s * 1.9, 15.2, 0.6), 0.45, horn)
		ball(m, "Nostril", 0.3, V(s * 0.5, 12.6, -6.42), lava, M.Neon)
		rod(m, "WingBone", V(s * 1.8, 8.0, 0.0), V(s * 5.0, 10.5, 1.5), 0.4, horn)
		part(m, "Wing", V(0.2, 2.6, 3.0), CF(s * 3.6, 8.6, 1.4) * ANG(0, 0, s * 0.7), { 120, 40, 30 })
	end
	eyes(m, V(0, 13.0, -4.55), 1.0, 0.8, glow, 0.4, horn)
	Kit.light(maw, lava, 14, 2)
	Kit.particles(maw, { color = glow, color2 = lava, size = 0.5, rate = 10, speed = 2, lifetime = 0.8, spread = 30, accel = V(0, -6, 0), emission = 1 })
	return head
end

-- Deep Abyss: a huge anglerfish walking on its fins, glowing lure out front.
function G.Angler(m)
	local skin, belly, fin = { 44, 48, 78 }, { 78, 86, 120 }, { 60, 70, 110 }
	local glow, eye = { 120, 255, 230 }, { 220, 255, 245 }
	local head = ball(m, "Head", 8.0, V(0, 6.2, 0), skin)
	ball(m, "Hump", 6.0, V(0, 6.6, 2.4), Kit.shade(skin, 0.85))
	part(m, "Jaw", V(7.0, 1.8, 5.6), V(0, 3.3, -1.6), belly)
	part(m, "Mouth", V(6.0, 1.6, 0.5), V(0, 4.6, -3.85), INK)
	for i = 0, 4 do
		tooth(m, V(-2.2 + i * 1.1, 5.35, -4.05), 0.6)
	end
	for i = 0, 3 do
		tooth(m, V(-1.65 + i * 1.1, 4.15, -4.35), 0.55)
	end
	for s = -1, 1, 2 do
		ball(m, "Eye", 1.0, V(s * 2.0, 8.1, -3.05), eye, M.Neon)
		ball(m, "Pupil", 0.4, V(s * 2.0, 8.1, -3.55), INK)
		part(m, "Brow", V(1.4, 0.35, 0.5), CF(s * 1.95, 8.85, -3.0) * ANG(0, 0, s * 0.4), Kit.shade(skin, 0.6))
		seg(m, "Fin", V(s * 3.5, 4.6, -0.8), V(s * 4.4, 0.2, -1.8), 0.5, fin, M.SmoothPlastic, nil, 1.6)
		seg(m, "Fin", V(s * 3.4, 4.6, 2.2), V(s * 4.3, 0.2, 3.2), 0.5, fin, M.SmoothPlastic, nil, 1.6)
		ball(m, "Spot", 0.45, V(s * 3.85, 6.5, 0.9), glow, M.Neon)
		ball(m, "Spot", 0.4, V(s * 3.3, 4.4, 1.8), glow, M.Neon)
	end
	-- lure
	rod(m, "LureStalk", V(0, 10.0, -0.6), V(0, 12.0, -2.4), 0.35, fin)
	rod(m, "LureStalk", V(0, 12.0, -2.4), V(0, 11.2, -4.9), 0.3, fin)
	local lure = ball(m, "Lure", 1.3, V(0, 10.75, -5.2), glow, M.Neon)
	Kit.light(lure, glow, 24, 3)
	Kit.particles(lure, { color = glow, size = 0.25, rate = 6, speed = 0.6, lifetime = 1.6, emission = 1 })
	-- tail
	part(m, "TailStalk", V(1.6, 2.4, 2.4), V(0, 6.2, 5.4), skin)
	seg(m, "TailFin", V(0, 6.6, 6.0), V(0, 9.4, 7.8), 0.35, fin, M.SmoothPlastic, nil, 2.0)
	seg(m, "TailFin", V(0, 5.8, 6.0), V(0, 3.2, 7.8), 0.35, fin, M.SmoothPlastic, nil, 2.0)
	local spines = { { V(0, 10.0, 1.2), V(0, 11.6, 2.2) }, { V(0, 9.6, 2.6), V(0, 11.0, 3.6) }, { V(0, 9.0, 3.8), V(0, 10.2, 4.8) } }
	for _, sp in ipairs(spines) do
		rod(m, "Spine", sp[1], sp[2], 0.2, fin)
	end
	return head
end

-- Prehistoric: a T-rex with tiny arms and a big toothy head.
function G.Rex(m)
	local skin, belly, dark = { 86, 118, 62 }, { 190, 180, 120 }, { 56, 80, 42 }
	local glow, claw = { 255, 90, 40 }, { 230, 225, 210 }
	for s = -1, 1, 2 do
		part(m, "Foot", V(2.0, 1.0, 3.2), V(s * 1.9, 0.5, -0.7), dark)
		part(m, "Toe", V(0.4, 0.4, 0.5), CF(s * 1.4, 0.3, -2.45) * ANG(0, 0, PI / 4), claw)
		part(m, "Toe", V(0.4, 0.4, 0.5), CF(s * 2.4, 0.3, -2.45) * ANG(0, 0, PI / 4), claw)
		rod(m, "Shin", V(s * 1.9, 1.0, 0.3), V(s * 1.9, 4.6, 1.5), 1.5, skin)
		part(m, "Thigh", V(2.3, 3.8, 3.4), CF(s * 2.0, 6.2, 0.8) * ANG(-0.2, 0, 0), skin)
		rod(m, "Arm", V(s * 1.9, 9.6, -2.6), V(s * 2.1, 8.4, -3.6), 0.6, skin)
		rod(m, "Claw", V(s * 2.1, 8.4, -3.6), V(s * 2.1, 7.9, -4.1), 0.25, claw)
	end
	part(m, "Body", V(4.4, 4.4, 7.0), CF(0, 8.4, 0.6) * ANG(0.22, 0, 0), skin)
	part(m, "Belly", V(3.4, 3.0, 0.5), CF(0, 8.3, -2.65) * ANG(0.22, 0, 0), belly)
	local tail = { V(0, 8.6, 3.9), V(0, 8.0, 6.6), V(0, 7.1, 9.0), V(0, 6.0, 11.0), V(0, 5.2, 12.6) }
	local widths = { 3.4, 2.6, 1.8, 1.1 }
	for i = 1, 4 do
		seg(m, "Tail", tail[i], tail[i + 1], widths[i], skin)
	end
	part(m, "Neck", V(2.8, 3.2, 2.8), CF(0, 11.0, -2.6) * ANG(0.5, 0, 0), skin)
	local head = part(m, "Head", V(3.4, 2.9, 5.4), V(0, 12.8, -4.9), skin)
	part(m, "Jaw", V(3.0, 1.0, 4.8), CF(0, 10.9, -5.0) * ANG(-0.22, 0, 0), Kit.shade(skin, 0.85))
	part(m, "MouthInner", V(2.8, 0.8, 4.4), V(0, 11.6, -5.1), { 120, 30, 30 })
	for _, t in ipairs({ { -0.55, -7.4 }, { 0.55, -7.4 }, { -1.4, -6.4 }, { 1.4, -6.4 } }) do
		tooth(m, V(t[1], 11.2, t[2]), 0.5)
	end
	tooth(m, V(-0.9, 11.75, -6.9), 0.4)
	tooth(m, V(0.9, 11.75, -6.9), 0.4)
	for s = -1, 1, 2 do
		ball(m, "Eye", 0.8, V(s * 1.55, 13.4, -5.6), glow, M.Neon)
		part(m, "Brow", V(1.0, 0.4, 1.2), CF(s * 1.5, 14.0, -5.6) * ANG(0, 0, s * 0.3), dark)
		ball(m, "Nostril", 0.35, V(s * 0.6, 13.3, -7.62), INK)
	end
	Kit.light(head, glow, 12, 1.2)
	local spikes = { V(0, 10.9, -0.8), V(0, 10.6, 1.2), V(0, 10.1, 3.2), V(0, 9.4, 5.4), V(0, 8.4, 7.8), V(0, 7.2, 10.0) }
	for i, p in ipairs(spikes) do
		local sz = 1.3 - i * 0.1
		part(m, "Spike", V(0.5, sz, sz * 1.1), p + V(0, sz * 0.3, 0), { 200, 110, 50 }, M.SmoothPlastic, nil, "Wedge")
	end
	return head
end

-- Skylands: a giant storm bird with half-spread wings and a lightning crest.
function G.Roc(m)
	local navy, chest, beak = { 60, 70, 122 }, { 150, 162, 205 }, { 250, 196, 60 }
	local leg, glow, feather2 = { 232, 182, 64 }, { 255, 250, 160 }, { 90, 100, 160 }
	for s = -1, 1, 2 do
		local ankle = V(s * 1.4, 0.6, 0.1)
		rod(m, "Toe", ankle, V(s * 1.0, 0.25, -1.7), 0.5, leg)
		rod(m, "Toe", ankle, V(s * 2.0, 0.25, -1.4), 0.5, leg)
		rod(m, "Toe", ankle, V(s * 1.4, 0.25, 1.1), 0.5, leg)
		rod(m, "Shin", ankle, V(s * 1.5, 4.6, 0.5), 0.8, leg)
		part(m, "Thigh", V(2.0, 2.8, 2.4), V(s * 1.5, 5.6, 0.6), navy)
	end
	ball(m, "Body", 5.8, V(0, 8.6, 0.8), navy)
	ball(m, "Chest", 4.6, V(0, 8.3, -0.6), chest)
	rod(m, "Neck", V(0, 10.2, -0.4), V(0, 11.8, -1.4), 2.4, navy)
	local head = ball(m, "Head", 3.4, V(0, 12.8, -1.8), navy)
	part(m, "Beak", V(1.3, 1.1, 2.2), V(0, 12.5, -4.0), beak)
	part(m, "BeakHook", V(1.0, 1.1, 0.9), CF(0, 11.85, -4.85) * ANG(0.5, 0, 0), Kit.shade(beak, 0.85))
	eyes(m, V(0, 13.15, -3.25), 0.95, 0.75, glow, 0.45, { 30, 30, 60 })
	-- lightning crest
	local crest = { V(0, 14.2, -1.4), V(0.5, 15.0, -1.1), V(-0.2, 15.4, -0.7), V(0.4, 16.3, -0.3) }
	for i = 1, #crest - 1 do
		seg(m, "Crest", crest[i], crest[i + 1], 0.4, glow, M.Neon)
	end
	seg(m, "CrestFeather", V(0, 14.0, -0.8), V(0, 15.0, 0.6), 0.3, navy, M.SmoothPlastic, nil, 0.9)
	-- wings
	for s = -1, 1, 2 do
		local sh, wr = V(s * 2.6, 10.2, 0.8), V(s * 5.8, 12.0, 1.6)
		rod(m, "WingArm", sh, wr, 1.1, navy)
		for k = 0, 4 do
			local r0 = sh:Lerp(wr, 0.2 + 0.2 * k)
			seg(m, "Feather", r0, r0 + V(s * (1.2 + 0.5 * k), -3.4 + 0.5 * k, 0.6), 0.3, (k % 2 == 0) and navy or feather2, M.SmoothPlastic, nil, 1.1)
		end
		seg(m, "WingBolt", sh + V(s * 0.8, 0, -0.6), wr + V(0, 0, -0.6), 0.25, glow, M.Neon)
	end
	for i = -1, 1 do
		seg(m, "TailFeather", V(0, 7.4, 3.4), V(i * 1.2, 4.6 - (1 - math.abs(i)) * 0.4, 6.8 + (1 - math.abs(i)) * 0.4), 1.0, navy, M.SmoothPlastic, nil, 0.3)
	end
	local top = m:FindFirstChild("Crest")
	Kit.light(top, glow, 14, 2)
	Kit.particles(top, { color = glow, size = 0.4, rate = 10, speed = 4, lifetime = 0.3, emission = 1 })
	return head
end

-- Void Realm: an armored void knight with a glowing visor and orbiting shards.
function G.Warden(m)
	local armor, trim, glow = { 44, 38, 64 }, { 90, 70, 130 }, { 200, 90, 255 }
	local cape, steel = { 40, 14, 60 }, { 120, 110, 150 }
	for s = -1, 1, 2 do
		part(m, "Sabaton", V(1.9, 1.0, 2.6), V(s * 1.25, 0.5, -0.3), armor, M.Metal)
		part(m, "Greave", V(1.6, 4.2, 1.8), V(s * 1.2, 3.1, 0), armor, M.Metal)
		part(m, "KneeGuard", V(1.8, 1.0, 0.6), V(s * 1.2, 3.6, -0.95), trim, M.Metal)
		part(m, "Pauldron", V(2.3, 1.5, 2.7), V(s * 3.1, 11.0, 0), trim, M.Metal)
		rod(m, "PauldronSpike", V(s * 3.2, 11.6, 0), V(s * 3.9, 13.0, 0), 0.45, armor, M.Metal)
		rod(m, "Arm", V(s * 3.2, 10.4, 0), V(s * 3.4, 7.4, -0.5), 1.4, armor, M.Metal)
		part(m, "Gauntlet", V(1.6, 1.9, 1.6), V(s * 3.4, 6.5, -0.7), trim, M.Metal)
		part(m, "Rune", V(0.2, 1.6, 0.1), V(s * 1.3, 8.6, -1.47), glow, M.Neon)
		rod(m, "Horn", V(s * 1.0, 13.6, 0), V(s * 1.8, 15.4, 0.6), 0.55, armor, M.Metal)
		ball(m, "HornTip", 0.4, V(s * 1.8, 15.4, 0.6), glow, M.Neon)
	end
	part(m, "Tasset", V(4.4, 1.8, 2.8), V(0, 5.9, 0), armor, M.Metal)
	part(m, "Torso", V(4.8, 4.4, 2.9), V(0, 9.0, 0), armor, M.Metal)
	local core = ball(m, "VoidCore", 1.3, V(0, 9.4, -1.45), glow, M.Neon)
	Kit.light(core, glow, 14, 2)
	part(m, "Gorget", V(3.0, 0.8, 2.6), V(0, 11.3, -0.1), trim, M.Metal)
	part(m, "Cape", V(4.4, 9.5, 0.3), CF(0, 7.6, 1.65) * ANG(-0.08, 0, 0), cape, M.Fabric)
	-- greatsword held point-down in the right hand
	rod(m, "Grip", V(3.4, 5.6, -0.7), V(3.4, 7.4, -0.7), 0.35, INK)
	ball(m, "Pommel", 0.5, V(3.4, 7.6, -0.7), glow, M.Neon)
	part(m, "Guard", V(2.6, 0.4, 0.6), V(3.4, 5.4, -0.7), trim, M.Metal)
	part(m, "Blade", V(0.35, 5.0, 1.1), V(3.4, 2.85, -0.7), steel, M.Metal)
	part(m, "BladeEdge", V(0.4, 4.6, 0.15), V(3.4, 2.9, -1.3), glow, M.Neon)
	local head = part(m, "Head", V(2.5, 2.9, 2.7), V(0, 12.6, -0.2), armor, M.Metal)
	part(m, "Visor", V(1.9, 0.32, 0.15), V(0, 12.8, -1.56), glow, M.Neon)
	eyes(m, V(0, 12.8, -1.6), 0.5, 0.55, glow)
	part(m, "HelmCrest", V(0.4, 1.0, 2.2), V(0, 14.3, -0.1), trim, M.Metal)
	for k = 0, 3 do
		local a = k * PI / 2 + 0.5
		local p = part(m, "Shard", V(0.6, 1.6, 0.6), CF(math.cos(a) * 5.2, 8 + k * 1.2, math.sin(a) * 5.2) * ANG(0.3, a, 0.3), glow, M.Neon, 0.1)
		orbit(p, 0.8)
		p:SetAttribute("SelfSpin", 1.5)
	end
	Kit.particles(core, { color = glow, color2 = cape, size = 0.5, rate = 10, speed = 1, lifetime = 1.6, emission = 1 })
	return head
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

--[[
	GuardianModels.build(kind, zoneIndex) -> Model
]]
function GuardianModels.build(kind, zoneIndex)
	local builder = G[kind]
	if not builder then
		error("Unknown guardian kind " .. tostring(kind))
	end
	local m = Instance.new("Model")
	m.Name = kind .. "Guardian"
	local root = Kit.part(m, { name = "Root", size = V(2, 0.2, 2), transparency = 1, collide = false })
	m.PrimaryPart = root
	builder(m)
	normalize(m, root, GuardianModels.Heights[kind] or 14)
	m:SetAttribute("GuardianKind", kind)
	if zoneIndex then
		m:SetAttribute("ZoneIndex", zoneIndex)
	end
	Kit.setCollide(m, false)
	return m
end

function GuardianModels.kinds()
	local out = {}
	for k in pairs(G) do
		table.insert(out, k)
	end
	table.sort(out)
	return out
end

return GuardianModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--[[
	Kit — part-construction helpers shared by the world builders and model
	factories. Everything is plain Parts (no external assets), so the whole game
	builds from source.
]]

local Kit = {}

local function rgb(c)
	if typeof(c) == "Color3" then
		return c
	end
	return Color3.fromRGB(c[1], c[2], c[3])
end
Kit.rgb = rgb

function Kit.shade(c, f)
	local col = rgb(c)
	return Color3.new(math.clamp(col.R * f, 0, 1), math.clamp(col.G * f, 0, 1), math.clamp(col.B * f, 0, 1))
end

function Kit.mix(a, b, t)
	return rgb(a):Lerp(rgb(b), t)
end

--[[
	Kit.part(parent, {
		size = Vector3, cf = CFrame, color = {r,g,b}|Color3, material = Enum.Material.X,
		shape = "Ball"|"Cylinder"|"Block"|"Wedge"|"CornerWedge", transparency, name,
		collide = bool (default true), anchored = bool (default true), reflectance,
		castShadow = bool,
	})
]]
function Kit.part(parent, o)
	local p
	if o.shape == "Wedge" then
		p = Instance.new("WedgePart")
	elseif o.shape == "CornerWedge" then
		p = Instance.new("CornerWedgePart")
	else
		p = Instance.new("Part")
		if o.shape == "Ball" then
			p.Shape = Enum.PartType.Ball
		elseif o.shape == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		end
	end
	p.Name = o.name or "Part"
	p.Anchored = o.anchored ~= false
	p.CanCollide = o.collide ~= false
	p.CanTouch = o.touch == true
	p.CanQuery = o.query ~= false
	p.CastShadow = o.castShadow ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = o.size or Vector3.new(4, 1, 4)
	p.CFrame = o.cf or CFrame.new()
	p.Color = rgb(o.color or { 163, 162, 165 })
	p.Material = o.material or Enum.Material.SmoothPlastic
	p.Transparency = o.transparency or 0
	p.Reflectance = o.reflectance or 0
	p.Parent = parent
	return p
end

function Kit.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name or "Model"
	m.Parent = parent
	return m
end

function Kit.folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Vertical cylinder (Roblox cylinders run along X; rotate so the axis is Y).
function Kit.cylinder(parent, o)
	local h, d = o.height or 1, o.diameter or 4
	local cf = (o.cf or CFrame.new()) * CFrame.Angles(0, 0, math.pi / 2)
	return Kit.part(parent, {
		name = o.name,
		size = Vector3.new(h, d, d),
		cf = cf,
		color = o.color,
		material = o.material,
		shape = "Cylinder",
		transparency = o.transparency,
		collide = o.collide,
		castShadow = o.castShadow,
		reflectance = o.reflectance,
	})
end

function Kit.ball(parent, o)
	local d = o.diameter or 4
	return Kit.part(parent, {
		name = o.name,
		size = Vector3.new(d, d, d),
		cf = o.cf or CFrame.new(),
		color = o.color,
		material = o.material,
		shape = "Ball",
		transparency = o.transparency,
		collide = o.collide,
		castShadow = o.castShadow,
		reflectance = o.reflectance,
	})
end

-- A wedge ramp/roof between two heights along local Z.
function Kit.wedge(parent, o)
	return Kit.part(parent, {
		name = o.name,
		size = o.size,
		cf = o.cf,
		color = o.color,
		material = o.material,
		shape = "Wedge",
		collide = o.collide,
		transparency = o.transparency,
	})
end

function Kit.light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = rgb(color)
	l.Range = range or 12
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Parent = parent
	return l
end

function Kit.particles(parent, o)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(rgb(o.color or { 255, 255, 255 }), rgb(o.color2 or o.color or { 255, 255, 255 }))
	e.Size = NumberSequence.new(o.size or 0.6, o.sizeEnd or 0)
	e.Transparency = NumberSequence.new(o.transparency or 0.2, 1)
	e.Lifetime = NumberRange.new(o.lifetime or 1, (o.lifetime or 1) * 1.5)
	e.Rate = o.rate or 10
	e.Speed = NumberRange.new(o.speed or 2, (o.speed or 2) * 1.5)
	e.SpreadAngle = Vector2.new(o.spread or 180, o.spread or 180)
	e.LightEmission = o.emission or 0.6
	e.Acceleration = o.accel or Vector3.new(0, 0, 0)
	e.Drag = o.drag or 0
	if o.texture then
		e.Texture = o.texture
	end
	e.Parent = parent
	return e
end

-- Weld every BasePart in `model` to `root` (used for carried/animated models).
function Kit.weldAll(model, root)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = root
		end
	end
end

function Kit.setCollide(model, collide)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanCollide = collide
			d.CanTouch = false
			if not collide then
				d.CanQuery = false
			end
		end
	end
end

function Kit.setAnchored(model, anchored)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = anchored
		end
	end
end

function Kit.setMassless(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Massless = true
		end
	end
end

-- Bold, outlined world-space label.
function Kit.billboard(adornee, o)
	local bb = Instance.new("BillboardGui")
	bb.Name = o.name or "Label"
	bb.Size = o.size or UDim2.new(0, 220, 0, 60)
	bb.StudsOffset = o.offset or Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = o.alwaysOnTop == true
	bb.MaxDistance = o.maxDistance or 120
	bb.LightInfluence = 0
	bb.Adornee = adornee
	bb.Parent = adornee
	return bb
end

function Kit.text(parent, o)
	local t = Instance.new("TextLabel")
	t.Name = o.name or "Text"
	t.BackgroundTransparency = 1
	t.Size = o.size or UDim2.new(1, 0, 1, 0)
	t.Position = o.position or UDim2.new(0, 0, 0, 0)
	t.AnchorPoint = o.anchor or Vector2.new(0, 0)
	t.Text = o.text or ""
	t.TextColor3 = rgb(o.color or { 255, 255, 255 })
	t.TextStrokeColor3 = rgb(o.strokeColor or { 20, 20, 30 })
	t.TextStrokeTransparency = o.stroke == false and 1 or 0
	t.Font = o.font or Enum.Font.FredokaOne
	-- TextWrapped must be set before TextScaled: in Roblox, TextWrapped = false turns TextScaled off.
	t.TextWrapped = o.wrapped == true
	t.TextScaled = o.scaled ~= false
	t.TextSize = o.textSize or 24
	t.TextXAlignment = o.xAlign or Enum.TextXAlignment.Center
	t.RichText = o.rich == true
	t.ZIndex = o.z or 1
	t.Parent = parent
	return t
end

return Kit
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--[[
	Remotes — the complete list of network endpoints. The server creates them,
	clients wait for them. Clients only ever send *intents*; every effect is
	validated on the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Events = {
	-- server -> client
	"Sync", -- (snapshot) local player's state for the HUD
	"Notify", -- (text, kind) small toast
	"Announce", -- (payload) big centered banner: zone entry, events, catches
	"OpenPanel", -- (panelName) world kiosk opened a UI panel
	"Effect", -- (kind, ...) client-side effects, e.g. ("knockback", velocity)
	-- client -> server
	"RequestUpgrade", -- (upgradeId)
	"RequestShield", -- ()
	"RequestTravel", -- (destination, zoneIndex?) Quick Travel; validated by TravelService
	"RequestPurchase", -- (itemKey, podSlot?) only opens the Roblox purchase prompt; grants happen in ProcessReceipt
}

local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
		for _, name in ipairs(Remotes.Events) do
			if not folder:FindFirstChild(name) then
				local ev = Instance.new("RemoteEvent")
				ev.Name = name
				ev.Parent = folder
			end
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
	return folder
end

function Remotes.get(name)
	local f = getFolder()
	if RunService:IsServer() then
		return f:FindFirstChild(name)
	end
	return f:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--[[
	Signal — tiny synchronous signal for server-side service events.
	Handlers run in order; an erroring handler is reported and does not stop the rest.
]]

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local entry = { fn = fn, connected = true }
	table.insert(self.handlers, entry)
	return {
		Disconnect = function()
			entry.connected = false
		end,
	}
end

function Signal:Fire(...)
	local snapshot = {}
	for _, h in ipairs(self.handlers) do
		if h.connected then
			table.insert(snapshot, h)
		end
	end
	self.handlers = snapshot
	for _, h in ipairs(snapshot) do
		local ok, err = pcall(h.fn, ...)
		if not ok then
			warn("[Signal] handler error: " .. tostring(err))
		end
	end
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[--[[
	Util — small pure helpers shared by server, client and tests.
]]

local Util = {}

function Util.clamp(x, lo, hi)
	if x < lo then
		return lo
	end
	if x > hi then
		return hi
	end
	return x
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

function Util.round(x)
	return math.floor(x + 0.5)
end

function Util.isFiniteNumber(x)
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1.23K", 15 -> "15", 2500000 -> "2.5M"
function Util.formatNumber(n)
	if not Util.isFiniteNumber(n) then
		return "0"
	end
	local negative = n < 0
	if negative then
		n = -n
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n = n / 1000
		i = i + 1
	end
	local s
	if i == 1 then
		s = tostring(math.floor(n))
	elseif n >= 100 then
		s = string.format("%.0f", math.floor(n))
	elseif n >= 10 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = string.format("%.2f", math.floor(n * 100) / 100)
	end
	-- strip trailing zeros after a decimal point ("2.50" -> "2.5", "3.0" -> "3")
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return (negative and "-" or "") .. s .. SUFFIXES[i]
end

function Util.formatMoney(n)
	return "$" .. Util.formatNumber(n)
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Util.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds + 0.5))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

function Util.deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t) do
		out[k] = Util.deepCopy(v)
	end
	return out
end

function Util.count(t)
	local n = 0
	for _ in pairs(t) do
		n = n + 1
	end
	return n
end

function Util.find(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

-- Roblox-only: convert a {r,g,b} config array into a Color3.
function Util.rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

return Util
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX0000003E"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000003D"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX0000001C"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><token name="RunContext">0</token><ProtectedString name="Source"><![CDATA[--[[
	Server bootstrap. Builds the world, then initializes and starts every
	service in dependency order. Services get the registry `S` in Init so they
	can call each other (S.CarryService:drop(...), etc.).
]]

local ServerScriptService = game:GetService("ServerScriptService")

local ServicesFolder = ServerScriptService:WaitForChild("Server"):WaitForChild("Services")

local ORDER = {
	"PlayerDataService",
	"ZoneService", -- builds the map
	"BaseService",
	"EconomyService",
	"SpeedService",
	"EventService",
	"CoreSpawnService",
	"CarryService",
	"StealService",
	"IncubatorService",
	"DisasterCollectionService",
	"GuardianService",
	"UpgradeService",
	"MonetizationService", -- Game Passes + Developer Products (ProcessReceipt)
	"TravelService", -- Quick Travel (HOME / STEAL / TRAIN / ZONES)
	"DevService", -- Studio-only chat commands
}

local S = {}
for _, name in ipairs(ORDER) do
	S[name] = require(ServicesFolder:WaitForChild(name))
end

for _, name in ipairs(ORDER) do
	local svc = S[name]
	if svc.Init then
		local ok, err = xpcall(svc.Init, debug.traceback, svc, S)
		if not ok then
			warn("[Main] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, name in ipairs(ORDER) do
	local svc = S[name]
	if svc.Start then
		local ok, err = xpcall(svc.Start, debug.traceback, svc)
		if not ok then
			warn("[Main] " .. name .. ".Start failed: " .. tostring(err))
		end
	end
end

-- expose for the headless integration tests / Studio command bar debugging
_G.StealADisaster = S
print("[Steal a Disaster] server ready")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000002D"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">BaseService</string><ProtectedString name="Source"><![CDATA[--[[
	BaseService — base assignment, spawning, base visuals, and base protection.

	* Every slot's base is built once at startup; joining players claim the
	  first free slot (attribute "BaseSlot").
	* Characters spawn on their own base.
	* "Lock Base" raises a shield for a few seconds (duration from the Shield
	  upgrade): no one can steal from a locked base and non-owners standing
	  inside are pushed out. Cooldown applies.
	* refresh(player) updates the owner sign, locked/unlocked pods & pedestals
	  and tier decor so upgrades are visible in the world.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local WorldLayout = require(Shared.Logic.WorldLayout)
local UpgradeLogic = require(Shared.Logic.UpgradeLogic)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local RateLimiter = require(Shared.Logic.RateLimiter)

local BaseBuilder = require(ServerScriptService.Server.World.BaseBuilder)

local BaseService = { Name = "BaseService" }

local S
local bases = {} -- [slot] = refs
local owners = {} -- [slot] = player
local slotOf = {} -- [player] = slot
local shields = {} -- [slot] = { untilT, cooldownUntil }
local shieldLimiter

function BaseService:Init(registry)
	S = registry
	local folder = Instance.new("Folder")
	folder.Name = "Bases"
	folder.Parent = workspace:WaitForChild("World")
	for i = 1, #Config.Bases.Slots do
		bases[i] = BaseBuilder.build(folder, i)
		shields[i] = { untilT = 0, cooldownUntil = 0 }
		self:_resetVisuals(i)
	end
	local rl = Config.RateLimits.Shield
	shieldLimiter = RateLimiter.new(rl[1], rl[2])
end

function BaseService:base(slot)
	return bases[slot]
end

function BaseService:slotOf(player)
	return slotOf[player]
end

function BaseService:ownerOf(slot)
	return owners[slot]
end

function BaseService:baseOf(player)
	local s = slotOf[player]
	return s and bases[s] or nil
end

function BaseService:inOwnBase(player, pos)
	local s = slotOf[player]
	if not s then
		return false
	end
	return WorldLayout.inBase(s, pos.X, pos.Z, 0)
end

function BaseService:spawnCFrame(slot)
	local p = WorldLayout.spawnPosition(slot)
	local cf = bases[slot].cf
	-- face toward the avenue (base local +X); the raw base rotation looks along local -Z,
	-- which put the camera against the entrance pylon in Studio
	return CFrame.new(p[1], p[2] + BaseBuilder.FLOOR_TOP, p[3]) * cf.Rotation * CFrame.Angles(0, -math.pi / 2, 0)
end

function BaseService:sendHome(player)
	local char = player.Character
	local s = slotOf[player]
	if not char or not s then
		return
	end
	char:PivotTo(self:spawnCFrame(s))
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end

-- Shield -------------------------------------------------------------------
function BaseService:isShielded(slot)
	local sh = shields[slot]
	return sh ~= nil and os.clock() < sh.untilT
end

function BaseService:activateShield(player)
	local s = slotOf[player]
	local data = S.PlayerDataService:get(player)
	if not s or not data then
		return false, "No base"
	end
	if not shieldLimiter:allow(player) then
		return false, "Slow down"
	end
	local sh = shields[s]
	local now = os.clock()
	if now < sh.untilT then
		return false, "Already locked"
	end
	if now < sh.cooldownUntil then
		return false, "Shield recharging (" .. math.ceil(sh.cooldownUntil - now) .. "s)"
	end
	local duration = UpgradeLogic.shieldDuration(data.upgrades.Shield)
	sh.untilT = now + duration
	sh.cooldownUntil = sh.untilT + Config.Bases.ShieldCooldown
	player:SetAttribute("ShieldUntil", workspace:GetServerTimeNow() + duration)
	self:_applyShieldVisual(s)
	S.PlayerDataService:markDirty(player)
	return true, duration
end

function BaseService:_applyShieldVisual(slot)
	local b = bases[slot]
	b.shieldWall.Transparency = self:isShielded(slot) and 0.35 or 1
end

-- Visuals ------------------------------------------------------------------
function BaseService:_resetVisuals(slot)
	local b = bases[slot]
	b.ownerText.Text = "EMPTY BASE"
	b.infoText.Text = "Waiting for a storm chaser..."
	b.billboardName.Text = ""
	b.billboardInfo.Text = ""
	for i, pod in ipairs(b.pods) do
		self:_setLocked(pod, i > Config.Bases.StartPods, "")
	end
	for i, ped in ipairs(b.pedestals) do
		self:_setLocked(ped, i > Config.Bases.StartPedestals, "")
	end
	for _, list in pairs(b.tiers) do
		for _, d in ipairs(list) do
			d.part.Transparency = 1
		end
	end
	b.shieldWall.Transparency = 1
end

function BaseService:_setLocked(unit, locked, priceText)
	unit.locked = locked
	for _, d in ipairs(unit.model:GetDescendants()) do
		if d:IsA("BasePart") then
			local orig = d:GetAttribute("OrigTransparency")
			if orig == nil then
				orig = d.Transparency
				d:SetAttribute("OrigTransparency", orig)
			end
			if locked then
				d.Transparency = math.max(orig, 0.7)
			else
				d.Transparency = orig
			end
		end
	end
	unit.lock.Enabled = locked
	local label = unit.lock:FindFirstChild("Text")
	if label then
		label.Text = locked and ("🔒 " .. priceText) or ""
	end
end

local function tierOf(data)
	local u = data.upgrades
	local score = (u.Treadmill - 1) + (u.Carry - 1) * 3 + (u.Pods - 2) * 2 + (u.Pedestals - 4) + (u.Shield - 1) * 2
	if score >= 40 then
		return 4
	elseif score >= 18 then
		return 3
	elseif score >= 6 then
		return 2
	end
	return 1
end
BaseService.tierOf = tierOf

function BaseService:refresh(player)
	local s = slotOf[player]
	local data = S.PlayerDataService:get(player)
	if not s or not data then
		return
	end
	local b = bases[s]
	local podCount = data.upgrades.Pods
	local pedCount = data.upgrades.Pedestals
	local podCost = UpgradeLogic.nextCost(data, "Pods")
	local pedCost = UpgradeLogic.nextCost(data, "Pedestals")
	for i, pod in ipairs(b.pods) do
		local price = (i == podCount + 1 and podCost) and Util.formatMoney(podCost) or ""
		self:_setLocked(pod, i > podCount, price)
	end
	for i, ped in ipairs(b.pedestals) do
		local price = (i == pedCount + 1 and pedCost) and Util.formatMoney(pedCost) or ""
		self:_setLocked(ped, i > pedCount, price)
	end
	local tier = tierOf(data)
	for t, list in pairs(b.tiers) do
		for _, d in ipairs(list) do
			d.part.Transparency = (t <= tier) and d.transparency or 1
		end
	end
	local income = S.EconomyService and S.EconomyService:incomeOf(player) or 0
	b.ownerText.Text = string.upper(player.DisplayName) .. "'S BASE"
	b.infoText.Text = Util.formatMoney(income) .. "/s  •  " .. #data.disasters .. "/" .. pedCount .. " disasters  •  Tier " .. tier
	b.billboardName.Text = player.DisplayName
	b.billboardInfo.Text = Util.formatMoney(income) .. "/s"
	self:refreshTreadmillLabel(player)
end

-- Treadmill screen: Speed per step, the purchase multiplier and Boost time left.
function BaseService:refreshTreadmillLabel(player)
	local s = slotOf[player]
	local data = S.PlayerDataService:get(player)
	local gain = s and bases[s].treadmill.gainLabel
	if not gain or not data then
		return
	end
	local SpeedLogic = require(Shared.Logic.SpeedLogic)
	local MonetizationLogic = require(Shared.Logic.MonetizationLogic)
	local mult = MonetizationLogic.speedMultiplier(data)
	local perStep = SpeedLogic.gainPerStep(data.upgrades.Treadmill) * mult
	local text = "+" .. Util.formatNumber(perStep) .. " SPEED / STEP"
	if (data.boostSpeed or 0) > 0 then
		text = text .. "  ⚡x" .. mult .. " " .. Util.formatTime(data.boostSpeed)
	elseif mult > 1 then
		text = text .. "  (x" .. mult .. ")"
	end
	gain.Text = text
end

-- Assignment ---------------------------------------------------------------
function BaseService:_assign(player)
	if slotOf[player] then
		return slotOf[player]
	end
	for i = 1, #Config.Bases.Slots do
		if not owners[i] then
			owners[i] = player
			slotOf[player] = i
			player:SetAttribute("BaseSlot", i)
			bases[i].model:SetAttribute("Owner", player.UserId)
			return i
		end
	end
	return nil
end

function BaseService:_release(player)
	local s = slotOf[player]
	if not s then
		return
	end
	owners[s] = nil
	slotOf[player] = nil
	shields[s] = { untilT = 0, cooldownUntil = 0 }
	bases[s].model:SetAttribute("Owner", nil)
	self:_resetVisuals(s)
end

function BaseService:_onCharacter(player, char)
	local s = slotOf[player]
	if not s then
		return
	end
	task.defer(function()
		if char.Parent then
			char:PivotTo(self:spawnCFrame(s))
		end
	end)
end

function BaseService:Start()
	local function onPlayer(player)
		local slot = self:_assign(player)
		if not slot then
			player:Kick("Server is full — please try another server.")
			return
		end
		player.CharacterAdded:Connect(function(char)
			self:_onCharacter(player, char)
		end)
		if player.Character then
			self:_onCharacter(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		self:_release(p)
	end)
	S.PlayerDataService.Loaded:Connect(function(player)
		self:refresh(player)
	end)

	-- base terminals
	for slot, b in pairs(bases) do
		b.shieldTerminal.prompt.Triggered:Connect(function(player)
			if owners[slot] ~= player then
				S.PlayerDataService:notify(player, "That's not your base!", "error")
				return
			end
			local ok, res = self:activateShield(player)
			if ok then
				S.PlayerDataService:notify(player, "Base locked for " .. res .. "s!", "success")
			else
				S.PlayerDataService:notify(player, res, "error")
			end
		end)
		b.upgradeTerminal.prompt.Triggered:Connect(function(player)
			if owners[slot] == player then
				Remotes.get("OpenPanel"):FireClient(player, "Shop")
			end
		end)
	end
	Remotes.get("RequestShield").OnServerEvent:Connect(function(player)
		local ok, res = self:activateShield(player)
		if ok then
			S.PlayerDataService:notify(player, "Base locked for " .. res .. "s!", "success")
		else
			S.PlayerDataService:notify(player, res, "error")
		end
	end)

	-- shield upkeep: expire visuals, push intruders out
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.25 then
			return
		end
		acc = 0
		for slot, b in pairs(bases) do
			local shielded = self:isShielded(slot)
			if (b.shieldWall.Transparency < 1) ~= shielded then
				self:_applyShieldVisual(slot)
			end
			if shielded then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= owners[slot] then
						local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
						if hrp and WorldLayout.inBase(slot, hrp.Position.X, hrp.Position.Z, 0) then
							local out = b.cf * CFrame.new(Config.Bases.Size / 2 + 8, 3, 0)
							p.Character:PivotTo(out)
							S.PlayerDataService:notify(p, "That base is locked!", "error")
						end
					end
				end
			end
		end
	end)
end

return BaseService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">CarryService</string><ProtectedString name="Source"><![CDATA[--[[
	CarryService — everything about cores in transit.

	An item is either
	  { kind = "world",  entity = <CoreSpawnService entity>, coreId, mutation, zoneIndex }
	  { kind = "player", victim = Player, podSlot = n, coreId, mutation, zoneIndex, progress }
	Ownership only transfers on delivery (carrier inside their own base).
	Any interruption returns every item to its source:
	  death, character removal, leaving, falling, guardian tag, owner tag,
	  and suspected teleport (movement faster than physically possible).
	If a robbery victim leaves, their in-transit items are cancelled first so
	nothing can be duplicated.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local CarryLogic = require(Shared.Logic.CarryLogic)
local Kit = require(Shared.Models.Kit)
local CoreModels = require(Shared.Models.CoreModels)
local Remotes = require(Shared.Remotes)

local CarryService = { Name = "CarryService" }

local S
local carriers = {} -- [player] = { items = {}, lastPos = Vector3?, visuals = {} }

local DROP_TEXT = {
	died = "You were knocked out — the core returned home.",
	guardian = "The guardian got you! The core went back to its nest.",
	caught = "Caught by the owner! The core went back.",
	teleport = "Movement rejected — the core went back.",
	fell = "You fell — the core returned.",
	left = "",
	lost = "You lost the core.",
	victimLeft = "The owner left — that core vanished.",
}

function CarryService:Init(registry)
	S = registry
end

local function state(player)
	local st = carriers[player]
	if not st then
		st = { items = {}, lastPos = nil, visuals = {} }
		carriers[player] = st
	end
	return st
end

function CarryService:getItems(player)
	local st = carriers[player]
	return st and st.items or {}
end

function CarryService:count(player)
	local st = carriers[player]
	return st and #st.items or 0
end

function CarryService:isCarrying(player)
	return self:count(player) > 0
end

function CarryService:walkMultiplier(player)
	local st = carriers[player]
	if not st or #st.items == 0 then
		return 1
	end
	local ids = {}
	for _, it in ipairs(st.items) do
		table.insert(ids, it.coreId)
	end
	return CarryLogic.walkMultiplier(CarryLogic.totalWeight(ids))
end

function CarryService:resetTracking(player)
	local st = carriers[player]
	if st then
		st.lastPos = nil
		st.budget = nil
	end
end

function CarryService:_rebuildVisuals(player)
	local st = state(player)
	for _, v in ipairs(st.visuals) do
		v:Destroy()
	end
	st.visuals = {}
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	for i, it in ipairs(st.items) do
		local m = CoreModels.build(it.coreId, it.mutation, 0.9)
		m.Name = "CarriedCore"
		m:PivotTo(hrp.CFrame * CFrame.new(0, 4.4 + (i - 1) * 2.8, 0))
		Kit.setCollide(m, false)
		Kit.setMassless(m)
		Kit.setAnchored(m, false)
		local w = Instance.new("WeldConstraint")
		w.Part0 = hrp
		w.Part1 = m.PrimaryPart
		w.Parent = m.PrimaryPart
		Kit.weldAll(m, m.PrimaryPart)
		m.Parent = char
		table.insert(st.visuals, m)
	end
	player:SetAttribute("Carrying", #st.items)
end

function CarryService:_changed(player)
	self:_rebuildVisuals(player)
	S.SpeedService:refreshWalkSpeed(player)
	S.PlayerDataService:markDirty(player)
end

function CarryService:add(player, item)
	local st = state(player)
	if #st.items == 0 then
		-- a fresh carry starts with a full movement budget; a budget drained by an
		-- earlier teleport rejection must not drop this one on its first step
		st.budget = nil
	end
	table.insert(st.items, item)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	st.lastPos = hrp and hrp.Position or nil
	self:_changed(player)
	Remotes.get("Announce"):FireClient(player, {
		kind = "carry",
		title = "RUN HOME!",
		subtitle = "Get " .. Config.Cores[item.coreId].name .. " back to your base",
		color = Config.Rarities[Config.Cores[item.coreId].rarity].color,
	})
end

local function returnItem(item)
	if item.kind == "world" then
		S.CoreSpawnService:returnToNest(item.entity)
	elseif item.kind == "player" then
		S.IncubatorService:cancelTransit(item.victim, item.podSlot)
	end
end

function CarryService:dropAll(player, reason)
	local st = carriers[player]
	if not st or #st.items == 0 then
		return 0
	end
	local n = #st.items
	for _, it in ipairs(st.items) do
		returnItem(it)
	end
	st.items = {}
	st.lastPos = nil
	if player.Parent == Players then
		self:_changed(player)
		local text = DROP_TEXT[reason or "lost"]
		if text and text ~= "" then
			S.PlayerDataService:notify(player, text, "error")
		end
	else
		for _, v in ipairs(st.visuals) do
			v:Destroy()
		end
		st.visuals = {}
	end
	return n
end

-- Remove items stolen from `victim` (victim is leaving). Thief loses them.
function CarryService:cancelFromVictim(victim)
	for thief, st in pairs(carriers) do
		local kept = {}
		local removed = 0
		for _, it in ipairs(st.items) do
			if it.kind == "player" and it.victim == victim then
				removed = removed + 1
				S.IncubatorService:cancelTransit(victim, it.podSlot)
			else
				table.insert(kept, it)
			end
		end
		if removed > 0 then
			st.items = kept
			if thief.Parent == Players then
				self:_changed(thief)
				S.PlayerDataService:notify(thief, DROP_TEXT.victimLeft, "error")
			end
		end
	end
end

function CarryService:deliver(player)
	local st = carriers[player]
	if not st or #st.items == 0 then
		return 0
	end
	local data = S.PlayerDataService:get(player)
	if not data then
		return 0
	end
	local delivered = {}
	for _, it in ipairs(st.items) do
		local entry
		if it.kind == "world" then
			if S.CoreSpawnService:consume(it.entity) then
				entry = { c = it.coreId, m = it.mutation, z = it.zoneIndex, p = 0 }
				data.stats.stolen = data.stats.stolen + 1
			end
		elseif it.kind == "player" then
			entry = S.IncubatorService:completeTransit(it.victim, it.podSlot)
			if entry then
				data.stats.stolen = data.stats.stolen + 1
				data.stats.robbed = data.stats.robbed + 1
				S.PlayerDataService:notify(it.victim, player.DisplayName .. " stole your " .. Config.Cores[entry.c].name .. "!", "error")
			end
		end
		if entry then
			S.IncubatorService:receive(player, entry)
			table.insert(delivered, entry)
		end
	end
	st.items = {}
	st.lastPos = nil
	self:_changed(player)
	if #delivered > 0 then
		local first = Config.Cores[delivered[1].c]
		Remotes.get("Announce"):FireClient(player, {
			kind = "delivered",
			title = "DELIVERED!",
			subtitle = (#delivered > 1) and (#delivered .. " cores secured") or (first.name .. " secured — incubating!"),
			color = { 120, 255, 140 },
		})
	end
	return #delivered
end

function CarryService:_tick(dt)
	for player, st in pairs(carriers) do
		if #st.items > 0 then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if player.Parent ~= Players then
				self:dropAll(player, "left")
			elseif not hrp or not hum then
				self:dropAll(player, "lost")
			elseif hum.Health <= 0 then
				self:dropAll(player, "died")
			else
				local pos = hrp.Position
				local maxWalk = S.SpeedService:maxWalkFor(player)
				local teleported = false
				if st.lastPos then
					local dx, dz = pos.X - st.lastPos.X, pos.Z - st.lastPos.Z
					st.budget, teleported = CarryLogic.spendBudget(st.budget or CarryLogic.newBudget(maxWalk), math.sqrt(dx * dx + dz * dz), dt, maxWalk)
				else
					st.budget = CarryLogic.newBudget(maxWalk)
				end
				if teleported then
					warn("[Carry] teleport suspected for " .. player.Name)
					self:dropAll(player, "teleport")
				else
					st.lastPos = pos
					if S.BaseService:inOwnBase(player, pos) then
						self:deliver(player)
					else
						-- owners can tag thieves carrying their cores
						for _, it in ipairs(st.items) do
							if it.kind == "player" and it.victim.Parent == Players then
								local vhrp = it.victim.Character and it.victim.Character:FindFirstChild("HumanoidRootPart")
								if vhrp and (vhrp.Position - pos).Magnitude <= Config.Carry.TagRange then
									self:dropAll(player, "caught")
									S.PlayerDataService:notify(it.victim, "You caught the thief! Core recovered.", "success")
									break
								end
							end
						end
					end
				end
			end
		end
	end
end

function CarryService:Start()
	RunService.Heartbeat:Connect(function(dt)
		self:_tick(dt)
	end)
	S.PlayerDataService.Releasing:Connect(function(player)
		self:cancelFromVictim(player)
		self:dropAll(player, "left")
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:dropAll(player, "left")
		carriers[player] = nil
	end)
	local function hookCharacter(player, char)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			hum.Died:Connect(function()
				self:dropAll(player, "died")
			end)
		end
	end
	local function hookPlayer(player)
		player.CharacterRemoving:Connect(function()
			self:dropAll(player, "died")
		end)
		player.CharacterAdded:Connect(function(char)
			hookCharacter(player, char)
		end)
		if player.Character then
			task.spawn(hookCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end
end

return CarryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">CoreSpawnService</string><ProtectedString name="Source"><![CDATA[--[[
	CoreSpawnService — the world's temporary Disaster Core opportunities.

	Each zone has a nest with N spawn points. A point holds at most one core
	entity. Entities are owned by the world until delivered:
	  state "Nest"    → visible on its plinth with a Steal prompt
	  state "Carried" → model removed; a carrier holds a reference
	Delivery consumes the entity and schedules a respawn. A drop (death,
	guardian, teleport, disconnect) returns it to its exact point.

	Every refresh (EventService) rerolls all uncarried cores with Frenzy odds
	and spawns Chaos Cores that vanish when the frenzy ends unless grabbed.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local SpawnLogic = require(Shared.Logic.SpawnLogic)
local EconomyLogic = require(Shared.Logic.EconomyLogic)
local Util = require(Shared.Util)
local Kit = require(Shared.Models.Kit)
local CoreModels = require(Shared.Models.CoreModels)

local CoreSpawnService = { Name = "CoreSpawnService" }

local S
local folder
local points = {} -- [zoneIndex] = { { pos, entity, respawnAt } }
local entities = {} -- [uid] = entity
local nextUid = 0
local random = Random.new()
local WORLD_CORE_SCALE = 1.6

local function rng()
	return random:NextNumber()
end

function CoreSpawnService:Init(registry)
	S = registry
	folder = Instance.new("Folder")
	folder.Name = "Cores"
	folder.Parent = workspace:WaitForChild("World")
	for i = 1, #Config.Zones do
		local refs = S.ZoneService:zoneRefs(i)
		points[i] = {}
		for j, pos in ipairs(refs.nestPoints) do
			points[i][j] = { pos = pos, entity = nil, respawnAt = 0 }
		end
	end
end

local function coreLabel(entity)
	local def = Config.Cores[entity.coreId]
	local rarity = Config.Rarities[def.rarity]
	local zone = Config.Zones[entity.zoneIndex]
	local root = entity.model.PrimaryPart
	local bb = Kit.billboard(root, { name = "CoreLabel", size = UDim2.new(0, 200, 0, 78), offset = Vector3.new(0, 4.8, 0), maxDistance = 90 })
	bb:SetAttribute("ReqSpeed", zone.speedReq)
	local mutText = ""
	if entity.mutation then
		mutText = string.upper(entity.mutation) .. " "
	end
	local m = entity.mutation and Config.Mutations[entity.mutation]
	if m then
		Kit.text(bb, { name = "Mutation", text = mutText, size = UDim2.new(1, 0, 0.24, 0), color = m.color })
	end
	Kit.text(bb, { name = "Name", text = def.name, size = UDim2.new(1, 0, 0.32, 0), position = UDim2.new(0, 0, 0.22, 0), color = { 255, 255, 255 }, font = Enum.Font.LuckiestGuy })
	Kit.text(bb, { name = "Rarity", text = string.upper(def.rarity) .. "  •  " .. Util.formatMoney(EconomyLogic.coreValue(entity.coreId, entity.mutation, entity.zoneIndex)), size = UDim2.new(1, 0, 0.22, 0), position = UDim2.new(0, 0, 0.53, 0), color = rarity.color })
	local req = zone.speedReq > 0 and ("⚡ " .. Util.formatNumber(zone.speedReq) .. " to steal") or ""
	Kit.text(bb, { name = "Requirement", text = req, size = UDim2.new(1, 0, 0.2, 0), position = UDim2.new(0, 0, 0.77, 0), color = { 255, 230, 90 } })
end

local function spawnModel(entity)
	local m = CoreModels.build(entity.coreId, entity.mutation, WORLD_CORE_SCALE)
	m:PivotTo(CFrame.new(entity.position))
	m:SetAttribute("Uid", entity.uid)
	m:SetAttribute("Zone", entity.zoneIndex)
	m.Parent = folder
	m:AddTag("Animated")
	entity.model = m
	coreLabel(entity)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StealPrompt"
	prompt.ActionText = "Steal"
	prompt.ObjectText = Config.Cores[entity.coreId].name
	prompt.HoldDuration = 0.35
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = m.PrimaryPart
	prompt:SetAttribute("ReqSpeed", Config.Zones[entity.zoneIndex].speedReq)
	prompt.Triggered:Connect(function(player)
		if S.StealService then
			S.StealService:tryStealWorld(player, entity)
		end
	end)
	entity.prompt = prompt
end

function CoreSpawnService:_create(zoneIndex, pointIndex, position, opts)
	opts = opts or {}
	local zone = Config.Zones[zoneIndex]
	local frenzy = opts.frenzy == true
	local coreId = opts.coreId or SpawnLogic.pickCore(zone, rng, frenzy)
	local mutMult = frenzy and Config.Events.FrenzyMutationMult or 1
	local mutation = opts.mutation
	if mutation == nil and not opts.noMutation then
		mutation = SpawnLogic.rollMutation(rng, mutMult)
	end
	nextUid = nextUid + 1
	local entity = {
		uid = nextUid,
		coreId = coreId,
		mutation = mutation,
		zoneIndex = zoneIndex,
		pointIndex = pointIndex,
		position = position,
		state = "Nest",
		carrier = nil,
		chaos = opts.chaos == true,
	}
	entities[entity.uid] = entity
	spawnModel(entity)
	if pointIndex then
		points[zoneIndex][pointIndex].entity = entity
	end
	return entity
end

function CoreSpawnService:_destroyModel(entity)
	if entity.model then
		entity.model:Destroy()
		entity.model = nil
		entity.prompt = nil
	end
end

function CoreSpawnService:_remove(entity)
	self:_destroyModel(entity)
	entities[entity.uid] = nil
	if entity.pointIndex then
		local p = points[entity.zoneIndex][entity.pointIndex]
		if p.entity == entity then
			p.entity = nil
			p.respawnAt = os.clock() + Config.Spawning.RespawnDelay
		end
	end
end

function CoreSpawnService:get(uid)
	return entities[uid]
end

function CoreSpawnService:points(zoneIndex)
	return points[zoneIndex]
end

function CoreSpawnService:entitiesInZone(zoneIndex)
	local out = {}
	for _, e in pairs(entities) do
		if e.zoneIndex == zoneIndex then
			table.insert(out, e)
		end
	end
	return out
end

-- Called by StealService after validation.
function CoreSpawnService:take(entity, player)
	if entity.state ~= "Nest" or entities[entity.uid] ~= entity then
		return false
	end
	entity.state = "Carried"
	entity.carrier = player
	self:_destroyModel(entity)
	return true
end

-- Carrier lost the core: put it back where it came from.
function CoreSpawnService:returnToNest(entity)
	if entities[entity.uid] ~= entity or entity.state ~= "Carried" then
		return
	end
	entity.state = "Nest"
	entity.carrier = nil
	if entity.expired then
		-- chaos core whose frenzy already ended: it fizzles out
		self:_remove(entity)
		return
	end
	spawnModel(entity)
end

-- Delivered: the world entity is gone; schedule a respawn on its point.
function CoreSpawnService:consume(entity)
	if entities[entity.uid] ~= entity then
		return false
	end
	self:_remove(entity)
	return true
end

function CoreSpawnService:refreshAll(frenzy)
	for zi, list in ipairs(points) do
		for pi, p in ipairs(list) do
			local e = p.entity
			if e and e.state == "Nest" then
				self:_remove(e)
				p.entity = nil
			end
			if not p.entity then
				self:_create(zi, pi, p.pos, { frenzy = frenzy })
			end
		end
	end
end

function CoreSpawnService:spawnChaosCores(count)
	-- prefer zones where players currently are, so the race is real
	local zonesWithPlayers = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local z = S.ZoneService:zoneOf(pl)
		if z and z >= 1 then
			table.insert(zonesWithPlayers, z)
		end
	end
	local spawned = {}
	for i = 1, count do
		local zi
		if #zonesWithPlayers > 0 then
			zi = zonesWithPlayers[(i - 1) % #zonesWithPlayers + 1]
		else
			zi = math.random(1, math.min(3, #Config.Zones))
		end
		local center = S.ZoneService:zoneRefs(zi).nestCenter
		local a = rng() * math.pi * 2
		local r = 6 + rng() * 10
		local pos = center + Vector3.new(math.cos(a) * r, 4.6, math.sin(a) * r)
		local e = self:_create(zi, nil, pos, { coreId = "ChaosCore", chaos = true, frenzy = true })
		table.insert(spawned, e)
	end
	return spawned
end

function CoreSpawnService:expireChaos()
	for _, e in pairs(entities) do
		if e.chaos then
			if e.state == "Nest" then
				self:_remove(e)
			else
				e.expired = true -- if dropped later it fizzles instead of returning
			end
		end
	end
end

function CoreSpawnService:Start()
	self:refreshAll(false)
	S.EventService.Refreshed:Connect(function()
		self:refreshAll(true)
		self:spawnChaosCores(Config.Events.ChaosCoresPerFrenzy)
	end)
	S.EventService.PhaseChanged:Connect(function(new, old)
		if old == "Frenzy" then
			self:expireChaos()
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.5 then
			return
		end
		acc = 0
		local now = os.clock()
		for zi, list in ipairs(points) do
			for pi, p in ipairs(list) do
				if not p.entity and now >= p.respawnAt then
					self:_create(zi, pi, p.pos, { frenzy = S.EventService:isFrenzy() })
				end
			end
		end
	end)
end

return CoreSpawnService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">DevService</string><ProtectedString name="Source"><![CDATA[--[[
	DevService — Studio-only test commands (disabled in live servers).

	Type in chat while play-testing in Studio:
	  /money <n>        set money
	  /speed <n>        set Speed
	  /core <CoreId>    put a core into your incubator (e.g. /core BlackHoleCore)
	  /hatch            finish all your pods now
	  /frenzy           jump to 2 s before the next refresh + Chaos Frenzy
	  /guardians off|on toggle all guardians
	  /reset            wipe your data back to defaults (this session)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local DataSchema = require(Shared.Logic.DataSchema)
local IncubatorLogic = require(Shared.Logic.IncubatorLogic)

local DevService = { Name = "DevService" }

local S

function DevService:Init(registry)
	S = registry
end

function DevService:enabled()
	return RunService:IsStudio()
end

function DevService:run(player, msg)
	if not self:enabled() or type(msg) ~= "string" then
		return false
	end
	local args = string.split(msg, " ")
	local cmd = string.lower(args[1] or "")
	local data = S.PlayerDataService:get(player)
	if not data then
		return false
	end
	local n = tonumber(args[2] or "")
	if cmd == "/money" and n then
		data.money = math.max(0, n)
	elseif cmd == "/speed" and n then
		data.speed = math.max(0, n)
		S.SpeedService:refreshWalkSpeed(player)
	elseif cmd == "/core" and args[2] and Config.Cores[args[2]] then
		S.IncubatorService:receive(player, { c = args[2], z = 1 })
	elseif cmd == "/hatch" then
		for _, pod in ipairs(data.pods) do
			pod.p = IncubatorLogic.incubationTime(pod.c, pod.z)
		end
		S.IncubatorService:tryHatchAll(player)
	elseif cmd == "/frenzy" then
		local info = S.EventService:elapsed() % Config.Events.Interval
		S.EventService:skip(Config.Events.Interval - info - 2)
	elseif cmd == "/guardians" then
		for i = 1, #Config.Zones do
			S.GuardianService:setEnabled(i, args[2] ~= "off")
		end
	elseif cmd == "/reset" then
		local fresh = DataSchema.default()
		for k, v in pairs(fresh) do
			data[k] = v
		end
		S.IncubatorService:clearAll(player)
		S.DisasterCollectionService:clearAll(player)
		S.EconomyService:recompute(player)
		S.SpeedService:refreshWalkSpeed(player)
	else
		return false
	end
	S.BaseService:refresh(player)
	S.EconomyService:_updateStats(player, data)
	S.PlayerDataService:markDirty(player)
	S.PlayerDataService:notify(player, "[dev] " .. msg, "info")
	return true
end

function DevService:Start()
	if not self:enabled() then
		return
	end
	local function hook(player)
		player.Chatted:Connect(function(msg)
			self:run(player, msg)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		hook(p)
	end
	print("[DevService] Studio commands enabled: /money /speed /core /hatch /frenzy /guardians /reset")
end

return DevService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">DisasterCollectionService</string><ProtectedString name="Source"><![CDATA[--[[
	DisasterCollectionService — hatched disasters on display pedestals.

	place(player, pod) turns a finished pod into a disaster on the first free
	pedestal (mutation rolled now if the core had none; Frenzy boosts it),
	records it in the Index, and refreshes income. Owners can sell a disaster
	with a hold-prompt on its pedestal to free the slot.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local EconomyLogic = require(Shared.Logic.EconomyLogic)
local IncubatorLogic = require(Shared.Logic.IncubatorLogic)
local DataSchema = require(Shared.Logic.DataSchema)
local RateLimiter = require(Shared.Logic.RateLimiter)
local Util = require(Shared.Util)
local Kit = require(Shared.Models.Kit)
local CoreModels = require(Shared.Models.CoreModels)
local Remotes = require(Shared.Remotes)

local okModels, DisasterModels = pcall(function()
	return require(Shared.Models.DisasterModels)
end)
if not okModels then
	DisasterModels = nil
end

local DisasterCollectionService = { Name = "DisasterCollectionService" }

local S
local visuals = {} -- [player] = { [slot] = { model, label } }
local sellLimiter
local random = Random.new()

function DisasterCollectionService:Init(registry)
	S = registry
	local rl = Config.RateLimits.Sell
	sellLimiter = RateLimiter.new(rl[1], rl[2])
end

local function buildModel(entry)
	if DisasterModels then
		local ok, m = pcall(DisasterModels.build, entry.d, entry.m)
		if ok and m then
			return m
		end
		warn("[Disasters] model build failed for " .. tostring(entry.d) .. ": " .. tostring(m))
	end
	-- fallback: an oversized core so the slot is never empty
	local coreId = Config.CoreByDisaster[entry.d]
	local m = CoreModels.build(coreId, entry.m)
	m:ScaleTo(1.4)
	return m
end

function DisasterCollectionService:_clearVisual(player, slot)
	local v = visuals[player] and visuals[player][slot]
	if v then
		v.model:Destroy()
		v.label:Destroy()
		if v.prompt then
			v.prompt:Destroy()
		end
		visuals[player][slot] = nil
	end
	local base = S.BaseService:baseOf(player)
	local ped = base and base.pedestals[slot]
	if ped then
		ped.ring.Color = Color3.fromRGB(90, 90, 100)
		ped.ring.Material = Enum.Material.SmoothPlastic
	end
end

function DisasterCollectionService:_buildVisual(player, entry)
	self:_clearVisual(player, entry.s)
	local base = S.BaseService:baseOf(player)
	local ped = base and base.pedestals[entry.s]
	if not ped then
		return
	end
	visuals[player] = visuals[player] or {}
	local def = Config.Disasters[entry.d]
	local rarity = Config.Rarities[def.rarity]
	local m = buildModel(entry)
	-- stand the model on the pedestal top, facing the avenue
	local _, size = m:GetBoundingBox()
	m:PivotTo(ped.top * base.cf.Rotation * CFrame.Angles(0, math.pi / 2, 0))
	m:AddTag("Animated")
	m.Parent = ped.model
	ped.ring.Color = Kit.rgb(rarity.color)
	ped.ring.Material = Enum.Material.Neon

	local height = math.max(4, size.Y)
	local bb = Kit.billboard(ped.root, { name = "DisasterLabel", size = UDim2.new(0, 180, 0, 70), offset = Vector3.new(0, height + 3, 0), maxDistance = 90 })
	local mut = entry.m and Config.Mutations[entry.m]
	if mut then
		Kit.text(bb, { name = "Mutation", text = string.upper(entry.m), size = UDim2.new(1, 0, 0.26, 0), color = mut.color })
	end
	Kit.text(bb, { name = "Name", text = def.name, size = UDim2.new(1, 0, 0.36, 0), position = UDim2.new(0, 0, 0.24, 0), color = rarity.color, font = Enum.Font.LuckiestGuy })
	Kit.text(bb, { name = "Income", text = Util.formatMoney(EconomyLogic.incomeFor(entry)) .. "/s", size = UDim2.new(1, 0, 0.32, 0), position = UDim2.new(0, 0, 0.62, 0), color = { 120, 255, 120 } })

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SellPrompt"
	prompt.ActionText = "Sell " .. Util.formatMoney(EconomyLogic.valueFor(entry))
	prompt.ObjectText = def.name
	prompt.HoldDuration = 1.2
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt:SetAttribute("OwnerOnly", player.UserId)
	prompt.Parent = ped.root
	local slot = entry.s
	prompt.Triggered:Connect(function(who)
		if who == player then
			self:sell(player, slot)
		end
	end)
	visuals[player][entry.s] = { model = m, label = bb, prompt = prompt }
end

function DisasterCollectionService:rebuildAll(player)
	local data = S.PlayerDataService:get(player)
	if not data then
		return
	end
	for _, d in ipairs(data.disasters) do
		self:_buildVisual(player, d)
	end
end

function DisasterCollectionService:clearAll(player)
	if visuals[player] then
		for slot in pairs(visuals[player]) do
			self:_clearVisual(player, slot)
		end
	end
	visuals[player] = nil
end

function DisasterCollectionService:freeSlot(player)
	local data = S.PlayerDataService:get(player)
	if not data then
		return nil
	end
	return DataSchema.freeSlot(data.disasters, data.upgrades.Pedestals)
end

-- Place a finished pod. Returns true on success.
function DisasterCollectionService:place(player, pod)
	local data = S.PlayerDataService:get(player)
	if not data then
		return false
	end
	local slot = DataSchema.freeSlot(data.disasters, data.upgrades.Pedestals)
	if not slot then
		return false
	end
	local core = Config.Cores[pod.c]
	local mutation = IncubatorLogic.hatchMutation(pod.m, function()
		return random:NextNumber()
	end, S.EventService:mutationMult())
	local entry = { s = slot, d = core.disaster, m = mutation, z = pod.z }
	table.insert(data.disasters, entry)
	local isNew = not data.index[entry.d]
	data.index[entry.d] = true
	data.stats.hatched = data.stats.hatched + 1
	self:_buildVisual(player, entry)
	S.EconomyService:recompute(player)
	S.BaseService:refresh(player)
	S.PlayerDataService:markDirty(player)
	local def = Config.Disasters[entry.d]
	local title = isNew and "NEW DISASTER!" or "HATCHED!"
	local sub = def.name .. (mutation and (" • " .. mutation) or "") .. " • " .. Util.formatMoney(EconomyLogic.incomeFor(entry)) .. "/s"
	Remotes.get("Announce"):FireClient(player, { kind = "hatch", title = title, subtitle = sub, color = Config.Rarities[def.rarity].color, disaster = entry.d, mutation = mutation })
	return true, entry
end

function DisasterCollectionService:sell(player, slot)
	if not sellLimiter:allow(player) then
		return false
	end
	local data = S.PlayerDataService:get(player)
	if not data then
		return false
	end
	local entry, idx = DataSchema.findBySlot(data.disasters, slot)
	if not entry then
		return false
	end
	local value = EconomyLogic.valueFor(entry)
	table.remove(data.disasters, idx)
	self:_clearVisual(player, slot)
	S.EconomyService:addMoney(player, value, "sell")
	S.EconomyService:recompute(player)
	S.BaseService:refresh(player)
	S.IncubatorService:tryHatchAll(player)
	S.PlayerDataService:notify(player, "Sold " .. Config.Disasters[entry.d].name .. " for " .. Util.formatMoney(value), "success")
	return true, value
end

function DisasterCollectionService:Start()
	S.PlayerDataService.Loaded:Connect(function(player)
		self:rebuildAll(player)
		S.EconomyService:recompute(player)
		S.BaseService:refresh(player)
	end)
	S.PlayerDataService.Releasing:Connect(function(player)
		self:clearAll(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:clearAll(player)
	end)
end

return DisasterCollectionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--[[
	EconomyService — passive income and all money mutations.

	Income is paid once per second from the disasters on display. All money
	changes go through addMoney/trySpend so they are validated in one place.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyLogic = require(Shared.Logic.EconomyLogic)
local MonetizationLogic = require(Shared.Logic.MonetizationLogic)
local Util = require(Shared.Util)

local EconomyService = { Name = "EconomyService" }

local S
local incomeCache = {}

function EconomyService:Init(registry)
	S = registry
end

function EconomyService:incomeOf(player)
	return incomeCache[player] or 0
end

function EconomyService:recompute(player)
	local data = S.PlayerDataService:get(player)
	if not data then
		incomeCache[player] = 0
		return 0
	end
	local inc = EconomyLogic.totalIncome(data.disasters) * MonetizationLogic.incomeMultiplier(data)
	incomeCache[player] = inc
	player:SetAttribute("Income", inc)
	return inc
end

function EconomyService:addMoney(player, amount, reason)
	local data = S.PlayerDataService:get(player)
	if not data or not Util.isFiniteNumber(amount) or amount < 0 then
		return false
	end
	data.money = data.money + amount
	S.PlayerDataService:markDirty(player)
	self:_updateStats(player, data)
	return true
end

function EconomyService:trySpend(player, amount)
	local data = S.PlayerDataService:get(player)
	if not data or not Util.isFiniteNumber(amount) or amount < 0 then
		return false
	end
	if data.money < amount then
		return false
	end
	data.money = data.money - amount
	S.PlayerDataService:markDirty(player)
	self:_updateStats(player, data)
	return true
end

function EconomyService:_ensureStats(player)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local money = Instance.new("StringValue")
		money.Name = "Cash"
		money.Parent = ls
		local speed = Instance.new("StringValue")
		speed.Name = "Speed"
		speed.Parent = ls
		ls.Parent = player
	end
	return ls
end

function EconomyService:_updateStats(player, data)
	local ls = self:_ensureStats(player)
	ls.Cash.Value = Util.formatMoney(data.money)
	ls.Speed.Value = Util.formatNumber(data.speed)
end

function EconomyService:Start()
	S.PlayerDataService.Loaded:Connect(function(player, data)
		self:recompute(player)
		self:_updateStats(player, data)
	end)
	Players.PlayerRemoving:Connect(function(p)
		incomeCache[p] = nil
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 1 then
			return
		end
		local elapsed = math.min(acc, 5)
		acc = 0
		for _, player in ipairs(S.PlayerDataService:loadedPlayers()) do
			local inc = incomeCache[player] or self:recompute(player)
			if inc > 0 then
				self:addMoney(player, inc * elapsed, "income")
			end
		end
	end)
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--[[
	EventService — the 5-minute world refresh and the 10-second Chaos Frenzy.

	Timeline (EventLogic): Normal → Warning (last 30 s) → refresh + Frenzy (10 s).
	On refresh, only *temporary world opportunities* (uncarried nest cores) are
	rerolled. Player money, cores, pods and disasters are never touched.

	Replicated state lives in ReplicatedStorage attributes so clients can show
	countdowns without extra traffic:
	  EventPhase      "Normal" | "Warning" | "Frenzy"
	  NextRefreshAt   server time (workspace:GetServerTimeNow()) of the next refresh
	  FrenzyEndsAt    server time when the current frenzy ends (0 otherwise)
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local EventLogic = require(Shared.Logic.EventLogic)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)

local EventService = { Name = "EventService" }
EventService.PhaseChanged = Signal.new() -- (newPhase, oldPhase, info)
EventService.Refreshed = Signal.new() -- (cycle)

local S
local startClock
local phase = "Normal"
local lastCycle = 0
local forcedOffset = 0

function EventService:Init(registry)
	S = registry
	startClock = os.clock()
end

function EventService:elapsed()
	return os.clock() - startClock + forcedOffset
end

function EventService:phase()
	return phase
end

function EventService:isFrenzy()
	return phase == "Frenzy"
end

function EventService:incubationRate()
	return phase == "Frenzy" and Config.Events.FrenzyIncubationMult or 1
end

function EventService:mutationMult()
	return phase == "Frenzy" and Config.Events.FrenzyMutationMult or 1
end

-- Debug/test helper: jump the cycle clock forward by `seconds`.
function EventService:skip(seconds)
	forcedOffset = forcedOffset + seconds
end

local function announceAll(payload)
	Remotes.get("Announce"):FireAllClients(payload)
end

function EventService:_publish(info)
	local now = workspace:GetServerTimeNow()
	ReplicatedStorage:SetAttribute("EventPhase", info.phase)
	ReplicatedStorage:SetAttribute("NextRefreshAt", now + info.toRefresh)
	ReplicatedStorage:SetAttribute("FrenzyEndsAt", info.phase == "Frenzy" and (now + info.frenzyLeft) or 0)
end

function EventService:_tick()
	local info = EventLogic.phaseAt(self:elapsed())
	if info.cycle > lastCycle then
		-- refresh exactly once per cycle boundary, even if several were skipped
		lastCycle = info.cycle
		self.Refreshed:Fire(info.cycle)
	end
	if info.phase ~= phase then
		local old = phase
		phase = info.phase
		self:_publish(info)
		if phase == "Warning" then
			announceAll({
				kind = "warning",
				title = "CHAOS FRENZY INCOMING",
				subtitle = "Cores refresh in " .. Config.Events.Warning .. "s — get in position!",
				color = { 255, 90, 220 },
			})
		elseif phase == "Frenzy" then
			announceAll({
				kind = "frenzy",
				title = "⚡ CHAOS FRENZY! ⚡",
				subtitle = "Rare cores everywhere • Chaos Cores spawned • Incubation x" .. Config.Events.FrenzyIncubationMult,
				color = { 255, 60, 230 },
			})
		elseif old == "Frenzy" then
			announceAll({ kind = "info", title = "FRENZY OVER", subtitle = "Next frenzy in 5:00", color = { 200, 200, 255 } })
		end
		self.PhaseChanged:Fire(phase, old, info)
	end
	return info
end

function EventService:Start()
	self:_publish(EventLogic.phaseAt(0))
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.1 then
			return
		end
		acc = 0
		self:_tick()
	end)
	-- re-publish periodically so late joiners & drift stay correct
	task.spawn(function()
		while true do
			task.wait(5)
			self:_publish(EventLogic.phaseAt(self:elapsed()))
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">GuardianService</string><ProtectedString name="Source"><![CDATA[--[[
	GuardianService — one guardian per zone protecting its nest.

	State machine (server-side, anchored models moved by PivotTo):
	  Sleep  → snoozes on the nest (💤). Wakes on its timer, or shortly after a
	           core is stolen ("alert").
	  Patrol → circles the nest; looks for players CARRYING a core within its
	           aggro radius and inside its leash.
	  Chase  → runs at 0.78 x the zone's gate WalkSpeed. Touching the carrier
	           knocks them back and returns their cores to the source.
	  Return → walks back to the nest after a tag or when the target escapes.
	Guardians ignore players who are only exploring.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local SpeedLogic = require(Shared.Logic.SpeedLogic)
local Kit = require(Shared.Models.Kit)
local Remotes = require(Shared.Remotes)

local okModels, GuardianModels = pcall(function()
	return require(Shared.Models.GuardianModels)
end)
if not okModels then
	GuardianModels = nil
end

local GuardianService = { Name = "GuardianService" }

local G = Config.Guardian
local ACTIVE_RANGE = 320
local S
local guardians = {} -- [zoneIndex] = g

function GuardianService:Init(registry)
	S = registry
end

local function fallbackModel(zoneIndex)
	local m = Instance.new("Model")
	m.Name = "Guardian"
	local root = Kit.part(m, { name = "Root", size = Vector3.new(1, 1, 1), transparency = 1, collide = false })
	m.PrimaryPart = root
	Kit.part(m, { name = "Body", size = Vector3.new(8, 8, 10), cf = CFrame.new(0, 6, 0), color = { 90, 90, 100 }, material = Enum.Material.Slate, collide = false })
	Kit.part(m, { name = "Head", size = Vector3.new(5, 5, 5), cf = CFrame.new(0, 12, -4), color = { 110, 110, 120 }, material = Enum.Material.Slate, collide = false })
	for _, x in ipairs({ -1.2, 1.2 }) do
		Kit.ball(m, { name = "Eye", diameter = 1, cf = CFrame.new(x, 12.6, -6.6), color = { 255, 60, 60 }, material = Enum.Material.Neon, collide = false })
	end
	return m
end

local function build(zoneIndex)
	local zone = Config.Zones[zoneIndex]
	local m
	if GuardianModels then
		local ok, res = pcall(GuardianModels.build, zone.guardian.kind, zoneIndex)
		if ok and res then
			m = res
		else
			warn("[Guardian] build failed for " .. zone.guardian.kind .. ": " .. tostring(res))
		end
	end
	m = m or fallbackModel(zoneIndex)
	m.Name = zone.guardian.name
	Kit.setCollide(m, false)
	Kit.setAnchored(m, true)
	local head = m:FindFirstChild("Head", true) or m.PrimaryPart
	local bb = Kit.billboard(head, { name = "GuardianLabel", size = UDim2.new(0, 220, 0, 60), offset = Vector3.new(0, 5, 0), maxDistance = 160 })
	local nameLabel = Kit.text(bb, { name = "Name", text = zone.guardian.name, size = UDim2.new(1, 0, 0.55, 0), color = { 255, 120, 90 }, font = Enum.Font.LuckiestGuy })
	local stateLabel = Kit.text(bb, { name = "State", text = "", size = UDim2.new(1, 0, 0.45, 0), position = UDim2.new(0, 0, 0.55, 0), color = { 255, 255, 255 } })
	return m, stateLabel
end

local STATE_TEXT = {
	Sleep = "💤 sleeping...",
	Patrol = "👀 on patrol",
	Chase = "❗ CHASING ❗",
	Return = "returning to nest",
}

function GuardianService:_setState(g, st)
	if g.state == st then
		return
	end
	g.state = st
	g.stateTime = 0
	g.label.Text = STATE_TEXT[st] or ""
	g.model:SetAttribute("State", st)
	if st == "Sleep" then
		g.timer = G.SleepTime
	elseif st == "Patrol" then
		g.timer = G.AwakeTime
	end
end

function GuardianService:alert(zoneIndex, player)
	local g = guardians[zoneIndex]
	if not g then
		return
	end
	if g.state == "Sleep" then
		g.timer = math.min(g.timer, 1.2)
	end
	g.lastThief = player
end

function GuardianService:get(zoneIndex)
	return guardians[zoneIndex]
end

-- Admin/test switch: a disabled guardian sleeps on its nest and never chases.
function GuardianService:setEnabled(zoneIndex, enabled)
	local g = guardians[zoneIndex]
	if not g then
		return
	end
	g.disabled = not enabled
	if g.disabled then
		self:_setState(g, "Sleep")
	end
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function GuardianService:_findTarget(g)
	local best, bestDist
	for _, p in ipairs(Players:GetPlayers()) do
		if S.CarryService:isCarrying(p) then
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = (flat(hrp.Position) - flat(g.pos)).Magnitude
				local fromNest = (flat(hrp.Position) - flat(g.nest)).Magnitude
				if d <= G.AggroRadius and fromNest <= G.LeashRadius and (not bestDist or d < bestDist) then
					best, bestDist = p, d
				end
			end
		end
	end
	return best
end

function GuardianService:_moveToward(g, target, speed, dt)
	local delta = flat(target) - flat(g.pos)
	local dist = delta.Magnitude
	if dist < 0.05 then
		return 0
	end
	local stepLen = math.min(dist, speed * dt)
	local dir = delta / dist
	g.pos = g.pos + dir * stepLen
	g.facing = dir
	return dist - stepLen
end

function GuardianService:_tag(g, player)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	S.CarryService:dropAll(player, "guardian")
	if hrp then
		local away = flat(hrp.Position) - flat(g.pos)
		if away.Magnitude < 0.1 then
			away = Vector3.new(0, 0, -1)
		end
		local vel = away.Unit * G.KnockbackForce + Vector3.new(0, 45, 0)
		hrp.AssemblyLinearVelocity = vel
		-- the client owns its character's physics, so it applies the knockback too
		Remotes.get("Effect"):FireClient(player, "knockback", vel)
	end
	g.tagCooldown = G.TagCooldown
	self:_setState(g, "Return")
end

function GuardianService:_step(g, dt)
	if g.disabled then
		return
	end
	g.stateTime = g.stateTime + dt
	if g.tagCooldown > 0 then
		g.tagCooldown = g.tagCooldown - dt
	end
	if g.state == "Sleep" then
		g.timer = g.timer - dt
		if g.timer <= 0 then
			self:_setState(g, "Patrol")
		end
	elseif g.state == "Patrol" then
		g.angle = g.angle + dt * (G.PatrolSpeed / 18)
		local target = g.nest + Vector3.new(math.cos(g.angle) * 18, 0, math.sin(g.angle) * 18)
		self:_moveToward(g, target, G.PatrolSpeed, dt)
		g.timer = g.timer - dt
		local victim = g.tagCooldown <= 0 and self:_findTarget(g) or nil
		if victim then
			g.target = victim
			self:_setState(g, "Chase")
		elseif g.timer <= 0 then
			self:_setState(g, "Sleep")
		end
	elseif g.state == "Chase" then
		local p = g.target
		local hrp = p and p.Parent == Players and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or not S.CarryService:isCarrying(p) then
			self:_setState(g, "Return")
		else
			local fromNest = (flat(hrp.Position) - flat(g.nest)).Magnitude
			if fromNest > G.LeashRadius + 6 then
				self:_setState(g, "Return")
			else
				local remaining = self:_moveToward(g, hrp.Position, g.chaseSpeed, dt)
				if remaining <= G.TagRange then
					self:_tag(g, p)
				end
			end
		end
	elseif g.state == "Return" then
		local remaining = self:_moveToward(g, g.nest + Vector3.new(18, 0, 0), G.PatrolSpeed * 1.6, dt)
		local victim = g.tagCooldown <= 0 and self:_findTarget(g) or nil
		if victim then
			g.target = victim
			self:_setState(g, "Chase")
		elseif remaining < 1 then
			g.angle = 0
			self:_setState(g, "Patrol")
		end
	end
	local look = g.facing or Vector3.new(0, 0, -1)
	g.model:PivotTo(CFrame.lookAt(g.pos, g.pos + look))
end

function GuardianService:Start()
	local folder = Instance.new("Folder")
	folder.Name = "Guardians"
	folder.Parent = workspace:WaitForChild("World")
	for i, zone in ipairs(Config.Zones) do
		local refs = S.ZoneService:zoneRefs(i)
		local model, label = build(i)
		local nest = Vector3.new(refs.nestCenter.X, 0.6, refs.nestCenter.Z)
		local g = {
			zoneIndex = i,
			model = model,
			label = label,
			nest = nest,
			pos = nest + Vector3.new(18, 0, 0),
			angle = 0,
			facing = Vector3.new(0, 0, -1),
			state = "",
			stateTime = 0,
			timer = 0,
			tagCooldown = 0,
			chaseSpeed = math.max(14, zone.guardian.speedFactor * SpeedLogic.walkSpeedFor(zone.speedReq)),
		}
		model:SetAttribute("ZoneIndex", i)
		model:SetAttribute("ChaseSpeed", g.chaseSpeed)
		model:PivotTo(CFrame.new(g.pos))
		model.Parent = folder
		guardians[i] = g
		-- stagger sleep cycles so zones feel different
		self:_setState(g, (i % 2 == 0) and "Sleep" or "Patrol")
		g.timer = g.timer * (0.4 + (i % 3) * 0.3)
	end
	-- ~30 Hz, and only zones with a player nearby (saves replication bandwidth)
	local acc = 0
	local activeCheck = 0
	local active = {}
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		activeCheck = activeCheck - dt
		if acc < 1 / 30 then
			return
		end
		local step = math.min(acc, 0.1)
		acc = 0
		if activeCheck <= 0 then
			activeCheck = 0.5
			for i, g in pairs(guardians) do
				active[i] = false
				for _, p in ipairs(Players:GetPlayers()) do
					local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					if hrp and (flat(hrp.Position) - flat(g.nest)).Magnitude < ACTIVE_RANGE then
						active[i] = true
						break
					end
				end
			end
		end
		for i, g in pairs(guardians) do
			if active[i] or g.state == "Chase" or g.state == "Return" then
				self:_step(g, step)
			end
		end
	end)
end

return GuardianService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">IncubatorService</string><ProtectedString name="Source"><![CDATA[--[[
	IncubatorService — pods at each base turn cores into disasters.

	* receive(player, entry) puts a delivered core into the first free pod, or
	  into storage (shown on the base sign) when all pods are busy.
	* Pods advance every tick at EventService:incubationRate() (x4 in Frenzy),
	  and offline time (capped) is applied on join.
	* When a pod finishes, DisasterCollectionService places the disaster on a
	  free pedestal. If none is free the pod waits in a "READY" state.
	* Visible in the world: the core floats inside the glass capsule, a neon
	  fill rises with progress, and a billboard shows name, rarity and time left.
	* Theft: beginTransit / cancelTransit / completeTransit. A pod in transit is
	  frozen and shows "STOLEN!"; ownership moves only on completeTransit.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local IncubatorLogic = require(Shared.Logic.IncubatorLogic)
local DataSchema = require(Shared.Logic.DataSchema)
local Util = require(Shared.Util)
local Kit = require(Shared.Models.Kit)
local CoreModels = require(Shared.Models.CoreModels)

local IncubatorService = { Name = "IncubatorService" }

local S
local transit = {} -- [victim] = { [podSlot] = thief }
local visuals = {} -- [player] = { [podSlot] = { model, label, ... } }
local promptsWired = false

local TICK = 0.25
local FILL_MAX = 6.6

function IncubatorService:Init(registry)
	S = registry
end

local function podsOf(player)
	local data = S.PlayerDataService:get(player)
	return data and data.pods or nil, data
end

function IncubatorService:isInTransit(player, slot)
	return transit[player] ~= nil and transit[player][slot] ~= nil
end

function IncubatorService:freePods(player)
	local data = S.PlayerDataService:get(player)
	if not data then
		return 0
	end
	return data.upgrades.Pods - #data.pods
end

function IncubatorService:hasRoom(player, incoming)
	local data = S.PlayerDataService:get(player)
	if not data then
		return false
	end
	local room = (data.upgrades.Pods - #data.pods) + (Config.Data.MaxStoredCores - #data.storage)
	return room >= (incoming or 1)
end

-- Visuals ---------------------------------------------------------------------
local function unitFor(player, slot)
	local base = S.BaseService:baseOf(player)
	return base and base.pods[slot] or nil
end

-- Instant Hatch prompt: only while the pod is incubating and not being stolen
-- (the client shows it only on its own base).
local function setHatchPrompt(unit, on)
	local prompt = unit and unit.root:FindFirstChild("HatchPrompt")
	if prompt and prompt.Enabled ~= on then
		prompt.Enabled = on
	end
end

function IncubatorService:_clearVisual(player, slot)
	local v = visuals[player] and visuals[player][slot]
	if v then
		if v.model then
			v.model:Destroy()
		end
		if v.label then
			v.label:Destroy()
		end
		visuals[player][slot] = nil
	end
	local unit = unitFor(player, slot)
	if unit then
		unit.fill.Size = Vector3.new(0.05, unit.fill.Size.Y, unit.fill.Size.Z)
		unit.fill.CFrame = CFrame.new(unit.basePos + Vector3.new(0, 1.45, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		local prompt = unit.root:FindFirstChild("PodStealPrompt")
		if prompt then
			prompt.Enabled = false
		end
		setHatchPrompt(unit, false)
	end
end

function IncubatorService:_buildVisual(player, pod)
	self:_clearVisual(player, pod.s)
	local unit = unitFor(player, pod.s)
	if not unit then
		return
	end
	visuals[player] = visuals[player] or {}
	local m = CoreModels.build(pod.c, pod.m, 1.1)
	m:PivotTo(unit.anchor)
	m:AddTag("Animated")
	m.Parent = unit.model
	local def = Config.Cores[pod.c]
	local rarity = Config.Rarities[def.rarity]
	local bb = Kit.billboard(unit.root, { name = "PodLabel", size = UDim2.new(0, 170, 0, 74), offset = Vector3.new(0, 10.5, 0), maxDistance = 80 })
	local name = Kit.text(bb, { name = "Name", text = def.name, size = UDim2.new(1, 0, 0.34, 0), color = rarity.color, font = Enum.Font.LuckiestGuy })
	local timer = Kit.text(bb, { name = "Timer", text = "", size = UDim2.new(1, 0, 0.3, 0), position = UDim2.new(0, 0, 0.34, 0), color = { 255, 255, 255 } })
	local barBg = Instance.new("Frame")
	barBg.Name = "BarBg"
	barBg.Size = UDim2.new(0.8, 0, 0.18, 0)
	barBg.Position = UDim2.new(0.1, 0, 0.74, 0)
	barBg.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	barBg.BorderSizePixel = 0
	barBg.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(10, 10, 15)
	stroke.Parent = barBg
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.Size = UDim2.new(0, 0, 1, 0)
	bar.BackgroundColor3 = Kit.rgb(rarity.color)
	bar.BorderSizePixel = 0
	bar.Parent = barBg
	unit.fill.Color = Kit.rgb(def.colors[3])
	visuals[player][pod.s] = { model = m, label = bb, timer = timer, bar = bar, name = name }
	local prompt = unit.root:FindFirstChild("PodStealPrompt")
	if prompt then
		prompt.Enabled = true
		prompt.ObjectText = def.name
	end
	self:_updateVisual(player, pod)
end

function IncubatorService:_updateVisual(player, pod)
	local v = visuals[player] and visuals[player][pod.s]
	local unit = unitFor(player, pod.s)
	if not v or not unit then
		return
	end
	local frac = IncubatorLogic.fraction(pod)
	local h = math.max(0.05, FILL_MAX * frac)
	unit.fill.Size = Vector3.new(h, unit.fill.Size.Y, unit.fill.Size.Z)
	unit.fill.CFrame = CFrame.new(unit.basePos + Vector3.new(0, 1.45 + h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	v.bar.Size = UDim2.new(frac, 0, 1, 0)
	setHatchPrompt(unit, frac < 1 and not self:isInTransit(player, pod.s))
	if self:isInTransit(player, pod.s) then
		v.timer.Text = "STOLEN! CHASE THEM!"
		v.timer.TextColor3 = Color3.fromRGB(255, 80, 80)
		v.model.Parent = nil
	else
		if v.model.Parent == nil then
			v.model.Parent = unit.model
		end
		v.timer.TextColor3 = Color3.fromRGB(255, 255, 255)
		if frac >= 1 then
			v.timer.Text = "READY • need a free pedestal"
		else
			local rate = S.EventService:incubationRate()
			local t = Util.formatTime(IncubatorLogic.remaining(pod) / rate)
			v.timer.Text = (rate > 1) and ("⚡ " .. t .. " (x" .. rate .. ")") or t
		end
	end
end

function IncubatorService:rebuildAll(player)
	local pods = podsOf(player)
	if not pods then
		return
	end
	for _, pod in ipairs(pods) do
		self:_buildVisual(player, pod)
	end
end

function IncubatorService:clearAll(player)
	if visuals[player] then
		for slot in pairs(visuals[player]) do
			self:_clearVisual(player, slot)
		end
	end
	visuals[player] = nil
end

-- Pod data --------------------------------------------------------------------
function IncubatorService:receive(player, entry)
	local data = S.PlayerDataService:get(player)
	if not data then
		return nil
	end
	local slot = DataSchema.freeSlot(data.pods, data.upgrades.Pods)
	if slot then
		local pod = { s = slot, c = entry.c, m = entry.m, z = entry.z or 1, p = entry.p or 0 }
		table.insert(data.pods, pod)
		self:_buildVisual(player, pod)
		S.PlayerDataService:markDirty(player)
		self:_tryHatch(player, pod)
		return "pod"
	end
	if #data.storage < Config.Data.MaxStoredCores then
		table.insert(data.storage, { c = entry.c, m = entry.m, z = entry.z or 1 })
		S.PlayerDataService:markDirty(player)
		S.PlayerDataService:notify(player, "All pods busy — core stored (" .. #data.storage .. " waiting).", "info")
		return "storage"
	end
	return nil
end

-- Move stored cores into free pods.
function IncubatorService:fillFromStorage(player)
	local data = S.PlayerDataService:get(player)
	if not data then
		return
	end
	while #data.storage > 0 do
		local slot = DataSchema.freeSlot(data.pods, data.upgrades.Pods)
		if not slot then
			break
		end
		local entry = table.remove(data.storage, 1)
		local pod = { s = slot, c = entry.c, m = entry.m, z = entry.z, p = 0 }
		table.insert(data.pods, pod)
		self:_buildVisual(player, pod)
	end
	S.PlayerDataService:markDirty(player)
end

function IncubatorService:_removePod(player, slot)
	local data = S.PlayerDataService:get(player)
	if not data then
		return nil
	end
	local pod, idx = DataSchema.findBySlot(data.pods, slot)
	if not pod then
		return nil
	end
	table.remove(data.pods, idx)
	self:_clearVisual(player, slot)
	S.PlayerDataService:markDirty(player)
	return pod
end

function IncubatorService:_tryHatch(player, pod)
	if self:isInTransit(player, pod.s) then
		return false
	end
	if IncubatorLogic.fraction(pod) < 1 then
		return false
	end
	local ok = S.DisasterCollectionService:place(player, pod)
	if ok then
		self:_removePod(player, pod.s)
		self:fillFromStorage(player)
	end
	return ok
end

function IncubatorService:tryHatchAll(player)
	local pods = podsOf(player)
	if not pods then
		return
	end
	local list = {}
	for _, p in ipairs(pods) do
		table.insert(list, p)
	end
	for _, p in ipairs(list) do
		self:_tryHatch(player, p)
	end
end

-- Instant Hatch: complete one pod exactly as if its timer ran out. The normal
-- hatch path then rolls mutation and places the disaster, so rarity, mutation
-- chance and value are unchanged.
function IncubatorService:finishPod(player, pod)
	if not pod or self:isInTransit(player, pod.s) then
		return false
	end
	pod.p = IncubatorLogic.incubationTime(pod.c, pod.z)
	self:_updateVisual(player, pod)
	S.PlayerDataService:markDirty(player)
	self:_tryHatch(player, pod)
	return true
end

function IncubatorService:onCapacityChanged(player)
	self:fillFromStorage(player)
	self:tryHatchAll(player)
end

-- Theft -------------------------------------------------------------------------
function IncubatorService:beginTransit(victim, slot, thief)
	local data = S.PlayerDataService:get(victim)
	if not data then
		return nil
	end
	local pod = DataSchema.findBySlot(data.pods, slot)
	if not pod or self:isInTransit(victim, slot) then
		return nil
	end
	transit[victim] = transit[victim] or {}
	transit[victim][slot] = thief
	self:_updateVisual(victim, pod)
	local unit = unitFor(victim, slot)
	local prompt = unit and unit.root:FindFirstChild("PodStealPrompt")
	if prompt then
		prompt.Enabled = false
	end
	return { c = pod.c, m = pod.m, z = pod.z, p = pod.p }
end

function IncubatorService:cancelTransit(victim, slot)
	if not transit[victim] or not transit[victim][slot] then
		return
	end
	transit[victim][slot] = nil
	local data = S.PlayerDataService:get(victim)
	local pod = data and DataSchema.findBySlot(data.pods, slot)
	if pod then
		self:_updateVisual(victim, pod)
		local unit = unitFor(victim, slot)
		local prompt = unit and unit.root:FindFirstChild("PodStealPrompt")
		if prompt then
			prompt.Enabled = true
		end
		self:_tryHatch(victim, pod)
	end
end

function IncubatorService:completeTransit(victim, slot)
	if not transit[victim] or not transit[victim][slot] then
		return nil
	end
	transit[victim][slot] = nil
	local pod = self:_removePod(victim, slot)
	if pod then
		self:fillFromStorage(victim)
		return { c = pod.c, m = pod.m, z = pod.z, p = pod.p }
	end
	return nil
end

-- Steal prompts on every pod of every base (owner check happens in StealService;
-- the client hides prompts on its own base).
function IncubatorService:_wirePrompts()
	if promptsWired then
		return
	end
	promptsWired = true
	for slot = 1, #Config.Bases.Slots do
		local base = S.BaseService:base(slot)
		for i, unit in ipairs(base.pods) do
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "PodStealPrompt"
			prompt.ActionText = "Steal"
			prompt.ObjectText = "Core"
			prompt.HoldDuration = Config.Bases.StealHoldTime
			prompt.MaxActivationDistance = 9
			prompt.RequiresLineOfSight = false
			prompt.Enabled = false
			prompt:SetAttribute("BaseSlot", slot)
			prompt.Parent = unit.root
			prompt.Triggered:Connect(function(thief)
				S.StealService:tryStealFromBase(thief, slot, i)
			end)
			local hatch = Instance.new("ProximityPrompt")
			hatch.Name = "HatchPrompt"
			hatch.ActionText = "Instant Hatch"
			hatch.ObjectText = "🥚 Finish this pod now"
			hatch.HoldDuration = 0
			hatch.MaxActivationDistance = 8
			hatch.RequiresLineOfSight = false
			hatch.Enabled = false
			hatch:SetAttribute("BaseSlot", slot)
			hatch:SetAttribute("OwnerOnly", true)
			hatch:SetAttribute("Range", 8)
			hatch.Parent = unit.root
			hatch.Triggered:Connect(function(player)
				if S.BaseService:slotOf(player) == slot and S.MonetizationService then
					S.MonetizationService:requestPurchase(player, "InstantHatch", { podSlot = i })
				end
			end)
		end
	end
end

function IncubatorService:Start()
	self:_wirePrompts()
	S.PlayerDataService.Loaded:Connect(function(player, data, offline)
		if offline and offline > 0 then
			for _, pod in ipairs(data.pods) do
				IncubatorLogic.advance(pod, offline, 1)
			end
		end
		self:fillFromStorage(player)
		self:rebuildAll(player)
		self:tryHatchAll(player)
	end)
	S.PlayerDataService.Releasing:Connect(function(player)
		-- any thief carrying this player's core loses it (CarryService handles the
		-- thief side); clear runtime-only state
		transit[player] = nil
		self:clearAll(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		transit[player] = nil
		self:clearAll(player)
		-- thieves who were robbing others keep nothing in transit tables here
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < TICK then
			return
		end
		local step = acc
		acc = 0
		local rate = S.EventService:incubationRate()
		for _, player in ipairs(S.PlayerDataService:loadedPlayers()) do
			local pods = podsOf(player)
			local list = {}
			for _, p in ipairs(pods) do
				table.insert(list, p)
			end
			for _, pod in ipairs(list) do
				if not self:isInTransit(player, pod.s) then
					local wasDone = IncubatorLogic.fraction(pod) >= 1
					local done = IncubatorLogic.advance(pod, step, rate)
					if done then
						self:_tryHatch(player, pod)
					end
					if not wasDone then
						self:_updateVisual(player, pod)
					end
				end
			end
		end
	end)
end

-- test hooks
function IncubatorService:_transit()
	return transit
end

return IncubatorService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--[[
	MonetizationService — Game Passes and Developer Products (server only).

	Developer Products are granted ONLY in MarketplaceService.ProcessReceipt:
	  * unknown player / data not loaded / unsaved session -> NotProcessedYet
	    (Roblox retries later, e.g. when the player rejoins);
	  * PurchaseId already recorded -> PurchaseGranted without granting again;
	  * otherwise grant, record the PurchaseId in the player's saved data, save,
	    and only then return PurchaseGranted. If the save fails we return
	    NotProcessedYet; the retry finds the recorded PurchaseId and does not
	    grant twice.

	Game Passes are verified with UserOwnsGamePassAsync on join and cached in
	saved data, so the entitlement survives reconnects and API outages.

	The RequestPurchase remote never grants anything on a live server: it only
	opens Roblox's purchase prompt. In Studio, items whose id is still 0 use a
	mock purchase that runs the same grant code (no Robux involved).
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local MConfig = require(Shared.Config.MonetizationConfig)
local MonetizationLogic = require(Shared.Logic.MonetizationLogic)
local EconomyLogic = require(Shared.Logic.EconomyLogic)
local RateLimiter = require(Shared.Logic.RateLimiter)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local MonetizationService = { Name = "MonetizationService" }

local S
local limiter
local productKeyById = {}
local passKeyById = {}
local pendingHatch = {} -- [player] = podSlot the player asked to hatch
local mockCounter = 0

function MonetizationService:Init(registry)
	S = registry
	limiter = RateLimiter.new(1, 3)
	productKeyById = MonetizationLogic.keysById("DeveloperProduct")
	passKeyById = MonetizationLogic.keysById("GamePass")
end

function MonetizationService:mockEnabled()
	return MConfig.MockInStudio == true and RunService:IsStudio()
end

local function notify(player, text, kind)
	S.PlayerDataService:notify(player, text, kind or "success")
end

function MonetizationService:_applyEffects(player)
	local data = S.PlayerDataService:get(player)
	if not data then
		return
	end
	player:SetAttribute("SpeedMult", MonetizationLogic.speedMultiplier(data))
	player:SetAttribute("BoostSeconds", math.ceil(data.boostSpeed or 0))
	S.EconomyService:recompute(player)
	S.BaseService:refresh(player)
	S.PlayerDataService:markDirty(player)
end

-- Game Passes -------------------------------------------------------------------
function MonetizationService:owns(player, key)
	return MonetizationLogic.owns(S.PlayerDataService:get(player), key)
end

function MonetizationService:grantPass(player, key)
	local data = S.PlayerDataService:get(player)
	local item = MConfig.Items[key]
	if not data or not item or item.type ~= "GamePass" or data.passes[key] then
		return false
	end
	data.passes[key] = true
	self:_applyEffects(player)
	notify(player, item.icon .. " " .. item.name .. " unlocked! " .. item.benefit .. ".")
	return true
end

-- Re-check every configured pass with Roblox. A failed API call keeps the
-- cached entitlement; a successful "not owned" (e.g. refund) removes it.
function MonetizationService:refreshPasses(player)
	for key, item in pairs(MConfig.Items) do
		if item.type == "GamePass" and item.id > 0 then
			local ok, owned = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, item.id)
			end)
			local data = S.PlayerDataService:get(player)
			if player.Parent ~= Players or not data then
				return
			end
			if ok then
				data.passes[key] = owned == true or nil
			end
		end
	end
	self:_applyEffects(player)
end

-- Developer Products ------------------------------------------------------------
function MonetizationService:_instantHatch(player, preferredSlot)
	local data = S.PlayerDataService:get(player)
	local pod = MonetizationLogic.pickHatchPod(data.pods, preferredSlot, function(slot)
		return S.IncubatorService:isInTransit(player, slot)
	end)
	if pod and S.IncubatorService:finishPod(player, pod) then
		notify(player, "🥚 Instant Hatch! " .. Config.Cores[pod.c].name .. " is done.")
		return true
	end
	-- nothing to hatch right now: keep it as a credit so the purchase is never lost
	data.hatchCredits = data.hatchCredits + 1
	S.PlayerDataService:markDirty(player)
	notify(player, "🥚 No pod was incubating — your Instant Hatch is saved for later.", "info")
	return true
end

-- Apply one Developer Product. Must not yield (it runs before the receipt is recorded).
function MonetizationService:grantProduct(player, key)
	local data = S.PlayerDataService:get(player)
	local item = MConfig.Items[key]
	if not data or not item or item.type ~= "DeveloperProduct" then
		return false
	end
	if key == "InstantHatch" then
		local slot = pendingHatch[player]
		pendingHatch[player] = nil
		return self:_instantHatch(player, slot)
	elseif key == "SpeedBoost" then
		data.boostSpeed = (data.boostSpeed or 0) + item.durationSeconds
		self:_applyEffects(player)
		notify(player, "⚡ Speed Boost active: x" .. MonetizationLogic.speedMultiplier(data) .. " treadmill Speed for " .. Util.formatTime(data.boostSpeed) .. ".")
		return true
	elseif key == "CashPack" then
		local amount = MonetizationLogic.cashPackAmount(EconomyLogic.totalIncome(data.disasters), data.speed)
		S.EconomyService:addMoney(player, amount, "cashpack")
		notify(player, "💵 Cash Pack: +" .. Util.formatMoney(amount) .. "!")
		return true
	end
	return false
end

-- Shared by ProcessReceipt and the Studio mock. Returns a ProductPurchaseDecision.
function MonetizationService:_grantReceipt(player, key, purchaseId)
	local NOT_YET = Enum.ProductPurchaseDecision.NotProcessedYet
	local data = S.PlayerDataService:get(player)
	if not data or not S.PlayerDataService:canGrantPurchases(player) then
		return NOT_YET
	end
	if MonetizationLogic.hasReceipt(data.receipts, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local ok, granted = pcall(self.grantProduct, self, player, key)
	if not ok or not granted then
		warn("[Monetization] could not grant " .. tostring(key) .. " to " .. player.Name .. ": " .. tostring(granted))
		return NOT_YET
	end
	-- recorded in the same data document as the reward, so they persist together
	MonetizationLogic.addReceipt(data.receipts, purchaseId)
	S.PlayerDataService:markDirty(player)
	if not S.PlayerDataService:saveForReceipt(player) then
		return NOT_YET
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService:processReceipt(receipt)
	local NOT_YET = Enum.ProductPurchaseDecision.NotProcessedYet
	if type(receipt) ~= "table" or receipt.PurchaseId == nil then
		return NOT_YET
	end
	local key = productKeyById[receipt.ProductId]
	if not key then
		warn("[Monetization] receipt for unknown product " .. tostring(receipt.ProductId))
		return NOT_YET
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return NOT_YET
	end
	return self:_grantReceipt(player, key, tostring(receipt.PurchaseId))
end

-- Purchase requests (prompts) ------------------------------------------------------
-- Opens Roblox's purchase prompt. On a live server this never grants anything.
function MonetizationService:requestPurchase(player, key, opts)
	if not limiter:allow(player) then
		return false, "rate"
	end
	local item = type(key) == "string" and MConfig.Items[key] or nil
	local data = S.PlayerDataService:get(player)
	if not item or not data then
		return false, "invalid"
	end
	if item.type == "GamePass" and data.passes[key] then
		notify(player, "You already own " .. item.name .. ".", "info")
		return false, "owned"
	end
	if key == "InstantHatch" then
		local slot = type(opts) == "table" and tonumber(opts.podSlot) or nil
		local inTransit = function(s)
			return S.IncubatorService:isInTransit(player, s)
		end
		local pod = MonetizationLogic.pickHatchPod(data.pods, slot, inTransit)
		if not pod then
			notify(player, "No core is incubating right now.", "info")
			return false, "no pod"
		end
		if data.hatchCredits > 0 then
			data.hatchCredits = data.hatchCredits - 1
			S.IncubatorService:finishPod(player, pod)
			S.PlayerDataService:markDirty(player)
			notify(player, "🥚 Used a saved Instant Hatch on " .. Config.Cores[pod.c].name .. ".")
			return true, "credit"
		end
		pendingHatch[player] = pod.s
	end
	if item.id > 0 then
		local ok, err = pcall(function()
			if item.type == "GamePass" then
				MarketplaceService:PromptGamePassPurchase(player, item.id)
			else
				MarketplaceService:PromptProductPurchase(player, item.id)
			end
		end)
		if not ok then
			warn("[Monetization] prompt failed: " .. tostring(err))
			return false, "prompt failed"
		end
		return true, "prompted"
	end
	if self:mockEnabled() then
		mockCounter = mockCounter + 1
		if item.type == "GamePass" then
			self:grantPass(player, key)
		else
			self:_grantReceipt(player, key, "studio-mock-" .. tostring(player.UserId) .. "-" .. mockCounter)
		end
		notify(player, "[Studio test purchase — no Robux spent]", "info")
		return true, "mock"
	end
	notify(player, item.name .. " isn't available yet.", "info")
	return false, "unconfigured"
end

-- World prompts ----------------------------------------------------------------------
function MonetizationService:_wireTreadmillPrompts()
	for slot = 1, #Config.Bases.Slots do
		local base = S.BaseService:base(slot)
		local console = base and base.treadmill and base.treadmill.console
		if console then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "BoostPrompt"
			prompt.ActionText = "Speed Boost"
			prompt.ObjectText = "⚡ 2× treadmill Speed • 15 min"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 7
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("BaseSlot", slot)
			prompt:SetAttribute("OwnerOnly", true)
			prompt:SetAttribute("Range", 7)
			prompt.Parent = console
			prompt.Triggered:Connect(function(player)
				if S.BaseService:slotOf(player) == slot then
					self:requestPurchase(player, "SpeedBoost")
				end
			end)
		end
	end
end

function MonetizationService:Start()
	MarketplaceService.ProcessReceipt = function(receipt)
		return self:processReceipt(receipt)
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = passKeyById[passId]
		if purchased and key then
			self:grantPass(player, key)
		end
	end)
	Remotes.get("RequestPurchase").OnServerEvent:Connect(function(player, key, podSlot)
		self:requestPurchase(player, key, { podSlot = podSlot })
	end)
	S.PlayerDataService.Loaded:Connect(function(player)
		self:_applyEffects(player)
		task.spawn(function()
			self:refreshPasses(player)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		pendingHatch[player] = nil
	end)
	self:_wireTreadmillPrompts()

	-- Speed Boost counts down only while the player is in game
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 1 then
			return
		end
		local elapsed = math.min(acc, 5)
		acc = 0
		for _, player in ipairs(S.PlayerDataService:loadedPlayers()) do
			local data = S.PlayerDataService:get(player)
			if data and (data.boostSpeed or 0) > 0 then
				data.boostSpeed = math.max(0, data.boostSpeed - elapsed)
				player:SetAttribute("BoostSeconds", math.ceil(data.boostSpeed))
				S.PlayerDataService:markDirty(player)
				if data.boostSpeed <= 0 then
					self:_applyEffects(player)
					notify(player, "⚡ Speed Boost ended.", "info")
				else
					S.BaseService:refreshTreadmillLabel(player)
				end
			end
		end
	end)
end

-- test hooks
function MonetizationService:_pendingHatch()
	return pendingHatch
end

return MonetizationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerDataService — loading, saving and syncing player data.

	* DataStore UpdateAsync with retries and a soft session lock (another server
	  holding a fresh lock delays the load; a stale lock is taken over).
	* Everything loaded passes through DataSchema.sanitize().
	* If the DataStore is unreachable (e.g. Studio without API access) the
	  session runs from memory and is flagged `noSave` so real data is never
	  overwritten with defaults.
	* Releasing fires BEFORE the final save so other services can resolve
	  runtime-only state (in-transit steals, carried cores) first.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local DataSchema = require(Shared.Logic.DataSchema)
local UpgradeLogic = require(Shared.Logic.UpgradeLogic)
local SpeedLogic = require(Shared.Logic.SpeedLogic)
local EconomyLogic = require(Shared.Logic.EconomyLogic)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)
local MonetizationLogic = require(Shared.Logic.MonetizationLogic)

local PlayerDataService = { Name = "PlayerDataService" }
PlayerDataService.Loaded = Signal.new() -- (player, data, offlineSeconds)
PlayerDataService.Changed = Signal.new() -- (player)
PlayerDataService.Releasing = Signal.new() -- (player, data)

local LOCK_TTL = 150
local RETRIES = 3
local SYNC_INTERVAL = 0.15

local S
local store
local sessions = {}
local jobId

local function key(player)
	return "u_" .. tostring(player.UserId)
end

local function isStudioAccessError(err)
	local msg = tostring(err)
	return string.find(msg, "403", 1, true) ~= nil
		or string.find(msg, "Studio", 1, true) ~= nil
		or string.find(msg, "API", 1, true) ~= nil and string.find(msg, "access", 1, true) ~= nil
end

function PlayerDataService:Init(registry)
	S = registry
	jobId = game.JobId
	if jobId == nil or jobId == "" then
		jobId = "studio-" .. tostring(math.random(1, 1e9))
	end
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = res
	else
		warn("[PlayerData] DataStore unavailable, running from memory: " .. tostring(res))
	end
end

-- Load with lock handling. Returns raw (may be nil), status ("ok"|"memory"|"failed")
local function loadRaw(player)
	if not store then
		return nil, "memory"
	end
	local lastErr
	for attempt = 1, RETRIES + 1 do
		local raw = nil
		local locked = false
		local force = attempt > RETRIES
		local ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old)
				if type(old) ~= "table" then
					old = {}
				end
				local lock = old.lock
				if not force and type(lock) == "table" and lock.job ~= jobId and type(lock.t) == "number" and os.time() - lock.t < LOCK_TTL then
					locked = true
					return nil
				end
				old.lock = { job = jobId, t = os.time() }
				raw = old
				return old
			end)
		end)
		if ok and not locked then
			return raw, "ok"
		end
		if not ok then
			lastErr = err
			if isStudioAccessError(err) then
				return nil, "memory"
			end
		end
		if attempt <= RETRIES then
			task.wait(locked and 4 or (1.5 * attempt))
		end
		if player.Parent ~= Players then
			return nil, "left"
		end
	end
	warn("[PlayerData] load failed for " .. player.Name .. ": " .. tostring(lastErr))
	return nil, "failed"
end

function PlayerDataService:_onPlayerAdded(player)
	if sessions[player] then
		return
	end
	local session = { data = nil, loaded = false, dirty = false, noSave = false, lastSync = 0, syncPending = false }
	sessions[player] = session
	local raw, status = loadRaw(player)
	if sessions[player] ~= session or player.Parent ~= Players then
		return
	end
	if status == "memory" or status == "failed" then
		session.noSave = true
	end
	session.memoryOnly = status == "memory"
	local data = DataSchema.sanitize(raw)
	local offline = 0
	if data.lastSeen > 0 then
		offline = math.clamp(os.time() - data.lastSeen, 0, Config.Economy.OfflineIncubationCap)
	end
	data.lastSeen = os.time()
	session.data = data
	session.loaded = true
	player:SetAttribute("DataLoaded", true)
	if status == "failed" then
		self:notify(player, "Your save couldn't load — progress this session won't be saved.", "error")
	end
	self.Loaded:Fire(player, data, offline)
	self:markDirty(player)
end

function PlayerDataService:get(player)
	local s = sessions[player]
	if s and s.loaded then
		return s.data
	end
	return nil
end

function PlayerDataService:isLoaded(player)
	local s = sessions[player]
	return s ~= nil and s.loaded
end

function PlayerDataService:waitFor(player, timeout)
	local deadline = os.clock() + (timeout or 30)
	while player.Parent == Players and os.clock() < deadline do
		local d = self:get(player)
		if d then
			return d
		end
		task.wait(0.1)
	end
	return self:get(player)
end

function PlayerDataService:markDirty(player)
	local s = sessions[player]
	if not s or not s.loaded then
		return
	end
	s.dirty = true
	s.syncPending = true
	self.Changed:Fire(player)
end

-- Purchases may only be granted into a session that will be saved (or a Studio
-- memory session). A live session whose load FAILED runs on defaults; granting
-- there would lose the purchase, so ProcessReceipt must retry later instead.
function PlayerDataService:canGrantPurchases(player)
	local s = sessions[player]
	return s ~= nil and s.loaded and (not s.noSave or s.memoryOnly == true)
end

-- Save now and report whether it reached the DataStore. Waits for an in-flight
-- save so the snapshot written includes the latest changes (receipt records).
function PlayerDataService:saveForReceipt(player)
	local s = sessions[player]
	if not s or not s.loaded then
		return false
	end
	local deadline = os.clock() + 15
	while s.saving and os.clock() < deadline do
		task.wait(0.1)
	end
	if s.saving then
		return false
	end
	return self:save(player, false)
end

function PlayerDataService:loadedPlayers()
	local out = {}
	for p, s in pairs(sessions) do
		if s.loaded and p.Parent == Players then
			table.insert(out, p)
		end
	end
	return out
end

function PlayerDataService:save(player, release)
	local s = sessions[player]
	if not s or not s.loaded or s.noSave or not store then
		return true
	end
	if s.saving then
		-- a save is in flight; queue another afterwards
		s.saveAgain = true
		return true
	end
	s.saving = true
	s.data.lastSeen = os.time()
	local snapshot = Util.deepCopy(s.data)
	local ok, err
	for attempt = 1, RETRIES do
		ok, err = pcall(function()
			store:UpdateAsync(key(player), function(old)
				local out = Util.deepCopy(snapshot)
				if not release then
					out.lock = { job = jobId, t = os.time() }
				end
				return out
			end)
		end)
		if ok then
			break
		end
		task.wait(attempt)
	end
	s.saving = false
	if ok then
		s.dirty = false
	else
		warn("[PlayerData] save failed for " .. player.Name .. ": " .. tostring(err))
	end
	if s.saveAgain and not release then
		s.saveAgain = false
		task.spawn(function()
			self:save(player, false)
		end)
	end
	return ok
end

function PlayerDataService:_onPlayerRemoving(player)
	local s = sessions[player]
	if not s then
		return
	end
	if s.loaded then
		self.Releasing:Fire(player, s.data)
		self:save(player, true)
	end
	sessions[player] = nil
end

-- Snapshot sent to the owning client for the HUD.
function PlayerDataService:snapshot(player)
	local data = self:get(player)
	if not data then
		return nil
	end
	local costs = {}
	for id in pairs(Config.Upgrades) do
		costs[id] = UpgradeLogic.nextCost(data, id) or -1
	end
	local disasters = {}
	for _, d in ipairs(data.disasters) do
		table.insert(disasters, { d = d.d, m = d.m, s = d.s })
	end
	local carried = {}
	if S.CarryService then
		for _, item in ipairs(S.CarryService:getItems(player)) do
			table.insert(carried, { c = item.coreId, m = item.mutation, kind = item.kind })
		end
	end
	local nextZone = SpeedLogic.nextZone(data.speed)
	return {
		money = data.money,
		speed = data.speed,
		walk = SpeedLogic.walkSpeedFor(data.speed),
		gainPerStep = SpeedLogic.gainPerStep(data.upgrades.Treadmill),
		income = S.EconomyService and S.EconomyService:incomeOf(player) or 0,
		upgrades = Util.deepCopy(data.upgrades),
		costs = costs,
		index = Util.deepCopy(data.index),
		disasters = disasters,
		podsUsed = #data.pods,
		storage = #data.storage,
		carried = carried,
		baseSlot = player:GetAttribute("BaseSlot") or 0,
		nextZone = nextZone and nextZone.id or "",
		nextZoneReq = nextZone and nextZone.speedReq or 0,
		stats = Util.deepCopy(data.stats),
		shieldUntil = player:GetAttribute("ShieldUntil") or 0,
		passes = Util.deepCopy(data.passes),
		boostSpeed = data.boostSpeed,
		hatchCredits = data.hatchCredits,
		speedMult = MonetizationLogic.speedMultiplier(data),
		incomeMult = MonetizationLogic.incomeMultiplier(data),
		cashPack = MonetizationLogic.cashPackAmount(EconomyLogic.totalIncome(data.disasters), data.speed),
	}
end

function PlayerDataService:notify(player, text, kind)
	local ev = Remotes.get("Notify")
	if ev then
		ev:FireClient(player, text, kind or "info")
	end
end

function PlayerDataService:Start()
	Players.PlayerAdded:Connect(function(p)
		self:_onPlayerAdded(p)
	end)
	Players.PlayerRemoving:Connect(function(p)
		self:_onPlayerRemoving(p)
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			self:_onPlayerAdded(p)
		end)
	end

	-- throttled client sync + leaderstats
	local syncEvent = Remotes.get("Sync")
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for p, s in pairs(sessions) do
			if s.loaded and s.syncPending and now - s.lastSync >= SYNC_INTERVAL then
				s.syncPending = false
				s.lastSync = now
				local snap = self:snapshot(p)
				if snap then
					syncEvent:FireClient(p, snap)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for p, s in pairs(sessions) do
				if s.loaded and s.dirty then
					task.spawn(function()
						self:save(p, false)
					end)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for p, s in pairs(sessions) do
			if s.loaded then
				pending = pending + 1
				task.spawn(function()
					self.Releasing:Fire(p, s.data)
					self:save(p, true)
					pending = pending - 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- test hook
function PlayerDataService:_sessions()
	return sessions
end

return PlayerDataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">SpeedService</string><ProtectedString name="Source"><![CDATA[--[[
	SpeedService — treadmill training and WalkSpeed.

	Steps are counted on the server only: a player earns steps while their root
	part is over THEIR OWN treadmill belt and their Humanoid is moving
	(MoveDirection), at the capped rate from SpeedLogic. No remote is involved,
	so steps can't be spoofed.

	WalkSpeed = walkSpeedFor(Speed) * carry multiplier, recomputed whenever
	speed or carried weight changes, and re-asserted periodically.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SpeedLogic = require(Shared.Logic.SpeedLogic)
local MonetizationLogic = require(Shared.Logic.MonetizationLogic)
local Util = require(Shared.Util)

local SpeedService = { Name = "SpeedService" }

local S
local stepStates = {}
local lastSync = {}

function SpeedService:Init(registry)
	S = registry
end

function SpeedService:maxWalkFor(player)
	local data = S.PlayerDataService:get(player)
	return SpeedLogic.walkSpeedFor(data and data.speed or 0)
end

function SpeedService:refreshWalkSpeed(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local mult = 1
	if S.CarryService then
		mult = S.CarryService:walkMultiplier(player)
	end
	local target = self:maxWalkFor(player) * mult
	if math.abs(hum.WalkSpeed - target) > 0.01 then
		hum.WalkSpeed = target
	end
	player:SetAttribute("WalkSpeed", target)
end

-- Is the player's root over their own treadmill belt?
function SpeedService:onTreadmill(player)
	local base = S.BaseService:baseOf(player)
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not base or not hrp then
		return false
	end
	local belt = base.treadmill.belt
	local rel = belt.CFrame:PointToObjectSpace(hrp.Position)
	local size = belt.Size
	return math.abs(rel.X) <= size.X / 2 + 0.5 and math.abs(rel.Z) <= size.Z / 2 + 0.5 and rel.Y > -1 and rel.Y < 7
end

function SpeedService:addSteps(player, steps)
	local data = S.PlayerDataService:get(player)
	if not data or steps <= 0 then
		return 0
	end
	local gain = SpeedLogic.gainPerStep(data.upgrades.Treadmill) * steps * MonetizationLogic.speedMultiplier(data)
	data.speed = data.speed + gain
	data.steps = data.steps + steps
	return gain
end

function SpeedService:Start()
	Players.PlayerRemoving:Connect(function(p)
		stepStates[p] = nil
		lastSync[p] = nil
	end)
	S.PlayerDataService.Loaded:Connect(function(player)
		self:refreshWalkSpeed(player)
	end)
	local function hookPlayer(player)
		player.CharacterAdded:Connect(function()
			task.defer(function()
				self:refreshWalkSpeed(player)
			end)
		end)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end

	local reassert = 0
	RunService.Heartbeat:Connect(function(dt)
		reassert = reassert + dt
		local doReassert = reassert >= 1
		if doReassert then
			reassert = 0
		end
		for _, player in ipairs(S.PlayerDataService:loadedPlayers()) do
			local st = stepStates[player]
			if not st then
				st = SpeedLogic.newStepState()
				stepStates[player] = st
			end
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			local running = hum ~= nil and hum.Health > 0 and hum.MoveDirection.Magnitude > 0.1 and self:onTreadmill(player)
			local steps = SpeedLogic.tickSteps(st, dt, running)
			if steps > 0 then
				local before = SpeedLogic.highestUnlockedZone(S.PlayerDataService:get(player).speed)
				self:addSteps(player, steps)
				local data = S.PlayerDataService:get(player)
				local after = SpeedLogic.highestUnlockedZone(data.speed)
				self:refreshWalkSpeed(player)
				player:SetAttribute("Speed", data.speed)
				-- sync at most ~4x/s while training
				local now = os.clock()
				if not lastSync[player] or now - lastSync[player] > 0.25 then
					lastSync[player] = now
					S.PlayerDataService:markDirty(player)
					if S.EconomyService then
						S.EconomyService:_updateStats(player, data)
					end
				end
				if after > before then
					local Config = require(Shared.Config.GameConfig)
					local zone = Config.Zones[after]
					local Remotes = require(Shared.Remotes)
					Remotes.get("Announce"):FireClient(player, {
						kind = "unlock",
						title = "ZONE UNLOCKED!",
						subtitle = "You can now steal in " .. zone.name,
						color = { 255, 230, 90 },
					})
				end
			elseif doReassert then
				self:refreshWalkSpeed(player)
			end
		end
	end)
end

return SpeedService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">StealService</string><ProtectedString name="Source"><![CDATA[--[[
	StealService — validates every steal attempt on the server.

	tryStealWorld(player, entity)       from a zone nest (ProximityPrompt)
	tryStealFromBase(thief, slot, pod)  an incubating core from another base

	Checks: data loaded, alive, in range (server-measured), zone Speed gate,
	carry capacity, room at home, base shield, not already in transit, rate limit.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local SpeedLogic = require(Shared.Logic.SpeedLogic)
local CarryLogic = require(Shared.Logic.CarryLogic)
local WorldLayout = require(Shared.Logic.WorldLayout)
local RateLimiter = require(Shared.Logic.RateLimiter)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local StealService = { Name = "StealService" }

local S
local limiter

function StealService:Init(registry)
	S = registry
	local rl = Config.RateLimits.Generic
	limiter = RateLimiter.new(rl[1], rl[2])
end

local function aliveRoot(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then
		return nil
	end
	return hrp
end

local function deny(player, text)
	S.PlayerDataService:notify(player, text, "error")
	return false, text
end

local function commonChecks(player, data, extraIncoming)
	if not CarryLogic.canCarryMore(S.CarryService:count(player), data.upgrades.Carry) then
		return "Your hands are full! Upgrade your Backpack to carry more."
	end
	if not S.IncubatorService:hasRoom(player, S.CarryService:count(player) + (extraIncoming or 1)) then
		return "Your base is full! Free a pod or pedestal first."
	end
	return nil
end

function StealService:tryStealWorld(player, entity)
	if not limiter:allow(player) then
		return false, "rate"
	end
	local data = S.PlayerDataService:get(player)
	if not data then
		return false, "not loaded"
	end
	if not entity or entity.state ~= "Nest" or S.CoreSpawnService:get(entity.uid) ~= entity then
		return false, "gone"
	end
	local hrp = aliveRoot(player)
	if not hrp then
		return false, "dead"
	end
	if (hrp.Position - entity.position).Magnitude > Config.Carry.PickupRange then
		return false, "range"
	end
	if not SpeedLogic.canStealInZone(data.speed, entity.zoneIndex) then
		local req = Config.Zones[entity.zoneIndex].speedReq
		return deny(player, "You need ⚡" .. Util.formatNumber(req) .. " Speed to steal here. Train on your treadmill!")
	end
	local err = commonChecks(player, data)
	if err then
		return deny(player, err)
	end
	if not S.CoreSpawnService:take(entity, player) then
		return false, "race"
	end
	S.CarryService:add(player, {
		kind = "world",
		entity = entity,
		coreId = entity.coreId,
		mutation = entity.mutation,
		zoneIndex = entity.zoneIndex,
	})
	if S.GuardianService then
		S.GuardianService:alert(entity.zoneIndex, player)
	end
	return true
end

function StealService:tryStealFromBase(thief, slot, podSlot)
	if not limiter:allow(thief) then
		return false, "rate"
	end
	local victim = S.BaseService:ownerOf(slot)
	if not victim or victim == thief then
		return false, "owner"
	end
	local data = S.PlayerDataService:get(thief)
	local vdata = S.PlayerDataService:get(victim)
	if not data or not vdata then
		return false, "not loaded"
	end
	if S.BaseService:isShielded(slot) then
		return deny(thief, "That base is locked!")
	end
	local hrp = aliveRoot(thief)
	if not hrp then
		return false, "dead"
	end
	local p = WorldLayout.podPosition(slot, podSlot)
	local podPos = Vector3.new(p[1], hrp.Position.Y, p[3])
	if (hrp.Position - podPos).Magnitude > Config.Carry.PickupRange then
		return false, "range"
	end
	local err = commonChecks(thief, data)
	if err then
		return deny(thief, err)
	end
	local pod = S.IncubatorService:beginTransit(victim, podSlot, thief)
	if not pod then
		return false, "empty"
	end
	S.CarryService:add(thief, {
		kind = "player",
		victim = victim,
		podSlot = podSlot,
		coreId = pod.c,
		mutation = pod.m,
		zoneIndex = pod.z,
		progress = pod.p,
	})
	Remotes.get("Announce"):FireClient(victim, {
		kind = "alarm",
		title = "BASE BREACH!",
		subtitle = thief.DisplayName .. " is stealing your " .. Config.Cores[pod.c].name .. " — tag them!",
		color = { 255, 70, 70 },
	})
	return true
end

return StealService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">TravelService</string><ProtectedString name="Source"><![CDATA[--[[
	TravelService — server-validated Quick Travel.

	Destinations: Home (own base spawn), Train (behind own treadmill), Steal
	(entrance of the highest zone the player can steal in), Zone n (any zone
	the player has unlocked). Every request is checked here: data loaded,
	alive, not carrying (no skipping the run home), cooldown, and progression.
	The landing spot is a fixed safe point (open corridor / base floor), shifted
	sideways to avoid other players. The carry anti-teleport tracker is reset.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local TravelLogic = require(Shared.Logic.TravelLogic)
local RateLimiter = require(Shared.Logic.RateLimiter)
local Remotes = require(Shared.Remotes)

local TravelService = { Name = "TravelService" }

local S
local limiter
local readyAt = {} -- [player] = os.clock() when the next trip is allowed

function TravelService:Init(registry)
	S = registry
	limiter = RateLimiter.new(2, 4)
end

local function otherRoots(player)
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local hrp = p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			table.insert(out, { hrp.Position.X, hrp.Position.Z })
		end
	end
	return out
end

-- Shift `cf` sideways (its RightVector) to the first spot clear of other players.
local function clearSpot(player, cf)
	local p = cf.Position
	local r = cf.RightVector
	local off = TravelLogic.clearOffset({ p.X, p.Y, p.Z }, { r.X, r.Z }, otherRoots(player))
	return cf + r * off
end

function TravelService:destination(player, dest, arg)
	local data = S.PlayerDataService:get(player)
	local slot = S.BaseService:slotOf(player)
	if dest == "Home" then
		if not slot then
			return nil
		end
		return S.BaseService:spawnCFrame(slot) + Vector3.new(0, 1, 0), "your base"
	elseif dest == "Train" then
		local base = slot and S.BaseService:base(slot)
		if not base then
			return nil
		end
		-- just off the back end of the belt, facing the console: walk forward to train
		local frame = base.treadmill.frame
		local pos = (frame * CFrame.new(-11.5, 3.5, 0)).Position
		return CFrame.lookAt(pos, pos + frame.RightVector), "your treadmill"
	end
	local index = (dest == "Steal") and TravelLogic.stealZone(data.speed) or tonumber(arg)
	local p = TravelLogic.zoneEntrance(index)
	local pos = Vector3.new(p[1], p[2], p[3])
	return CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)), Config.Zones[index].name
end

-- Returns ok, message.
function TravelService:request(player, dest, arg)
	if not limiter:allow(player) then
		return false, nil
	end
	local data = S.PlayerDataService:get(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not hrp or not hum or hum.Health <= 0 then
		return false, nil
	end
	local ok, reason = TravelLogic.check(dest, arg, data.speed, S.CarryService:count(player), os.clock(), readyAt[player])
	if not ok then
		return false, reason
	end
	local cf, label = self:destination(player, dest, arg)
	if not cf then
		return false, "You don't have a base yet."
	end
	cf = clearSpot(player, cf)
	S.CarryService:resetTracking(player)
	char:PivotTo(cf)
	hrp.AssemblyLinearVelocity = Vector3.zero
	readyAt[player] = os.clock() + TravelLogic.COOLDOWN
	player:SetAttribute("TravelReadyAt", workspace:GetServerTimeNow() + TravelLogic.COOLDOWN)
	return true, label
end

function TravelService:Start()
	Remotes.get("RequestTravel").OnServerEvent:Connect(function(player, dest, arg)
		local ok, msg = self:request(player, dest, arg)
		if not ok and msg then
			S.PlayerDataService:notify(player, msg, "error")
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		readyAt[player] = nil
	end)
end

return TravelService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">UpgradeService</string><ProtectedString name="Source"><![CDATA[--[[
	UpgradeService — the only way to spend money on progression.

	Client sends RequestUpgrade(upgradeId). The server rate-limits, validates the
	id and price via UpgradeLogic, applies the effect and refreshes the base so
	the change is visible in the world (new pods/pedestals unlock, decor tiers).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local UpgradeLogic = require(Shared.Logic.UpgradeLogic)
local RateLimiter = require(Shared.Logic.RateLimiter)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local UpgradeService = { Name = "UpgradeService" }

local S
local limiter

function UpgradeService:Init(registry)
	S = registry
	local rl = Config.RateLimits.Upgrade
	limiter = RateLimiter.new(rl[1], rl[2])
end

function UpgradeService:buy(player, upgradeId)
	if type(upgradeId) ~= "string" or not Config.Upgrades[upgradeId] then
		return false, "Unknown upgrade"
	end
	if not limiter:allow(player) then
		return false, "Slow down"
	end
	local data = S.PlayerDataService:get(player)
	if not data then
		return false, "Not loaded"
	end
	local ok, res = UpgradeLogic.buy(data, upgradeId)
	if not ok then
		return false, res
	end
	-- side effects
	if upgradeId == "Pods" then
		S.IncubatorService:onCapacityChanged(player)
	elseif upgradeId == "Pedestals" then
		S.IncubatorService:tryHatchAll(player)
	elseif upgradeId == "Treadmill" or upgradeId == "Carry" then
		S.SpeedService:refreshWalkSpeed(player)
	end
	S.BaseService:refresh(player)
	S.EconomyService:_updateStats(player, data)
	S.PlayerDataService:markDirty(player)
	return true, res
end

function UpgradeService:Start()
	Remotes.get("RequestUpgrade").OnServerEvent:Connect(function(player, upgradeId)
		local ok, res = self:buy(player, upgradeId)
		if ok then
			local def = Config.Upgrades[upgradeId]
			local data = S.PlayerDataService:get(player)
			S.PlayerDataService:notify(player, def.name .. " upgraded to Lv " .. data.upgrades[upgradeId] .. "!", "success")
		elseif res == "Not enough money" then
			local data = S.PlayerDataService:get(player)
			local cost = data and UpgradeLogic.nextCost(data, upgradeId)
			local short = cost and (cost - data.money) or 0
			S.PlayerDataService:notify(player, "Not enough money — you need " .. Util.formatMoney(math.max(0, short)) .. " more.", "error")
		elseif res ~= "Slow down" then
			S.PlayerDataService:notify(player, tostring(res), "error")
		end
	end)
end

return UpgradeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">ZoneService</string><ProtectedString name="Source"><![CDATA[--[[
	ZoneService — builds the world and tracks which zone each player is in.

	Player attribute "Zone": 0 = hub/bases, 1..9 = route zone, -1 = out of bounds.
	Players who fall out of the world are returned to their base.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local WorldLayout = require(Shared.Logic.WorldLayout)
local Signal = require(Shared.Signal)

local MapBuilder = require(ServerScriptService.Server.World.MapBuilder)

local ZoneService = { Name = "ZoneService" }
ZoneService.ZoneChanged = Signal.new() -- (player, newZone, oldZone)

local S
local current = {}
local KILL_Y = -40

function ZoneService:Init(registry)
	S = registry
	self.world = MapBuilder.build()
end

function ZoneService:zoneOf(player)
	return current[player] or 0
end

function ZoneService:zoneRefs(index)
	return self.world.zones[index]
end

function ZoneService:hubRefs()
	return self.world.hub
end

local function rootOf(player)
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end
ZoneService.rootOf = function(_, player)
	return rootOf(player)
end

function ZoneService:Start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc = acc + dt
		if acc < 0.2 then
			return
		end
		acc = 0
		for _, player in ipairs(Players:GetPlayers()) do
			local hrp = rootOf(player)
			if hrp then
				local pos = hrp.Position
				if pos.Y < KILL_Y then
					if S.CarryService then
						S.CarryService:dropAll(player, "fell")
					end
					if S.BaseService then
						S.BaseService:sendHome(player)
					end
				end
				local z = WorldLayout.zoneAt(pos.X, pos.Z)
				local old = current[player]
				if z ~= old then
					current[player] = z
					player:SetAttribute("Zone", z)
					self.ZoneChanged:Fire(player, z, old or 0)
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		current[p] = nil
	end)
end

return ZoneService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000003C"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Backdrop</string><ProtectedString name="Source"><![CDATA[--[[
	Backdrop — scenery beyond the playable strip, so the world no longer floats
	in empty sky. Built once by MapBuilder into World.Backdrop (separate from the
	zone folders, which keep their own contract).

	* Ground skirts continue each zone's ground out to the horizon (and around
	  the hub), slightly below the playable ground.
	* Each zone gets themed silhouettes 200-480 studs out on both sides:
	  hills + town, giant trees, mesas, snow peaks, volcanoes, trench cliffs,
	  a prehistoric volcano, a cloud sea with floating islands, void shards.

	Everything is decorative: no collision, no touch, no queries, no shadows,
	and nothing inside |x| <= 80 (the route walls are at |x| = 76).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local WorldLayout = require(Shared.Logic.WorldLayout)
local Kit = require(Shared.Models.Kit)

local Backdrop = {}

local NEAR, FAR = 220, 480 -- silhouette distance band from the route centre
local SKIRT_OUT = 640 -- ground skirt reaches this far from the centre

local function deco(parent, o)
	o.collide = false
	o.castShadow = false
	o.query = false
	return Kit.part(parent, o)
end

local function ball(parent, pos, d, color, material)
	return deco(parent, { name = "Hill", shape = "Ball", size = Vector3.new(d, d, d), cf = CFrame.new(pos), color = color, material = material or Enum.Material.Grass })
end

-- square pyramid from four wedges (same construction as the Frostfall peaks)
local function peak(parent, pos, w, h, color, material, yaw)
	local base = CFrame.new(pos) * CFrame.Angles(0, yaw or 0, 0)
	for i = 0, 3 do
		deco(parent, {
			name = "Peak",
			shape = "Wedge",
			size = Vector3.new(w, h, w / 2),
			cf = base * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, h / 2, -w / 4),
			color = color,
			material = material,
		})
	end
end

local function block(parent, pos, size, color, material, yaw)
	return deco(parent, { name = "Block", size = size, cf = CFrame.new(pos + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, yaw or 0, 0), color = color, material = material })
end

local function column(parent, pos, h, d, color, material)
	return deco(parent, { name = "Column", shape = "Cylinder", size = Vector3.new(h, d, d), cf = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), color = color, material = material })
end

-- Per-zone themes. `ground` = skirt colour/material (nil = no ground: Skylands),
-- `feature(parent, pos, side, rng)` places one landmark cluster at `pos`.
local THEMES = {
	Suburb = {
		ground = { { 104, 172, 84 }, Enum.Material.Grass },
		feature = function(p, pos, side, rng)
			ball(p, pos + Vector3.new(0, -30, 0), rng(90, 140), { 92, 160, 76 })
			for i = 0, 2 do
				local h = rng(30, 70)
				block(p, pos + Vector3.new(side * (40 + i * 22), 0, rng(-30, 30)), Vector3.new(18, h, 18), Kit.mix({ 230, 220, 205 }, { 150, 170, 200 }, rng()), Enum.Material.SmoothPlastic)
			end
		end,
	},
	Overgrowth = {
		ground = { { 58, 120, 54 }, Enum.Material.Grass },
		feature = function(p, pos, side, rng)
			local h = rng(90, 150)
			column(p, pos, h, rng(14, 20), { 90, 64, 44 }, Enum.Material.Wood)
			for _ = 1, 3 do
				-- canopy balls (radius >= 25) stay within 18 studs of the trunk top so none float free
				ball(p, pos + Vector3.new(rng(-18, 18), h + rng(-6, 12), rng(-18, 18)), rng(50, 80), { 46, 110, 52 }, Enum.Material.Grass)
			end
		end,
	},
	Droughtlands = {
		ground = { { 214, 162, 110 }, Enum.Material.Sandstone },
		feature = function(p, pos, side, rng)
			local w, d = rng(60, 110), rng(50, 90)
			local h = rng(40, 80)
			block(p, pos, Vector3.new(w, h, d), { 190, 120, 80 }, Enum.Material.Sandstone, rng(0, 1))
			block(p, pos + Vector3.new(0, h, 0), Vector3.new(w * 0.86, 8, d * 0.86), { 222, 160, 108 }, Enum.Material.Sandstone)
		end,
	},
	Frostfall = {
		ground = { { 232, 240, 250 }, Enum.Material.Snow },
		feature = function(p, pos, side, rng)
			local w, h = rng(120, 180), rng(110, 170)
			peak(p, pos, w, h, { 120, 130, 150 }, Enum.Material.Rock, rng(0, 1))
			peak(p, pos + Vector3.new(0, h * 0.55, 0), w * 0.45, h * 0.45, { 245, 250, 255 }, Enum.Material.Snow, rng(0, 1))
		end,
	},
	MagmaBasin = {
		ground = { { 54, 46, 46 }, Enum.Material.Basalt },
		feature = function(p, pos, side, rng)
			local w, h = rng(120, 170), rng(80, 120)
			peak(p, pos, w, h, { 46, 38, 40 }, Enum.Material.Basalt, rng(0, 1))
			deco(p, { name = "Lava", shape = "Ball", size = Vector3.new(w * 0.22, w * 0.22, w * 0.22), cf = CFrame.new(pos + Vector3.new(0, h * 0.92, 0)), color = { 255, 120, 30 }, material = Enum.Material.Neon })
			deco(p, { name = "LavaPool", size = Vector3.new(w * 0.7, 0.4, w * 0.4), cf = CFrame.new(pos + Vector3.new(side * w * 0.6, 0.3, 0)), color = { 255, 90, 20 }, material = Enum.Material.Neon })
		end,
	},
	DeepAbyss = {
		ground = { { 34, 52, 82 }, Enum.Material.Sand },
		feature = function(p, pos, side, rng)
			block(p, pos, Vector3.new(rng(50, 80), rng(110, 170), rng(70, 120)), { 22, 34, 58 }, Enum.Material.Slate)
			for _ = 1, 2 do
				column(p, pos + Vector3.new(-side * rng(40, 70), 0, rng(-40, 40)), rng(30, 60), rng(4, 7), { 60, 230, 255 }, Enum.Material.Neon)
			end
		end,
	},
	Prehistoric = {
		ground = { { 84, 112, 54 }, Enum.Material.Grass },
		feature = function(p, pos, side, rng)
			if rng() < 0.4 then
				peak(p, pos, 150, 120, { 70, 56, 46 }, Enum.Material.Rock, rng(0, 1))
				deco(p, { name = "Smoke", shape = "Ball", size = Vector3.new(40, 40, 40), cf = CFrame.new(pos + Vector3.new(0, 130, 0)), color = { 120, 110, 105 }, material = Enum.Material.SmoothPlastic, transparency = 0.35 })
			else
				ball(p, pos + Vector3.new(0, -25, 0), rng(80, 120), { 70, 120, 50 })
				for _ = 1, 3 do
					local h = rng(30, 50)
					column(p, pos + Vector3.new(rng(-35, 35), 10, rng(-35, 35)), h, 3, { 110, 84, 56 }, Enum.Material.Wood)
				end
			end
		end,
	},
	Skylands = {
		ground = nil, -- open sky: a cloud sea below instead
		clouds = true,
		feature = function(p, pos, side, rng)
			local y = rng(10, 70)
			local w = rng(40, 70)
			deco(p, { name = "Island", shape = "Ball", size = Vector3.new(w, w, w), cf = CFrame.new(pos + Vector3.new(0, y - w * 0.35, 0)), color = { 120, 100, 80 }, material = Enum.Material.Rock })
			deco(p, { name = "IslandTop", shape = "Cylinder", size = Vector3.new(4, w * 1.05, w * 1.05), cf = CFrame.new(pos + Vector3.new(0, y + w * 0.12, 0)) * CFrame.Angles(0, 0, math.pi / 2), color = { 120, 200, 110 }, material = Enum.Material.Grass })
		end,
	},
	VoidRealm = {
		ground = { { 24, 14, 40 }, Enum.Material.Glass },
		feature = function(p, pos, side, rng)
			for _ = 1, 3 do
				local h = rng(60, 140)
				deco(p, { name = "Shard", size = Vector3.new(rng(8, 16), h, rng(8, 16)), cf = CFrame.new(pos + Vector3.new(rng(-40, 40), h / 2 - 5, rng(-40, 40))) * CFrame.Angles(rng(-0.3, 0.3), rng(0, 3), rng(-0.3, 0.3)), color = Kit.mix({ 150, 60, 255 }, { 40, 200, 255 }, rng()), material = Enum.Material.Neon, transparency = 0.15 })
			end
		end,
	},
}

local function skirts(parent, z0, z1, color, material)
	local len = z1 - z0
	for side = -1, 1, 2 do
		deco(parent, { name = "Skirt", size = Vector3.new(SKIRT_OUT - 76, 2, len), cf = CFrame.new(side * (76 + (SKIRT_OUT - 76) / 2), -1.3, (z0 + z1) / 2), color = Kit.shade(color, 0.92), material = material })
	end
end

function Backdrop.build(root, rng)
	local m = Kit.model(root, "Backdrop")
	-- hub surroundings: grass all round, low hills behind the bases
	local hub = Config.World
	local hz0 = hub.HubCenter[3] - hub.HubSize[2] / 2
	local hz1 = hub.HubCenter[3] + hub.HubSize[2] / 2
	for side = -1, 1, 2 do
		deco(m, { name = "HubSkirt", size = Vector3.new(SKIRT_OUT - 160, 2, hz1 - hz0 + 400), cf = CFrame.new(side * (160 + (SKIRT_OUT - 160) / 2), -1.3, (hz0 + hz1) / 2 - 200), color = { 98, 166, 80 }, material = Enum.Material.Grass })
		for i = 0, 4 do
			ball(m, Vector3.new(side * rng(260, 420), -40, hz0 - 120 + i * 120 + rng(-30, 30)), rng(110, 170), { 90, 158, 74 })
		end
	end
	deco(m, { name = "HubBack", size = Vector3.new(SKIRT_OUT * 2, 2, 400), cf = CFrame.new(0, -1.3, hz0 - 200), color = { 98, 166, 80 }, material = Enum.Material.Grass })

	for i, zone in ipairs(Config.Zones) do
		local theme = THEMES[zone.id]
		if theme then
			local z0 = WorldLayout.zoneStartZ(i)
			local z1 = z0 + Config.World.ZoneLength
			local zm = Kit.model(m, zone.id)
			if theme.ground then
				-- zone 1 skirt starts at the hub edge so there is no gap at the route link
				skirts(zm, (i == 1) and hz1 or z0, z1, theme.ground[1], theme.ground[2])
			end
			if theme.clouds then
				for side = -1, 1, 2 do
					for k = 0, 2 do
						deco(zm, { name = "CloudSea", shape = "Ball", size = Vector3.new(160, 160, 160), cf = CFrame.new(side * (170 + k * 140), -95, z0 + 60 + k * 70), color = { 250, 252, 255 }, material = Enum.Material.SmoothPlastic, transparency = 0.1 })
					end
				end
			end
			for side = -1, 1, 2 do
				for k = 0, 1 do
					local x = side * rng(NEAR, FAR)
					local z = z0 + (k + 0.5) * (z1 - z0) / 2 + rng(-40, 40)
					theme.feature(zm, Vector3.new(x, 0, z), side, rng)
				end
			end
		end
	end
	-- beyond the end wall: more void ground so the route doesn't end at the sky
	local last = Config.Zones[#Config.Zones]
	local endZ = WorldLayout.zoneStartZ(#Config.Zones) + Config.World.ZoneLength
	if THEMES[last.id] and THEMES[last.id].ground then
		deco(m, { name = "EndSkirt", size = Vector3.new(SKIRT_OUT * 2, 2, 500), cf = CFrame.new(0, -1.3, endZ + 250), color = Kit.shade(THEMES[last.id].ground[1], 0.92), material = THEMES[last.id].ground[2] })
		for k = -2, 2 do
			THEMES[last.id].feature(m, Vector3.new(k * 110, 0, endZ + 220 + math.abs(k) * 30), (k < 0) and -1 or 1, rng)
		end
	end
	return m
end

return Backdrop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">BaseBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	BaseBuilder — the physical player base: a "storm shelter lab" on a raised
	concrete pad with walls on three sides, open front toward the avenue,
	incubator pods along the back, display pedestals in the middle, a treadmill,
	an upgrade terminal, a shield (lock) button, an owner sign and decor that
	unlocks as the base is upgraded.

	Local frame: origin = base center at ground level, +X = toward the avenue.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local WorldLayout = require(Shared.Logic.WorldLayout)
local Kit = require(Shared.Models.Kit)

local BaseBuilder = {}

BaseBuilder.FLOOR_TOP = 1

local CONCRETE = { 188, 190, 198 }
local TRIM = { 255, 196, 40 }
local DARK = { 44, 48, 60 }
local METAL = { 150, 156, 170 }
local PLATE = { 120, 124, 136 }

local SLOT_COLORS = {
	{ 255, 90, 90 },
	{ 255, 170, 60 },
	{ 255, 230, 80 },
	{ 110, 220, 100 },
	{ 70, 200, 255 },
	{ 90, 120, 255 },
	{ 190, 100, 255 },
	{ 255, 110, 200 },
}
BaseBuilder.SLOT_COLORS = SLOT_COLORS

local function baseCF(slotIndex)
	local slot = Config.Bases.Slots[slotIndex]
	return CFrame.new(slot.x, 0, slot.z) * CFrame.Angles(0, slot.face == 1 and 0 or math.pi, 0)
end
BaseBuilder.baseCF = baseCF

local function worldPos(t, yOffset)
	return Vector3.new(t[1], t[2] + (yOffset or 0), t[3])
end

local function lockLabel(adornee, text)
	local bb = Kit.billboard(adornee, { name = "LockLabel", size = UDim2.new(0, 120, 0, 44), offset = Vector3.new(0, 3.2, 0), maxDistance = 60 })
	Kit.text(bb, { name = "Text", text = text, color = { 230, 230, 240 } })
	return bb
end

local function buildPod(model, pos, slotColor)
	local m = Kit.model(model, "Pod")
	local root = Kit.cylinder(m, { name = "PodBase", height = 1.4, diameter = 6, cf = CFrame.new(pos + Vector3.new(0, 0.7, 0)), color = DARK, material = Enum.Material.DiamondPlate })
	Kit.cylinder(m, { name = "PodRing", height = 0.3, diameter = 6.3, cf = CFrame.new(pos + Vector3.new(0, 1.3, 0)), color = slotColor, material = Enum.Material.Neon, collide = false })
	local glass = Kit.cylinder(m, { name = "Capsule", height = 7, diameter = 4.6, cf = CFrame.new(pos + Vector3.new(0, 4.9, 0)), color = { 200, 235, 255 }, material = Enum.Material.Glass, transparency = 0.65, castShadow = false })
	glass.CanCollide = false
	Kit.cylinder(m, { name = "Cap", height = 1, diameter = 5.4, cf = CFrame.new(pos + Vector3.new(0, 8.9, 0)), color = METAL, material = Enum.Material.Metal })
	local fill = Kit.cylinder(m, { name = "Fill", height = 0.05, diameter = 4.2, cf = CFrame.new(pos + Vector3.new(0, 1.45, 0)), color = { 120, 255, 200 }, material = Enum.Material.Neon, transparency = 0.45, collide = false, castShadow = false })
	-- pipes into the back wall
	Kit.part(m, { name = "Pipe", size = Vector3.new(0.7, 0.7, 4), cf = CFrame.new(pos + Vector3.new(0, 8.2, 0)) * CFrame.new(0, 0, 0), color = METAL, material = Enum.Material.Metal, collide = false })
	local anchor = CFrame.new(pos + Vector3.new(0, 4.6, 0))
	m.PrimaryPart = root
	return { model = m, root = root, fill = fill, capsule = glass, anchor = anchor, basePos = pos }
end

local function buildPedestal(model, pos)
	local m = Kit.model(model, "Pedestal")
	local root = Kit.cylinder(m, { name = "Plinth", height = 1.6, diameter = 6.4, cf = CFrame.new(pos + Vector3.new(0, 0.8, 0)), color = { 230, 232, 238 }, material = Enum.Material.Marble })
	local ring = Kit.cylinder(m, { name = "RarityRing", height = 0.25, diameter = 6.7, cf = CFrame.new(pos + Vector3.new(0, 1.5, 0)), color = { 90, 90, 100 }, material = Enum.Material.SmoothPlastic, collide = false })
	Kit.cylinder(m, { name = "Top", height = 0.2, diameter = 5.6, cf = CFrame.new(pos + Vector3.new(0, 1.7, 0)), color = { 60, 64, 78 }, material = Enum.Material.SmoothPlastic, collide = false })
	m.PrimaryPart = root
	return { model = m, root = root, ring = ring, top = CFrame.new(pos + Vector3.new(0, 1.8, 0)), basePos = pos }
end

local function buildTreadmill(model, slotIndex, cf)
	local m = Kit.model(model, "Treadmill")
	local center = worldPos(WorldLayout.treadmillPosition(slotIndex), BaseBuilder.FLOOR_TOP)
	local rot = cf.Rotation
	local frame = CFrame.new(center) * rot
	Kit.part(m, { name = "Deck", size = Vector3.new(18, 0.8, 8), cf = frame * CFrame.new(0, 0.4, 0), color = DARK, material = Enum.Material.Metal })
	local belt = Kit.part(m, { name = "Belt", size = Vector3.new(16, 0.3, 6), cf = frame * CFrame.new(0, 0.95, 0), color = { 30, 30, 34 }, material = Enum.Material.Rubber })
	for _, z in ipairs({ -3.4, 3.4 }) do
		Kit.part(m, { name = "Led", size = Vector3.new(16, 0.2, 0.3), cf = frame * CFrame.new(0, 1, z), color = TRIM, material = Enum.Material.Neon, collide = false })
		Kit.part(m, { name = "Rail", size = Vector3.new(6, 0.35, 0.35), cf = frame * CFrame.new(5.5, 4, z), color = METAL, material = Enum.Material.Metal })
		Kit.part(m, { name = "RailPost", size = Vector3.new(0.35, 3.4, 0.35), cf = frame * CFrame.new(8.2, 2.5, z), color = METAL, material = Enum.Material.Metal })
	end
	-- console at the front end, with a screen the server writes speed info to
	local console = Kit.part(m, { name = "Console", size = Vector3.new(1, 5, 7), cf = frame * CFrame.new(9, 2.5, 0), color = DARK, material = Enum.Material.Metal })
	local screen = Kit.part(m, { name = "Screen", size = Vector3.new(0.2, 2.6, 6), cf = frame * CFrame.new(8.45, 4, 0), color = { 15, 20, 30 }, material = Enum.Material.SmoothPlastic, collide = false })
	local sg = Instance.new("SurfaceGui")
	sg.Name = "TreadGui"
	sg.Face = Enum.NormalId.Left
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.Brightness = 2
	sg.Parent = screen
	Kit.text(sg, { name = "Title", text = "TREADMILL", size = UDim2.new(1, 0, 0.35, 0), color = TRIM, font = Enum.Font.LuckiestGuy })
	Kit.text(sg, { name = "Gain", text = "+5 SPEED / STEP", size = UDim2.new(1, 0, 0.6, 0), position = UDim2.new(0, 0, 0.38, 0), color = { 255, 255, 255 } })
	-- the screen faces the runner, so a floating label makes the treadmill easy to spot from the base entrance
	local tag = Kit.billboard(console, { name = "TreadmillLabel", size = UDim2.new(12, 0, 3, 0), offset = Vector3.new(0, 4.5, 0), maxDistance = 90 })
	Kit.text(tag, { name = "Text", text = "🏃 TREADMILL", color = TRIM, font = Enum.Font.LuckiestGuy })
	-- conveyor: the belt pushes toward local -X; running toward the console keeps you in place
	belt.AssemblyLinearVelocity = rot:VectorToWorldSpace(Vector3.new(-Config.Speed.BeltSpeed, 0, 0))
	return { model = m, belt = belt, frame = frame, console = console, gainLabel = sg:FindFirstChild("Gain") }
end

local function buildTerminal(model, pos, rot, title, color, icon)
	local m = Kit.model(model, title .. "Terminal")
	local cf = CFrame.new(pos) * rot
	local pad = Kit.part(m, { name = "Pad", size = Vector3.new(6, 0.4, 6), cf = cf * CFrame.new(0, 0.2, 0), color = color, material = Enum.Material.Neon, transparency = 0.3 })
	Kit.part(m, { name = "Stand", size = Vector3.new(1.6, 4.2, 2.6), cf = cf * CFrame.new(-1.8, 2.3, 0), color = DARK, material = Enum.Material.Metal })
	local screen = Kit.part(m, { name = "Screen", size = Vector3.new(0.3, 2.2, 3.4), cf = cf * CFrame.new(-1.0, 4.4, 0) * CFrame.Angles(0, 0, -0.3), color = color, material = Enum.Material.Neon })
	-- sized in studs (not pixels) so the two terminal labels, 14 studs apart, never overlap at a distance
	local bb = Kit.billboard(screen, { name = "Label", size = UDim2.new(10, 0, 3, 0), offset = Vector3.new(0, 2.8, 0), maxDistance = 70 })
	Kit.text(bb, { name = "Text", text = icon .. " " .. title, color = { 255, 255, 255 }, font = Enum.Font.LuckiestGuy })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = title
	prompt.ActionText = "Use"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	return { model = m, pad = pad, prompt = prompt, label = bb }
end

function BaseBuilder.build(parent, slotIndex)
	local cf = baseCF(slotIndex)
	local rot = cf.Rotation
	local size = Config.Bases.Size
	local half = size / 2
	local slotColor = SLOT_COLORS[(slotIndex - 1) % #SLOT_COLORS + 1]
	local model = Kit.model(parent, "Base" .. slotIndex)
	model:SetAttribute("Slot", slotIndex)
	local function at(lx, ly, lz)
		return cf * CFrame.new(lx, ly, lz)
	end

	-- pad, floor zones and trim
	Kit.part(model, { name = "Pad", size = Vector3.new(size, BaseBuilder.FLOOR_TOP, size), cf = at(0, BaseBuilder.FLOOR_TOP / 2, 0), color = CONCRETE, material = Enum.Material.Concrete })
	Kit.part(model, { name = "PodDeck", size = Vector3.new(24, 0.1, size - 6), cf = at(-21, BaseBuilder.FLOOR_TOP + 0.05, 0), color = PLATE, material = Enum.Material.DiamondPlate })
	Kit.part(model, { name = "DisplayDeck", size = Vector3.new(30, 0.1, size - 10), cf = at(10, BaseBuilder.FLOOR_TOP + 0.05, 0), color = { 210, 212, 220 }, material = Enum.Material.Marble })
	-- front hazard edge
	for i = 1, 12 do
		local seg = size / 12
		Kit.part(model, { name = "Hazard", size = Vector3.new(2, 0.14, seg), cf = at(half - 1, BaseBuilder.FLOOR_TOP + 0.07, -half + seg * (i - 0.5)), color = (i % 2 == 0) and DARK or TRIM, material = Enum.Material.SmoothPlastic })
	end
	-- ramp/step down to the avenue
	Kit.part(model, { name = "Step", shape = "Wedge", size = Vector3.new(size, BaseBuilder.FLOOR_TOP, 3), cf = at(half + 1.5, BaseBuilder.FLOOR_TOP / 2, 0) * CFrame.Angles(0, math.pi / 2, 0), color = CONCRETE, material = Enum.Material.Concrete })

	-- walls: back (tall) + sides
	local wallH = 7
	Kit.part(model, { name = "BackWall", size = Vector3.new(2, 14, size), cf = at(-half + 1, BaseBuilder.FLOOR_TOP + 7, 0), color = { 160, 164, 176 }, material = Enum.Material.Concrete })
	Kit.part(model, { name = "BackTrim", size = Vector3.new(2.2, 1, size), cf = at(-half + 1, BaseBuilder.FLOOR_TOP + 14.2, 0), color = slotColor, material = Enum.Material.SmoothPlastic })
	for _, side in ipairs({ -1, 1 }) do
		Kit.part(model, { name = "SideWall", size = Vector3.new(size - 14, wallH, 2), cf = at(-7, BaseBuilder.FLOOR_TOP + wallH / 2, side * (half - 1)), color = { 170, 174, 186 }, material = Enum.Material.Concrete })
		Kit.part(model, { name = "SideTrim", size = Vector3.new(size - 14, 0.8, 2.2), cf = at(-7, BaseBuilder.FLOOR_TOP + wallH + 0.4, side * (half - 1)), color = TRIM, material = Enum.Material.SmoothPlastic })
		-- shield pylons at the front corners
		local pylon = Kit.part(model, { name = "Pylon", size = Vector3.new(3, 12, 3), cf = at(half - 2, BaseBuilder.FLOOR_TOP + 6, side * (half - 2)), color = DARK, material = Enum.Material.Metal })
		local emitter = Kit.part(model, { name = "PylonEmitter", size = Vector3.new(3.2, 1.2, 3.2), cf = at(half - 2, BaseBuilder.FLOOR_TOP + 11, side * (half - 2)), color = slotColor, material = Enum.Material.Neon })
		Kit.light(emitter, slotColor, 18, 1)
	end
	-- bunker door on the back wall
	Kit.part(model, { name = "BunkerDoor", size = Vector3.new(0.6, 8, 10), cf = at(-half + 2.2, BaseBuilder.FLOOR_TOP + 4, 0), color = { 90, 96, 110 }, material = Enum.Material.DiamondPlate })
	Kit.part(model, { name = "DoorStripe", size = Vector3.new(0.7, 1, 10), cf = at(-half + 2.25, BaseBuilder.FLOOR_TOP + 7.2, 0), color = TRIM, material = Enum.Material.SmoothPlastic })

	-- owner sign above the back wall (readable from the avenue)
	local signPart = Kit.part(model, { name = "OwnerSign", size = Vector3.new(1, 7, 34), cf = at(-half + 1, BaseBuilder.FLOOR_TOP + 19, 0), color = DARK, material = Enum.Material.Metal })
	Kit.part(model, { name = "SignFrame", size = Vector3.new(1.2, 7.6, 34.6), cf = at(-half + 0.9, BaseBuilder.FLOOR_TOP + 19, 0), color = slotColor, material = Enum.Material.SmoothPlastic })
	local sg = Instance.new("SurfaceGui")
	sg.Name = "OwnerGui"
	sg.Face = Enum.NormalId.Right -- local +X: faces the avenue
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 25
	sg.LightInfluence = 0
	sg.Brightness = 1.4
	sg.Parent = signPart
	local ownerText = Kit.text(sg, { name = "Owner", text = "EMPTY BASE", size = UDim2.new(1, -20, 0.62, 0), position = UDim2.new(0, 10, 0.04, 0), color = { 255, 255, 255 }, font = Enum.Font.LuckiestGuy })
	local infoText = Kit.text(sg, { name = "Info", text = "Waiting for a storm chaser...", size = UDim2.new(1, -20, 0.3, 0), position = UDim2.new(0, 10, 0.66, 0), color = TRIM })
	for _, side in ipairs({ -1, 1 }) do
		Kit.part(model, { name = "SignPost", size = Vector3.new(1, 6, 1), cf = at(-half + 1, BaseBuilder.FLOOR_TOP + 14, side * 14), color = DARK, material = Enum.Material.Metal })
	end

	-- shield wall (visual only; the server enforces it)
	local shield = Kit.part(model, { name = "ShieldWall", size = Vector3.new(0.6, 14, size - 4), cf = at(half - 2, BaseBuilder.FLOOR_TOP + 7, 0), color = slotColor, material = Enum.Material.ForceField, transparency = 1, collide = false, castShadow = false, query = false })

	-- pods & pedestals
	local pods = {}
	for i = 1, Config.Bases.MaxPods do
		local p = buildPod(model, worldPos(WorldLayout.podPosition(slotIndex, i), BaseBuilder.FLOOR_TOP), slotColor)
		p.lock = lockLabel(p.root, "🔒")
		pods[i] = p
	end
	local pedestals = {}
	for i = 1, Config.Bases.MaxPedestals do
		local p = buildPedestal(model, worldPos(WorldLayout.pedestalPosition(slotIndex, i), BaseBuilder.FLOOR_TOP))
		p.lock = lockLabel(p.root, "🔒")
		pedestals[i] = p
	end

	local treadmill = buildTreadmill(model, slotIndex, cf)
	local upgradeTerm = buildTerminal(model, cf * Vector3.new(31, BaseBuilder.FLOOR_TOP, -14), rot, "UPGRADES", { 60, 200, 90 }, "⬆")
	upgradeTerm.prompt.ActionText = "Open Shop"
	local shieldPos = WorldLayout.shieldButtonPosition(slotIndex)
	local shieldTerm = buildTerminal(model, worldPos(shieldPos, BaseBuilder.FLOOR_TOP), rot, "LOCK BASE", { 70, 170, 255 }, "🛡")
	shieldTerm.prompt.ActionText = "Lock"
	shieldTerm.prompt.HoldDuration = 0.4

	-- tier decor (revealed as the base improves)
	local tiers = {}
	local function decor(tier, part)
		tiers[tier] = tiers[tier] or {}
		table.insert(tiers[tier], { part = part, transparency = part.Transparency })
		part.Transparency = 1
		part.CanCollide = false
	end
	for _, side in ipairs({ -1, 1 }) do
		decor(2, Kit.part(model, { name = "RodTower", size = Vector3.new(1.4, 22, 1.4), cf = at(-half + 3, BaseBuilder.FLOOR_TOP + 11, side * (half - 3)), color = METAL, material = Enum.Material.Metal }))
		decor(2, Kit.ball(model, { name = "RodTip", diameter = 2.2, cf = at(-half + 3, BaseBuilder.FLOOR_TOP + 22.5, side * (half - 3)), color = slotColor, material = Enum.Material.Neon }))
	end
	decor(3, Kit.cylinder(model, { name = "DishStand", height = 6, diameter = 1.4, cf = at(-half + 6, BaseBuilder.FLOOR_TOP + 17, -12), color = METAL, material = Enum.Material.Metal }))
	decor(3, Kit.cylinder(model, { name = "Dish", height = 0.6, diameter = 8, cf = at(-half + 6, BaseBuilder.FLOOR_TOP + 20.5, -12) * CFrame.Angles(0, 0, 0.6), color = { 235, 235, 240 }, material = Enum.Material.SmoothPlastic }))
	for _, side in ipairs({ -1, 1 }) do
		decor(4, Kit.part(model, { name = "NeonTrim", size = Vector3.new(size - 14, 0.4, 2.3), cf = at(-7, BaseBuilder.FLOOR_TOP + wallH + 1, side * (half - 1)), color = slotColor, material = Enum.Material.Neon }))
	end
	decor(4, Kit.part(model, { name = "BackNeon", size = Vector3.new(2.4, 0.5, size), cf = at(-half + 1, BaseBuilder.FLOOR_TOP + 14.9, 0), color = slotColor, material = Enum.Material.Neon }))

	-- floating owner billboard over the entrance (visible from far)
	local bbAnchor = Kit.part(model, { name = "OwnerAnchor", size = Vector3.new(1, 1, 1), cf = at(half - 2, BaseBuilder.FLOOR_TOP + 16, 0), transparency = 1, collide = false, query = false })
	local bb = Kit.billboard(bbAnchor, { name = "OwnerBillboard", size = UDim2.new(0, 260, 0, 70), offset = Vector3.new(0, 0, 0), maxDistance = 400 })
	local bbName = Kit.text(bb, { name = "Name", text = "", size = UDim2.new(1, 0, 0.6, 0), color = slotColor, font = Enum.Font.LuckiestGuy })
	local bbInfo = Kit.text(bb, { name = "Info", text = "", size = UDim2.new(1, 0, 0.4, 0), position = UDim2.new(0, 0, 0.6, 0), color = { 255, 255, 255 } })

	return {
		slot = slotIndex,
		model = model,
		cf = cf,
		color = slotColor,
		pods = pods,
		pedestals = pedestals,
		treadmill = treadmill,
		upgradeTerminal = upgradeTerm,
		shieldTerminal = shieldTerm,
		shieldWall = shield,
		ownerText = ownerText,
		infoText = infoText,
		billboardName = bbName,
		billboardInfo = bbInfo,
		tiers = tiers,
	}
end

return BaseBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	MapBuilder — builds the static world from config at server start:
	lighting baseline, the starting hub (Storm Research Plaza), the long central
	route with a gate arch per zone, a nest per zone and boundaries.
	Per-zone environments are delegated to World/Zones/<ZoneId>.lua (falls back
	to World/Zones/Generic.lua).

	Returns refs used by the services:
	  { root, hub, zones = { [i] = { folder, nestCenter, nestPoints = {Vector3}, gate } } }
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local WorldLayout = require(Shared.Logic.WorldLayout)
local Util = require(Shared.Util)
local Kit = require(Shared.Models.Kit)

local ZonesFolder = script.Parent:WaitForChild("Zones")

local MapBuilder = {}

local W = Config.World

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function seededRng(seed)
	local r = Random.new(seed)
	return function(a, b)
		if a then
			return r:NextNumber(a, b)
		end
		return r:NextNumber()
	end
end

---------------------------------------------------------------------------
-- Lighting baseline (the client tweens per-zone moods on top of this)
---------------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(110, 110, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 165)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.GlobalShadows = true
	Lighting.FogColor = Color3.fromRGB(190, 215, 255)
	Lighting.FogStart = 0
	Lighting.FogEnd = 1200
	Lighting.ExposureCompensation = 0.1

	local function ensure(class, name)
		local e = Lighting:FindFirstChild(name)
		if not e then
			e = Instance.new(class)
			e.Name = name
			e.Parent = Lighting
		end
		return e
	end
	local atm = ensure("Atmosphere", "Atmosphere")
	atm.Density = 0.28
	atm.Offset = 0.15
	atm.Color = Color3.fromRGB(200, 220, 255)
	atm.Decay = Color3.fromRGB(110, 120, 150)
	atm.Glare = 0.2
	atm.Haze = 1.2
	local cc = ensure("ColorCorrectionEffect", "ZoneGrade")
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.01
	local bloom = ensure("BloomEffect", "Bloom")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 1.6
	local rays = ensure("SunRaysEffect", "SunRays")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	ensure("Sky", "Sky")
end

---------------------------------------------------------------------------
-- Hub: Storm Research Plaza
---------------------------------------------------------------------------
local HAZARD_Y = { 255, 200, 40 }
local HAZARD_K = { 35, 35, 40 }
local CONCRETE = { 196, 196, 204 }
local DARK = { 46, 50, 62 }

local function hazardStripe(parent, cf, length, width, count)
	-- alternating yellow/black blocks along local X
	local seg = length / count
	for i = 1, count do
		Kit.part(parent, {
			name = "Hazard",
			size = Vector3.new(seg, 0.22, width),
			cf = cf * CFrame.new(-length / 2 + seg * (i - 0.5), 0, 0),
			color = (i % 2 == 0) and HAZARD_K or HAZARD_Y,
			material = Enum.Material.SmoothPlastic,
		})
	end
end

local function signBoard(parent, cf, size, title, subtitle, color)
	local board = Kit.part(parent, { name = "Sign", size = size, cf = cf, color = DARK, material = Enum.Material.Metal })
	local sg = Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.Brightness = 1.4
	sg.Parent = board
	Kit.text(sg, { name = "Title", text = title, size = UDim2.new(1, -20, 0.6, 0), position = UDim2.new(0, 10, 0.05, 0), color = color or { 255, 255, 255 }, font = Enum.Font.LuckiestGuy })
	if subtitle then
		Kit.text(sg, { name = "Subtitle", text = subtitle, size = UDim2.new(1, -20, 0.3, 0), position = UDim2.new(0, 10, 0.66, 0), color = { 230, 235, 255 } })
	end
	-- back face too
	local back = sg:Clone()
	back.Face = Enum.NormalId.Back
	back.Parent = board
	return board
end

local function kiosk(parent, pos, title, color, panel)
	local m = Kit.model(parent, title .. "Kiosk")
	local base = Kit.part(m, { name = "Base", size = Vector3.new(12, 1.2, 8), cf = CFrame.new(pos + Vector3.new(0, 0.6, 0)), color = DARK, material = Enum.Material.DiamondPlate })
	Kit.part(m, { name = "Counter", size = Vector3.new(10, 3.6, 2.4), cf = CFrame.new(pos + Vector3.new(0, 3, -1.6)), color = color, material = Enum.Material.SmoothPlastic })
	Kit.part(m, { name = "CounterTop", size = Vector3.new(10.6, 0.4, 3), cf = CFrame.new(pos + Vector3.new(0, 4.9, -1.6)), color = DARK, material = Enum.Material.Metal })
	for _, x in ipairs({ -5.2, 5.2 }) do
		Kit.part(m, { name = "Post", size = Vector3.new(0.6, 9, 0.6), cf = CFrame.new(pos + Vector3.new(x, 5.7, -2.6)), color = DARK, material = Enum.Material.Metal })
	end
	local awning = Kit.part(m, { name = "Awning", shape = "Wedge", size = Vector3.new(11.6, 1.6, 4.6), cf = CFrame.new(pos + Vector3.new(0, 10.6, -1.2)) * CFrame.Angles(0, math.pi, 0), color = color, material = Enum.Material.Fabric })
	signBoard(m, CFrame.new(pos + Vector3.new(0, 8.1, -2.7)), Vector3.new(10, 3.4, 0.4), title, nil, { 255, 255, 255 })
	local screen = Kit.part(m, { name = "Screen", size = Vector3.new(3.4, 2.2, 0.3), cf = CFrame.new(pos + Vector3.new(0, 6.2, -1.6)) * CFrame.Angles(-0.25, 0, 0), color = { 60, 200, 255 }, material = Enum.Material.Neon })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = title
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = base
	prompt:SetAttribute("Panel", panel)
	base:SetAttribute("Panel", panel)
	return m, prompt
end

local function stormTower(parent, pos)
	local m = Kit.model(parent, "StormTower")
	Kit.cylinder(m, { name = "Plinth", height = 2, diameter = 22, cf = CFrame.new(pos + Vector3.new(0, 1, 0)), color = DARK, material = Enum.Material.DiamondPlate })
	hazardStripe(m, CFrame.new(pos + Vector3.new(0, 2.1, 10.2)), 16, 1.4, 8)
	Kit.cylinder(m, { name = "Mast", height = 46, diameter = 3, cf = CFrame.new(pos + Vector3.new(0, 25, 0)), color = { 210, 214, 224 }, material = Enum.Material.Metal })
	for i = 1, 4 do
		local y = 8 + i * 9
		Kit.cylinder(m, { name = "Collar", height = 0.8, diameter = 4.4, cf = CFrame.new(pos + Vector3.new(0, y, 0)), color = (i % 2 == 0) and HAZARD_Y or DARK, material = Enum.Material.Metal })
	end
	-- siren horns
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local hp = pos + Vector3.new(0, 40, 0) + dir * 3.2
		Kit.part(m, { name = "Horn", size = Vector3.new(2.6, 2.6, 4), cf = CFrame.lookAt(hp, hp + dir), color = { 220, 60, 50 }, material = Enum.Material.SmoothPlastic })
		Kit.part(m, { name = "HornMouth", size = Vector3.new(2.0, 2.0, 0.2), cf = CFrame.lookAt(hp + dir * 2.05, hp + dir * 3), color = { 30, 30, 35 }, material = Enum.Material.SmoothPlastic })
	end
	-- anemometer (client spins it via Orbit)
	local hubY = 49
	local hub = Kit.cylinder(m, { name = "AnemoHub", height = 1, diameter = 1.4, cf = CFrame.new(pos + Vector3.new(0, hubY, 0)), color = DARK, material = Enum.Material.Metal })
	local anemo = Kit.model(m, "Anemometer")
	local aroot = Kit.part(anemo, { name = "Root", size = Vector3.new(0.5, 0.5, 0.5), cf = CFrame.new(pos + Vector3.new(0, hubY + 0.6, 0)), transparency = 1, collide = false })
	anemo.PrimaryPart = aroot
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local armPos = pos + Vector3.new(0, hubY + 0.6, 0) + dir * 2
		local arm = Kit.part(anemo, { name = "Arm", size = Vector3.new(0.3, 0.3, 4), cf = CFrame.lookAt(armPos, armPos + dir), color = DARK, material = Enum.Material.Metal, collide = false })
		arm:SetAttribute("Orbit", 2.2)
		local cup = Kit.ball(anemo, { name = "Cup", diameter = 1.4, cf = CFrame.new(armPos + dir * 2), color = HAZARD_Y, material = Enum.Material.SmoothPlastic, collide = false })
		cup:SetAttribute("Orbit", 2.2)
	end
	anemo:AddTag("Animated")
	-- event screen (client writes the countdown into it)
	local screen = Kit.part(m, { name = "EventScreen", size = Vector3.new(18, 7, 0.6), cf = CFrame.new(pos + Vector3.new(0, 30, 2.2)), color = { 20, 22, 30 }, material = Enum.Material.SmoothPlastic })
	local sg = Instance.new("SurfaceGui")
	sg.Name = "EventGui"
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	sg.Brightness = 2
	sg.Parent = screen
	Kit.text(sg, { name = "Title", text = "NEXT CHAOS FRENZY", size = UDim2.new(1, 0, 0.4, 0), color = { 255, 90, 220 }, font = Enum.Font.LuckiestGuy })
	Kit.text(sg, { name = "Timer", text = "5:00", size = UDim2.new(1, 0, 0.6, 0), position = UDim2.new(0, 0, 0.4, 0), color = { 255, 255, 255 }, font = Enum.Font.LuckiestGuy })
	screen:AddTag("EventScreen")
	local front = sg:Clone()
	front.Face = Enum.NormalId.Front
	front.Parent = screen
	return m
end

local function tree(parent, pos, scale, leafColor)
	scale = scale or 1
	local m = Kit.model(parent, "Tree")
	Kit.cylinder(m, { name = "Trunk", height = 7 * scale, diameter = 1.4 * scale, cf = CFrame.new(pos + Vector3.new(0, 3.5 * scale, 0)), color = { 110, 75, 50 }, material = Enum.Material.Wood })
	local leaf = leafColor or { 80, 170, 70 }
	Kit.ball(m, { name = "Leaves", diameter = 7 * scale, cf = CFrame.new(pos + Vector3.new(0, 9 * scale, 0)), color = leaf, material = Enum.Material.Grass })
	Kit.ball(m, { name = "Leaves", diameter = 5 * scale, cf = CFrame.new(pos + Vector3.new(2 * scale, 7.5 * scale, 1 * scale)), color = Kit.shade(leaf, 0.9), material = Enum.Material.Grass })
	Kit.ball(m, { name = "Leaves", diameter = 4.6 * scale, cf = CFrame.new(pos + Vector3.new(-1.8 * scale, 7.8 * scale, -1.2 * scale)), color = Kit.shade(leaf, 1.08), material = Enum.Material.Grass })
	return m
end
MapBuilder.tree = tree

local function bench(parent, cf)
	Kit.part(parent, { name = "BenchSeat", size = Vector3.new(6, 0.5, 2), cf = cf * CFrame.new(0, 1.6, 0), color = { 170, 110, 60 }, material = Enum.Material.WoodPlanks })
	Kit.part(parent, { name = "BenchBack", size = Vector3.new(6, 1.6, 0.4), cf = cf * CFrame.new(0, 2.6, 0.8), color = { 170, 110, 60 }, material = Enum.Material.WoodPlanks })
	for _, x in ipairs({ -2.6, 2.6 }) do
		Kit.part(parent, { name = "BenchLeg", size = Vector3.new(0.4, 1.4, 1.8), cf = cf * CFrame.new(x, 0.9, 0), color = DARK, material = Enum.Material.Metal })
	end
end

local function planter(parent, pos, size)
	Kit.part(parent, { name = "Planter", size = Vector3.new(size.X, 1.6, size.Z), cf = CFrame.new(pos + Vector3.new(0, 1.0, 0)), color = { 150, 152, 162 }, material = Enum.Material.Concrete })
	Kit.part(parent, { name = "PlanterSoil", size = Vector3.new(size.X - 1, 0.3, size.Z - 1), cf = CFrame.new(pos + Vector3.new(0, 1.85, 0)), color = { 90, 150, 60 }, material = Enum.Material.Grass })
end

local function buildHub(root)
	local hub = Kit.model(root, "Hub")
	local c = Config.World.HubCenter
	local size = Config.World.HubSize
	local cx, cz = c[1], c[3]
	local hubZ0, hubZ1 = cz - size[2] / 2, cz + size[2] / 2
	-- foundation & plaza
	Kit.part(hub, { name = "Ground", size = Vector3.new(size[1], 4, size[2]), cf = CFrame.new(cx, -2, cz), color = { 120, 170, 90 }, material = Enum.Material.Grass })
	Kit.part(hub, { name = "Plaza", size = Vector3.new(150, 0.4, size[2] - 10), cf = CFrame.new(0, 0.2, cz), color = CONCRETE, material = Enum.Material.Concrete })
	-- plaza tile bands (alternate tones, readable scale)
	for i = 0, 18 do
		if i % 2 == 0 then
			Kit.part(hub, { name = "TileBand", size = Vector3.new(150, 0.42, 10), cf = CFrame.new(0, 0.21, hubZ0 + 10 + i * 20), color = { 182, 184, 194 }, material = Enum.Material.Concrete })
		end
	end
	-- central avenue running the full hub toward the route
	Kit.part(hub, { name = "Avenue", size = Vector3.new(W.PathWidth + 6, 0.5, hubZ1 - (hubZ0 + 40)), cf = CFrame.new(0, 0.25, (hubZ1 + hubZ0 + 40) / 2), color = { 70, 72, 82 }, material = Enum.Material.Asphalt })
	for z = hubZ0 + 50, hubZ1 - 20, 16 do
		Kit.part(hub, { name = "Dash", size = Vector3.new(0.8, 0.52, 7), cf = CFrame.new(0, 0.26, z), color = { 255, 255, 255 }, material = Enum.Material.SmoothPlastic })
	end
	for i = 0, 2 do
		Kit.part(hub, { name = "Arrow", shape = "Wedge", size = Vector3.new(8, 0.3, 5), cf = CFrame.new(0, 0.66, hubZ1 - 34 + i * 9) * CFrame.Angles(math.pi / 2, math.pi, 0), color = HAZARD_Y, material = Enum.Material.SmoothPlastic, collide = false })
	end
	hazardStripe(hub, CFrame.new(0, 0.52, hubZ1 - 6), W.PathWidth + 6, 3, 10)

	-- a colored walkway from the avenue to each base (in the base's own color)
	local BaseBuilder = require(script.Parent:WaitForChild("BaseBuilder"))
	for i, slot in ipairs(Config.Bases.Slots) do
		local col = BaseBuilder.SLOT_COLORS[(i - 1) % #BaseBuilder.SLOT_COLORS + 1]
		local x0 = W.PathWidth / 2 + 3
		local x1 = math.abs(slot.x) - Config.Bases.Size / 2 - 2
		local len = x1 - x0
		local sx = (slot.x > 0) and 1 or -1
		Kit.part(hub, { name = "Walkway", size = Vector3.new(len, 0.46, 12), cf = CFrame.new(sx * (x0 + len / 2), 0.23, slot.z), color = col, material = Enum.Material.SmoothPlastic })
		Kit.part(hub, { name = "WalkwayEdge", size = Vector3.new(len, 0.48, 1), cf = CFrame.new(sx * (x0 + len / 2), 0.24, slot.z - 6.5), color = Kit.shade(col, 0.6), material = Enum.Material.SmoothPlastic })
		Kit.part(hub, { name = "WalkwayEdge", size = Vector3.new(len, 0.48, 1), cf = CFrame.new(sx * (x0 + len / 2), 0.24, slot.z + 6.5), color = Kit.shade(col, 0.6), material = Enum.Material.SmoothPlastic })
		-- slot number marker at the avenue end
		local marker = Kit.cylinder(hub, { name = "SlotMarker", height = 0.5, diameter = 7, cf = CFrame.new(sx * (x0 + 4), 0.3, slot.z), color = col, material = Enum.Material.Neon })
		marker.CanCollide = false
	end

	-- landscaping between walkways
	local rng = seededRng(77)
	local gaps = { -195, -105, -15, 75, 150 }
	for _, z in ipairs(gaps) do
		for side = -1, 1, 2 do
			planter(hub, Vector3.new(side * 50, 0.4, z), Vector3.new(22, 0, 14))
			tree(hub, Vector3.new(side * 44, 2, z), 0.8 + rng(0, 0.2))
			tree(hub, Vector3.new(side * 56, 2, z + 2), 0.7 + rng(0, 0.2), { 100, 185, 80 })
			bench(hub, CFrame.new(side * 30, 0.4, z) * CFrame.Angles(0, side > 0 and -math.pi / 2 or math.pi / 2, 0))
		end
	end
	-- lamps & zone-colored flags along the avenue
	for i = 0, 7 do
		local z = hubZ0 + 60 + i * 42
		for side = -1, 1, 2 do
			local x = side * (W.PathWidth / 2 + 6)
			Kit.cylinder(hub, { name = "LampPost", height = 12, diameter = 0.6, cf = CFrame.new(x, 6, z), color = DARK, material = Enum.Material.Metal })
			local bulb = Kit.part(hub, { name = "Lamp", size = Vector3.new(1.6, 1, 1.6), cf = CFrame.new(x, 12.4, z), color = { 255, 240, 200 }, material = Enum.Material.Neon })
			Kit.light(bulb, { 255, 230, 190 }, 22, 1.2)
			local zone = Config.Zones[(i % #Config.Zones) + 1]
			local zc = zone.sky.fog
			Kit.part(hub, { name = "Banner", size = Vector3.new(0.2, 4, 2.4), cf = CFrame.new(x, 9, z + 1.4), color = zc, material = Enum.Material.Fabric, collide = false })
		end
	end

	-- landmarks: storm tower at the far end, kiosks between the first base rows
	stormTower(hub, Vector3.new(0, 0, hubZ0 + 30))
	local _, indexPrompt = kiosk(hub, Vector3.new(-40, 0.4, -105), "DISASTER INDEX", { 150, 80, 230 }, "Index")
	local _, shopPrompt = kiosk(hub, Vector3.new(40, 0.4, -105), "UPGRADES", { 50, 190, 90 }, "Shop")

	-- neutral fallback spawn (players are moved to their base on spawn)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "FallbackSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.6, 8)
	spawn.CFrame = CFrame.new(0, 0.3, 40)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = hub

	-- perimeter fence
	for side = -1, 1, 2 do
		Kit.part(hub, { name = "Fence", size = Vector3.new(1, 5, size[2]), cf = CFrame.new(side * (size[1] / 2 - 0.5), 2.5, cz), color = DARK, material = Enum.Material.Metal })
	end
	Kit.part(hub, { name = "Fence", size = Vector3.new(size[1], 5, 1), cf = CFrame.new(0, 2.5, hubZ0 + 0.5), color = DARK, material = Enum.Material.Metal })
	for side = -1, 1, 2 do
		-- front fence leaves the route gap open
		local w = size[1] / 2 - (W.PathWidth / 2 + 7)
		Kit.part(hub, { name = "Fence", size = Vector3.new(w, 5, 1), cf = CFrame.new(side * (W.PathWidth / 2 + 7 + w / 2), 2.5, hubZ1 - 0.5), color = DARK, material = Enum.Material.Metal })
	end
	for i = 1, 14 do
		local side = (i % 2 == 0) and 1 or -1
		tree(hub, Vector3.new(side * (size[1] / 2 - 6), 0, hubZ0 + 10 + i * 26 + rng(-4, 4)), 1 + rng(-0.1, 0.25))
	end
	return { model = hub, indexPrompt = indexPrompt, shopPrompt = shopPrompt }
end

---------------------------------------------------------------------------
-- Zone gate + nest + boundaries
---------------------------------------------------------------------------
local function rarityLine(zone)
	local parts = {}
	for _, coreId in ipairs(zone.cores) do
		local c = Config.Cores[coreId]
		local col = Config.Rarities[c.rarity].color
		table.insert(parts, string.format('<font color="rgb(%d,%d,%d)">%s</font>', col[1], col[2], col[3], c.name))
	end
	return table.concat(parts, "  •  ")
end

local function buildGate(folder, index, zone, palette)
	local z0 = WorldLayout.zoneStartZ(index)
	local m = Kit.model(folder, "Gate")
	local accent = palette and palette.accent or { 255, 255, 255 }
	local stone = palette and palette.gate or DARK
	local half = W.PathWidth / 2 + 5
	for _, x in ipairs({ -half, half }) do
		Kit.part(m, { name = "Pillar", size = Vector3.new(6, 30, 6), cf = CFrame.new(x, 15, z0), color = stone, material = palette and palette.gateMaterial or Enum.Material.Slate })
		local cap = Kit.part(m, { name = "Cap", size = Vector3.new(7, 2, 7), cf = CFrame.new(x, 31, z0), color = accent, material = Enum.Material.Neon })
		Kit.light(cap, accent, 24, 1.4)
	end
	local header = Kit.part(m, { name = "Header", size = Vector3.new(half * 2 + 6, 9, 2), cf = CFrame.new(0, 26, z0), color = stone, material = palette and palette.gateMaterial or Enum.Material.Slate })
	local sg = Instance.new("SurfaceGui")
	sg.Name = "GateGui"
	sg.Face = Enum.NormalId.Front -- Front = -Z, facing players arriving from the hub
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 28
	sg.LightInfluence = 0
	sg.Brightness = 1.3
	sg.Parent = header
	-- the pillars hide the outer 6 studs of each end, so text stays in the middle 70%
	Kit.text(sg, { name = "Index", text = "ZONE " .. index, size = UDim2.new(0.7, 0, 0.18, 0), position = UDim2.new(0.15, 0, 0.02, 0), color = accent })
	Kit.text(sg, { name = "ZoneName", text = string.upper(zone.name), size = UDim2.new(0.7, 0, 0.42, 0), position = UDim2.new(0.15, 0, 0.18, 0), color = { 255, 255, 255 }, font = Enum.Font.LuckiestGuy })
	local req = zone.speedReq > 0 and ("⚡ " .. Util.formatNumber(zone.speedReq) .. " SPEED TO STEAL") or "⚡ NO SPEED NEEDED"
	Kit.text(sg, { name = "Requirement", text = req, size = UDim2.new(0.7, 0, 0.2, 0), position = UDim2.new(0.15, 0, 0.6, 0), color = { 255, 230, 90 } })
	Kit.text(sg, { name = "Cores", text = rarityLine(zone), size = UDim2.new(0.68, 0, 0.16, 0), position = UDim2.new(0.16, 0, 0.82, 0), rich = true })
	header:SetAttribute("ZoneIndex", index)
	header:AddTag("ZoneGate")
	return m
end

local function buildNest(folder, index, zone, palette)
	local center = v3(WorldLayout.nestCenter(index))
	local m = Kit.model(folder, "Nest")
	local rimColor = palette and palette.nest or { 90, 90, 100 }
	local glow = palette and palette.accent or { 255, 255, 255 }
	Kit.cylinder(m, { name = "NestFloor", height = 0.6, diameter = Config.Spawning.NestRadius * 2 + 16, cf = CFrame.new(center + Vector3.new(0, 0.3, 0)), color = rimColor, material = palette and palette.nestMaterial or Enum.Material.Slate })
	Kit.cylinder(m, { name = "NestRing", height = 0.66, diameter = Config.Spawning.NestRadius * 2 + 2, cf = CFrame.new(center + Vector3.new(0, 0.31, 0)), color = glow, material = Enum.Material.Neon, transparency = 0.35 })
	Kit.cylinder(m, { name = "NestInner", height = 0.7, diameter = Config.Spawning.NestRadius * 2 - 3, cf = CFrame.new(center + Vector3.new(0, 0.33, 0)), color = rimColor, material = palette and palette.nestMaterial or Enum.Material.Slate })
	local points = {}
	for i, p in ipairs(WorldLayout.nestPoints(index)) do
		local pos = v3(p)
		local plinth = Kit.cylinder(m, { name = "Plinth" .. i, height = 2.2, diameter = 4.2, cf = CFrame.new(pos + Vector3.new(0, 1.1, 0)), color = Kit.shade(rimColor, 0.8), material = Enum.Material.Basalt })
		Kit.cylinder(m, { name = "PlinthGlow", height = 0.25, diameter = 4.5, cf = CFrame.new(pos + Vector3.new(0, 2.25, 0)), color = glow, material = Enum.Material.Neon, collide = false })
		table.insert(points, pos + Vector3.new(0, 4.6, 0))
	end
	return center, points
end

local function buildBoundaries(root)
	local total = #Config.Zones * W.ZoneLength
	local zMid = W.RouteStartZ + total / 2
	local inv = Kit.model(root, "Boundaries")
	for side = -1, 1, 2 do
		local wall = Kit.part(inv, { name = "Wall", size = Vector3.new(2, 120, total + 40), cf = CFrame.new(side * (W.ZoneWidth / 2 + 1), 60, zMid), transparency = 1, castShadow = false })
		wall.CanQuery = false
	end
	local endWall = Kit.part(inv, { name = "EndWall", size = Vector3.new(W.ZoneWidth + 4, 120, 2), cf = CFrame.new(0, 60, W.RouteStartZ + total + 1), transparency = 1, castShadow = false })
	endWall.CanQuery = false
	-- connector between hub and zone 1
	Kit.part(root, { name = "RouteLink", size = Vector3.new(W.PathWidth + 6, 4, 30), cf = CFrame.new(0, -2, W.RouteStartZ - 10), color = { 70, 72, 82 }, material = Enum.Material.Asphalt })
end

---------------------------------------------------------------------------
function MapBuilder.build()
	local existing = workspace:FindFirstChild("World")
	if existing then
		existing:Destroy()
	end
	setupLighting()
	local root = Kit.model(workspace, "World")
	local refs = { root = root, zones = {} }
	refs.hub = buildHub(root)
	buildBoundaries(root)

	local zonesRoot = Kit.folder(root, "Zones")
	for i, zone in ipairs(Config.Zones) do
		local folder = Kit.model(zonesRoot, zone.id)
		local builder = ZonesFolder:FindFirstChild(zone.id) or ZonesFolder:FindFirstChild("Generic")
		local build = require(builder)
		local z0 = WorldLayout.zoneStartZ(i)
		local ctx = {
			folder = folder,
			index = i,
			zone = zone,
			z0 = z0,
			z1 = z0 + W.ZoneLength,
			length = W.ZoneLength,
			width = W.ZoneWidth,
			pathWidth = W.PathWidth,
			nest = v3(WorldLayout.nestCenter(i)),
			nestRadius = Config.Spawning.NestRadius,
			rng = seededRng(1000 + i * 17),
			Kit = Kit,
			tree = tree,
		}
		local ok, result = pcall(build, ctx)
		if not ok then
			warn("[MapBuilder] zone builder " .. zone.id .. " failed: " .. tostring(result))
			result = nil
		end
		local palette = type(result) == "table" and result.palette or nil
		local gate = buildGate(folder, i, zone, palette)
		local nestCenter, points = buildNest(folder, i, zone, palette)
		refs.zones[i] = { folder = folder, gate = gate, nestCenter = nestCenter, nestPoints = points, palette = palette }
	end
	-- scenery beyond the playable strip (decorative; never allowed to break the world)
	local okB, errB = pcall(function()
		require(script.Parent:WaitForChild("Backdrop")).build(root, seededRng(4242))
	end)
	if not okB then
		warn("[MapBuilder] backdrop failed: " .. tostring(errB))
	end
	return refs
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000003B"><Properties><string name="Name">Zones</string></Properties><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">DeepAbyss</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 6 — Deep Abyss. The ocean drained out of this trench long ago and
	forgot to take the pressure with it: a dark slate-and-sand seabed between
	towering rock walls, branching coral that still glows at the tips, giant
	kelp, clams, a broken shipwreck, and the ribcage of a colossal whale
	behind the nest. A rippling "water ceiling" hangs far overhead.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local SEABED = { 46, 56, 74 }
local SEABED_DARK = { 34, 42, 58 }
local SAND_RIPPLE = { 66, 78, 98 }
local TRENCH_LANE = { 30, 37, 52 }
local ROCK = { 38, 46, 62 }
local ROCK_LIGHT = { 52, 62, 82 }
local BONE = { 214, 210, 192 }
local WOOD = { 84, 66, 50 }
local WOOD_DARK = { 62, 48, 38 }
local KELP = { { 58, 112, 58 }, { 74, 128, 54 }, { 52, 98, 66 } }
local CORAL = { { 255, 110, 150 }, { 255, 140, 70 }, { 50, 200, 190 }, { 190, 110, 230 } }
local GLOW = { 80, 230, 255 }

-- Cylinder spanning two points (Roblox cylinders run along local X).
local function limb(Kit, parent, a, b, d, o)
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local cf
	if flat.Magnitude < 0.01 then
		cf = CFrame.new(mid) * CFrame.Angles(0, 0, math.pi / 2)
	else
		cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0)
	end
	return Kit.part(parent, {
		name = o.name or "Limb",
		shape = "Cylinder",
		size = Vector3.new(len, d, d),
		cf = cf,
		color = o.color,
		material = o.material,
		collide = o.collide,
		transparency = o.transparency,
	})
end

-- Branching coral: a trunk that forks into upturned arms with bulbous tips.
local function coral(ctx, parent, pos, scale, color, glowTips)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "Coral")
	local trunkTop = pos + Vector3.new(0, 4 * scale, 0)
	limb(Kit, m, pos, trunkTop, 1.8 * scale, { name = "CoralTrunk", color = Kit.shade(color, 0.8), material = Enum.Material.Pebble })
	local arms = 4
	local spin = rng(0, math.pi * 2)
	for i = 1, arms do
		local a = spin + i / arms * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local elbow = trunkTop + dir * (2.6 * scale) + Vector3.new(0, (2.5 + rng(0, 1.5)) * scale, 0)
		limb(Kit, m, trunkTop, elbow, 1.2 * scale, { name = "CoralArm", color = color, material = Enum.Material.Pebble })
		local tip = elbow + dir * (1.2 * scale) + Vector3.new(0, (2.5 + rng(0, 2.5)) * scale, 0)
		limb(Kit, m, elbow, tip, 0.9 * scale, { name = "CoralArm", color = color, material = Enum.Material.Pebble })
		local glow = glowTips and i % 2 == 0
		local bulb = Kit.ball(m, {
			name = glow and "CoralGlow" or "CoralTip",
			diameter = 1.3 * scale,
			cf = CFrame.new(tip),
			color = glow and Kit.mix(color, { 255, 255, 255 }, 0.35) or Kit.shade(color, 1.15),
			material = glow and Enum.Material.Neon or Enum.Material.Pebble,
		})
		if glow and i == 2 then
			Kit.light(bulb, color, 14, 0.8)
		end
	end
	return m
end

-- Sea fan: a flat lattice disc on a stub, standing edge-on like a hand of lace.
local function seaFan(ctx, parent, pos, scale, color, yaw)
	local Kit = ctx.Kit
	local base = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	Kit.cylinder(parent, { name = "FanStub", height = 2 * scale, diameter = 0.8 * scale, cf = base * CFrame.new(0, 1 * scale, 0), color = Kit.shade(color, 0.7), material = Enum.Material.Pebble })
	Kit.part(parent, { name = "SeaFan", shape = "Cylinder", size = Vector3.new(0.3, 9 * scale, 9 * scale), cf = base * CFrame.new(0, 6 * scale, 0), color = color, material = Enum.Material.Fabric, transparency = 0.1 })
	Kit.part(parent, { name = "SeaFan", shape = "Cylinder", size = Vector3.new(0.35, 5 * scale, 5 * scale), cf = base * CFrame.new(0, 8.5 * scale, 2.5 * scale), color = Kit.shade(color, 1.1), material = Enum.Material.Fabric })
end

-- Tube sponge cluster: open-topped stubby tubes.
local function sponges(ctx, parent, pos, color)
	local Kit, rng = ctx.Kit, ctx.rng
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2 + rng(0, 1)
		local p = pos + Vector3.new(math.cos(a) * 1.6, 0, math.sin(a) * 1.6)
		local h = rng(2.5, 6)
		Kit.cylinder(parent, { name = "Sponge", height = h, diameter = 1.6, cf = CFrame.new(p + Vector3.new(0, h / 2, 0)), color = color, material = Enum.Material.Sand })
		Kit.cylinder(parent, { name = "SpongeMouth", height = 0.2, diameter = 1.1, cf = CFrame.new(p + Vector3.new(0, h + 0.01, 0)), color = Kit.shade(color, 0.35), material = Enum.Material.SmoothPlastic, collide = false })
	end
end

-- Giant kelp: a slightly zig-zagging ribbon with blades and a float at the top.
local function kelp(ctx, parent, pos, height)
	local Kit, rng = ctx.Kit, ctx.rng
	local color = KELP[math.floor(rng(1, #KELP + 0.99))]
	local segs = 4
	local segH = height / segs
	local lean = rng(-0.12, 0.12)
	local prev = pos
	for i = 1, segs do
		local nextP = pos + Vector3.new(math.sin(i * 1.3) * 0.9 + lean * i * segH, i * segH, math.cos(i * 1.1) * 0.6)
		local mid = (prev + nextP) / 2
		Kit.part(parent, {
			name = "Kelp",
			size = Vector3.new(1.6, 0.5, (nextP - prev).Magnitude + 0.4),
			cf = CFrame.lookAt(mid, nextP),
			color = color,
			material = Enum.Material.Grass,
			collide = false,
		})
		if i == 2 or i == 3 then
			local side = (i == 2) and 1 or -1
			Kit.part(parent, {
				name = "KelpBlade",
				size = Vector3.new(0.2, segH * 0.8, 2.6),
				cf = CFrame.new(mid + Vector3.new(0, 0, side * 1.4)) * CFrame.Angles(side * 0.5, 0, 0),
				color = Kit.shade(color, 1.15),
				material = Enum.Material.Grass,
				collide = false,
			})
		end
		prev = nextP
	end
	Kit.ball(parent, { name = "KelpFloat", diameter = 1.4, cf = CFrame.new(prev + Vector3.new(0, 0.6, 0)), color = { 150, 140, 60 }, material = Enum.Material.SmoothPlastic, collide = false })
end

-- Giant clam: two ribbed shells hinged at the back, a glowing pearl inside.
local function clam(ctx, parent, pos, yaw, pearl)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "Clam")
	local base = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local shell = { 226, 196, 206 }
	Kit.cylinder(m, { name = "ShellLower", height = 1.2, diameter = 6.5, cf = base * CFrame.new(0, 0.6, 0), color = shell, material = Enum.Material.Marble })
	Kit.cylinder(m, { name = "ShellFlesh", height = 0.3, diameter = 5.4, cf = base * CFrame.new(0, 1.3, 0), color = { 120, 70, 130 }, material = Enum.Material.SmoothPlastic, collide = false })
	Kit.cylinder(m, {
		name = "ShellUpper",
		height = 1.0,
		diameter = 6.5,
		cf = base * CFrame.new(0, 1.4, 3) * CFrame.Angles(0.75, 0, 0) * CFrame.new(0, 0, -3),
		color = Kit.shade(shell, 0.92),
		material = Enum.Material.Marble,
	})
	if pearl then
		local p = Kit.ball(m, { name = "Pearl", diameter = 1.6, cf = base * CFrame.new(0, 2.1, -0.6), color = { 210, 250, 255 }, material = Enum.Material.Neon, collide = false })
		Kit.light(p, GLOW, 12, 0.9)
		Kit.particles(p, { color = { 200, 240, 255 }, size = 0.35, sizeEnd = 0.6, rate = 2, lifetime = 3, speed = 2, spread = 12, accel = Vector3.new(0, 3, 0), transparency = 0.4 })
	end
	return m
end

-- Broken hull section: curved planks over a keel, lying tilted in the silt.
local function hullSection(ctx, parent, cf, length)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "Shipwreck")
	local r = 8
	Kit.part(m, { name = "Keel", size = Vector3.new(1.6, 1.6, length + 4), cf = cf * CFrame.new(0, -r + 0.8, 0), color = WOOD_DARK, material = Enum.Material.Wood })
	for i = 0, 6 do
		local a = math.rad(-160 + i * 23.3)
		if i ~= 4 then -- one plank torn away
			local px, py = math.cos(a) * r, math.sin(a) * r
			local plankLen = length - ((i % 3) * 3)
			Kit.part(m, {
				name = "HullPlank",
				size = Vector3.new(0.8, 3.4, plankLen),
				cf = cf * CFrame.new(px, py, (i % 2) * 1.5) * CFrame.Angles(0, 0, a),
				color = (i % 2 == 0) and WOOD or WOOD_DARK,
				material = Enum.Material.WoodPlanks,
			})
		end
	end
	-- ribs of the frame poking past the planks
	for k = -1, 1 do
		for _, sgn in ipairs({ -1, 1 }) do
			local a = math.rad(sgn > 0 and -20 or -160)
			Kit.part(m, {
				name = "HullRib",
				size = Vector3.new(0.7, 6, 0.9),
				cf = cf * CFrame.new(math.cos(a) * (r + 1.8), math.sin(a) * (r + 1.8) + 2.4, k * length * 0.32) * CFrame.Angles(0, 0, a + sgn * 0.15),
				color = WOOD_DARK,
				material = Enum.Material.Wood,
			})
		end
	end
	-- a torn deck beam across the top
	Kit.part(m, { name = "DeckBeam", size = Vector3.new(2 * r + 3, 0.9, 1.4), cf = cf * CFrame.new(0, 0.6, length * 0.2) * CFrame.Angles(0, 0, 0.12), color = WOOD, material = Enum.Material.WoodPlanks })
	return m
end

-- The whale skeleton: spine arching along X, ribs falling to the seabed on
-- both sides, a huge blocky skull on the -X end and tail flukes on +X.
local function whaleSkeleton(ctx, parent, zc)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "WhaleSkeleton")
	local spine = {}
	for i = 0, 15 do
		local x = -42 + i * 7
		local t = i / 15
		local y = 9 + 24 * math.sin(math.min(1, t * 1.35) * math.pi * 0.85) * (1 - t * 0.55)
		table.insert(spine, Vector3.new(x, y, zc))
	end
	for i = 1, #spine do
		local p = spine[i]
		local taper = 1 - (i / #spine) * 0.6
		if i < #spine then
			limb(Kit, m, p, spine[i + 1], 2.8 * taper, { name = "Spine", color = BONE, material = Enum.Material.Limestone })
		end
		Kit.part(m, { name = "Vertebra", shape = "Cylinder", size = Vector3.new(1.6, 5 * taper, 5 * taper), cf = CFrame.new(p), color = Kit.shade(BONE, 0.95), material = Enum.Material.Limestone })
		Kit.part(m, { name = "SpinalSpike", size = Vector3.new(0.9, 3.2 * taper, 1.4), cf = CFrame.new(p + Vector3.new(0, 2.6 * taper, 0)) * CFrame.Angles(0, 0, -0.35), color = BONE, material = Enum.Material.Limestone })
	end
	-- ribs: quarter ellipses down to the seabed on both sides. The middle
	-- ribs have collapsed, leaving the way on to the next zone open.
	for i = 2, 10 do
		local top = spine[i]
		local rz = 6 + top.Y * 0.28
		for _, side in ipairs((math.abs(top.X) >= 17) and { -1, 1 } or {}) do
			local prev = top
			for s = 1, 3 do
				local t = s / 3 * math.pi / 2
				local p = Vector3.new(top.X + s * 0.6, 0.8 + (top.Y - 0.8) * math.cos(t), zc + side * rz * math.sin(t))
				limb(Kit, m, prev, p, 1.3, { name = "Rib", color = BONE, material = Enum.Material.Limestone })
				prev = p
			end
		end
	end
	for _, s in ipairs({ { -6, -9, 0.5 }, { 5, 7, -0.4 } }) do
		Kit.part(m, { name = "FallenRib", shape = "Cylinder", size = Vector3.new(14, 1.2, 1.2), cf = CFrame.new(s[1], 0.3, zc + s[2]) * CFrame.Angles(0, s[3], 0), color = Kit.shade(BONE, 0.9), material = Enum.Material.Limestone, collide = false })
	end
	-- skull: cranium, long rostrum and a lower jaw lying in the sand
	local head = spine[1]
	Kit.part(m, { name = "Cranium", size = Vector3.new(13, 11, 15), cf = CFrame.new(head + Vector3.new(-6, 0, 0)) * CFrame.Angles(0, 0, -0.2), color = BONE, material = Enum.Material.Limestone })
	Kit.part(m, { name = "Brow", size = Vector3.new(6, 3, 17), cf = CFrame.new(head + Vector3.new(-8, 5, 0)) * CFrame.Angles(0, 0, -0.3), color = Kit.shade(BONE, 1.04), material = Enum.Material.Limestone })
	Kit.part(m, { name = "Rostrum", shape = "Wedge", size = Vector3.new(10, 5, 24), cf = CFrame.new(head + Vector3.new(-23, -4, 0)) * CFrame.Angles(0, -math.pi / 2, 0) * CFrame.Angles(-0.1, 0, 0), color = Kit.shade(BONE, 0.96), material = Enum.Material.Limestone })
	Kit.part(m, { name = "Jaw", size = Vector3.new(28, 2, 2), cf = CFrame.new(head.X - 20, 1.2, zc - 5) * CFrame.Angles(0, -0.12, 0.08), color = Kit.shade(BONE, 0.9), material = Enum.Material.Limestone })
	Kit.part(m, { name = "Jaw", size = Vector3.new(28, 2, 2), cf = CFrame.new(head.X - 20, 1.2, zc + 5) * CFrame.Angles(0, 0.12, -0.08), color = Kit.shade(BONE, 0.9), material = Enum.Material.Limestone })
	local eye = Kit.ball(m, { name = "EyeGlow", diameter = 2.4, cf = CFrame.new(head + Vector3.new(-9, 1, -7.4)), color = GLOW, material = Enum.Material.Neon, collide = false })
	Kit.light(eye, GLOW, 22, 1.2)
	-- pectoral fin bones (fanned fingers) and tail flukes
	local shoulder = spine[4]
	for _, side in ipairs({ -1, 1 }) do
		local elbow = Vector3.new(shoulder.X - 2, 3, zc + side * 11)
		limb(Kit, m, Vector3.new(shoulder.X, shoulder.Y - 6, zc + side * 4), elbow, 1.4, { name = "FinBone", color = BONE, material = Enum.Material.Limestone })
		for k = -1, 1 do
			limb(Kit, m, elbow, Vector3.new(elbow.X + k * 3, 0.8, elbow.Z + side * 5), 0.8, { name = "FinFinger", color = BONE, material = Enum.Material.Limestone })
		end
	end
	local tail = spine[#spine]
	for _, side in ipairs({ -1, 1 }) do
		Kit.part(m, { name = "Fluke", shape = "Wedge", size = Vector3.new(1, 3, 9), cf = CFrame.new(tail + Vector3.new(3, 0, side * 4.5)) * CFrame.Angles(0, side > 0 and 0 or math.pi, 0), color = BONE, material = Enum.Material.Limestone })
	end
	-- teal glow pooled under the ribcage
	for _, x in ipairs({ -18, 6 }) do
		local orb = Kit.ball(m, { name = "Biolume", diameter = 1.6, cf = CFrame.new(x, 0.5, zc + 2), color = GLOW, material = Enum.Material.Neon, collide = false })
		Kit.light(orb, GLOW, 26, 1.4)
	end
	return m
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W, L = ctx.z0, ctx.z1, ctx.width, ctx.length
	local zm = (z0 + z1) / 2
	local rng = ctx.rng
	local nest = ctx.nest
	local clearR = ctx.nestRadius + 14
	local laneHalf = ctx.pathWidth / 2

	local function nearNest(x, z, pad)
		return (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude < clearR + (pad or 0)
	end

	-- seabed: dark sand slab, slate plates and silt ripples on top
	Kit.part(f, { name = "Seabed", size = Vector3.new(W, 4, L), cf = CFrame.new(0, -2, zm), color = SEABED, material = Enum.Material.Sand })
	for i = 1, 16 do
		local x = rng(-62, 62)
		local z = rng(z0 + 6, z1 - 6)
		Kit.part(f, {
			name = "SlatePlate",
			size = Vector3.new(rng(10, 24), 0.3, rng(8, 18)),
			cf = CFrame.new(x, 0.05, z) * CFrame.Angles(0, rng(0, math.pi), 0),
			color = (i % 2 == 0) and SEABED_DARK or Kit.shade(SEABED_DARK, 1.12),
			material = Enum.Material.Slate,
		})
	end
	for i = 1, 12 do
		local side = (i % 2 == 0) and 1 or -1
		Kit.part(f, {
			name = "SiltRipple",
			size = Vector3.new(rng(14, 26), 0.35, 1.2),
			cf = CFrame.new(side * rng(24, 58), 0.1, rng(z0 + 10, z1 - 10)) * CFrame.Angles(0, rng(-0.3, 0.3), 0),
			color = SAND_RIPPLE,
			material = Enum.Material.Sand,
		})
	end

	-- the trench lane: darker gravel with glowing markers leading to the nest
	local laneEnd = nest.Z - (ctx.nestRadius + 8)
	Kit.part(f, { name = "TrenchLane", size = Vector3.new(ctx.pathWidth - 2, 0.3, laneEnd - z0), cf = CFrame.new(0, 0.1, (z0 + laneEnd) / 2), color = TRENCH_LANE, material = Enum.Material.Pebble })
	for z = z0 + 14, laneEnd - 6, 22 do
		for side = -1, 1, 2 do
			local dot = Kit.cylinder(f, { name = "LaneGlow", height = 0.2, diameter = 1.1, cf = CFrame.new(side * (laneHalf - 0.5), 0.3, z), color = GLOW, material = Enum.Material.Neon, collide = false })
			dot.CastShadow = false
		end
	end

	-- trench walls: towering slate slabs leaning in from both sides
	for side = -1, 1, 2 do
		for i = 0, 9 do
			local z = z0 + 13 + i * 26 + rng(-3, 3)
			local h = rng(22, 42)
			Kit.part(f, {
				name = "TrenchWall",
				size = Vector3.new(rng(10, 15), h, rng(24, 32)),
				cf = CFrame.new(side * 71, h / 2 - 2, z) * CFrame.Angles(rng(-0.06, 0.06), rng(-0.15, 0.15), side * rng(0.05, 0.14)),
				color = (i % 2 == 0) and ROCK or ROCK_LIGHT,
				material = Enum.Material.Slate,
			})
			Kit.ball(f, { name = "Boulder", diameter = rng(5, 9), cf = CFrame.new(side * rng(60, 64), 0.5, z + rng(-8, 8)), color = ROCK, material = Enum.Material.Slate })
			if i % 3 == 1 then
				-- glowing polyps clinging to the wall face
				local polyp = Kit.ball(f, { name = "Polyp", diameter = 0.9, cf = CFrame.new(side * 64.2, rng(4, 12), z + rng(-6, 6)), color = { 120, 255, 220 }, material = Enum.Material.Neon, collide = false })
				Kit.ball(f, { name = "Polyp", diameter = 0.6, cf = polyp.CFrame * CFrame.new(0, 1.3, 0.8), color = { 120, 255, 220 }, material = Enum.Material.Neon, collide = false })
			end
		end
	end

	-- coral gardens along both sides of the lane
	local coralSpots = {
		{ -30, 22 }, { 34, 30 }, { -46, 58 }, { 28, 76 }, { -26, 104 }, { 48, 112 },
		{ -54, 140 }, { 58, 160 }, { -60, 196 }, { 56, 212 }, { -36, 248 }, { 40, 250 },
	}
	for i, s in ipairs(coralSpots) do
		local x, z = s[1], z0 + s[2]
		if not nearNest(x, z, 6) then
			coral(ctx, f, Vector3.new(x, 0, z), 1 + rng(0, 0.6), CORAL[(i - 1) % #CORAL + 1], i % 2 == 1)
			if i % 3 == 0 then
				sponges(ctx, f, Vector3.new(x + rng(4, 7), 0, z + rng(-4, 4)), CORAL[i % #CORAL + 1])
			end
		end
	end
	local fanSpots = { { -20, 44 }, { 22, 54 }, { 38, 96 }, { -40, 86 }, { 20, 120 }, { -64, 168 }, { 66, 186 } }
	for i, s in ipairs(fanSpots) do
		if not nearNest(s[1], z0 + s[2], 4) then
			seaFan(ctx, f, Vector3.new(s[1], 0, z0 + s[2]), 0.9 + rng(0, 0.4), (i % 2 == 0) and { 200, 80, 170 } or { 255, 120, 90 }, rng(-0.5, 0.5))
		end
	end

	-- giant kelp forests in the back corners of each bank
	local kelpSpots = { { -58, 34 }, { 60, 50 }, { -36, 128 }, { 40, 138 }, { -62, 226 }, { 64, 236 } }
	for _, s in ipairs(kelpSpots) do
		for k = 1, 3 do
			local x = s[1] + rng(-6, 6)
			local z = z0 + s[2] + rng(-6, 6)
			if not nearNest(x, z) then
				kelp(ctx, f, Vector3.new(x, 0, z), rng(18, 34))
			end
		end
	end

	-- clams scattered in the silt (pearls glow)
	local clamSpots = { { -22, 30 }, { 20, 66 }, { -34, 118 }, { 30, 98 }, { -20, 154 }, { 64, 120 } }
	for i, s in ipairs(clamSpots) do
		if not nearNest(s[1], z0 + s[2], 2) then
			clam(ctx, f, Vector3.new(s[1], 0, z0 + s[2]), rng(-0.6, 0.6) + ((s[1] > 0) and math.pi / 2 or -math.pi / 2), i % 2 == 1)
		end
	end

	-- shipwreck: a broken hull on the left bank, the stern on the right
	hullSection(ctx, f, CFrame.new(-44, 7, z0 + 78) * CFrame.Angles(0, 0.35, -0.42), 28)
	Kit.cylinder(f, { name = "BrokenMast", height = 34, diameter = 1.6, cf = CFrame.new(-34, 2.5, z0 + 104) * CFrame.Angles(0, 0.9, 0) * CFrame.Angles(0, 0, math.pi / 2 - 0.12), color = WOOD_DARK, material = Enum.Material.Wood })
	Kit.part(f, { name = "Sail", size = Vector3.new(0.2, 9, 14), cf = CFrame.new(-36, 2.2, z0 + 112) * CFrame.Angles(0.3, 0.9, 1.3), color = { 150, 150, 135 }, material = Enum.Material.Fabric, collide = false })
	hullSection(ctx, f, CFrame.new(50, 6.5, z0 + 40) * CFrame.Angles(0, -0.6, 0.5), 20)
	for i = 1, 3 do
		local bp = Vector3.new(36 + i * 3.4, 0, z0 + 58 + i * 2)
		if i == 2 then
			Kit.part(f, { name = "Barrel", shape = "Cylinder", size = Vector3.new(3, 2.4, 2.4), cf = CFrame.new(bp + Vector3.new(0, 1.2, 1)) * CFrame.Angles(0, 0.7, 0), color = WOOD, material = Enum.Material.WoodPlanks })
		else
			Kit.cylinder(f, { name = "Barrel", height = 3, diameter = 2.4, cf = CFrame.new(bp + Vector3.new(0, 1.5, 0)), color = WOOD, material = Enum.Material.WoodPlanks })
		end
	end
	-- the anchor, half-buried
	Kit.part(f, { name = "AnchorShank", size = Vector3.new(1, 10, 1), cf = CFrame.new(40, 4, z0 + 124) * CFrame.Angles(0, 0.4, 0.35), color = { 70, 80, 90 }, material = Enum.Material.CorrodedMetal })
	Kit.part(f, { name = "AnchorArm", size = Vector3.new(7, 1, 1), cf = CFrame.new(38.6, 0.4, z0 + 124.6) * CFrame.Angles(0, 0.4, -0.2), color = { 70, 80, 90 }, material = Enum.Material.CorrodedMetal })
	Kit.cylinder(f, { name = "AnchorRing", height = 0.6, diameter = 2.4, cf = CFrame.new(43.3, 8.4, z0 + 122.6) * CFrame.Angles(math.pi / 2, 0.4, 0), color = { 70, 80, 90 }, material = Enum.Material.CorrodedMetal })

	-- hydrothermal vents: short chimneys breathing bubbles
	for _, s in ipairs({ { -24, 70 }, { 24, 18 }, { 52, 196 }, { -50, 214 } }) do
		local x, z = s[1], z0 + s[2]
		if not nearNest(x, z, 2) then
			Kit.cylinder(f, { name = "Vent", height = 4, diameter = 3.2, cf = CFrame.new(x, 2, z), color = { 28, 30, 36 }, material = Enum.Material.Basalt })
			local mouth = Kit.cylinder(f, { name = "VentMouth", height = 0.3, diameter = 2, cf = CFrame.new(x, 4.05, z), color = { 60, 200, 230 }, material = Enum.Material.Neon, collide = false })
			Kit.particles(mouth, { color = { 190, 235, 255 }, size = 0.5, sizeEnd = 0.9, rate = 5, lifetime = 5, speed = 3, spread = 10, accel = Vector3.new(0, 3, 0), transparency = 0.35 })
		end
	end

	-- hero: the whale skeleton behind the nest
	whaleSkeleton(ctx, f, z1 - 16)

	-- water ceiling far overhead, with faint light shafts
	Kit.part(f, { name = "WaterCeiling", size = Vector3.new(W + 10, 1, L), cf = CFrame.new(0, 82, zm), color = { 40, 110, 170 }, material = Enum.Material.Glass, transparency = 0.55, collide = false, castShadow = false })
	Kit.part(f, { name = "WaterSurface", size = Vector3.new(W + 10, 0.4, L), cf = CFrame.new(0, 79, zm), color = { 70, 170, 230 }, material = Enum.Material.ForceField, transparency = 0.3, collide = false, castShadow = false })
	for i = 0, 5 do
		local x = -50 + i * 20 + rng(-4, 4)
		local z = z0 + 24 + i * 38
		Kit.part(f, {
			name = "LightShaft",
			size = Vector3.new(4 + rng(0, 3), 76, 4 + rng(0, 3)),
			cf = CFrame.new(x, 40, z) * CFrame.Angles(0.18, 0, 0.12),
			color = { 130, 210, 255 },
			material = Enum.Material.SmoothPlastic,
			transparency = 0.9,
			collide = false,
			castShadow = false,
		})
	end
	-- drifting plankton motes
	local motes = Kit.part(f, { name = "Plankton", size = Vector3.new(W - 20, 30, L - 20), cf = CFrame.new(0, 30, zm), transparency = 1, collide = false, castShadow = false })
	motes.CanQuery = false
	Kit.particles(motes, { color = { 150, 230, 255 }, size = 0.25, sizeEnd = 0.1, rate = 18, lifetime = 8, speed = 0.4, accel = Vector3.new(0, 0.3, 0), emission = 1, transparency = 0.3 })

	return {
		palette = {
			accent = GLOW,
			gate = { 70, 92, 104 },
			gateMaterial = Enum.Material.CorrodedMetal,
			nest = { 48, 64, 86 },
			nestMaterial = Enum.Material.Slate,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">Droughtlands</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 3 — Droughtlands. "Nothing grows. Everything cracks."
	A sun-baked clay pan split by dark crack lines (a few still glowing with
	trapped heat), a dry riverbed snaking across the route, banded sandstone
	mesas walling in the sides, saguaro cacti, dead trees, tumbleweeds and the
	bleached ribcage of something enormous arching over the trail. Behind the
	nest the route passes under the hero: a sandstone arch crowned by a giant
	horned cattle skull with embers smouldering in its eye sockets.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local CLAY = { 206, 146, 98 }
local CLAY_LIGHT = { 224, 172, 120 }
local CLAY_DARK = { 184, 124, 84 }
local TRAIL = { 228, 196, 150 }
local CRACK = { 72, 42, 28 }
local BED = { 232, 210, 170 }
local BONE = { 236, 226, 200 }
local BONE_DARK = { 196, 182, 154 }
local CACTUS = { 88, 132, 74 }
local DEADWOOD = { 128, 106, 88 }
-- the Skull Arch stands right in front of the Frostfall gate; everything above its mouth is lifted
-- so the gate sign reads through the mouth from far away
local MOUTH_LIFT = 10
local HEAT = { 255, 130, 40 }
local BANDS = { { 196, 112, 74 }, { 226, 164, 108 }, { 178, 96, 66 }, { 236, 196, 146 }, { 206, 134, 88 } }

-- cylinder between two points (Roblox cylinders run along local X)
local function rod(Kit, parent, a, b, d, o)
	if math.abs(b.X - a.X) < 0.01 and math.abs(b.Z - a.Z) < 0.01 then
		b = b + Vector3.new(0.02, 0, 0)
	end
	local mid = (a + b) / 2
	return Kit.part(parent, {
		name = o.name or "Rod",
		shape = "Cylinder",
		size = Vector3.new((b - a).Magnitude, d, d),
		cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0),
		color = o.color,
		material = o.material,
		collide = o.collide,
		transparency = o.transparency,
		castShadow = o.castShadow,
	})
end

-- Safety net: collidable decoration that strays into the run corridor (kept
-- open through the whole zone so players can reach the next gate) or the nest
-- arena is made non-colliding.
local function clearPlayArea(ctx)
	local nest = ctx.nest
	local guard = ctx.nestRadius + 14.5
	local half = ctx.pathWidth / 2 + 0.5
	for _, d in ipairs(ctx.folder:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			local cf, s = d.CFrame, d.Size / 2
			local lx, ly, lz, hx, hy, hz = math.huge, math.huge, math.huge, -math.huge, -math.huge, -math.huge
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local c = cf * Vector3.new(s.X * sx, s.Y * sy, s.Z * sz)
						lx, ly, lz = math.min(lx, c.X), math.min(ly, c.Y), math.min(lz, c.Z)
						hx, hy, hz = math.max(hx, c.X), math.max(hy, c.Y), math.max(hz, c.Z)
					end
				end
			end
			if hy > 0.8 then
				local inCorridor = ly < 12.5 and lx < half and hx > -half
				local cx = math.clamp(nest.X, lx, hx)
				local cz = math.clamp(nest.Z, lz, hz)
				local inNest = Vector3.new(cx - nest.X, 0, cz - nest.Z).Magnitude < guard
				if inCorridor or inNest then
					d.CanCollide = false
				end
			end
		end
	end
end

-- zig-zag crack line on the ground (decorative)
local function crack(ctx, parent, start, heading, segs, segLen, width, color)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local p = start
	local a = heading
	for i = 1, segs do
		a = a + ctx.rng(-0.7, 0.7)
		local len = segLen * rng(0.7, 1.3)
		local q = p + Vector3.new(math.cos(a) * len, 0, math.sin(a) * len)
		q = Vector3.new(math.clamp(q.X, -73, 73), 0, math.clamp(q.Z, ctx.z0 + 2, ctx.z1 - 2))
		if (q - p).Magnitude < 0.5 then
			break
		end
		len = (q - p).Magnitude
		local mid = (p + q) / 2
		Kit.part(parent, {
			name = "Crack",
			size = Vector3.new(width * (1 - 0.15 * i / segs), 0.12, len + width),
			cf = CFrame.lookAt(Vector3.new(mid.X, 0.03, mid.Z), Vector3.new(q.X, 0.03, q.Z)),
			color = color or CRACK,
			material = Enum.Material.Slate,
			collide = false,
			castShadow = false,
		})
		p = q
	end
	return p
end

local function mesa(ctx, parent, pos, w, d, h, bandOffset)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "Mesa")
	local layers = math.max(3, math.floor(h / 7))
	local lh = h / layers
	for i = 0, layers - 1 do
		local shrink = 1 - 0.045 * i
		Kit.part(m, {
			name = "Band",
			size = Vector3.new(w * shrink * rng(0.96, 1.04), lh + 0.2, d * shrink * rng(0.96, 1.04)),
			cf = CFrame.new(pos + Vector3.new(rng(-0.6, 0.6), lh * (i + 0.5), rng(-0.6, 0.6))) * CFrame.Angles(0, rng(-0.06, 0.06), 0),
			color = BANDS[(i + bandOffset) % #BANDS + 1],
			material = Enum.Material.Sandstone,
		})
	end
	-- flat cap of darker desert varnish
	local top = 1 - 0.045 * layers
	Kit.part(m, { name = "Cap", size = Vector3.new(w * top + 1, 1.2, d * top + 1), cf = CFrame.new(pos + Vector3.new(0, h + 0.5, 0)), color = { 150, 86, 58 }, material = Enum.Material.Sandstone })
	-- talus at the foot
	for i = 1, 2 do
		local a = rng(0, 6.28)
		local r = math.min(w, d) * 0.5
		Kit.part(m, { name = "Talus", size = Vector3.new(rng(4, 7), rng(2, 4), rng(4, 7)), cf = CFrame.new(pos + Vector3.new(math.cos(a) * r, 1, math.sin(a) * r)) * CFrame.Angles(rng(-0.3, 0.3), rng(0, 3), rng(-0.3, 0.3)), color = BANDS[(i + bandOffset) % #BANDS + 1], material = Enum.Material.Sandstone })
	end
	return m
end

local function saguaro(ctx, parent, pos, h)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "Saguaro")
	local col = Kit.shade(CACTUS, rng(0.9, 1.1))
	local d = 1.6 + h * 0.08
	Kit.cylinder(m, { name = "Trunk", height = h, diameter = d, cf = CFrame.new(pos + Vector3.new(0, h / 2, 0)), color = col, material = Enum.Material.Plastic })
	Kit.ball(m, { name = "Top", diameter = d, cf = CFrame.new(pos + Vector3.new(0, h, 0)), color = col, material = Enum.Material.Plastic })
	local arms = (h > 7) and 2 or 1
	local a0 = rng(0, 6.28)
	for i = 1, arms do
		local a = a0 + (i - 1) * math.pi + rng(-0.3, 0.3)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local y = h * rng(0.38, 0.58)
		local reach = d * 1.5
		local ad = d * 0.72
		rod(Kit, m, pos + Vector3.new(0, y, 0), pos + dir * reach + Vector3.new(0, y, 0), ad, { name = "ArmOut", color = col, material = Enum.Material.Plastic })
		local up = h * rng(0.22, 0.34)
		Kit.cylinder(m, { name = "ArmUp", height = up, diameter = ad, cf = CFrame.new(pos + dir * reach + Vector3.new(0, y + up / 2, 0)), color = col, material = Enum.Material.Plastic })
		Kit.ball(m, { name = "ArmTip", diameter = ad, cf = CFrame.new(pos + dir * reach + Vector3.new(0, y + up, 0)), color = col, material = Enum.Material.Plastic })
	end
	return m
end

local function deadTree(ctx, parent, pos, h)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "DeadTree")
	local top = pos + Vector3.new(rng(-1.5, 1.5), h, rng(-1.5, 1.5))
	rod(Kit, m, pos + Vector3.new(0, -0.5, 0), top, 1.3, { name = "Trunk", color = DEADWOOD, material = Enum.Material.Wood })
	for i = 1, 3 do
		local t = 0.45 + i * 0.15
		local from = pos:Lerp(top, t)
		local a = rng(0, 6.28)
		local len = h * rng(0.3, 0.45)
		local to = from + Vector3.new(math.cos(a) * len, len * rng(0.4, 0.9), math.sin(a) * len)
		rod(Kit, m, from, to, 0.6, { name = "Branch", color = Kit.shade(DEADWOOD, 0.9), material = Enum.Material.Wood, collide = false })
	end
	return m
end

local function tumbleweed(ctx, parent, pos, d)
	local Kit = ctx.Kit
	Kit.ball(parent, { name = "Tumbleweed", diameter = d, cf = CFrame.new(pos + Vector3.new(0, d / 2 - 0.2, 0)), color = { 176, 136, 84 }, material = Enum.Material.Grass, transparency = 0.3, collide = false })
	Kit.ball(parent, { name = "TumbleweedCore", diameter = d * 0.65, cf = CFrame.new(pos + Vector3.new(0.2, d / 2 - 0.2, 0.1)), color = { 140, 104, 64 }, material = Enum.Material.Grass, collide = false })
end

-- the bleached ribcage of a colossal beast, ribs bowing over the trail
local function ribcage(ctx, parent, zA, zB)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "Ribcage")
	local spineX = -36
	local n = 9
	for i = 0, n - 1 do
		local z = zA + (zB - zA) * i / (n - 1)
		Kit.part(m, { name = "Vertebra", size = Vector3.new(3.6, 2.6, 3.2), cf = CFrame.new(spineX, 1, z) * CFrame.Angles(0, rng(-0.1, 0.1), 0.1), color = BONE, material = Enum.Material.Limestone })
		Kit.part(m, { name = "Spinous", size = Vector3.new(1, 3.2, 1.4), cf = CFrame.new(spineX - 1.4, 3.4, z) * CFrame.Angles(0, 0, 0.5), color = BONE_DARK, material = Enum.Material.Limestone })
	end
	-- ribs (the middle ones are the tallest; two are snapped off)
	local ribs = 6
	for r = 0, ribs - 1 do
		local z = zA + 3 + r * (zB - zA - 6) / (ribs - 1)
		local H = 16 + 7 * math.sin((r + 0.5) / ribs * math.pi)
		local c, a = -8, 28
		local broken = (r == 1 or r == 4)
		local stopAt = broken and 3 or 0
		local prev
		for k = 6, stopAt, -1 do
			local th = k / 6 * math.pi
			local p = Vector3.new(c + a * math.cos(th), H * math.sin(th) + 0.4, z - math.sin(th) * 2.5)
			if prev then
				rod(Kit, m, prev, p, 1.9 - (6 - k) * 0.12, { name = "Rib", color = BONE, material = Enum.Material.Limestone })
			end
			prev = p
		end
		if broken then
			-- the lost half lies in the dust off the trail
			rod(Kit, m, Vector3.new(24, 0.6, z - 3), Vector3.new(34, 0.8, z + 4), 1.5, { name = "RibShard", color = BONE_DARK, material = Enum.Material.Limestone })
		end
	end
	-- pelvis and a trailing tail
	Kit.part(m, { name = "Pelvis", size = Vector3.new(9, 4, 6), cf = CFrame.new(spineX - 3, 1.6, zB + 6) * CFrame.Angles(0.2, 0.3, 0.15), color = BONE_DARK, material = Enum.Material.Limestone })
	for i = 1, 5 do
		local t = i / 5
		Kit.ball(m, { name = "TailBone", diameter = 2.6 - t * 1.4, cf = CFrame.new(spineX - 6 - t * 18, 0.6, zB + 10 + math.sin(t * 3) * 5), color = BONE, material = Enum.Material.Limestone })
	end
	return m
end

-- hero: a sandstone arch crowned by a giant horned cattle skull
local function skullArch(ctx, parent, zc)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "SkullArch")
	local front = zc - 8
	for side = -1, 1, 2 do
		for i = 0, 4 do
			Kit.part(m, { name = "ArchPillar", size = Vector3.new(14 - i * 0.6, 6.2, 16 - i * 0.6), cf = CFrame.new(side * 21.5, 3 + i * 6, zc) * CFrame.Angles(0, rng(-0.03, 0.03), 0), color = BANDS[(i + 1) % #BANDS + 1], material = Enum.Material.Sandstone })
		end
		Kit.part(m, { name = "Rubble", size = Vector3.new(5, 3, 4), cf = CFrame.new(side * 30, 1.2, zc - 6) * CFrame.Angles(0.2, 0.5, 0.1), color = BANDS[2], material = Enum.Material.Sandstone })
	end
	Kit.part(m, { name = "Lintel", size = Vector3.new(58, 7, 16), cf = CFrame.new(0, 21.5, zc), color = BANDS[4], material = Enum.Material.Sandstone })
	Kit.part(m, { name = "LintelBand", size = Vector3.new(58.4, 1.6, 16.4), cf = CFrame.new(0, 19.6, zc), color = BANDS[3], material = Enum.Material.Sandstone })
	-- skull: snout drops toward the lintel, cranium above, cheekbones taper
	Kit.part(m, { name = "Snout", size = Vector3.new(15, 11, 12), cf = CFrame.new(0, 30.5, zc - 1), color = BONE, material = Enum.Material.Limestone })
	Kit.part(m, { name = "Muzzle", size = Vector3.new(12, 4, 11), cf = CFrame.new(0, 26.5, zc - 1.5), color = BONE_DARK, material = Enum.Material.Limestone })
	for side = -1, 1, 2 do
		Kit.part(m, { name = "Nostril", size = Vector3.new(2.2, 3, 0.6), cf = CFrame.new(side * 3, 28.5, zc - 7.2), color = { 52, 34, 26 }, material = Enum.Material.Slate })
		Kit.part(m, { name = "Cheekbone", size = Vector3.new(7, 13, 13), cf = CFrame.new(side * 10, 34, zc) * CFrame.Angles(0, 0, side * 0.32), color = BONE, material = Enum.Material.Limestone })
	end
	Kit.part(m, { name = "Cranium", size = Vector3.new(30, 17, 16), cf = CFrame.new(0, 44.5, zc), color = BONE, material = Enum.Material.Limestone })
	Kit.part(m, { name = "Crown", size = Vector3.new(22, 4, 13), cf = CFrame.new(0, 54.5, zc + 0.5), color = BONE, material = Enum.Material.Limestone })
	Kit.part(m, { name = "Brow", size = Vector3.new(31, 2.6, 3), cf = CFrame.new(0, 48.6, front - 0.6), color = BONE_DARK, material = Enum.Material.Limestone })
	for side = -1, 1, 2 do
		Kit.part(m, { name = "EyeSocket", size = Vector3.new(8, 7, 0.8), cf = CFrame.new(side * 7.5, 43.5, front - 0.3), color = { 40, 24, 18 }, material = Enum.Material.Slate })
		local ember = Kit.ball(m, { name = "Ember", diameter = 2.4, cf = CFrame.new(side * 7.5, 43, front - 0.6), color = HEAT, material = Enum.Material.Neon, collide = false })
		Kit.light(ember, HEAT, 22, 1.6)
		-- horn: a boss, then a sweep out and up
		Kit.ball(m, { name = "HornBoss", diameter = 7, cf = CFrame.new(side * 15, 47, zc), color = BONE_DARK, material = Enum.Material.Limestone })
		local pts = {
			Vector3.new(side * 15, 47, zc),
			Vector3.new(side * 27, 45, zc - 1),
			Vector3.new(side * 38, 48, zc - 2),
			Vector3.new(side * 46, 55, zc - 2.5),
			Vector3.new(side * 49, 64, zc - 2),
		}
		local ds = { 6.2, 5, 3.8, 2.6 }
		for i = 1, 4 do
			local col = Kit.mix(BONE, { 120, 96, 72 }, (i - 1) / 4)
			rod(Kit, m, pts[i], pts[i + 1], ds[i], { name = "Horn", color = col, material = Enum.Material.Limestone })
		end
		Kit.ball(m, { name = "HornTip", diameter = 2, cf = CFrame.new(pts[5]), color = { 110, 88, 66 }, material = Enum.Material.Limestone })
	end
	-- weathering cracks across the bone
	Kit.part(m, { name = "BoneCrack", size = Vector3.new(0.4, 9, 0.3), cf = CFrame.new(-2, 47, front - 0.1) * CFrame.Angles(0, 0, 0.4), color = { 120, 100, 80 }, material = Enum.Material.Slate, collide = false })
	Kit.part(m, { name = "BoneCrack", size = Vector3.new(0.4, 6, 0.3), cf = CFrame.new(3, 33, zc - 7.1) * CFrame.Angles(0, 0, -0.5), color = { 120, 100, 80 }, material = Enum.Material.Slate, collide = false })
	for _, c in ipairs(m:GetChildren()) do
		if c:IsA("BasePart") and c.Name ~= "ArchPillar" and c.Name ~= "Rubble" then
			c.CFrame = c.CFrame + Vector3.new(0, MOUTH_LIFT, 0)
		end
	end
	return m
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W = ctx.z0, ctx.z1, ctx.width
	local rng = ctx.rng
	local nest = ctx.nest
	local half = ctx.pathWidth / 2
	local nestGuard = ctx.nestRadius + 14

	local function clear(x, z, r)
		if math.abs(x) - r < half + 2 then
			return false
		end
		if (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude - r * 1.42 < nestGuard + 1 then
			return false
		end
		if z - r < z0 + 3 or z + r > z1 - 2 then
			return false
		end
		if math.abs(x) < 26 + r and z - r < z0 + 6 then
			return false
		end
		return true
	end

	---------------------------------------------------------------------
	-- ground: baked clay plates in slightly different tones
	---------------------------------------------------------------------
	local cols = { { -75, -45 }, { -45, -13 }, { -13, 13 }, { 13, 45 }, { 45, 75 } }
	local rows = 7
	local rowLen = ctx.length / rows
	for r = 0, rows - 1 do
		for c, span in ipairs(cols) do
			local pick = ((r * 3 + c) % 3 == 0) and CLAY_DARK or (((r + c) % 2 == 0) and CLAY or CLAY_LIGHT)
			Kit.part(f, { name = "Ground", size = Vector3.new(span[2] - span[1], 4, rowLen), cf = CFrame.new((span[1] + span[2]) / 2, -2, z0 + (r + 0.5) * rowLen), color = Kit.shade(pick, rng(0.96, 1.04)), material = (c == 3) and Enum.Material.Sandstone or Enum.Material.Ground })
		end
	end
	-- worn trail of packed dust to the nest
	local trailEnd = nest.Z - nestGuard + 8
	Kit.part(f, { name = "Trail", size = Vector3.new(ctx.pathWidth - 6, 0.2, trailEnd - z0), cf = CFrame.new(0, 0.06, (z0 + trailEnd) / 2), color = TRAIL, material = Enum.Material.Sand, collide = false })
	for i = 0, 5 do
		for side = -1, 1, 2 do
			Kit.part(f, { name = "TrailEdge", size = Vector3.new(rng(3, 5), 0.18, rng(12, 18)), cf = CFrame.new(side * (half - 3 + rng(0, 1.5)), 0.05, z0 + 10 + i * (trailEnd - z0 - 10) / 6) * CFrame.Angles(0, rng(-0.3, 0.3), 0), color = Kit.mix(TRAIL, CLAY, 0.5), material = Enum.Material.Sand, collide = false })
		end
	end

	---------------------------------------------------------------------
	-- cracks: a dark network over the whole pan, radiating from the nest
	---------------------------------------------------------------------
	for i = 1, 24 do
		local x = rng(-70, 70)
		local z = rng(z0 + 6, z1 - 10)
		crack(ctx, f, Vector3.new(x, 0, z), rng(0, 6.28), 4, rng(4, 7), rng(0.3, 0.55))
	end
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + rng(-0.2, 0.2)
		local start = nest + Vector3.new(math.cos(a), 0, math.sin(a)) * (ctx.nestRadius + 8)
		crack(ctx, f, start, a, 3, rng(5, 8), 0.6)
	end
	-- deep fissures still glowing with trapped heat
	for _, s in ipairs({ { -42, z0 + 30, 0.3 }, { 40, z0 + 84, 2.6 }, { -56, z0 + 186, 1.4 } }) do
		local start = Vector3.new(s[1], 0, s[2])
		crack(ctx, f, start, s[3], 3, 8, 1.6)
		local p = start + Vector3.new(math.cos(s[3]) * 10, 0, math.sin(s[3]) * 10)
		local glow = Kit.part(f, { name = "HeatSeam", size = Vector3.new(0.5, 0.14, 16), cf = CFrame.lookAt(Vector3.new(start.X, 0.06, start.Z), Vector3.new(p.X, 0.06, p.Z)) * CFrame.new(0, 0, -6), color = HEAT, material = Enum.Material.Neon, collide = false, castShadow = false })
		Kit.light(glow, HEAT, 14, 0.9)
	end

	---------------------------------------------------------------------
	-- dry riverbed meandering across the pan (flush, crosses the trail)
	---------------------------------------------------------------------
	local river = {
		Vector3.new(-80, 0, z0 + 152), Vector3.new(-52, 0, z0 + 136), Vector3.new(-26, 0, z0 + 120),
		Vector3.new(0, 0, z0 + 104), Vector3.new(24, 0, z0 + 90), Vector3.new(48, 0, z0 + 64), Vector3.new(80, 0, z0 + 50),
	}
	for i = 1, #river - 1 do
		local a, b = river[i], river[i + 1]
		local len = (b - a).Magnitude + 6
		local cf = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.05, 0), b + Vector3.new(0, 0.05, 0))
		Kit.part(f, { name = "Riverbed", size = Vector3.new(12, 0.16, len), cf = cf, color = BED, material = Enum.Material.Sand, collide = false, castShadow = false })
		for side = -1, 1, 2 do
			Kit.part(f, { name = "RiverBank", size = Vector3.new(1.4, 0.22, len), cf = cf * CFrame.new(side * 6.4, 0.02, 0), color = Kit.shade(CLAY_DARK, 0.85), material = Enum.Material.Ground, collide = false, castShadow = false })
		end
		for k = 1, 3 do
			local p = a:Lerp(b, rng(0, 1)) + Vector3.new(rng(-4, 4), 0, rng(-4, 4))
			Kit.ball(f, { name = "Pebble", diameter = rng(0.6, 1.6), cf = CFrame.new(p.X, 0.15, p.Z), color = Kit.shade({ 190, 170, 150 }, rng(0.8, 1.1)), material = Enum.Material.Pebble, collide = false })
		end
	end

	---------------------------------------------------------------------
	-- banded mesas & buttes walling in the sides
	---------------------------------------------------------------------
	local mesas = {
		{ -63, z0 + 32, 20, 26, 44 }, { -62, z0 + 108, 22, 30, 34 }, { -64, z0 + 212, 20, 24, 54 },
		{ 64, z0 + 56, 22, 28, 40 }, { 64, z0 + 140, 20, 24, 50 }, { 66, z0 + 228, 16, 20, 30 },
		{ -48, z0 + 64, 8, 8, 26 }, { 52, z0 + 104, 7, 8, 32 },
	}
	for i, s in ipairs(mesas) do
		mesa(ctx, f, Vector3.new(s[1], 0, s[2]), s[3], s[4], s[5], i)
	end

	---------------------------------------------------------------------
	-- saguaros, dead trees and tumbleweeds
	---------------------------------------------------------------------
	local cacti = {
		{ -22, z0 + 18, 9 }, { 23, z0 + 44, 11 }, { -30, z0 + 96, 7 }, { 34, z0 + 124, 12 },
		{ -40, z0 + 150, 10 }, { 22, z0 + 12, 6 }, { -54, z0 + 240, 12 }, { 56, z0 + 250, 9 },
		{ 44, z0 + 30, 8 }, { -46, z0 + 8, 10 }, { 58, z0 + 186, 8 }, { -64, z0 + 160, 9 },
	}
	for _, s in ipairs(cacti) do
		if clear(s[1], s[2], 3) then
			saguaro(ctx, f, Vector3.new(s[1], 0, s[2]), s[3])
		end
	end
	for _, s in ipairs({ { 30, z0 + 70, 12 }, { -26, z0 + 56, 10 }, { 46, z0 + 160, 14 }, { -52, z0 + 132, 11 }, { 36, z0 + 238, 12 }, { -36, z0 + 250, 10 } }) do
		if clear(s[1], s[2], 4) then
			deadTree(ctx, f, Vector3.new(s[1], 0, s[2]), s[3])
		end
	end
	for i = 1, 8 do
		tumbleweed(ctx, f, Vector3.new(rng(-60, 60), 0, rng(z0 + 10, z1 - 30)), rng(2.4, 4))
	end

	---------------------------------------------------------------------
	-- the ribcage the trail runs through
	---------------------------------------------------------------------
	ribcage(ctx, f, z0 + 70, z0 + 116)

	---------------------------------------------------------------------
	-- hero: the skull arch behind the nest; dust blows across it
	---------------------------------------------------------------------
	skullArch(ctx, f, z1 - 20)
	local dust = Kit.part(f, { name = "DustDrift", size = Vector3.new(140, 6, 40), cf = CFrame.new(0, 3, z0 + 60), transparency = 1, collide = false, castShadow = false })
	dust.CanQuery = false
	Kit.particles(dust, { color = { 230, 200, 150 }, color2 = { 210, 170, 120 }, size = 2.5, sizeEnd = 5, transparency = 0.75, rate = 6, lifetime = 4, speed = 4, spread = 20, emission = 0, accel = Vector3.new(6, 0, 0), texture = "rbxasset://textures/particles/smoke_main.dds" })

	clearPlayArea(ctx)

	return {
		palette = {
			accent = { 255, 176, 72 },
			gate = { 196, 138, 88 },
			gateMaterial = Enum.Material.Sandstone,
			nest = { 178, 124, 84 },
			nestMaterial = Enum.Material.Sandstone,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">Frostfall</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 4 — Frostfall. "The cold bites back."
	A snowbound pass: packed-snow trail over deep snow with glacier and ice
	sheets, wind-carved drifts banked against the walls, snow-capped pines,
	jagged glowing ice crystals, a frozen pond, frost lanterns and an ice arch
	dripping icicles over the route. Behind the nest rises the hero: a glacier
	wall carved into an ice cathedral, twin spired towers around a gateway the
	route runs through, a glowing rose window, and an aurora above it all.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local SNOW = { 238, 244, 252 }
local SNOW_SHADE = { 214, 226, 242 }
local PACKED = { 196, 210, 228 }
local ICE = { 162, 212, 242 }
local GLACIER = { 150, 200, 236 }
local GLACIER_DEEP = { 112, 168, 220 }
local PINE = { 38, 80, 60 }
local PINE_LIGHT = { 52, 98, 70 }
local BARK = { 88, 64, 50 }
local COLD = { 120, 214, 255 }
local AURORA = { { 110, 255, 200 }, { 130, 190, 255 }, { 180, 140, 255 }, { 100, 240, 230 } }
-- the Ice Cathedral gateway stands right in front of the Magma Basin gate; lifted so its sign reads through it
local GATEWAY_LIFT = 8

-- cylinder between two points (Roblox cylinders run along local X)
local function rod(Kit, parent, a, b, d, o)
	if math.abs(b.X - a.X) < 0.01 and math.abs(b.Z - a.Z) < 0.01 then
		b = b + Vector3.new(0.02, 0, 0)
	end
	local mid = (a + b) / 2
	return Kit.part(parent, {
		name = o.name or "Rod",
		shape = "Cylinder",
		size = Vector3.new((b - a).Magnitude, d, d),
		cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0),
		color = o.color,
		material = o.material,
		collide = o.collide,
		transparency = o.transparency,
		castShadow = o.castShadow,
	})
end

-- Safety net: collidable decoration that strays into the run corridor (kept
-- open through the whole zone so players can reach the next gate) or the nest
-- arena is made non-colliding.
local function clearPlayArea(ctx)
	local nest = ctx.nest
	local guard = ctx.nestRadius + 14.5
	local half = ctx.pathWidth / 2 + 0.5
	for _, d in ipairs(ctx.folder:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			local cf, s = d.CFrame, d.Size / 2
			local lx, ly, lz, hx, hy, hz = math.huge, math.huge, math.huge, -math.huge, -math.huge, -math.huge
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local c = cf * Vector3.new(s.X * sx, s.Y * sy, s.Z * sz)
						lx, ly, lz = math.min(lx, c.X), math.min(ly, c.Y), math.min(lz, c.Z)
						hx, hy, hz = math.max(hx, c.X), math.max(hy, c.Y), math.max(hz, c.Z)
					end
				end
			end
			if hy > 0.8 then
				local inCorridor = ly < 12.5 and lx < half and hx > -half
				local cx = math.clamp(nest.X, lx, hx)
				local cz = math.clamp(nest.Z, lz, hz)
				local inNest = Vector3.new(cx - nest.X, 0, cz - nest.Z).Magnitude < guard
				if inCorridor or inNest then
					d.CanCollide = false
				end
			end
		end
	end
end

-- square pyramid (or a two-faced chisel point when `faces` = 2) from wedges.
-- `base` is the CFrame at the centre of the bottom face; slopes face outward.
local function peak(Kit, parent, base, sx, sz, h, o, faces)
	faces = faces or 4
	local step = (faces == 4) and 1 or 2
	for i = 0, 3, step do
		local even = (i % 2 == 0)
		local w = even and sx or sz
		local d = even and sz or sx
		Kit.part(parent, {
			name = o.name or "Peak",
			shape = "Wedge",
			size = Vector3.new(w, h, d / 2),
			cf = base * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, h / 2, -d / 4),
			color = o.color,
			material = o.material,
			transparency = o.transparency,
			reflectance = o.reflectance,
			collide = o.collide,
		})
	end
end

local function pine(ctx, parent, pos, scale, tiers)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "Pine")
	local trunkH = 4 * scale
	Kit.cylinder(m, { name = "Trunk", height = trunkH + 2, diameter = 1.4 * scale, cf = CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)), color = BARK, material = Enum.Material.Wood })
	local y = trunkH * 0.6
	local yaw = rng(0, 1.57)
	for t = 1, tiers do
		local k = 1 - (t - 1) / (tiers + 0.6)
		local s = 12 * scale * k
		local h = 6.5 * scale * (0.85 + 0.15 * k)
		local base = CFrame.new(pos + Vector3.new(0, y, 0)) * CFrame.Angles(0, yaw + t * 0.785, 0)
		peak(Kit, m, base, s, s, h, { name = "Needles", color = (t % 2 == 0) and PINE_LIGHT or PINE, material = Enum.Material.Grass })
		-- snow resting on the upper half of every tier above the lowest
		if t >= 2 then
			peak(Kit, m, base * CFrame.new(0, h * 0.5 - 0.15, 0), s * 0.56, s * 0.56, h * 0.56, { name = "SnowCap", color = SNOW, material = Enum.Material.Snow })
		end
		y = y + h * 0.62
	end
	return m
end

local function iceCluster(ctx, parent, pos, n, scale, lit)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "IceCrystals")
	for i = 1, n do
		local w = rng(1.6, 3) * scale
		local h = rng(5, 11) * scale * ((i == 1) and 1.35 or 1)
		local off = (i == 1) and Vector3.new(0, 0, 0) or Vector3.new(rng(-2.5, 2.5) * scale, 0, rng(-2.5, 2.5) * scale)
		local base = CFrame.new(pos + off + Vector3.new(0, -0.5, 0)) * CFrame.Angles(rng(-0.35, 0.35), rng(0, 3.14), rng(-0.35, 0.35))
		local col = (i % 2 == 0) and ICE or Kit.mix(ICE, { 255, 255, 255 }, 0.35)
		Kit.part(m, { name = "Shard", size = Vector3.new(w, h, w * 0.8), cf = base * CFrame.new(0, h / 2, 0), color = col, material = Enum.Material.Glass, transparency = 0.25, reflectance = 0.15 })
		peak(Kit, m, base * CFrame.new(0, h, 0), w, w * 0.8, w * 1.1, { name = "ShardTip", color = col, material = Enum.Material.Glass, transparency = 0.25, reflectance = 0.15 }, 2)
	end
	if lit then
		local core = Kit.ball(m, { name = "ColdCore", diameter = 1.4 * scale, cf = CFrame.new(pos + Vector3.new(0, 1.2 * scale, 0)), color = COLD, material = Enum.Material.Neon, collide = false })
		Kit.light(core, COLD, 18 * scale, 1.3)
	end
	return m
end

-- wind-packed drift: a wedge whose slope faces `dir`
local function drift(ctx, parent, pos, dir, len, h, depth)
	local Kit = ctx.Kit
	local c = pos + Vector3.new(0, h / 2 - 0.1, 0)
	return Kit.part(parent, { name = "Snowdrift", shape = "Wedge", size = Vector3.new(len, h, depth), cf = CFrame.lookAt(c, c + dir), color = Kit.shade(SNOW, ctx.rng(0.95, 1)), material = Enum.Material.Snow })
end

local function icicles(ctx, parent, from, to, y, count, maxLen)
	local Kit = ctx.Kit
	local rng = ctx.rng
	for i = 1, count do
		local p = from:Lerp(to, (i - 0.5) / count)
		local len = rng(maxLen * 0.4, maxLen)
		local w = rng(0.5, 0.9)
		Kit.part(parent, { name = "Icicle", size = Vector3.new(w, len, w), cf = CFrame.new(p.X + rng(-0.3, 0.3), y - len / 2, p.Z) * CFrame.Angles(0, 0.785, 0), color = Kit.mix(ICE, { 255, 255, 255 }, 0.4), material = Enum.Material.Ice, transparency = 0.15, collide = false })
	end
end

local function lantern(ctx, parent, pos)
	local Kit = ctx.Kit
	Kit.cylinder(parent, { name = "LanternPost", height = 9, diameter = 0.7, cf = CFrame.new(pos + Vector3.new(0, 4.5, 0)), color = { 60, 70, 86 }, material = Enum.Material.Metal })
	local lamp = Kit.part(parent, { name = "FrostLantern", size = Vector3.new(1.4, 1.8, 1.4), cf = CFrame.new(pos + Vector3.new(0, 9.6, 0)), color = COLD, material = Enum.Material.Neon })
	Kit.light(lamp, COLD, 20, 1.1)
	Kit.part(parent, { name = "LanternSnow", size = Vector3.new(2, 0.5, 2), cf = CFrame.new(pos + Vector3.new(0, 10.75, 0)), color = SNOW, material = Enum.Material.Snow })
end

-- hero: the glacier wall carved into an ice cathedral
local function cathedral(ctx, parent, zc)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "IceCathedral")
	local depth = 22
	local front = zc - depth / 2
	-- twin towers framing the gateway
	for side = -1, 1, 2 do
		local x = side * 21
		Kit.part(m, { name = "TowerBase", size = Vector3.new(15, 6, depth + 2), cf = CFrame.new(side * 21.8, 3, zc), color = GLACIER_DEEP, material = Enum.Material.Glacier })
		Kit.part(m, { name = "Tower", size = Vector3.new(14, 56, depth - 2), cf = CFrame.new(x, 32, zc), color = GLACIER, material = Enum.Material.Glacier })
		Kit.part(m, { name = "TowerSnow", size = Vector3.new(14.6, 1.4, depth - 1.4), cf = CFrame.new(x, 60.5, zc), color = SNOW, material = Enum.Material.Snow })
		peak(Kit, m, CFrame.new(x, 61, zc), 12, 12, 24, { name = "Spire", color = Kit.mix(ICE, { 255, 255, 255 }, 0.3), material = Enum.Material.Glass, transparency = 0.15, reflectance = 0.2 })
		-- glowing lancet window up each tower
		local slit = Kit.part(m, { name = "Lancet", size = Vector3.new(3, 16, 0.4), cf = CFrame.new(x, 40, front + 0.8), color = COLD, material = Enum.Material.Neon, transparency = 0.2, collide = false })
		Kit.light(slit, COLD, 24, 1)
		-- glacier wings out to the walls, jagged on top
		local wingX = { 36, 52, 67 }
		local wingH = { 44, 52, 38 }
		for i = 1, 3 do
			local wx = side * wingX[i]
			local w = (i == 3) and 16 or 17
			local h = wingH[i] + rng(-3, 3)
			Kit.part(m, { name = "GlacierWall", size = Vector3.new(w, h, depth - 4 + i * 1.5), cf = CFrame.new(wx, h / 2, zc + 1) * CFrame.Angles(0, rng(-0.04, 0.04), 0), color = (i % 2 == 0) and GLACIER or GLACIER_DEEP, material = Enum.Material.Glacier })
			Kit.part(m, { name = "GlacierShard", size = Vector3.new(w * 0.5, 14, 7), cf = CFrame.new(wx + rng(-3, 3), h + 3, zc + rng(-3, 3)) * CFrame.Angles(rng(-0.3, 0.3), rng(0, 1), side * rng(0.2, 0.5)), color = Kit.mix(GLACIER, { 255, 255, 255 }, 0.3), material = Enum.Material.Ice, transparency = 0.1 })
		end
		-- frozen waterfall pouring down the wing face
		Kit.part(m, { name = "FrozenFall", size = Vector3.new(6, 38, 1.2), cf = CFrame.new(side * 44, 19, front + 1.2), color = Kit.mix(ICE, { 255, 255, 255 }, 0.5), material = Enum.Material.Glass, transparency = 0.3, reflectance = 0.2, collide = false })
		icicles(ctx, m, Vector3.new(side * 30, 0, front - 0.6), Vector3.new(side * 60, 0, front - 0.6), 30, 5, 6)
	end
	-- the gateway: header block, pointed arch ribs and the rose window
	local beforeGateway = {}
	for _, c in ipairs(m:GetChildren()) do
		beforeGateway[c] = true
	end
	Kit.part(m, { name = "Header", size = Vector3.new(28.5, 30, depth - 4), cf = CFrame.new(0, 37, zc), color = GLACIER, material = Enum.Material.Glacier })
	Kit.part(m, { name = "HeaderSnow", size = Vector3.new(29, 1.4, depth - 3.4), cf = CFrame.new(0, 52.6, zc), color = SNOW, material = Enum.Material.Snow })
	peak(Kit, m, CFrame.new(0, 53, zc), 28, depth - 4, 12, { name = "Gable", color = GLACIER_DEEP, material = Enum.Material.Glacier }, 2)
	for side = -1, 1, 2 do
		local rib = Kit.part(m, { name = "ArchRib", size = Vector3.new(2, 15, 2), cf = CFrame.lookAt(Vector3.new(side * 7, 16.5, front - 1.4), Vector3.new(side * 7, 16.5, front - 5)) * CFrame.Angles(0, 0, side * 0.62), color = Kit.mix(ICE, { 255, 255, 255 }, 0.5), material = Enum.Material.Ice, collide = false })
		rib.CastShadow = false
	end
	local rose = Kit.part(m, { name = "RoseWindow", shape = "Cylinder", size = Vector3.new(0.6, 13, 13), cf = CFrame.new(0, 37, front - 1.5) * CFrame.Angles(0, math.pi / 2, 0), color = COLD, material = Enum.Material.Neon, transparency = 0.1, collide = false })
	Kit.light(rose, COLD, 60, 2)
	Kit.part(m, { name = "RoseFrame", shape = "Cylinder", size = Vector3.new(0.6, 16, 16), cf = CFrame.new(0, 37, front - 1.2) * CFrame.Angles(0, math.pi / 2, 0), color = SNOW, material = Enum.Material.Ice })
	for i = 0, 2 do
		Kit.part(m, { name = "RoseTracery", size = Vector3.new(0.7, 13, 0.4), cf = CFrame.new(0, 37, front - 1.9) * CFrame.Angles(0, 0, i * math.pi / 3), color = SNOW, material = Enum.Material.Ice, collide = false })
	end
	icicles(ctx, m, Vector3.new(-12.5, 0, front + 0.5), Vector3.new(12.5, 0, front + 0.5), 22, 7, 5)
	-- raise the gateway so the Magma Basin gate sign right behind it stays readable through the arch
	for _, c in ipairs(m:GetChildren()) do
		if not beforeGateway[c] and c:IsA("BasePart") then
			c.CFrame = c.CFrame + Vector3.new(0, GATEWAY_LIFT, 0)
		end
	end
	return m
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W = ctx.z0, ctx.z1, ctx.width
	local rng = ctx.rng
	local nest = ctx.nest
	local half = ctx.pathWidth / 2
	local nestGuard = ctx.nestRadius + 14

	local function clear(x, z, r)
		if math.abs(x) - r < half + 2 then
			return false
		end
		if (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude - r * 1.42 < nestGuard + 1 then
			return false
		end
		if z - r < z0 + 3 or z + r > z1 - 2 then
			return false
		end
		if math.abs(x) < 26 + r and z - r < z0 + 6 then
			return false
		end
		return true
	end

	---------------------------------------------------------------------
	-- ground: deep snow with glacier sheets toward the walls
	---------------------------------------------------------------------
	local cols = { { -75, -45 }, { -45, -13 }, { -13, 13 }, { 13, 45 }, { 45, 75 } }
	local rows = 7
	local rowLen = ctx.length / rows
	for r = 0, rows - 1 do
		for c, span in ipairs(cols) do
			local edge = (c == 1 or c == 5) and (r % 3 == 1)
			Kit.part(f, {
				name = "Ground",
				size = Vector3.new(span[2] - span[1], 4, rowLen),
				cf = CFrame.new((span[1] + span[2]) / 2, -2, z0 + (r + 0.5) * rowLen),
				color = edge and GLACIER or Kit.shade(((r + c) % 2 == 0) and SNOW or SNOW_SHADE, rng(0.98, 1.01)),
				material = edge and Enum.Material.Glacier or Enum.Material.Snow,
			})
		end
	end
	-- packed-snow trail with sheets of ice across it
	local trailEnd = nest.Z - nestGuard + 8
	Kit.part(f, { name = "Trail", size = Vector3.new(ctx.pathWidth - 4, 0.2, trailEnd - z0), cf = CFrame.new(0, 0.06, (z0 + trailEnd) / 2), color = PACKED, material = Enum.Material.Snow, collide = false })
	for i = 0, 5 do
		for side = -1, 1, 2 do
			Kit.part(f, { name = "TrailEdge", size = Vector3.new(rng(2.5, 4), 0.18, rng(12, 18)), cf = CFrame.new(side * (half - 2 + rng(0, 1.5)), 0.05, z0 + 10 + i * (trailEnd - z0 - 10) / 6) * CFrame.Angles(0, rng(-0.3, 0.3), 0), color = Kit.mix(PACKED, SNOW, 0.5), material = Enum.Material.Snow, collide = false })
		end
	end
	for i = 1, 12 do
		local x = rng(-66, 66)
		local z = rng(z0 + 8, z1 - 30)
		Kit.cylinder(f, { name = "IceSheet", height = 0.16, diameter = rng(6, 15), cf = CFrame.new(x, 0.08, z), color = (i % 3 == 0) and GLACIER or ICE, material = (i % 3 == 0) and Enum.Material.Glacier or Enum.Material.Ice, reflectance = 0.2, collide = false, castShadow = false })
	end
	-- a polished ice ring around the nest
	Kit.cylinder(f, { name = "NestIce", height = 0.2, diameter = ctx.nestRadius * 2 + 30, cf = CFrame.new(nest.X, 0.08, nest.Z), color = ICE, material = Enum.Material.Ice, reflectance = 0.25, collide = false, castShadow = false })

	---------------------------------------------------------------------
	-- drifts banked against the walls and along the trail
	---------------------------------------------------------------------
	for i = 0, 6 do
		for side = -1, 1, 2 do
			local z = z0 + 18 + i * 34 + rng(-4, 4)
			local h = rng(4, 8)
			local depth = rng(10, 16)
			drift(ctx, f, Vector3.new(side * (75 - depth / 2), 0, z), Vector3.new(-side, 0, 0), rng(18, 26), h, depth)
		end
	end
	for i = 0, 4 do
		for side = -1, 1, 2 do
			local z = z0 + 14 + i * 24 + rng(-3, 3)
			drift(ctx, f, Vector3.new(side * (half + 4.5), 0, z), Vector3.new(-side, 0, 0), rng(8, 12), rng(1.2, 2), 5)
		end
	end
	for i = 1, 8 do
		local x = (i % 2 == 0 and 1 or -1) * rng(24, 60)
		local z = rng(z0 + 10, z1 - 30)
		if clear(x, z, 4) then
			Kit.ball(f, { name = "SnowMound", diameter = rng(6, 10), cf = CFrame.new(x, -1.5, z), color = SNOW, material = Enum.Material.Snow })
		end
	end

	---------------------------------------------------------------------
	-- snowy pines: big ones near the walls, small ones closer in
	---------------------------------------------------------------------
	local bigPines = {
		{ -58, z0 + 26 }, { 60, z0 + 44 }, { -62, z0 + 84 }, { 56, z0 + 108 },
		{ -60, z0 + 150 }, { 62, z0 + 178 }, { -64, z0 + 208 }, { 34, z0 + 16 },
	}
	for _, p in ipairs(bigPines) do
		if clear(p[1], p[2], 7) then
			pine(ctx, f, Vector3.new(p[1], 0, p[2]), 1.1 + rng(0, 0.35), 3)
		end
	end
	local smallPines = {
		{ -30, z0 + 40 }, { 28, z0 + 66 }, { -36, z0 + 112 }, { 40, z0 + 132 },
		{ -24, z0 + 20 }, { 46, z0 + 82 }, { -44, z0 + 64 }, { 30, z0 + 100 },
	}
	for _, p in ipairs(smallPines) do
		if clear(p[1], p[2], 4) then
			pine(ctx, f, Vector3.new(p[1], 0, p[2]), 0.6 + rng(0, 0.2), 2)
		end
	end

	---------------------------------------------------------------------
	-- jagged ice crystals, some glowing cold blue
	---------------------------------------------------------------------
	local crystals = {
		{ -22, z0 + 58, 1, true }, { 24, z0 + 30, 0.9, false }, { -48, z0 + 128, 1.3, true },
		{ 50, z0 + 150, 1.4, true }, { 22, z0 + 112, 0.8, false }, { -40, z0 + 10, 1, false },
		{ 66, z0 + 234, 1.3, true },
	}
	for _, c in ipairs(crystals) do
		if clear(c[1], c[2], 4 * c[3]) then
			iceCluster(ctx, f, Vector3.new(c[1], 0, c[2]), 3, c[3], c[4])
		end
	end

	---------------------------------------------------------------------
	-- the frozen pond, ringed with snow, reeds caught in the ice
	---------------------------------------------------------------------
	local pond = Vector3.new(-44, 0, z0 + 92)
	Kit.cylinder(f, { name = "FrozenPond", height = 0.4, diameter = 26, cf = CFrame.new(pond.X, 0, pond.Z), color = { 140, 196, 232 }, material = Enum.Material.Ice, reflectance = 0.35 })
	Kit.cylinder(f, { name = "PondDeep", height = 0.42, diameter = 14, cf = CFrame.new(pond.X + 2, 0.01, pond.Z - 1), color = { 90, 150, 205 }, material = Enum.Material.Ice, reflectance = 0.4, collide = false })
	Kit.cylinder(f, { name = "FishingHole", height = 0.44, diameter = 2.2, cf = CFrame.new(pond.X + 5, 0.02, pond.Z + 3), color = { 30, 50, 80 }, material = Enum.Material.Glass, collide = false })
	for i = 0, 8 do
		local a = i / 9 * math.pi * 2
		local p = pond + Vector3.new(math.cos(a), 0, math.sin(a)) * 13.5
		Kit.ball(f, { name = "PondSnow", diameter = rng(3, 5), cf = CFrame.new(p.X, -0.6, p.Z), color = SNOW, material = Enum.Material.Snow })
	end
	for i = 1, 5 do
		local p = pond + Vector3.new(rng(-11, -6), 0, rng(-6, 6))
		Kit.part(f, { name = "FrozenReed", size = Vector3.new(0.25, rng(2, 3.5), 0.25), cf = CFrame.new(p.X, 1.2, p.Z) * CFrame.Angles(rng(-0.2, 0.2), 0, rng(-0.2, 0.2)), color = { 150, 140, 110 }, material = Enum.Material.Grass, collide = false })
	end

	---------------------------------------------------------------------
	-- frost lanterns and an ice arch with icicles over the route
	---------------------------------------------------------------------
	for _, z in ipairs({ z0 + 36, z0 + 96 }) do
		for side = -1, 1, 2 do
			lantern(ctx, f, Vector3.new(side * 16.5, 0, z))
		end
	end
	local archZ = z0 + 70
	local prev
	for i = 0, 6 do
		local th = math.pi * i / 6
		local p = Vector3.new(math.cos(th) * 20, math.sin(th) * 20, archZ)
		if prev then
			local mid = (prev + p) / 2
			Kit.part(f, { name = "IceArch", size = Vector3.new(4, 3, (p - prev).Magnitude + 1.6), cf = CFrame.lookAt(mid, p), color = Kit.mix(ICE, { 255, 255, 255 }, 0.25), material = Enum.Material.Ice, transparency = 0.15, reflectance = 0.15, collide = false })
		end
		prev = p
	end
	icicles(ctx, f, Vector3.new(-9, 0, archZ), Vector3.new(9, 0, archZ), 17.6, 6, 4)

	---------------------------------------------------------------------
	-- hero: the ice cathedral; aurora ribbons and snowfall above
	---------------------------------------------------------------------
	cathedral(ctx, f, z1 - 16)
	for i = 1, 4 do
		local ribbon = Kit.part(f, {
			name = "Aurora",
			size = Vector3.new(70, 12, 0.4),
			cf = CFrame.new(-48 + i * 22, 96 + i * 4, z1 - 2 - i * 8) * CFrame.Angles(0.2, rng(-0.4, 0.4), rng(-0.15, 0.15)),
			color = AURORA[i],
			material = Enum.Material.Neon,
			transparency = 0.7,
			collide = false,
			castShadow = false,
		})
		ribbon.CanQuery = false
	end
	local sky = Kit.part(f, { name = "Snowfall", size = Vector3.new(150, 2, 250), cf = CFrame.new(0, 60, (z0 + z1) / 2), transparency = 1, collide = false, castShadow = false })
	sky.CanQuery = false
	Kit.particles(sky, { color = { 255, 255, 255 }, size = 0.35, sizeEnd = 0.25, transparency = 0.1, rate = 45, lifetime = 12, speed = 1, spread = 30, emission = 0.3, accel = Vector3.new(1.5, -5, 0) })

	clearPlayArea(ctx)

	return {
		palette = {
			accent = { 150, 226, 255 },
			gate = { 196, 220, 240 },
			gateMaterial = Enum.Material.Glacier,
			nest = { 186, 214, 238 },
			nestMaterial = Enum.Material.Ice,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">Generic</string><ProtectedString name="Source"><![CDATA[--[[
	Generic fallback zone builder: used only when a zone has no dedicated
	builder in World/Zones/<ZoneId>.lua. Gives each zone a distinct ground
	material/color and simple props so the route is always playable.
]]

local PALETTES = {
	Overgrowth = { ground = { 70, 120, 50 }, mat = Enum.Material.LeafyGrass, prop = { 150, 90, 160 }, accent = { 170, 255, 110 } },
	Droughtlands = { ground = { 205, 160, 105 }, mat = Enum.Material.Sandstone, prop = { 170, 110, 70 }, accent = { 255, 200, 90 } },
	Frostfall = { ground = { 235, 242, 255 }, mat = Enum.Material.Snow, prop = { 150, 210, 255 }, accent = { 170, 230, 255 } },
	MagmaBasin = { ground = { 50, 40, 40 }, mat = Enum.Material.Basalt, prop = { 255, 90, 20 }, accent = { 255, 120, 40 } },
	DeepAbyss = { ground = { 30, 50, 80 }, mat = Enum.Material.Sand, prop = { 60, 220, 200 }, accent = { 80, 230, 255 } },
	Prehistoric = { ground = { 110, 120, 60 }, mat = Enum.Material.Ground, prop = { 230, 220, 190 }, accent = { 255, 180, 70 } },
	Skylands = { ground = { 230, 235, 255 }, mat = Enum.Material.SmoothPlastic, prop = { 255, 255, 255 }, accent = { 170, 210, 255 } },
	VoidRealm = { ground = { 20, 10, 30 }, mat = Enum.Material.Glass, prop = { 160, 60, 255 }, accent = { 200, 100, 255 } },
}

return function(ctx)
	local Kit = ctx.Kit
	local pal = PALETTES[ctx.zone.id] or { ground = { 120, 120, 120 }, mat = Enum.Material.Slate, prop = { 200, 200, 200 }, accent = { 255, 255, 255 } }
	local zm = (ctx.z0 + ctx.z1) / 2
	Kit.part(ctx.folder, { name = "Ground", size = Vector3.new(ctx.width, 4, ctx.length), cf = CFrame.new(0, -2, zm), color = pal.ground, material = pal.mat })
	Kit.part(ctx.folder, { name = "Path", size = Vector3.new(ctx.pathWidth, 0.3, ctx.length * 0.55), cf = CFrame.new(0, 0.15, ctx.z0 + ctx.length * 0.275), color = Kit.shade(pal.ground, 0.8), material = pal.mat })
	for i = 1, 26 do
		local side = (i % 2 == 0) and 1 or -1
		local x = side * ctx.rng(ctx.pathWidth / 2 + 8, ctx.width / 2 - 6)
		local z = ctx.rng(ctx.z0 + 8, ctx.z1 - 8)
		if (Vector3.new(x, 0, z) - ctx.nest).Magnitude > ctx.nestRadius + 14 then
			local h = ctx.rng(3, 12)
			Kit.part(ctx.folder, { name = "Prop", size = Vector3.new(ctx.rng(3, 8), h, ctx.rng(3, 8)), cf = CFrame.new(x, h / 2, z) * CFrame.Angles(0, ctx.rng(0, 3), 0), color = pal.prop, material = pal.mat })
		end
	end
	return { palette = { accent = pal.accent, gate = Kit.shade(pal.ground, 0.6), nest = Kit.shade(pal.ground, 0.7) } }
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">MagmaBasin</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 5 — Magma Basin. "The ground is the disaster."
	A scorched basin of basalt and cracked lava rock: a glowing lava river
	cuts across the route under a dark basalt bridge, lava pools simmer at
	the sides, volcanic spires and black obsidian shards jut from the ground,
	steam vents hiss, ash-covered dead trees smoulder and ash drifts down.
	The hero closes the zone: an erupting volcano with a glowing crater,
	lava streaming down its face and a lava-tube tunnel through its base that
	the route runs through.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local BASALT = { 52, 46, 46 }
local BASALT_DARK = { 34, 30, 32 }
local SCORCH = { 72, 52, 44 }
local PATH = { 84, 78, 78 }
local LAVA = { 255, 112, 28 }
local LAVA_HOT = { 255, 190, 60 }
local EMBER = { 255, 84, 24 }
local OBSIDIAN = { 18, 14, 22 }
local ASH = { 150, 144, 140 }
local CHAR = { 44, 38, 36 }

-- cylinder between two points (Roblox cylinders run along local X)
local function rod(Kit, parent, a, b, d, o)
	if math.abs(b.X - a.X) < 0.01 and math.abs(b.Z - a.Z) < 0.01 then
		b = b + Vector3.new(0.02, 0, 0)
	end
	local mid = (a + b) / 2
	return Kit.part(parent, {
		name = o.name or "Rod",
		shape = "Cylinder",
		size = Vector3.new((b - a).Magnitude, d, d),
		cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0),
		color = o.color,
		material = o.material,
		collide = o.collide,
		transparency = o.transparency,
		castShadow = o.castShadow,
	})
end

-- Safety net: collidable decoration that strays into the run corridor (kept
-- open through the whole zone so players can reach the next gate) or the nest
-- arena is made non-colliding.
local function clearPlayArea(ctx)
	local nest = ctx.nest
	local guard = ctx.nestRadius + 14.5
	local half = ctx.pathWidth / 2 + 0.5
	for _, d in ipairs(ctx.folder:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			local cf, s = d.CFrame, d.Size / 2
			local lx, ly, lz, hx, hy, hz = math.huge, math.huge, math.huge, -math.huge, -math.huge, -math.huge
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local c = cf * Vector3.new(s.X * sx, s.Y * sy, s.Z * sz)
						lx, ly, lz = math.min(lx, c.X), math.min(ly, c.Y), math.min(lz, c.Z)
						hx, hy, hz = math.max(hx, c.X), math.max(hy, c.Y), math.max(hz, c.Z)
					end
				end
			end
			if hy > 0.8 then
				local inCorridor = ly < 12.5 and lx < half and hx > -half
				local cx = math.clamp(nest.X, lx, hx)
				local cz = math.clamp(nest.Z, lz, hz)
				local inNest = Vector3.new(cx - nest.X, 0, cz - nest.Z).Magnitude < guard
				if inCorridor or inNest then
					d.CanCollide = false
				end
			end
		end
	end
end

-- two-faced chisel point from wedges; `base` is the CFrame at the bottom centre
local function chisel(Kit, parent, base, w, d, h, o)
	for i = 0, 2, 2 do
		Kit.part(parent, {
			name = o.name or "Tip",
			shape = "Wedge",
			size = Vector3.new(w, h, d / 2),
			cf = base * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, h / 2, -d / 4),
			color = o.color,
			material = o.material,
			reflectance = o.reflectance,
			collide = o.collide,
		})
	end
end

-- flowing lava ribbon between points; banks of dark crust where requested
local function lavaRiver(ctx, parent, pts, width, banks, skip)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "LavaRiver")
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		if not (skip and skip(a, b)) then
			local len = (b - a).Magnitude + width * 0.6
			local cf = CFrame.lookAt((a + b) / 2 + Vector3.new(0, 0.06, 0), b + Vector3.new(0, 0.06, 0))
			local lava = Kit.part(m, { name = "Lava", size = Vector3.new(width, 0.2, len), cf = cf, color = (i % 2 == 0) and LAVA or EMBER, material = Enum.Material.Neon, collide = false, castShadow = false })
			Kit.part(m, { name = "LavaCore", size = Vector3.new(width * 0.4, 0.24, len * 0.9), cf = cf * CFrame.new(0, 0.02, 0), color = LAVA_HOT, material = Enum.Material.Neon, collide = false, castShadow = false })
			Kit.light(lava, LAVA, width * 2.6, 1.4)
			if banks then
				for side = -1, 1, 2 do
					Kit.part(m, { name = "Crust", size = Vector3.new(1.8, 0.6, len), cf = cf * CFrame.new(side * (width / 2 + 0.7), 0.24, 0), color = BASALT_DARK, material = Enum.Material.Basalt })
				end
			end
		end
	end
	return m
end

local function lavaPool(ctx, parent, pos, d)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "LavaPool")
	local lava = Kit.cylinder(m, { name = "Lava", height = 0.2, diameter = d, cf = CFrame.new(pos + Vector3.new(0, 0.07, 0)), color = LAVA, material = Enum.Material.Neon, collide = false, castShadow = false })
	Kit.cylinder(m, { name = "LavaCore", height = 0.24, diameter = d * 0.5, cf = CFrame.new(pos + Vector3.new(rng(-1, 1), 0.09, rng(-1, 1))), color = LAVA_HOT, material = Enum.Material.Neon, collide = false, castShadow = false })
	Kit.light(lava, LAVA, d * 1.6, 1.6)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2 + rng(-0.3, 0.3)
		local p = pos + Vector3.new(math.cos(a), 0, math.sin(a)) * (d / 2 + 0.6)
		Kit.part(m, { name = "RimRock", size = Vector3.new(rng(3, 5), rng(1, 2.2), rng(2, 3.5)), cf = CFrame.lookAt(Vector3.new(p.X, 0.3, p.Z), Vector3.new(pos.X, 0.3, pos.Z)) * CFrame.Angles(rng(-0.2, 0.2), 0, rng(-0.2, 0.2)), color = BASALT_DARK, material = Enum.Material.Basalt })
	end
	return m
end

local function spire(ctx, parent, pos, h, seam)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "RockSpire")
	local n = 4
	local y = 0
	local w = h * 0.32
	local yaw = rng(0, 1.5)
	for i = 1, n do
		local sh = h / n * 1.15
		local k = 1 - (i - 1) / n * 0.8
		Kit.part(m, { name = "Spire", size = Vector3.new(w * k, sh, w * k * 0.85), cf = CFrame.new(pos + Vector3.new(rng(-0.4, 0.4) * i, y + sh / 2, rng(-0.4, 0.4) * i)) * CFrame.Angles(rng(-0.06, 0.06), yaw + i * 0.4, rng(-0.06, 0.06)), color = (i % 2 == 0) and BASALT or BASALT_DARK, material = Enum.Material.Basalt })
		y = y + sh * 0.85
	end
	if seam then
		local glow = Kit.part(m, { name = "MagmaSeam", size = Vector3.new(0.4, h * 0.55, 0.4), cf = CFrame.new(pos + Vector3.new(0, h * 0.3, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.new(w * 0.5, 0, 0) * CFrame.Angles(0, 0, 0.12), color = EMBER, material = Enum.Material.Neon, collide = false })
		Kit.light(glow, EMBER, 12, 0.9)
	end
	return m
end

local function steamVent(ctx, parent, pos, hot)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "SteamVent")
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		local p = pos + Vector3.new(math.cos(a) * 2.2, 0, math.sin(a) * 2.2)
		Kit.part(m, { name = "VentRock", size = Vector3.new(2.2, rng(1.2, 2.4), 1.6), cf = CFrame.lookAt(Vector3.new(p.X, 0.5, p.Z), Vector3.new(pos.X, 0.5, pos.Z)) * CFrame.Angles(-0.35, 0, 0), color = BASALT, material = Enum.Material.Basalt })
	end
	local mouth = Kit.cylinder(m, { name = "VentMouth", height = 0.3, diameter = 2.6, cf = CFrame.new(pos + Vector3.new(0, 0.2, 0)), color = hot and LAVA or { 30, 26, 26 }, material = hot and Enum.Material.Neon or Enum.Material.Basalt, collide = false })
	Kit.particles(mouth, { color = { 220, 214, 210 }, color2 = { 120, 116, 116 }, size = 2, sizeEnd = 7, transparency = 0.45, rate = 9, lifetime = 3, speed = 9, spread = 12, emission = 0, accel = Vector3.new(0.8, 2, 0), drag = 0.6, texture = "rbxasset://textures/particles/smoke_main.dds" })
	if hot then
		Kit.light(mouth, LAVA, 12, 1.2)
	end
	return m
end

local function obsidian(ctx, parent, pos, scale)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "Obsidian")
	for i = 1, 3 do
		local w = rng(1.4, 2.6) * scale
		local d = w * 0.7
		local h = rng(3.5, 8) * scale * ((i == 1) and 1.3 or 1)
		local off = (i == 1) and Vector3.new(0, 0, 0) or Vector3.new(rng(-2.2, 2.2) * scale, 0, rng(-2.2, 2.2) * scale)
		local base = CFrame.new(pos + off + Vector3.new(0, -0.4, 0)) * CFrame.Angles(rng(-0.4, 0.4), rng(0, 3.14), rng(-0.4, 0.4))
		Kit.part(m, { name = "Shard", size = Vector3.new(w, h, d), cf = base * CFrame.new(0, h / 2, 0), color = OBSIDIAN, material = Enum.Material.Glass, reflectance = 0.35 })
		chisel(Kit, m, base * CFrame.new(0, h, 0), w, d, w * 1.2, { name = "ShardTip", color = OBSIDIAN, material = Enum.Material.Glass, reflectance = 0.35 })
	end
	return m
end

-- a cluster of hexagonal-ish basalt columns, tallest in the middle
local function basaltColumns(ctx, parent, pos, n, tall)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "BasaltColumns")
	for i = 1, n do
		local a = i / n * math.pi * 2
		local r = (i == 1) and 0 or rng(2, 4.5)
		local h = tall * ((i == 1) and 1 or rng(0.35, 0.85))
		local p = pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		Kit.cylinder(m, { name = "Column", height = h, diameter = rng(2.6, 3.4), cf = CFrame.new(p + Vector3.new(0, h / 2, 0)), color = Kit.shade(BASALT, rng(0.75, 1.1)), material = Enum.Material.Basalt })
		if i % 3 == 0 then
			Kit.cylinder(m, { name = "AshCap", height = 0.3, diameter = 2.4, cf = CFrame.new(p + Vector3.new(0, h + 0.1, 0)), color = ASH, material = Enum.Material.Slate, collide = false })
		end
	end
	return m
end

local function ashTree(ctx, parent, pos, h)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "AshTree")
	local top = pos + Vector3.new(rng(-1.2, 1.2), h, rng(-1.2, 1.2))
	rod(Kit, m, pos + Vector3.new(0, -0.5, 0), top, 1.4, { name = "CharredTrunk", color = CHAR, material = Enum.Material.Wood })
	Kit.cylinder(m, { name = "AshDrift", height = 1, diameter = 4, cf = CFrame.new(pos + Vector3.new(0, 0.3, 0)), color = ASH, material = Enum.Material.Slate })
	for i = 1, 3 do
		local from = pos:Lerp(top, 0.45 + i * 0.15)
		local a = rng(0, 6.28)
		local len = h * rng(0.28, 0.42)
		local to = from + Vector3.new(math.cos(a) * len, len * rng(0.3, 0.8), math.sin(a) * len)
		rod(Kit, m, from, to, 0.55, { name = "Branch", color = (i == 2) and Kit.mix(CHAR, ASH, 0.5) or CHAR, material = Enum.Material.Wood, collide = false })
		if i == 1 then
			local ember = Kit.ball(m, { name = "Ember", diameter = 0.6, cf = CFrame.new(to), color = EMBER, material = Enum.Material.Neon, collide = false })
			Kit.light(ember, EMBER, 6, 0.8)
		end
	end
	return m
end

-- hero: a truncated volcano cone facing the gate, lava tube through its base
local function volcano(ctx, parent, zc)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "Volcano")
	local depth = 30
	local front = zc - depth / 2
	local tube = 14 -- half-width of the lava tube (the route runs through it)
	-- as tall as the next zone's gate sign, so the sign stays readable through the tube
	local tubeH = 30
	local k = 70 / 75 -- flank slope
	local rimY = k * (75 - tube)
	-- flanks: wedges rising from the side walls to the crater rim
	for side = -1, 1, 2 do
		local c = Vector3.new(side * (75 + tube) / 2, rimY / 2, zc)
		Kit.part(m, { name = "Flank", shape = "Wedge", size = Vector3.new(depth, rimY, 75 - tube), cf = CFrame.lookAt(c, c + Vector3.new(side, 0, 0)), color = (side < 0) and BASALT or Kit.shade(BASALT, 0.9), material = Enum.Material.Basalt })
		-- tube walls: dark basalt frame at the tunnel mouth
		Kit.part(m, { name = "TubeFrame", size = Vector3.new(3, tubeH + 1, 3), cf = CFrame.new(side * (tube + 2.5), (tubeH + 1) / 2, front - 0.5), color = BASALT_DARK, material = Enum.Material.Basalt })
		local glow = Kit.part(m, { name = "TubeGlow", size = Vector3.new(0.4, 1.2, 18), cf = CFrame.new(side * (tube + 0.3), 9, zc), color = LAVA, material = Enum.Material.Neon, collide = false })
		Kit.light(glow, LAVA, 22, 1.5)
		-- lava streaming down the face into a pool at the foot
		local pts = {
			Vector3.new(side * 9, rimY, front - 0.6),
			Vector3.new(side * 16, rimY - 14, front - 0.8),
			Vector3.new(side * 22, rimY - 28, front - 0.8),
			Vector3.new(side * 30, rimY - 42, front - 0.8),
			Vector3.new(side * 36, 0.4, front - 1.6),
		}
		for i = 1, 4 do
			rod(Kit, m, pts[i], pts[i + 1], 2.2 - i * 0.2, { name = "LavaFlow", color = (i % 2 == 0) and LAVA or LAVA_HOT, material = Enum.Material.Neon, collide = false, castShadow = false })
		end
		-- craggy boulders on the lower slopes
		for i = 1, 3 do
			local x = side * (24 + i * 12)
			local y = k * (75 - math.abs(x)) * rng(0.2, 0.5)
			Kit.part(m, { name = "Crag", size = Vector3.new(rng(6, 9), rng(5, 8), rng(4, 6)), cf = CFrame.new(x, y, front + 1) * CFrame.Angles(rng(-0.3, 0.3), rng(-0.5, 0.5), rng(-0.4, 0.4)), color = BASALT_DARK, material = Enum.Material.Basalt })
		end
		-- crater rim
		Kit.part(m, { name = "Rim", size = Vector3.new(6, 4, depth - 2), cf = CFrame.new(side * (tube - 1), rimY + 1.2, zc) * CFrame.Angles(0, 0, side * 0.25), color = BASALT_DARK, material = Enum.Material.Basalt })
	end
	-- mass above the tube, crater lip front/back
	Kit.part(m, { name = "Crown", size = Vector3.new(tube * 2, rimY - tubeH, depth), cf = CFrame.new(0, tubeH + (rimY - tubeH) / 2, zc), color = SCORCH, material = Enum.Material.CrackedLava })
	Kit.part(m, { name = "TubeLintel", size = Vector3.new(tube * 2 + 8, 3, 3), cf = CFrame.new(0, tubeH + 0.5, front + 0.5), color = BASALT_DARK, material = Enum.Material.Basalt })
	for side = -1, 1, 2 do
		Kit.part(m, { name = "Lip", size = Vector3.new(tube * 2 - 2, 2.4, 3), cf = CFrame.new(0, rimY + 0.8, zc + side * (depth / 2 - 2)) * CFrame.Angles(side * 0.2, 0, 0), color = BASALT_DARK, material = Enum.Material.Basalt })
	end
	-- the glowing crater: magma lake, fountain blobs, smoke and embers
	local crater = Kit.part(m, { name = "Crater", size = Vector3.new(tube * 2 - 4, 0.6, depth - 6), cf = CFrame.new(0, rimY + 0.2, zc), color = LAVA, material = Enum.Material.Neon, collide = false })
	Kit.light(crater, LAVA, 60, 3)
	Kit.part(m, { name = "CraterCore", size = Vector3.new(tube, 0.7, depth * 0.45), cf = CFrame.new(0, rimY + 0.3, zc), color = LAVA_HOT, material = Enum.Material.Neon, collide = false })
	for i = 1, 5 do
		Kit.ball(m, { name = "LavaBlob", diameter = rng(1.5, 3), cf = CFrame.new(rng(-6, 6), rimY + 3 + i * 2.2, zc + rng(-5, 5)), color = (i % 2 == 0) and LAVA_HOT or LAVA, material = Enum.Material.Neon, collide = false, castShadow = false })
	end
	local plume = Kit.part(m, { name = "Plume", size = Vector3.new(16, 2, 16), cf = CFrame.new(0, rimY + 3, zc), transparency = 1, collide = false, castShadow = false })
	plume.CanQuery = false
	Kit.particles(plume, { color = { 70, 62, 60 }, color2 = { 30, 28, 30 }, size = 8, sizeEnd = 22, transparency = 0.3, rate = 10, lifetime = 7, speed = 14, spread = 14, emission = 0, accel = Vector3.new(2, 1.5, 0), drag = 0.3, texture = "rbxasset://textures/particles/smoke_main.dds" })
	Kit.particles(plume, { color = LAVA_HOT, color2 = EMBER, size = 0.6, sizeEnd = 0.1, transparency = 0, rate = 30, lifetime = 2.5, speed = 26, spread = 25, emission = 1, accel = Vector3.new(0, -18, 0) })
	return m
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W = ctx.z0, ctx.z1, ctx.width
	local rng = ctx.rng
	local nest = ctx.nest
	local half = ctx.pathWidth / 2
	local nestGuard = ctx.nestRadius + 14

	local function clear(x, z, r)
		if math.abs(x) - r < half + 2 then
			return false
		end
		if (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude - r * 1.42 < nestGuard + 1 then
			return false
		end
		if z - r < z0 + 3 or z + r > z1 - 2 then
			return false
		end
		if math.abs(x) < 26 + r and z - r < z0 + 6 then
			return false
		end
		return true
	end

	---------------------------------------------------------------------
	-- ground: basalt and cracked lava rock, a paved basalt causeway
	---------------------------------------------------------------------
	local cols = { { -75, -45 }, { -45, -13 }, { -13, 13 }, { 13, 45 }, { 45, 75 } }
	local rows = 7
	local rowLen = ctx.length / rows
	for r = 0, rows - 1 do
		for c, span in ipairs(cols) do
			local lavaRock = (c ~= 3) and ((r + c) % 3 == 0)
			Kit.part(f, {
				name = "Ground",
				size = Vector3.new(span[2] - span[1], 4, rowLen),
				cf = CFrame.new((span[1] + span[2]) / 2, -2, z0 + (r + 0.5) * rowLen),
				color = lavaRock and SCORCH or Kit.shade(((r + c) % 2 == 0) and BASALT or BASALT_DARK, rng(0.95, 1.08)),
				material = lavaRock and Enum.Material.CrackedLava or Enum.Material.Basalt,
			})
		end
	end
	local pathEnd = nest.Z - nestGuard + 8
	Kit.part(f, { name = "Causeway", size = Vector3.new(ctx.pathWidth - 4, 0.24, pathEnd - z0), cf = CFrame.new(0, 0.07, (z0 + pathEnd) / 2), color = PATH, material = Enum.Material.Slate, collide = false })
	for side = -1, 1, 2 do
		Kit.part(f, { name = "CausewayEdge", size = Vector3.new(1, 0.5, pathEnd - z0 - 4), cf = CFrame.new(side * (half - 1.5), 0.2, (z0 + pathEnd) / 2), color = BASALT_DARK, material = Enum.Material.Basalt, collide = false })
	end
	-- glowing fault lines scattered over the basin and ringing the nest
	for i = 1, 14 do
		local p = Vector3.new(rng(-70, 70), 0, rng(z0 + 8, z1 - 40))
		local a = rng(0, 6.28)
		for s = 1, 3 do
			a = a + rng(-0.6, 0.6)
			local len = rng(4, 7)
			local q = p + Vector3.new(math.cos(a) * len, 0, math.sin(a) * len)
			q = Vector3.new(math.clamp(q.X, -73, 73), 0, math.clamp(q.Z, z0 + 2, z1 - 2))
			local mid = (p + q) / 2
			if (q - p).Magnitude > 0.5 then
				Kit.part(f, { name = "FaultGlow", size = Vector3.new(0.35, 0.12, (q - p).Magnitude + 0.3), cf = CFrame.lookAt(Vector3.new(mid.X, 0.04, mid.Z), Vector3.new(q.X, 0.04, q.Z)), color = (s == 2) and LAVA_HOT or EMBER, material = Enum.Material.Neon, collide = false, castShadow = false })
			end
			p = q
		end
	end
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2 + rng(-0.15, 0.15)
		local p = nest + Vector3.new(math.cos(a), 0, math.sin(a)) * (ctx.nestRadius + 9)
		local q = nest + Vector3.new(math.cos(a + 0.12), 0, math.sin(a + 0.12)) * (ctx.nestRadius + 17)
		local mid = (p + q) / 2
		Kit.part(f, { name = "NestFault", size = Vector3.new(0.5, 0.12, (q - p).Magnitude), cf = CFrame.lookAt(Vector3.new(mid.X, 0.04, mid.Z), Vector3.new(q.X, 0.04, q.Z)), color = EMBER, material = Enum.Material.Neon, collide = false, castShadow = false })
	end

	---------------------------------------------------------------------
	-- the lava river across the route, spanned by a basalt bridge
	---------------------------------------------------------------------
	local riverZ = z0 + 62
	local bridgeHalf = half + 2
	lavaRiver(ctx, f, {
		Vector3.new(-80, 0, riverZ + 14), Vector3.new(-50, 0, riverZ + 8), Vector3.new(-bridgeHalf - 2, 0, riverZ),
		Vector3.new(bridgeHalf + 2, 0, riverZ), Vector3.new(46, 0, riverZ - 6), Vector3.new(80, 0, riverZ - 12),
	}, 9, true, function(a, b)
		return math.abs(a.X) < bridgeHalf + 3 and math.abs(b.X) < bridgeHalf + 3
	end)
	local bridge = Kit.model(f, "BasaltBridge")
	Kit.part(bridge, { name = "Deck", size = Vector3.new(bridgeHalf * 2 + 6, 1, 15), cf = CFrame.new(0, 0.1, riverZ), color = BASALT_DARK, material = Enum.Material.Basalt })
	for side = -1, 1, 2 do
		for i = -1, 1 do
			Kit.part(bridge, { name = "Post", size = Vector3.new(1.4, 3.4, 1.4), cf = CFrame.new(side * (half + 1.6), 2.2, riverZ + i * 6.4), color = BASALT, material = Enum.Material.Basalt })
		end
		Kit.part(bridge, { name = "Rail", size = Vector3.new(1, 0.8, 14.2), cf = CFrame.new(side * (half + 1.6), 3.6, riverZ), color = BASALT_DARK, material = Enum.Material.Basalt })
		local brazier = Kit.part(bridge, { name = "Brazier", size = Vector3.new(1, 0.8, 1), cf = CFrame.new(side * (half + 1.6), 4.4, riverZ - 6.4), color = LAVA_HOT, material = Enum.Material.Neon, collide = false })
		Kit.light(brazier, LAVA, 16, 1.2)
	end

	---------------------------------------------------------------------
	-- lava pools at the sides and a lava creek along the left wall
	---------------------------------------------------------------------
	for _, p in ipairs({ { -46, z0 + 22, 14 }, { 52, z0 + 112, 18 }, { -56, z0 + 128, 12 }, { 58, z0 + 204, 14 }, { 38, z0 + 28, 10 } }) do
		lavaPool(ctx, f, Vector3.new(p[1], 0, p[2]), p[3])
	end
	lavaRiver(ctx, f, {
		Vector3.new(-36, 0, z1 - 30), Vector3.new(-56, 0, z1 - 52), Vector3.new(-66, 0, z1 - 86),
		Vector3.new(-64, 0, z1 - 112), Vector3.new(-58, 0, z1 - 130),
	}, 6, false)

	---------------------------------------------------------------------
	-- volcanic spires, obsidian, steam vents, ash trees
	---------------------------------------------------------------------
	local spires = {
		{ -30, z0 + 40, 22, true }, { 32, z0 + 84, 26, false }, { -64, z0 + 70, 34, true }, { 66, z0 + 40, 30, false },
		{ 66, z0 + 150, 38, true }, { -68, z0 + 190, 32, false }, { 28, z0 + 16, 16, false }, { -36, z0 + 104, 18, true },
		{ 68, z0 + 236, 28, true }, { 62, z0 + 82, 20, false },
	}
	for _, s in ipairs(spires) do
		if clear(s[1], s[2], s[3] * 0.2) then
			spire(ctx, f, Vector3.new(s[1], 0, s[2]), s[3], s[4])
		end
	end
	local shards = { { 22, z0 + 50, 1 }, { -22, z0 + 78, 1.2 }, { 44, z0 + 64, 1.4 }, { -44, z0 + 60, 1 }, { 58, z0 + 172, 1.5 }, { -24, z0 + 124, 0.9 }, { 22, z0 + 112, 0.9 } }
	for _, s in ipairs(shards) do
		if clear(s[1], s[2], 3 * s[3]) then
			obsidian(ctx, f, Vector3.new(s[1], 0, s[2]), s[3])
		end
	end
	for i, v in ipairs({ { -20, z0 + 30 }, { 21, z0 + 96 }, { -52, z0 + 92 }, { 46, z0 + 140 }, { -62, z0 + 228 }, { 22, z0 + 70 } }) do
		if clear(v[1], v[2], 3) then
			steamVent(ctx, f, Vector3.new(v[1], 0, v[2]), i % 2 == 1)
		end
	end
	for _, c in ipairs({ { -60, z0 + 12, 14 }, { 60, z0 + 126, 18 }, { -66, z0 + 112, 12 }, { 66, z0 + 96, 16 }, { -66, z0 + 156, 20 }, { 64, z0 + 214, 14 }, { 30, z0 + 128, 8 } }) do
		if clear(c[1], c[2], 6) then
			basaltColumns(ctx, f, Vector3.new(c[1], 0, c[2]), 7, c[3])
		end
	end
	for _, t in ipairs({ { 40, z0 + 14, 11 }, { -54, z0 + 46, 13 }, { 48, z0 + 92, 10 }, { -48, z0 + 152, 12 }, { 54, z0 + 186, 11 }, { -30, z0 + 16, 9 } }) do
		if clear(t[1], t[2], 3) then
			ashTree(ctx, f, Vector3.new(t[1], 0, t[2]), t[3])
		end
	end

	---------------------------------------------------------------------
	-- hero: the erupting volcano; ash falling over the whole basin
	---------------------------------------------------------------------
	volcano(ctx, f, z1 - 18)
	local sky = Kit.part(f, { name = "Ashfall", size = Vector3.new(150, 2, 250), cf = CFrame.new(0, 55, (z0 + z1) / 2), transparency = 1, collide = false, castShadow = false })
	sky.CanQuery = false
	Kit.particles(sky, { color = { 120, 114, 112 }, color2 = { 80, 76, 76 }, size = 0.3, sizeEnd = 0.2, transparency = 0.2, rate = 30, lifetime = 12, speed = 1, spread = 30, emission = 0, accel = Vector3.new(1, -4, 0) })
	Kit.particles(sky, { color = LAVA_HOT, color2 = EMBER, size = 0.2, sizeEnd = 0, transparency = 0, rate = 8, lifetime = 10, speed = 1, spread = 40, emission = 1, accel = Vector3.new(0.5, -3, 0) })

	clearPlayArea(ctx)

	return {
		palette = {
			accent = { 255, 128, 44 },
			gate = { 52, 44, 44 },
			gateMaterial = Enum.Material.Basalt,
			nest = { 72, 50, 42 },
			nestMaterial = Enum.Material.CrackedLava,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">Overgrowth</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 2 — Overgrowth. "Nature fights back."
	An ancient stone road swallowed by the forest: a muddy trail over broken
	cobbles, giant spotted mushrooms (some glowing underneath), crumbling ruin
	pillars and an arch reclaimed by moss, vines and roots arching over the
	route, ferns and fireflies everywhere. Behind the nest stands the hero: a
	colossal ancient tree whose two root-legs form a living archway the route
	runs through, with a glowing heart in its trunk.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local LEAF = { 76, 140, 58 }
local LEAF_DARK = { 52, 104, 44 }
local MOSS = { 110, 170, 70 }
local MUD = { 98, 76, 52 }
local MUD_DARK = { 78, 60, 42 }
local STONE = { 128, 132, 116 }
local STONE_DARK = { 98, 104, 92 }
local BARK = { 92, 66, 44 }
local BARK_DARK = { 70, 50, 34 }
local STEM = { 236, 226, 200 }
local GLOW = { 170, 255, 110 }
local FIREFLY = { 230, 255, 140 }
local CAP_COLORS = { { 200, 60, 50 }, { 150, 70, 170 }, { 60, 150, 160 }, { 220, 130, 50 } }
local GILL_GLOWS = { { 120, 255, 200 }, { 190, 120, 255 }, { 170, 255, 110 } }
local GROUND_MATS = { Enum.Material.LeafyGrass, Enum.Material.Grass, Enum.Material.LeafyGrass, Enum.Material.Mud }

-- cylinder between two points (Roblox cylinders run along local X)
local function rod(Kit, parent, a, b, d, o)
	if math.abs(b.X - a.X) < 0.01 and math.abs(b.Z - a.Z) < 0.01 then
		b = b + Vector3.new(0.02, 0, 0)
	end
	local mid = (a + b) / 2
	return Kit.part(parent, {
		name = o.name or "Rod",
		shape = "Cylinder",
		size = Vector3.new((b - a).Magnitude, d, d),
		cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0),
		color = o.color,
		material = o.material,
		collide = o.collide,
		transparency = o.transparency,
		castShadow = o.castShadow,
	})
end

-- Safety net: collidable decoration that strays into the run corridor (kept
-- open through the whole zone so players can reach the next gate) or the nest
-- arena is made non-colliding.
local function clearPlayArea(ctx)
	local nest = ctx.nest
	local guard = ctx.nestRadius + 14.5
	local half = ctx.pathWidth / 2 + 0.5
	for _, d in ipairs(ctx.folder:GetDescendants()) do
		if d:IsA("BasePart") and d.CanCollide then
			local cf, s = d.CFrame, d.Size / 2
			local lx, ly, lz, hx, hy, hz = math.huge, math.huge, math.huge, -math.huge, -math.huge, -math.huge
			for _, sx in ipairs({ -1, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					for _, sz in ipairs({ -1, 1 }) do
						local c = cf * Vector3.new(s.X * sx, s.Y * sy, s.Z * sz)
						lx, ly, lz = math.min(lx, c.X), math.min(ly, c.Y), math.min(lz, c.Z)
						hx, hy, hz = math.max(hx, c.X), math.max(hy, c.Y), math.max(hz, c.Z)
					end
				end
			end
			if hy > 0.8 then
				local inCorridor = ly < 12.5 and lx < half and hx > -half
				local cx = math.clamp(nest.X, lx, hx)
				local cz = math.clamp(nest.Z, lz, hz)
				local inNest = Vector3.new(cx - nest.X, 0, cz - nest.Z).Magnitude < guard
				if inCorridor or inNest then
					d.CanCollide = false
				end
			end
		end
	end
end

local function mushroom(ctx, parent, pos, h, capD, colorIdx, glow)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "GiantMushroom")
	local capColor = CAP_COLORS[(colorIdx - 1) % #CAP_COLORS + 1]
	local base = CFrame.new(pos) * CFrame.Angles(rng(-0.08, 0.08), rng(0, 6.28), rng(-0.08, 0.08))
	local stemD = math.max(1.6, capD * 0.17)
	local small = capD < 6
	if not small then
		Kit.ball(m, { name = "StemBulb", diameter = stemD * 1.7, cf = base * CFrame.new(0, stemD * 0.35, 0), color = Kit.shade(STEM, 0.92), material = Enum.Material.Plastic })
	end
	Kit.cylinder(m, { name = "Stem", height = h, diameter = stemD, cf = base * CFrame.new(0, h / 2, 0), color = STEM, material = Enum.Material.Plastic })
	local capH = math.max(1.6, capD * 0.15)
	local gillColor = glow and GILL_GLOWS[(colorIdx - 1) % #GILL_GLOWS + 1] or { 225, 205, 180 }
	local gills = Kit.cylinder(m, { name = "Gills", height = 0.4, diameter = capD * 0.86, cf = base * CFrame.new(0, h - capH / 2 - 0.15, 0), color = gillColor, material = glow and Enum.Material.Neon or Enum.Material.Plastic })
	if glow then
		Kit.light(gills, gillColor, capD * 1.3, 1.1)
	end
	Kit.cylinder(m, { name = "Cap", height = capH, diameter = capD, cf = base * CFrame.new(0, h, 0), color = capColor, material = Enum.Material.SmoothPlastic })
	Kit.cylinder(m, { name = "CapDome", height = capH * 0.8, diameter = capD * 0.72, cf = base * CFrame.new(0, h + capH * 0.85, 0), color = Kit.shade(capColor, 1.06), material = Enum.Material.SmoothPlastic })
	Kit.cylinder(m, { name = "CapTop", height = capH * 0.6, diameter = capD * 0.38, cf = base * CFrame.new(0, h + capH * 1.5, 0), color = Kit.shade(capColor, 1.12), material = Enum.Material.SmoothPlastic })
	for i = 1, small and 0 or 3 do
		local a = i / 3 * math.pi * 2 + rng(-0.4, 0.4)
		local r = capD * 0.42
		Kit.ball(m, { name = "Spot", diameter = capD * 0.13, cf = base * CFrame.new(math.cos(a) * r, h + capH * 0.4, math.sin(a) * r), color = { 250, 245, 230 }, material = Enum.Material.SmoothPlastic, collide = false })
	end
	return m
end

local function ruinPillar(ctx, parent, pos, h, broken)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "RuinPillar")
	Kit.part(m, { name = "Plinth", size = Vector3.new(5.5, 1.6, 5.5), cf = CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, rng(0, 1.5), 0.04), color = STONE_DARK, material = Enum.Material.Cobblestone })
	Kit.cylinder(m, { name = "Shaft", height = h, diameter = 3.6, cf = CFrame.new(pos + Vector3.new(0, 1.4 + h / 2, 0)), color = STONE, material = Enum.Material.Cobblestone })
	if broken then
		-- the snapped-off drum leans against the base
		Kit.cylinder(m, { name = "Drum", height = 3, diameter = 3.6, cf = CFrame.new(pos + Vector3.new(3.2, 1.6, 1.5)) * CFrame.Angles(0.3, 0, 1.2), color = STONE, material = Enum.Material.Cobblestone })
		Kit.part(m, { name = "Moss", size = Vector3.new(3.8, 0.5, 3.8), cf = CFrame.new(pos + Vector3.new(0, 1.5 + h, 0)) * CFrame.Angles(0.15, 0, -0.12), color = MOSS, material = Enum.Material.LeafyGrass })
	else
		Kit.part(m, { name = "Capital", size = Vector3.new(5, 1.4, 5), cf = CFrame.new(pos + Vector3.new(0, 2.1 + h, 0)), color = STONE_DARK, material = Enum.Material.Cobblestone })
		Kit.part(m, { name = "Moss", size = Vector3.new(5.4, 0.6, 5.4), cf = CFrame.new(pos + Vector3.new(0, 3, 0) + Vector3.new(0, h, 0)), color = MOSS, material = Enum.Material.LeafyGrass })
	end
	-- ivy creeping up the shaft
	rod(Kit, m, pos + Vector3.new(1.7, 0, 0.4), pos + Vector3.new(-0.6, h * 0.8, 1.7), 0.5, { name = "Ivy", color = LEAF_DARK, material = Enum.Material.LeafyGrass, collide = false })
	return m
end

local function fern(ctx, parent, pos, scale)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local col = (rng() < 0.5) and LEAF or MOSS
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2 + rng(-0.3, 0.3)
		local len = 4.2 * scale
		Kit.part(parent, {
			name = "Frond",
			size = Vector3.new(1.3 * scale, 0.15, len),
			cf = CFrame.new(pos) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.9 * scale, -len / 2 + 0.3) * CFrame.Angles(0.55 + rng(-0.15, 0.15), 0, 0),
			color = Kit.shade(col, rng(0.85, 1.1)),
			material = Enum.Material.Grass,
			collide = false,
		})
	end
end

-- vine or root bowing over the corridor; never collides
local function overArch(ctx, parent, z, span, apex, d, color, material, hangers)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "OverArch")
	local n = 8
	local prev
	local tw = rng(-3, 3)
	for i = 0, n do
		local t = i / n
		local th = math.pi * t
		local p = Vector3.new(math.cos(th) * span, math.sin(th) * apex - 1 + (1 - math.sin(th)) * 0, z + math.sin(th * 2) * tw)
		if prev then
			local seg = rod(Kit, m, prev, p, d * (1 - 0.35 * math.sin(th)), { name = "ArchSeg", color = color, material = material, collide = false })
			seg.CastShadow = true
		end
		prev = p
	end
	-- leaves / hanging strands from the top of the arch
	for i = 1, hangers do
		local x = (i / (hangers + 1) - 0.5) * span * 1.2
		local topY = math.sqrt(math.max(0, 1 - (x / span) ^ 2)) * apex - 1
		local len = rng(3, 6)
		rod(Kit, m, Vector3.new(x, topY, z), Vector3.new(x + rng(-0.4, 0.4), topY - len, z + rng(-0.4, 0.4)), 0.35, { name = "HangingVine", color = LEAF, material = Enum.Material.LeafyGrass, collide = false })
		Kit.ball(m, { name = "Leaves", diameter = rng(1.6, 2.4), cf = CFrame.new(x, topY + 0.4, z), color = Kit.shade(LEAF, rng(0.85, 1.1)), material = Enum.Material.LeafyGrass, collide = false })
	end
	return m
end

local function ruinArch(ctx, parent, z)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "RuinArch")
	for side = -1, 1, 2 do
		local x = side * 17.8
		Kit.part(m, { name = "Plinth", size = Vector3.new(5.6, 1.6, 5.6), cf = CFrame.new(x, 0.6, z), color = STONE_DARK, material = Enum.Material.Cobblestone })
		Kit.part(m, { name = "Pillar", size = Vector3.new(4.2, 13.6, 4.2), cf = CFrame.new(x, 8.2, z) * CFrame.Angles(0, 0, side * 0.015), color = STONE, material = Enum.Material.Cobblestone })
		Kit.part(m, { name = "Capital", size = Vector3.new(5.4, 1.4, 5.4), cf = CFrame.new(x, 15.4, z), color = STONE_DARK, material = Enum.Material.Cobblestone })
		rod(Kit, m, Vector3.new(x - side * 2.2, 0, z - 1.5), Vector3.new(x + side * 0.5, 14, z - 2.3), 0.6, { name = "Ivy", color = LEAF_DARK, material = Enum.Material.LeafyGrass, collide = false })
	end
	Kit.part(m, { name = "Lintel", size = Vector3.new(42, 3.2, 4.6), cf = CFrame.new(0, 17.7, z) * CFrame.Angles(0, 0, 0.02), color = STONE, material = Enum.Material.Cobblestone })
	Kit.part(m, { name = "LintelMoss", size = Vector3.new(36, 0.8, 5), cf = CFrame.new(-2, 19.6, z) * CFrame.Angles(0, 0, 0.03), color = MOSS, material = Enum.Material.LeafyGrass })
	-- glowing rune carved into the face, the forest's mark
	local rune = Kit.part(m, { name = "Rune", size = Vector3.new(5, 1.4, 0.2), cf = CFrame.new(0, 17.7, z - 2.35), color = GLOW, material = Enum.Material.Neon, collide = false })
	Kit.light(rune, GLOW, 16, 0.8)
	for i = 1, 6 do
		local x = -16 + i * 4.6 + ctx.rng(-1, 1)
		rod(Kit, m, Vector3.new(x, 19.3, z - 2.4), Vector3.new(x, 19.3 - ctx.rng(4, 6.5), z - 2.6), 0.35, { name = "HangingVine", color = LEAF, material = Enum.Material.LeafyGrass, collide = false })
	end
	return m
end

local function brokenArch(ctx, parent, z)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "BrokenArch")
	-- left side still stands with a stub of lintel
	Kit.part(m, { name = "Plinth", size = Vector3.new(5.6, 1.6, 5.6), cf = CFrame.new(-17.8, 0.6, z), color = STONE_DARK, material = Enum.Material.Cobblestone })
	Kit.part(m, { name = "Pillar", size = Vector3.new(4.2, 13.6, 4.2), cf = CFrame.new(-17.8, 8.2, z), color = STONE, material = Enum.Material.Cobblestone })
	Kit.part(m, { name = "LintelStub", size = Vector3.new(11, 3.2, 4.6), cf = CFrame.new(-14.5, 16.4, z) * CFrame.Angles(0, 0, -0.12), color = STONE, material = Enum.Material.Cobblestone })
	Kit.part(m, { name = "Moss", size = Vector3.new(9, 0.7, 5), cf = CFrame.new(-15, 18.3, z) * CFrame.Angles(0, 0, -0.12), color = MOSS, material = Enum.Material.LeafyGrass })
	-- right side snapped; the lintel lies in the undergrowth beside the road
	Kit.part(m, { name = "Plinth", size = Vector3.new(5.6, 1.6, 5.6), cf = CFrame.new(17.8, 0.6, z), color = STONE_DARK, material = Enum.Material.Cobblestone })
	Kit.part(m, { name = "PillarStump", size = Vector3.new(4.2, 4.5, 4.2), cf = CFrame.new(17.8, 3.4, z) * CFrame.Angles(0.05, 0, 0.08), color = STONE, material = Enum.Material.Cobblestone })
	Kit.part(m, { name = "FallenLintel", size = Vector3.new(4.6, 3.2, 26), cf = CFrame.new(26, 1.3, z + 6) * CFrame.Angles(0.06, 0.25, 0.1), color = STONE, material = Enum.Material.Cobblestone })
	Kit.part(m, { name = "FallenMoss", size = Vector3.new(5, 0.6, 18), cf = CFrame.new(26.3, 3, z + 7) * CFrame.Angles(0.06, 0.25, 0.1), color = MOSS, material = Enum.Material.LeafyGrass })
	Kit.part(m, { name = "FallenPillar", size = Vector3.new(4.2, 9, 4.2), cf = CFrame.new(31, 2.1, z - 8) * CFrame.Angles(0, 0.6, math.pi / 2), color = STONE, material = Enum.Material.Cobblestone })
	return m
end

local function heroTree(ctx, parent, zt)
	local Kit = ctx.Kit
	local rng = ctx.rng
	local m = Kit.model(parent, "AncientTree")
	-- two root-legs bow inward to carry the trunk over the route
	for side = -1, 1, 2 do
		local pts = {
			Vector3.new(side * 32, -1, zt - 1),
			Vector3.new(side * 26.5, 11, zt),
			Vector3.new(side * 19, 22, zt + 1),
			Vector3.new(side * 9, 31, zt),
		}
		local ds = { 12, 10.5, 9.5 }
		for i = 1, 3 do
			rod(Kit, m, pts[i], pts[i + 1], ds[i], { name = "RootLeg", color = (i == 2) and BARK_DARK or BARK, material = Enum.Material.Wood })
		end
		Kit.ball(m, { name = "Knee", diameter = 10.5, cf = CFrame.new(pts[2]), color = BARK, material = Enum.Material.Wood })
		Kit.ball(m, { name = "Knee", diameter = 9.5, cf = CFrame.new(pts[3]), color = BARK_DARK, material = Enum.Material.Wood })
		-- root flares sprawling over the ground
		rod(Kit, m, Vector3.new(side * 30, 2.5, zt - 2), Vector3.new(side * 47, -0.6, zt - 9), 4.4, { name = "RootFlare", color = BARK, material = Enum.Material.Wood })
		rod(Kit, m, Vector3.new(side * 31, 2.5, zt + 2), Vector3.new(side * 44, -0.6, zt + 13), 4, { name = "RootFlare", color = BARK_DARK, material = Enum.Material.Wood })
		rod(Kit, m, Vector3.new(side * 27, 2.5, zt - 3), Vector3.new(side * 30, -0.6, zt - 17), 3.6, { name = "RootFlare", color = BARK, material = Enum.Material.Wood })
		-- moss on the knees
		Kit.part(m, { name = "Moss", size = Vector3.new(8, 1, 8), cf = CFrame.new(pts[2] + Vector3.new(0, 4.6, 0)) * CFrame.Angles(0, 0, side * 0.4), color = MOSS, material = Enum.Material.LeafyGrass, collide = false })
	end
	-- trunk
	Kit.cylinder(m, { name = "Trunk", height = 40, diameter = 24, cf = CFrame.new(0, 48, zt), color = BARK, material = Enum.Material.Wood })
	Kit.cylinder(m, { name = "TrunkUpper", height = 20, diameter = 17, cf = CFrame.new(0, 76, zt + 1), color = BARK_DARK, material = Enum.Material.Wood })
	Kit.cylinder(m, { name = "TrunkBase", height = 6, diameter = 20, cf = CFrame.new(0, 30, zt), color = BARK_DARK, material = Enum.Material.Wood })
	-- the glowing heart in the bark, visible from the gate
	Kit.ball(m, { name = "Hollow", diameter = 9, cf = CFrame.new(0, 46, zt - 9.6), color = { 40, 30, 22 }, material = Enum.Material.Wood })
	local heart = Kit.ball(m, { name = "Heart", diameter = 5.5, cf = CFrame.new(0, 46, zt - 12.4), color = GLOW, material = Enum.Material.Neon, collide = false })
	Kit.light(heart, GLOW, 45, 2.2)
	Kit.particles(heart, { color = GLOW, color2 = { 255, 255, 200 }, size = 0.5, sizeEnd = 0, rate = 8, lifetime = 2.5, speed = 1.5, emission = 1 })
	-- branches
	local tips = {
		Vector3.new(-32, 86, zt - 4), Vector3.new(32, 86, zt + 3),
		Vector3.new(-14, 96, zt - 8), Vector3.new(16, 98, zt + 6),
	}
	for _, tip in ipairs(tips) do
		rod(Kit, m, Vector3.new(0, 74, zt), tip, 4.5, { name = "Branch", color = BARK, material = Enum.Material.Wood, collide = false })
	end
	-- canopy
	local crowns = {
		{ Vector3.new(0, 100, zt), 36 },
		{ Vector3.new(-32, 90, zt - 4), 28 },
		{ Vector3.new(32, 90, zt + 3), 28 },
		{ Vector3.new(-54, 80, zt + 4), 22 },
		{ Vector3.new(54, 81, zt - 2), 22 },
		{ Vector3.new(-16, 106, zt + 6), 24 },
		{ Vector3.new(18, 107, zt - 6), 24 },
		{ Vector3.new(0, 86, zt - 16), 22 },
		{ Vector3.new(-40, 76, zt - 14), 16 },
		{ Vector3.new(42, 77, zt - 12), 16 },
	}
	for i, c in ipairs(crowns) do
		Kit.ball(m, { name = "Canopy", diameter = c[2], cf = CFrame.new(c[1]), color = Kit.shade((i % 2 == 0) and LEAF or LEAF_DARK, rng(0.9, 1.08)), material = Enum.Material.LeafyGrass, collide = false })
	end
	-- glowing seed pods hanging on long vines from the canopy
	for i = 1, 6 do
		local x = -48 + i * 13.7 + rng(-3, 3)
		local z = zt - 10 + rng(-4, 4)
		local top = 74 + rng(0, 4)
		local bottom = top - rng(10, 18)
		rod(Kit, m, Vector3.new(x, top, z), Vector3.new(x, bottom, z), 0.4, { name = "PodVine", color = LEAF_DARK, material = Enum.Material.LeafyGrass, collide = false })
		local pod = Kit.ball(m, { name = "SeedPod", diameter = 1.8, cf = CFrame.new(x, bottom - 0.8, z), color = GILL_GLOWS[(i % #GILL_GLOWS) + 1], material = Enum.Material.Neon, collide = false })
		if i % 2 == 0 then
			Kit.light(pod, GLOW, 14, 0.9)
		end
	end
	-- a curtain of moss hanging under the arch the runners pass through
	for i = 1, 6 do
		local x = -10 + i * 2.9 + rng(-0.6, 0.6)
		local top = 27 - math.abs(x) * 0.25
		rod(Kit, m, Vector3.new(x, top, zt - 3), Vector3.new(x + rng(-0.3, 0.3), top - rng(5, 9), zt - 3.4), 0.5, { name = "MossCurtain", color = MOSS, material = Enum.Material.LeafyGrass, collide = false })
	end
	return m
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W = ctx.z0, ctx.z1, ctx.width
	local rng = ctx.rng
	local nest = ctx.nest
	local half = ctx.pathWidth / 2
	local nestGuard = ctx.nestRadius + 14

	-- is a prop of radius r at (x, z) clear of the corridor, nest and gate?
	local function clear(x, z, r)
		if math.abs(x) - r < half + 2 then
			return false
		end
		if (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude - r * 1.42 < nestGuard + 1 then
			return false
		end
		if z - r < z0 + 3 or z + r > z1 - 2 then
			return false
		end
		if math.abs(x) < 26 + r and z - r < z0 + 6 then
			return false
		end
		return true
	end

	---------------------------------------------------------------------
	-- ground: patchwork of leafy grass, grass and mud; a mud trail runs over
	-- the cracked cobbles of the old road
	---------------------------------------------------------------------
	local cols = { { -75, -45 }, { -45, -13 }, { -13, 13 }, { 13, 45 }, { 45, 75 } }
	local rows = 8
	local rowLen = ctx.length / rows
	for r = 0, rows - 1 do
		for c, span in ipairs(cols) do
			local mat, col
			if c == 3 then
				mat, col = Enum.Material.Mud, Kit.shade(MUD, rng(0.92, 1.05))
			else
				mat = GROUND_MATS[math.floor(rng(1, #GROUND_MATS + 0.999))]
				col = (mat == Enum.Material.Mud) and Kit.shade(MUD_DARK, rng(0.95, 1.1)) or Kit.shade(((r + c) % 2 == 0) and LEAF or LEAF_DARK, rng(0.9, 1.08))
			end
			Kit.part(f, { name = "Ground", size = Vector3.new(span[2] - span[1], 4, rowLen), cf = CFrame.new((span[1] + span[2]) / 2, -2, z0 + (r + 0.5) * rowLen), color = col, material = mat })
		end
	end
	-- trail edges: ragged mud tongues spilling into the grass
	local trailEnd = nest.Z - nestGuard + 6
	for i = 0, 6 do
		local z = z0 + 8 + i * (trailEnd - z0 - 8) / 7
		for side = -1, 1, 2 do
			Kit.part(f, { name = "TrailEdge", size = Vector3.new(rng(4, 7), 0.2, rng(11, 17)), cf = CFrame.new(side * (half + rng(-0.5, 1.5)), 0.05, z) * CFrame.Angles(0, rng(-0.5, 0.5), 0), color = Kit.shade(MUD, rng(0.85, 1)), material = Enum.Material.Mud, collide = false })
		end
	end
	-- broken cobbles of the old road poking through the mud
	for i = 1, 14 do
		local x = rng(-half + 2, half - 2)
		local z = rng(z0 + 8, trailEnd)
		Kit.part(f, { name = "Cobble", size = Vector3.new(rng(2.5, 4.5), 0.3, rng(2.5, 4.5)), cf = CFrame.new(x, 0.12, z) * CFrame.Angles(0, rng(0, 1.5), 0), color = Kit.shade(STONE, rng(0.85, 1.05)), material = Enum.Material.Cobblestone })
	end
	-- moss patches everywhere (flat, decorative)
	for i = 1, 16 do
		local x = rng(-70, 70)
		local z = rng(z0 + 6, z1 - 6)
		Kit.cylinder(f, { name = "MossPatch", height = 0.2, diameter = rng(5, 14), cf = CFrame.new(x, 0.06, z), color = Kit.shade(MOSS, rng(0.85, 1.1)), material = Enum.Material.LeafyGrass, collide = false })
	end
	-- a ring of wildflower moss around the nest
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local p = nest + Vector3.new(math.cos(a), 0, math.sin(a)) * (ctx.nestRadius + 10)
		Kit.cylinder(f, { name = "NestMoss", height = 0.2, diameter = rng(8, 12), cf = CFrame.new(p.X, 0.07, p.Z), color = Kit.shade(MOSS, rng(0.95, 1.15)), material = Enum.Material.LeafyGrass, collide = false })
	end

	---------------------------------------------------------------------
	-- ruins: an arch the route still runs through, a broken one, pillars
	---------------------------------------------------------------------
	ruinArch(ctx, f, z0 + 64)
	brokenArch(ctx, f, z0 + 112)
	local pillarSpots = {
		{ -30, z0 + 22, 11, false }, { 34, z0 + 40, 13, true }, { -38, z0 + 88, 9, true },
		{ 40, z0 + 90, 14, false }, { -62, z0 + 140, 12, false }, { 63, z0 + 160, 10, true },
		{ -60, z0 + 200, 15, false }, { 60, z0 + 212, 8, true },
	}
	for _, s in ipairs(pillarSpots) do
		ruinPillar(ctx, f, Vector3.new(s[1], 0, s[2]), s[3], s[4])
	end
	-- fallen drums half sunk in the moss
	for _, d in ipairs({ { -24, z0 + 48, 0.4 }, { 28, z0 + 74, -0.9 }, { -55, z0 + 170, 1.2 }, { 52, z0 + 120, 0.2 } }) do
		Kit.cylinder(f, { name = "FallenDrum", height = 5, diameter = 3.6, cf = CFrame.new(d[1], 1.2, d[2]) * CFrame.Angles(0, d[3], math.pi / 2), color = STONE, material = Enum.Material.Cobblestone })
	end

	---------------------------------------------------------------------
	-- giant mushrooms: the recurring silhouette, biggest near the walls
	---------------------------------------------------------------------
	local shrooms = {
		{ -26, z0 + 30, 13, 13, true }, { 27, z0 + 18, 10, 11, false }, { -50, z0 + 40, 22, 19, false },
		{ 54, z0 + 56, 20, 18, true }, { 24, z0 + 100, 12, 12, true }, { -27, z0 + 128, 14, 12, false },
		{ -56, z0 + 96, 18, 16, true }, { 58, z0 + 104, 24, 20, false }, { -64, z0 + 160, 16, 14, true },
		{ 64, z0 + 186, 19, 15, true }, { -48, z0 + 236, 12, 12, true }, { 50, z0 + 240, 14, 12, true },
		{ -66, z0 + 70, 11, 10, false }, { 68, z0 + 26, 13, 12, false },
	}
	for i, s in ipairs(shrooms) do
		mushroom(ctx, f, Vector3.new(s[1], 0, s[2]), s[3], s[4], i, s[5])
	end
	-- little mushroom clusters along the trail edge
	for i = 1, 7 do
		local side = (i % 2 == 0) and 1 or -1
		local x = side * rng(18, 23)
		local z = z0 + 14 + i * 15
		if clear(x, z, 2) then
			mushroom(ctx, f, Vector3.new(x, 0, z), rng(2.5, 4), rng(3, 4.5), i + 2, i % 3 == 0)
		end
	end

	---------------------------------------------------------------------
	-- vines and roots bowing over the route (non-colliding)
	---------------------------------------------------------------------
	overArch(ctx, f, z0 + 30, 21, 21, 1.4, LEAF_DARK, Enum.Material.LeafyGrass, 4)
	overArch(ctx, f, z0 + 88, 23, 18, 2.6, BARK, Enum.Material.Wood, 3)
	overArch(ctx, f, z0 + 98, 20, 23, 1.2, LEAF, Enum.Material.LeafyGrass, 3)
	overArch(ctx, f, z0 + 124, 22, 20, 2.2, BARK_DARK, Enum.Material.Wood, 4)

	-- gnarled roots snaking along the ground at the sides
	for i = 1, 10 do
		local side = (i % 2 == 0) and 1 or -1
		local x = side * rng(20, 66)
		local z = rng(z0 + 10, z1 - 12)
		if clear(x, z, 6) then
			local a = Vector3.new(x - 5, -0.6, z + rng(-3, 3))
			local b = Vector3.new(x + 5, -0.6, z + rng(-3, 3))
			rod(Kit, f, a, Vector3.new(x, 1.2, z), 2.2, { name = "Root", color = BARK, material = Enum.Material.Wood })
			rod(Kit, f, Vector3.new(x, 1.2, z), b, 1.8, { name = "Root", color = BARK_DARK, material = Enum.Material.Wood })
		end
	end

	---------------------------------------------------------------------
	-- ferns & bushes: dense near the walls, a frond line along the trail
	---------------------------------------------------------------------
	local placed = 0
	for i = 1, 60 do
		if placed >= 13 then
			break
		end
		local side = (i % 2 == 0) and 1 or -1
		local x = side * rng(17, 72)
		local z = rng(z0 + 8, z1 - 8)
		if math.abs(x) > half + 3 and (Vector3.new(x, 0, z) - nest).Magnitude > ctx.nestRadius + 9 then
			fern(ctx, f, Vector3.new(x, 0, z), rng(0.8, 1.4))
			placed = placed + 1
		end
	end
	for i = 1, 12 do
		local side = (i % 2 == 0) and 1 or -1
		local x = side * rng(46, 70)
		local z = rng(z0 + 10, z1 - 10)
		if clear(x, z, 4) then
			local col = Kit.shade(LEAF_DARK, rng(0.85, 1.15))
			Kit.ball(f, { name = "Bush", diameter = rng(5, 7.5), cf = CFrame.new(x, 1.6, z), color = col, material = Enum.Material.LeafyGrass })
			Kit.ball(f, { name = "Bush", diameter = rng(3.5, 5), cf = CFrame.new(x + rng(-3, 3), 1.3, z + rng(-3, 3)), color = Kit.shade(col, 1.12), material = Enum.Material.LeafyGrass })
		end
	end
	-- old forest trees packed against the side walls
	for i = 0, 5 do
		for side = -1, 1, 2 do
			local z = z0 + 14 + i * 40 + rng(-5, 5)
			if clear(side * 71, z, 4) then
				ctx.tree(f, Vector3.new(side * 71, 0, z), 1.5 + rng(0, 0.5), Kit.shade(LEAF_DARK, rng(0.9, 1.1)))
			end
		end
	end

	---------------------------------------------------------------------
	-- fireflies: drifting sparkles over the undergrowth, a few lit motes
	---------------------------------------------------------------------
	for _, a in ipairs({ { -42, z0 + 60 }, { 42, z0 + 60 }, { -45, z0 + 170 }, { 45, z0 + 170 }, { 0, z0 + 70 } }) do
		local carrier = Kit.part(f, { name = "Fireflies", size = Vector3.new(34, 8, 60), cf = CFrame.new(a[1], 5, a[2]), transparency = 1, collide = false, castShadow = false })
		carrier.CanQuery = false
		Kit.particles(carrier, { color = FIREFLY, color2 = GLOW, size = 0.3, sizeEnd = 0.1, rate = 5, lifetime = 3, speed = 0.6, emission = 1, transparency = 0.1 })
	end
	for i = 1, 18 do
		local x = rng(-66, 66)
		local z = rng(z0 + 10, z1 - 10)
		local mote = Kit.ball(f, { name = "Firefly", diameter = 0.35, cf = CFrame.new(x, rng(1.5, 8), z), color = FIREFLY, material = Enum.Material.Neon, collide = false, castShadow = false })
		if i % 5 == 0 then
			Kit.light(mote, FIREFLY, 8, 0.8)
		end
	end

	---------------------------------------------------------------------
	-- hero: the colossal ancient tree arching over the route behind the nest
	---------------------------------------------------------------------
	heroTree(ctx, f, z1 - 14)

	clearPlayArea(ctx)

	return {
		palette = {
			accent = GLOW,
			gate = { 96, 112, 86 },
			gateMaterial = Enum.Material.Cobblestone,
			nest = { 92, 74, 52 },
			nestMaterial = Enum.Material.Mud,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">Prehistoric</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 7 — Prehistoric. A steaming jungle that time forgot: mud trails
	through fern-choked clearings, umbrella-crowned conifers, stubby cycads,
	bubbling tar pits and layered stone ridges. The route runs straight under
	the bleached arch of a sauropod skeleton, and a smoking volcano looms in
	the back corner behind the nest.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local SOIL = { 104, 94, 58 }
local GRASS = { 92, 128, 54 }
local GRASS_DARK = { 74, 108, 46 }
local MUD = { 96, 72, 50 }
local MUD_DARK = { 70, 52, 38 }
local STRATA = { { 150, 118, 84 }, { 126, 100, 74 }, { 168, 138, 98 } }
local BONE = { 232, 222, 196 }
local BONE_OLD = { 206, 190, 152 }
local BARK = { 96, 70, 48 }
local FROND = { { 70, 132, 52 }, { 88, 148, 58 }, { 60, 112, 50 } }
local NEEDLES = { 46, 92, 50 }
local TAR = { 14, 12, 12 }
local LAVA = { 255, 120, 30 }
local AMBER = { 255, 170, 40 }

-- Cylinder spanning two points (Roblox cylinders run along local X).
local function limb(Kit, parent, a, b, d, o)
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local flat = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local cf
	if flat.Magnitude < 0.01 then
		cf = CFrame.new(mid) * CFrame.Angles(0, 0, math.pi / 2)
	else
		cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0)
	end
	return Kit.part(parent, {
		name = o.name or "Limb",
		shape = "Cylinder",
		size = Vector3.new(len, d, d),
		cf = cf,
		color = o.color,
		material = o.material,
		collide = o.collide,
		transparency = o.transparency,
	})
end

-- Giant fern: a leafy heart with long fronds arching out low to the ground.
local function fern(ctx, parent, pos, scale)
	local Kit, rng = ctx.Kit, ctx.rng
	local color = FROND[math.floor(rng(1, #FROND + 0.99))]
	Kit.ball(parent, { name = "FernHeart", diameter = 2.4 * scale, cf = CFrame.new(pos + Vector3.new(0, 0.8 * scale, 0)), color = Kit.shade(color, 0.8), material = Enum.Material.LeafyGrass, collide = false })
	local n = 6
	local spin = rng(0, math.pi)
	for i = 1, n do
		local a = spin + i / n * math.pi * 2
		local len = (8 + rng(0, 3)) * scale
		Kit.part(parent, {
			name = "Frond",
			size = Vector3.new(2.4 * scale, 0.3, len),
			cf = CFrame.new(pos + Vector3.new(0, 1.2 * scale, 0)) * CFrame.Angles(0, a, 0) * CFrame.Angles(0.45 + rng(-0.1, 0.15), 0, 0) * CFrame.new(0, 0, -len / 2),
			color = (i % 2 == 0) and color or Kit.shade(color, 1.12),
			material = Enum.Material.LeafyGrass,
			collide = false,
		})
	end
end

-- Cycad: a scaly pineapple trunk with a crown of stiff fronds and a seed cone.
local function cycad(ctx, parent, pos, scale)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "Cycad")
	local h = 0
	for i = 1, 3 do
		local seg = 1.8 * scale
		Kit.cylinder(m, { name = "CycadTrunk", height = seg, diameter = (3.4 - i * 0.35) * scale, cf = CFrame.new(pos + Vector3.new(0, h + seg / 2, 0)), color = (i % 2 == 0) and BARK or Kit.shade(BARK, 1.2), material = Enum.Material.Wood })
		h = h + seg
	end
	local top = pos + Vector3.new(0, h, 0)
	Kit.ball(m, { name = "SeedCone", diameter = 1.8 * scale, cf = CFrame.new(top + Vector3.new(0, 0.6 * scale, 0)), color = { 220, 130, 50 }, material = Enum.Material.Pebble })
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2 + rng(0, 0.4)
		local len = 6.5 * scale
		Kit.part(m, {
			name = "CycadFrond",
			size = Vector3.new(1.4 * scale, 0.25, len),
			cf = CFrame.new(top) * CFrame.Angles(0, a, 0) * CFrame.Angles(0.55, 0, 0) * CFrame.new(0, 0, -len / 2),
			color = (i % 2 == 0) and { 64, 116, 48 } or { 80, 134, 54 },
			material = Enum.Material.Grass,
			collide = false,
		})
	end
	return m
end

-- Ancient conifer: tall bare trunk, buttress roots, umbrella tiers of needles.
local function bigTree(ctx, parent, pos, scale)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "AncientConifer")
	local h = 34 * scale
	Kit.cylinder(m, { name = "Trunk", height = h, diameter = 3.4 * scale, cf = CFrame.new(pos + Vector3.new(0, h / 2, 0)), color = BARK, material = Enum.Material.Wood })
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2 + rng(0, 1)
		Kit.part(m, {
			name = "Buttress",
			shape = "Wedge",
			size = Vector3.new(1.2 * scale, 6 * scale, 4 * scale),
			cf = CFrame.new(pos) * CFrame.Angles(0, a, 0) * CFrame.new(0, 3 * scale, -(1.6 + 2) * scale) * CFrame.Angles(0, math.pi, 0),
			color = Kit.shade(BARK, 0.9),
			material = Enum.Material.Wood,
		})
	end
	-- umbrella crown: stacked shallow discs, widest at the bottom
	for i = 0, 2 do
		local d = (22 - i * 6) * scale
		Kit.cylinder(m, {
			name = "Canopy",
			height = 2.4 * scale,
			diameter = d,
			cf = CFrame.new(pos + Vector3.new(rng(-0.5, 0.5), h - 4 * scale + i * 3.2 * scale, rng(-0.5, 0.5))),
			color = (i % 2 == 0) and NEEDLES or Kit.shade(NEEDLES, 1.18),
			material = Enum.Material.LeafyGrass,
			collide = false,
		})
	end
	-- a couple of bare branches under the crown
	for _, s in ipairs({ -1, 1 }) do
		local from = pos + Vector3.new(0, h - 9 * scale, 0)
		limb(Kit, m, from, from + Vector3.new(s * 6 * scale, 4 * scale, s * 2 * scale), 0.9 * scale, { name = "Branch", color = BARK, material = Enum.Material.Wood, collide = false })
	end
	return m
end

-- Tar pit: a glossy black pool flush with the mud, bubbles and a doomed bone.
local function tarPit(ctx, parent, pos, d)
	local Kit, rng = ctx.Kit, ctx.rng
	Kit.cylinder(parent, { name = "TarRim", height = 0.3, diameter = d + 5, cf = CFrame.new(pos + Vector3.new(0, 0, 0)), color = MUD_DARK, material = Enum.Material.Mud })
	Kit.cylinder(parent, { name = "TarPit", height = 0.2, diameter = d, cf = CFrame.new(pos + Vector3.new(0, 0.1, 0)), color = TAR, material = Enum.Material.SmoothPlastic, reflectance = 0.35, collide = false })
	for i = 1, 3 do
		local a = rng(0, math.pi * 2)
		local r = rng(0, d * 0.32)
		Kit.ball(parent, { name = "TarBubble", diameter = rng(0.8, 1.8), cf = CFrame.new(pos + Vector3.new(math.cos(a) * r, 0.1, math.sin(a) * r)), color = { 24, 20, 20 }, material = Enum.Material.SmoothPlastic, reflectance = 0.4, collide = false })
	end
	-- a sinking femur and a tusk sticking out of the tar
	Kit.cylinder(parent, { name = "SinkingBone", height = 6, diameter = 0.9, cf = CFrame.new(pos + Vector3.new(d * 0.18, 1.6, -d * 0.12)) * CFrame.Angles(0.5, 0, 0.6), color = BONE_OLD, material = Enum.Material.Limestone, collide = false })
	Kit.ball(parent, { name = "BoneKnob", diameter = 1.5, cf = CFrame.new(pos + Vector3.new(d * 0.18 - 1.7, 4.1, -d * 0.12 - 1.4)), color = BONE_OLD, material = Enum.Material.Limestone, collide = false })
	local fume = Kit.part(parent, { name = "TarFume", size = Vector3.new(d * 0.6, 0.2, d * 0.6), cf = CFrame.new(pos + Vector3.new(0, 0.3, 0)), transparency = 1, collide = false, castShadow = false })
	fume.CanQuery = false
	Kit.particles(fume, { color = { 60, 55, 50 }, size = 1.2, sizeEnd = 3, rate = 2, lifetime = 4, speed = 1.5, spread = 15, accel = Vector3.new(0, 1, 0), emission = 0, transparency = 0.6 })
end

-- Layered rock ridge segment: stacked strata blocks, slightly offset.
local function ridge(ctx, parent, pos, w, d, side)
	local Kit, rng = ctx.Kit, ctx.rng
	local y = 0
	for i = 1, 3 do
		local h = rng(4, 7) * (1.2 - i * 0.15)
		local shrink = (i - 1) * 2.2
		Kit.part(parent, {
			name = "Strata",
			size = Vector3.new(w - shrink, h, d - shrink * 1.5),
			cf = CFrame.new(pos + Vector3.new(side * shrink * 0.6, y + h / 2, rng(-1, 1))) * CFrame.Angles(0, rng(-0.06, 0.06), side * 0.04),
			color = STRATA[(i - 1) % #STRATA + 1],
			material = Enum.Material.Sandstone,
		})
		y = y + h
	end
end

-- The sauropod skeleton: body spanning the route (legs either side of the
-- corridor), long neck rearing up over the left bank, tail sweeping down right.
local function sauropod(ctx, parent, zA)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "SauropodArch")
	local function bone(a, b, d, name)
		-- only bones well outside the corridor collide
		local solid = math.min(math.abs(a.X), math.abs(b.X)) > 17 and math.min(a.Y, b.Y) < 30
		return limb(Kit, m, a, b, d, { name = name, color = BONE, material = Enum.Material.Limestone, collide = solid })
	end
	local spine = {
		Vector3.new(-60, 64, zA), Vector3.new(-54, 61, zA), Vector3.new(-46, 55, zA), Vector3.new(-38, 47, zA),
		Vector3.new(-30, 37, zA), Vector3.new(-21, 28, zA), Vector3.new(-10, 28.5, zA), Vector3.new(0, 29, zA),
		Vector3.new(10, 28, zA), Vector3.new(20, 26, zA), Vector3.new(31, 22, zA), Vector3.new(42, 17, zA),
		Vector3.new(52, 11, zA), Vector3.new(61, 6, zA), Vector3.new(70, 2.4, zA),
	}
	for i = 1, #spine - 1 do
		local d = (i <= 5) and (1.5 + i * 0.25) or math.max(0.9, 3 - (i - 6) * 0.25)
		bone(spine[i], spine[i + 1], d, "Spine")
		if i >= 2 and i <= 12 then
			Kit.part(m, { name = "Vertebra", shape = "Cylinder", size = Vector3.new(1.2, d * 1.8, d * 1.8), cf = CFrame.lookAt(spine[i], spine[i + 1]) * CFrame.Angles(0, math.pi / 2, 0), color = BONE_OLD, material = Enum.Material.Limestone, collide = false })
			Kit.part(m, { name = "NeuralSpike", size = Vector3.new(0.8, d * 1.6, 1.2), cf = CFrame.new(spine[i] + Vector3.new(0, d * 1.1, 0)), color = BONE, material = Enum.Material.Limestone, collide = false })
		end
	end
	-- skull and jaw
	local head = spine[1]
	Kit.part(m, { name = "Skull", size = Vector3.new(6, 3.6, 3.4), cf = CFrame.new(head + Vector3.new(-3.4, 0.4, 0)) * CFrame.Angles(0, 0, -0.25), color = BONE, material = Enum.Material.Limestone, collide = false })
	Kit.part(m, { name = "Jaw", size = Vector3.new(5, 1, 2.8), cf = CFrame.new(head + Vector3.new(-3.8, -1.8, 0)) * CFrame.Angles(0, 0, -0.45), color = BONE_OLD, material = Enum.Material.Limestone, collide = false })
	Kit.ball(m, { name = "EyeSocket", diameter = 1.3, cf = CFrame.new(head + Vector3.new(-3, 1, -1.5)), color = { 30, 26, 22 }, material = Enum.Material.SmoothPlastic, collide = false })
	-- ribs hanging from the back, high above the route
	for i = 0, 8 do
		local x = -16 + i * 4
		local top = Vector3.new(x, 28.6 - math.abs(x) * 0.06, zA)
		local drop = 12 - math.abs(x) * 0.25
		for _, s in ipairs({ -1, 1 }) do
			local mid = top + Vector3.new(0.4, -drop * 0.45, s * 6.5)
			local tip = top + Vector3.new(1, -drop, s * 4.5)
			limb(Kit, m, top, mid, 0.8, { name = "Rib", color = BONE, material = Enum.Material.Limestone, collide = false })
			limb(Kit, m, mid, tip, 0.7, { name = "Rib", color = BONE, material = Enum.Material.Limestone, collide = false })
		end
	end
	-- shoulder blades and pelvis
	for _, s in ipairs({ -1, 1 }) do
		Kit.part(m, { name = "Scapula", size = Vector3.new(7, 4, 0.8), cf = CFrame.new(-20, 23, zA + s * 4.4) * CFrame.Angles(0, 0, 0.9), color = BONE_OLD, material = Enum.Material.Limestone, collide = false })
		Kit.part(m, { name = "Pelvis", size = Vector3.new(8, 5, 0.9), cf = CFrame.new(20, 22.5, zA + s * 4.4) * CFrame.Angles(0, 0, -0.4), color = BONE_OLD, material = Enum.Material.Limestone, collide = false })
	end
	-- four pillar legs, safely outside the corridor
	for _, leg in ipairs({ { x = -21, knee = -1.2 }, { x = 21, knee = 1.6 } }) do
		for _, s in ipairs({ -1, 1 }) do
			local hip = Vector3.new(leg.x, 22, zA + s * 5)
			local knee = Vector3.new(leg.x + leg.knee, 11, zA + s * 5.6)
			local foot = Vector3.new(leg.x, 1.2, zA + s * 6)
			bone(hip, knee, 2.8, "LegBone")
			bone(knee, foot, 2.4, "LegBone")
			Kit.ball(m, { name = "Knee", diameter = 3.4, cf = CFrame.new(knee), color = BONE_OLD, material = Enum.Material.Limestone })
			Kit.part(m, { name = "Foot", size = Vector3.new(5, 1.4, 4.6), cf = CFrame.new(foot + Vector3.new(leg.x > 0 and 0.6 or -0.6, -0.5, 0)), color = BONE_OLD, material = Enum.Material.Limestone })
		end
	end
	return m
end

-- Half-buried ribcage of some other giant, lying along Z on the bank.
local function fossilRibcage(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "FossilRibcage")
	Kit.part(m, { name = "BuriedSpine", shape = "Cylinder", size = Vector3.new(30, 2.2, 2.2), cf = CFrame.new(pos + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, math.pi / 2, 0), color = BONE_OLD, material = Enum.Material.Limestone })
	for i = 0, 5 do
		local z = pos.Z - 11 + i * 4.4
		local h = 13 - math.abs(i - 2.5) * 2
		for _, s in ipairs({ -1, 1 }) do
			local a = Vector3.new(pos.X, 1, z)
			local b = Vector3.new(pos.X + s * 5.5, h * 0.7, z + 0.6)
			local c = Vector3.new(pos.X + s * 6.5, h, z + 1.4)
			local d = Vector3.new(pos.X + s * 4.2, h + 3, z + 2)
			limb(Kit, m, a, b, 1.1, { name = "Rib", color = BONE, material = Enum.Material.Limestone })
			limb(Kit, m, b, c, 1.0, { name = "Rib", color = BONE, material = Enum.Material.Limestone })
			limb(Kit, m, c, d, 0.8, { name = "Rib", color = BONE, material = Enum.Material.Limestone })
		end
	end
	-- the skull, nose-down in the dirt
	Kit.part(m, { name = "Skull", size = Vector3.new(6, 5, 9), cf = CFrame.new(pos + Vector3.new(0, 1.6, -18)) * CFrame.Angles(-0.35, 0.2, 0), color = BONE_OLD, material = Enum.Material.Limestone })
	Kit.part(m, { name = "Horn", shape = "Wedge", size = Vector3.new(1.2, 4.5, 2.4), cf = CFrame.new(pos + Vector3.new(0, 5.6, -19)) * CFrame.Angles(0, math.pi, 0), color = BONE, material = Enum.Material.Limestone })
	return m
end

-- The smoking volcano: stacked basalt tiers, a molten crater and lava runs.
local function volcano(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "Volcano")
	local tiers = 11
	local tierH = 5
	for i = 0, tiers - 1 do
		local t = i / (tiers - 1)
		local d = 38 - t * 26
		Kit.cylinder(m, {
			name = "VolcanoTier",
			height = tierH + 0.4,
			diameter = d,
			cf = CFrame.new(pos + Vector3.new(t * -2, i * tierH + tierH / 2, t * 1.5)),
			color = Kit.mix({ 92, 78, 66 }, { 54, 46, 44 }, t),
			material = (i % 2 == 0) and Enum.Material.Rock or Enum.Material.Basalt,
		})
	end
	local topY = tiers * tierH
	local top = pos + Vector3.new(-2, topY, 1.5)
	local crater = Kit.cylinder(m, { name = "Crater", height = 0.6, diameter = 9, cf = CFrame.new(top + Vector3.new(0, 0.1, 0)), color = LAVA, material = Enum.Material.Neon, collide = false })
	Kit.light(crater, LAVA, 40, 2)
	Kit.particles(crater, { color = { 90, 84, 80 }, color2 = { 160, 150, 140 }, size = 6, sizeEnd = 16, rate = 6, lifetime = 9, speed = 8, spread = 18, accel = Vector3.new(-1.5, 2, 0), emission = 0, transparency = 0.35 })
	-- frozen smoke plume drifting over the jungle
	for i = 1, 5 do
		Kit.ball(m, { name = "SmokePlume", diameter = 9 + i * 3, cf = CFrame.new(top + Vector3.new(-i * 4, 4 + i * 8, -i * 1.5)), color = Kit.mix({ 120, 112, 104 }, { 175, 168, 158 }, i / 5), material = Enum.Material.SmoothPlastic, transparency = 0.25 + i * 0.08, collide = false, castShadow = false })
	end
	-- lava runs down the face toward the route
	for k, ang in ipairs({ -0.5, 0.15, 0.8 }) do
		local dir = Vector3.new(-math.sin(ang), 0, -math.cos(ang))
		local a = top + dir * 5 + Vector3.new(0, -0.5, 0)
		local b = pos + dir * (17 - k) + Vector3.new(0, 2 + k * 2, 0)
		local len = (b - a).Magnitude
		Kit.part(m, { name = "LavaRun", size = Vector3.new(1.4, 0.6, len), cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, 0.6, 0), color = LAVA, material = Enum.Material.Neon, collide = false })
	end
	return m
end

-- Pteranodon silhouette gliding overhead.
local function pteranodon(ctx, parent, pos, yaw)
	local Kit = ctx.Kit
	local base = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local c = { 120, 84, 70 }
	Kit.part(parent, { name = "PteroBody", size = Vector3.new(1.4, 1.2, 5), cf = base, color = c, material = Enum.Material.SmoothPlastic, collide = false })
	Kit.part(parent, { name = "PteroCrest", shape = "Wedge", size = Vector3.new(0.4, 2, 4), cf = base * CFrame.new(0, 1, -3.2) * CFrame.Angles(0, math.pi, 0), color = Kit.shade(c, 0.8), material = Enum.Material.SmoothPlastic, collide = false })
	for _, s in ipairs({ -1, 1 }) do
		Kit.part(parent, { name = "PteroWing", size = Vector3.new(9, 0.2, 3.4), cf = base * CFrame.new(s * 5, 0.6, 0.3) * CFrame.Angles(0, s * 0.25, s * 0.18), color = Kit.shade(c, 1.15), material = Enum.Material.Fabric, collide = false })
	end
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W, L = ctx.z0, ctx.z1, ctx.width, ctx.length
	local zm = (z0 + z1) / 2
	local rng = ctx.rng
	local nest = ctx.nest
	local clearR = ctx.nestRadius + 14

	local function nearNest(x, z, pad)
		return (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude < clearR + (pad or 0)
	end

	-- ground: packed soil, lush grass patches, mud wallows
	Kit.part(f, { name = "Soil", size = Vector3.new(W, 4, L), cf = CFrame.new(0, -2, zm), color = SOIL, material = Enum.Material.Ground })
	for i = 1, 18 do
		local side = (i % 2 == 0) and 1 or -1
		Kit.part(f, {
			name = "GrassPatch",
			size = Vector3.new(rng(18, 34), 0.3, rng(18, 34)),
			cf = CFrame.new(side * rng(26, 58), 0.05, z0 + (i - 0.5) * L / 18 + rng(-4, 4)) * CFrame.Angles(0, rng(0, math.pi), 0),
			color = (i % 3 == 0) and GRASS_DARK or GRASS,
			material = Enum.Material.Grass,
		})
	end
	for i = 1, 5 do
		local side = (i % 2 == 0) and 1 or -1
		Kit.cylinder(f, { name = "MudWallow", height = 0.3, diameter = rng(10, 16), cf = CFrame.new(side * rng(24, 40), 0.08, z0 + i * 40 + rng(-6, 6)), color = MUD, material = Enum.Material.Mud })
	end

	-- the trail: a slightly wandering mud path toward the nest
	local trailEnd = nest.Z - (ctx.nestRadius + 6)
	local segLen = 20
	local nSeg = math.floor((trailEnd - z0) / segLen)
	for i = 0, nSeg - 1 do
		local z = z0 + segLen * (i + 0.5)
		local x = math.sin(i * 0.9) * 2.5
		Kit.part(f, { name = "Trail", size = Vector3.new(ctx.pathWidth - 6 + (i % 2) * 2, 0.35, segLen + 3), cf = CFrame.new(x, 0.1, z) * CFrame.Angles(0, math.sin(i * 1.7) * 0.06, 0), color = (i % 2 == 0) and MUD or Kit.shade(MUD, 1.08), material = Enum.Material.Mud })
	end
	-- three-toed footprints along the trail
	for i = 0, 6 do
		local z = z0 + 18 + i * 15
		local x = ((i % 2 == 0) and -4 or 4) + math.sin(i) * 1.5
		for k = -1, 1 do
			Kit.part(f, { name = "Footprint", size = Vector3.new(0.9, 0.38, 2.6), cf = CFrame.new(x + k * 0.9, 0.11, z) * CFrame.Angles(0, k * 0.45, 0), color = MUD_DARK, material = Enum.Material.Mud, collide = false })
		end
	end

	-- stone ridges along both walls
	for side = -1, 1, 2 do
		for i = 0, 8 do
			local z = z0 + 14 + i * 29 + rng(-4, 4)
			ridge(ctx, f, Vector3.new(side * rng(66, 70), 0, z), rng(12, 18), rng(20, 28), side)
		end
	end

	-- ancient conifers framing the route
	for _, s in ipairs({ { -54, 26 }, { 58, 18 }, { -60, 120 }, { 52, 92 }, { -62, 222 }, { -38, 150 } }) do
		if not nearNest(s[1], z0 + s[2], 10) then
			bigTree(ctx, f, Vector3.new(s[1], 0, z0 + s[2]), 1 + rng(-0.1, 0.25))
		end
	end

	-- fern thickets and cycads, dense near the walls, thinning toward the trail
	local fernSpots = {
		{ -24, 14 }, { 26, 36 }, { -32, 48 }, { 22, 66 }, { -44, 72 }, { 38, 70 }, { -26, 110 }, { 30, 118 },
		{ -50, 96 }, { 46, 134 }, { -56, 166 }, { 60, 160 }, { -50, 246 }, { 30, 246 }, { 64, 104 }, { -20, 248 },
	}
	for _, s in ipairs(fernSpots) do
		if not nearNest(s[1], z0 + s[2], 4) then
			fern(ctx, f, Vector3.new(s[1] + rng(-2, 2), 0, z0 + s[2] + rng(-2, 2)), 0.9 + rng(0, 0.6))
		end
	end
	for _, s in ipairs({ { 34, 22 }, { -36, 30 }, { 28, 100 }, { -30, 126 }, { 60, 196 }, { -60, 196 } }) do
		if not nearNest(s[1], z0 + s[2], 4) then
			cycad(ctx, f, Vector3.new(s[1], 0, z0 + s[2]), 1 + rng(0, 0.5))
		end
	end

	-- tar pits on the banks, well away from the trail and the nest
	tarPit(ctx, f, Vector3.new(40, 0.02, z0 + 48), 16)
	tarPit(ctx, f, Vector3.new(-42, 0.02, z0 + 136), 14)
	tarPit(ctx, f, Vector3.new(58, 0.02, z0 + 236), 12)

	-- fossils: a half-buried ribcage and scattered bones
	fossilRibcage(ctx, f, Vector3.new(-46, 0, z0 + 52))
	for i = 1, 6 do
		local side = (i % 2 == 0) and 1 or -1
		local x, z = side * rng(20, 56), z0 + rng(10, 250)
		if not nearNest(x, z, 2) then
			Kit.cylinder(f, { name = "Bone", height = rng(3, 6), diameter = 0.7, cf = CFrame.new(x, 0.35, z) * CFrame.Angles(math.pi / 2, rng(0, 3), 0), color = BONE_OLD, material = Enum.Material.Limestone, collide = false })
		end
	end

	-- amber nuggets glowing in the ridges (sparingly lit)
	for i, s in ipairs({ { -60, 40 }, { 60, 74 }, { -60, 180 }, { 60, 140 } }) do
		local amber = Kit.part(f, { name = "Amber", size = Vector3.new(1.6, 2.2, 1.6), cf = CFrame.new(s[1], 1.4, z0 + s[2]) * CFrame.Angles(0.3, i, 0.4), color = AMBER, material = Enum.Material.Neon, transparency = 0.1, collide = false })
		Kit.light(amber, AMBER, 14, 0.9)
	end

	-- the sauropod arch over the route, and the volcano behind the nest
	sauropod(ctx, f, z0 + 88)
	volcano(ctx, f, Vector3.new(46, 0, z1 - 17))
	-- a rubble field and fallen boulders at the volcano's foot
	for i = 1, 6 do
		local x, z = rng(18, 70), z1 - rng(4, 30)
		if not nearNest(x, z, 3) then
			Kit.ball(f, { name = "VolcanicBoulder", diameter = rng(3, 6), cf = CFrame.new(x, 0.6, z), color = { 60, 52, 48 }, material = Enum.Material.Basalt })
		end
	end
	-- the far left corner stays jungle: a last pair of conifers and ferns
	bigTree(ctx, f, Vector3.new(-40, 0, z1 - 10), 1.2)
	fern(ctx, f, Vector3.new(-56, 0, z1 - 20), 1.4)

	-- pteranodons riding the thermals
	pteranodon(ctx, f, Vector3.new(-24, 70, z0 + 140), 0.6)
	pteranodon(ctx, f, Vector3.new(14, 82, z0 + 196), -0.9)
	pteranodon(ctx, f, Vector3.new(40, 64, z0 + 60), 2.2)

	-- humid jungle haze drifting through
	local haze = Kit.part(f, { name = "Haze", size = Vector3.new(W - 20, 4, L - 20), cf = CFrame.new(0, 4, zm), transparency = 1, collide = false, castShadow = false })
	haze.CanQuery = false
	Kit.particles(haze, { color = { 255, 240, 200 }, size = 0.2, sizeEnd = 0.05, rate = 10, lifetime = 6, speed = 0.5, accel = Vector3.new(0, 0.2, 0), emission = 0.8, transparency = 0.3 })

	return {
		palette = {
			accent = { 255, 180, 70 },
			gate = { 128, 104, 74 },
			gateMaterial = Enum.Material.Rock,
			nest = { 98, 82, 58 },
			nestMaterial = Enum.Material.Ground,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">Skylands</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 8 — Skylands. Floating islands adrift on a sea of cloud, where storms
	are born. The route is a long grassy island with rocky cliffs underneath;
	side islands hang at different heights with waterfalls pouring into the
	clouds, wind-bent trees, crackling storm pylons and drifting rocks. Behind
	the nest a sky temple floats beneath a towering anvil thunderhead.

	Open-air gaps are allowed outside the corridor and nest (docs/ZONE_CONTRACT.md):
	anyone who falls drops through the clouds to the kill plane and goes home.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local GRASS = { 120, 196, 96 }
local GRASS_DARK = { 98, 172, 82 }
local CLIFF = { 132, 126, 140 }
local CLIFF_DARK = { 98, 94, 112 }
local CLOUD = { 248, 250, 255 }
local CLOUD_SHADE = { 214, 222, 240 }
local STORM = { 92, 98, 124 }
local STORM_DARK = { 62, 66, 88 }
local MARBLE = { 236, 238, 246 }
local COPPER = { 196, 120, 70 }
local SPARK = { 190, 220, 255 }
local WATER = { 150, 210, 255 }
local WOOD = { 150, 110, 70 }

-- An island: a grass cap whose top sits at `top`, over tapering rock tiers
-- (`depth` scales how far the rock hangs down).
local function island(ctx, parent, center, radius, top, solid, depth)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "Island")
	Kit.cylinder(m, { name = "IslandGrass", height = 2, diameter = radius * 2, cf = CFrame.new(center.X, top - 1, center.Z), color = GRASS, material = Enum.Material.Grass, collide = solid })
	local y = top - 2
	local r = radius
	for i = 1, 3 do
		local h = radius * (0.35 + i * 0.12) * (depth or 1)
		r = r * 0.72
		Kit.cylinder(m, {
			name = "IslandRock",
			height = h,
			diameter = r * 2 + 2,
			cf = CFrame.new(center.X + rng(-1, 1), y - h / 2, center.Z + rng(-1, 1)),
			color = (i % 2 == 0) and CLIFF_DARK or CLIFF,
			material = (i == 1) and Enum.Material.Rock or Enum.Material.Slate,
			collide = solid,
		})
		y = y - h
	end
	Kit.ball(m, { name = "IslandTip", diameter = r * 1.4, cf = CFrame.new(center.X, y, center.Z), color = CLIFF_DARK, material = Enum.Material.Slate, collide = false })
	return m
end

-- Waterfall pouring off an island edge into the cloud sea.
local function waterfall(ctx, parent, top, dir, width)
	local Kit = ctx.Kit
	local bottom = -30
	local h = top.Y - bottom
	local cf = CFrame.lookAt(Vector3.new(top.X, top.Y - h / 2, top.Z), Vector3.new(top.X, top.Y - h / 2, top.Z) + dir)
	Kit.part(parent, { name = "Waterfall", size = Vector3.new(width, h, 0.8), cf = cf, color = WATER, material = Enum.Material.Glass, transparency = 0.35, collide = false, castShadow = false })
	Kit.part(parent, { name = "WaterfallSheen", size = Vector3.new(width * 0.35, h, 0.9), cf = cf * CFrame.new(width * 0.15, 0, -0.1), color = { 235, 250, 255 }, material = Enum.Material.Neon, transparency = 0.45, collide = false, castShadow = false })
	Kit.part(parent, { name = "WaterLip", size = Vector3.new(width, 0.3, 3), cf = CFrame.lookAt(top - dir * 1.4 + Vector3.new(0, 0.05, 0), top + dir), color = WATER, material = Enum.Material.Glass, transparency = 0.2, collide = false })
	local mist = Kit.ball(parent, { name = "Mist", diameter = width * 2.2, cf = CFrame.new(top.X, -24, top.Z) + dir * 2, color = CLOUD, material = Enum.Material.SmoothPlastic, transparency = 0.3, collide = false, castShadow = false })
	Kit.particles(mist, { color = { 255, 255, 255 }, size = 1.5, sizeEnd = 4, rate = 4, lifetime = 3, speed = 3, spread = 60, emission = 0.2, transparency = 0.5 })
end

-- Wind-swept tree: a leaning trunk with its crown blown downwind (+X).
local function windTree(ctx, parent, pos, scale, wind)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "WindTree")
	local lean = 0.35 * wind
	local h = 10 * scale
	Kit.cylinder(m, { name = "Trunk", height = h, diameter = 1.3 * scale, cf = CFrame.new(pos) * CFrame.Angles(0, 0, -lean) * CFrame.new(0, h / 2, 0), color = { 120, 90, 64 }, material = Enum.Material.Wood })
	local crown = pos + Vector3.new(math.sin(lean) * h + wind * 2 * scale, h * math.cos(lean), 0)
	Kit.ball(m, { name = "Leaves", diameter = 5.5 * scale, cf = CFrame.new(crown), color = GRASS_DARK, material = Enum.Material.LeafyGrass, collide = false })
	Kit.ball(m, { name = "Leaves", diameter = 4.5 * scale, cf = CFrame.new(crown + Vector3.new(wind * 3.6 * scale, -0.8 * scale, rng(-1, 1))), color = GRASS, material = Enum.Material.LeafyGrass, collide = false })
	Kit.ball(m, { name = "Leaves", diameter = 3.4 * scale, cf = CFrame.new(crown + Vector3.new(wind * 6.4 * scale, -1.6 * scale, rng(-1, 1))), color = { 140, 210, 110 }, material = Enum.Material.LeafyGrass, collide = false })
	return m
end

-- Storm pylon: a marble column wound with copper coils and a crackling orb.
local function stormPylon(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "StormPylon")
	Kit.part(m, { name = "PylonBase", size = Vector3.new(3.4, 1, 3.4), cf = CFrame.new(pos + Vector3.new(0, 0.5, 0)), color = MARBLE, material = Enum.Material.Marble })
	Kit.cylinder(m, { name = "PylonColumn", height = 12, diameter = 1.5, cf = CFrame.new(pos + Vector3.new(0, 7, 0)), color = MARBLE, material = Enum.Material.Marble })
	for i = 1, 3 do
		Kit.cylinder(m, { name = "Coil", height = 0.5, diameter = 2.8 - i * 0.3, cf = CFrame.new(pos + Vector3.new(0, 7 + i * 1.6, 0)), color = COPPER, material = Enum.Material.Metal })
	end
	local orb = Kit.ball(m, { name = "StormOrb", diameter = 2.2, cf = CFrame.new(pos + Vector3.new(0, 14.2, 0)), color = SPARK, material = Enum.Material.Neon, collide = false })
	Kit.light(orb, SPARK, 18, 1.3)
	Kit.particles(orb, { color = { 220, 235, 255 }, color2 = { 160, 120, 255 }, size = 0.5, sizeEnd = 0, rate = 8, lifetime = 0.4, speed = 6, emission = 1 })
	-- frozen arcs crackling off the orb
	for k, a in ipairs({ 0.6, 2.7, 4.6 }) do
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local p1 = pos + Vector3.new(0, 14.2, 0) + dir * 1.2
		local p2 = p1 + dir * 1.6 + Vector3.new(0, (k % 2 == 0) and 1.4 or -1.2, 0)
		local p3 = p2 + dir * 1.2 + Vector3.new(0, (k % 2 == 0) and -0.6 or 0.8, 0)
		Kit.part(m, { name = "Arc", size = Vector3.new(0.18, 0.18, (p2 - p1).Magnitude), cf = CFrame.lookAt((p1 + p2) / 2, p2), color = SPARK, material = Enum.Material.Neon, collide = false })
		Kit.part(m, { name = "Arc", size = Vector3.new(0.15, 0.15, (p3 - p2).Magnitude), cf = CFrame.lookAt((p2 + p3) / 2, p3), color = SPARK, material = Enum.Material.Neon, collide = false })
	end
	return m
end

-- Puffy cloud cluster (non-colliding).
local function cloud(ctx, parent, pos, scale, color)
	local Kit, rng = ctx.Kit, ctx.rng
	color = color or CLOUD
	Kit.ball(parent, { name = "Cloud", diameter = 12 * scale, cf = CFrame.new(pos), color = color, material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2 + rng(0, 1)
		Kit.ball(parent, {
			name = "Cloud",
			diameter = (7 + rng(0, 3)) * scale,
			cf = CFrame.new(pos + Vector3.new(math.cos(a) * 6 * scale, rng(-2, 1) * scale, math.sin(a) * 4 * scale)),
			color = (i == 2) and CLOUD_SHADE or color,
			material = Enum.Material.SmoothPlastic,
			collide = false,
			castShadow = false,
		})
	end
end

-- Floating rock shard: a rough lump with a dangling point.
local function floatingRock(ctx, parent, pos, s)
	local Kit, rng = ctx.Kit, ctx.rng
	Kit.part(parent, { name = "FloatRock", size = Vector3.new(3 * s, 1.6 * s, 2.6 * s), cf = CFrame.new(pos) * CFrame.Angles(rng(-0.3, 0.3), rng(0, 3), rng(-0.3, 0.3)), color = CLIFF, material = Enum.Material.Slate, collide = false })
	Kit.part(parent, { name = "FloatRockTip", shape = "Wedge", size = Vector3.new(2 * s, 2.4 * s, 1.6 * s), cf = CFrame.new(pos + Vector3.new(0, -1.8 * s, 0)) * CFrame.Angles(math.pi, rng(0, 3), 0), color = CLIFF_DARK, material = Enum.Material.Slate, collide = false })
	Kit.part(parent, { name = "FloatRockMoss", size = Vector3.new(2.6 * s, 0.3, 2.2 * s), cf = CFrame.new(pos + Vector3.new(0, 0.85 * s, 0)), color = GRASS, material = Enum.Material.Grass, collide = false })
end

-- Rope-and-plank bridge between two points at ground level (along X).
local function bridge(ctx, parent, x0, x1, z)
	local Kit = ctx.Kit
	local n = math.floor(math.abs(x1 - x0) / 2.2)
	local dir = (x1 > x0) and 1 or -1
	for i = 0, n do
		Kit.part(parent, { name = "BridgePlank", size = Vector3.new(1.9, 0.4, 5), cf = CFrame.new(x0 + dir * (i * 2.2 + 1), -0.2, z) * CFrame.Angles(0, 0, (i % 2 == 0) and 0.02 or -0.02), color = (i % 2 == 0) and WOOD or Kit.shade(WOOD, 0.85), material = Enum.Material.WoodPlanks })
	end
	for _, s in ipairs({ -1, 1 }) do
		for _, x in ipairs({ x0, x1 }) do
			Kit.cylinder(parent, { name = "BridgePost", height = 3.4, diameter = 0.5, cf = CFrame.new(x, 1.7, z + s * 2.6), color = Kit.shade(WOOD, 0.7), material = Enum.Material.Wood })
		end
		Kit.part(parent, { name = "BridgeRope", size = Vector3.new(math.abs(x1 - x0), 0.2, 0.2), cf = CFrame.new((x0 + x1) / 2, 2.6, z + s * 2.6), color = { 200, 180, 140 }, material = Enum.Material.Fabric, collide = false })
	end
end

-- The sky temple floating beneath the anvil thunderhead.
local function skyTemple(ctx, parent, pos)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "SkyTemple")
	island(ctx, m, pos, 15, pos.Y, true, 0.45)
	Kit.cylinder(m, { name = "TempleFloor", height = 1, diameter = 24, cf = CFrame.new(pos + Vector3.new(0, 0.5, 0)), color = MARBLE, material = Enum.Material.Marble })
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local p = pos + Vector3.new(math.cos(a) * 10, 0, math.sin(a) * 10)
		if i ~= 3 then -- one pillar has fallen
			Kit.cylinder(m, { name = "TemplePillar", height = 13, diameter = 1.8, cf = CFrame.new(p + Vector3.new(0, 7.5, 0)), color = MARBLE, material = Enum.Material.Marble })
		else
			Kit.cylinder(m, { name = "BrokenPillar", height = 5, diameter = 1.8, cf = CFrame.new(p + Vector3.new(0, 3.5, 0)), color = MARBLE, material = Enum.Material.Marble })
		end
		Kit.part(m, { name = "PillarCap", size = Vector3.new(2.6, 0.8, 2.6), cf = CFrame.new(p + Vector3.new(0, 14.4, 0)), color = MARBLE, material = Enum.Material.Marble })
	end
	Kit.cylinder(m, { name = "TempleRing", height = 1.6, diameter = 24, cf = CFrame.new(pos + Vector3.new(0, 15.6, 0)), color = MARBLE, material = Enum.Material.Marble })
	Kit.ball(m, { name = "TempleDome", diameter = 18, cf = CFrame.new(pos + Vector3.new(0, 16, 0)), color = { 170, 200, 240 }, material = Enum.Material.Marble })
	Kit.cylinder(m, { name = "DomeBand", height = 0.8, diameter = 12, cf = CFrame.new(pos + Vector3.new(0, 23.6, 0)), color = COPPER, material = Enum.Material.Metal })
	local rod = Kit.cylinder(m, { name = "LightningRod", height = 8, diameter = 0.6, cf = CFrame.new(pos + Vector3.new(0, 28, 0)), color = COPPER, material = Enum.Material.Metal })
	local core = Kit.ball(m, { name = "StormHeart", diameter = 5, cf = CFrame.new(pos + Vector3.new(0, 6.5, 0)), color = SPARK, material = Enum.Material.Neon, collide = false })
	Kit.light(core, { 180, 200, 255 }, 34, 2)
	Kit.particles(core, { color = { 220, 235, 255 }, color2 = { 170, 130, 255 }, size = 0.8, sizeEnd = 0, rate = 12, lifetime = 0.5, speed = 8, emission = 1 })
	-- waterfalls off the temple island's front lip
	for _, x in ipairs({ -8, 9 }) do
		waterfall(ctx, m, Vector3.new(pos.X + x, pos.Y - 0.2, pos.Z - 14), Vector3.new(0, 0, -1), 4)
	end
	return m, rod
end

-- The anvil thunderhead: a churning column with a flat top that overhangs the nest.
local function anvilCloud(ctx, parent, base, rodTop)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "AnvilCloud")
	for i = 0, 4 do
		local y = base.Y + i * 6
		local d = 26 + math.sin(i * 0.9) * 4 + i * 0.6
		Kit.ball(m, { name = "StormColumn", diameter = d, cf = CFrame.new(base.X + rng(-4, 4), y, base.Z + rng(-3, 3)), color = Kit.mix(STORM_DARK, STORM, i / 4), material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
		Kit.ball(m, { name = "StormColumn", diameter = d * 0.7, cf = CFrame.new(base.X + ((i % 2 == 0) and 12 or -12), y + 3, base.Z + rng(-2, 4)), color = Kit.mix(STORM_DARK, STORM, math.min(1, i / 4 + 0.1)), material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
	end
	-- the anvil: a wide flat sheet of puffs, spreading in X and toward the route
	local topY = base.Y + 32
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		local rx, rz = 58, 34
		local x = math.cos(a) * rx * rng(0.75, 1)
		local z = base.Z - 16 + math.sin(a) * rz * rng(0.75, 1)
		z = math.min(z, base.Z + 4)
		Kit.ball(m, { name = "Anvil", diameter = rng(16, 24), cf = CFrame.new(x, topY + rng(-2, 3), z), color = (i % 3 == 0) and CLOUD_SHADE or { 196, 204, 226 }, material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
	end
	for _, p in ipairs({ { 0, -16, 34 }, { -26, -12, 26 }, { 26, -18, 26 }, { 0, -36, 24 } }) do
		Kit.ball(m, { name = "AnvilCore", diameter = p[3], cf = CFrame.new(p[1], topY + 2, base.Z + p[2]), color = { 206, 212, 232 }, material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
	end
	-- lightning: frozen zig-zag bolts from the cloud down to the temple rod and the clouds
	local function bolt(from, to, segs, seed)
		local prev = from
		for s = 1, segs do
			local t = s / segs
			local p = from:Lerp(to, t)
			if s < segs then
				p = p + Vector3.new(math.sin(seed + s * 2.1) * 3, 0, math.cos(seed + s * 1.7) * 2)
			end
			Kit.part(m, { name = "Lightning", size = Vector3.new(0.45, 0.45, (p - prev).Magnitude), cf = CFrame.lookAt((prev + p) / 2, p), color = { 235, 240, 255 }, material = Enum.Material.Neon, collide = false, castShadow = false })
			prev = p
		end
	end
	bolt(Vector3.new(base.X + 4, base.Y - 2, base.Z - 4), rodTop, 2, 1)
	bolt(Vector3.new(-30, topY - 6, base.Z - 30), Vector3.new(-62, 54, base.Z - 17), 4, 3)
	bolt(Vector3.new(36, topY - 6, base.Z - 24), Vector3.new(64, 46, base.Z - 15), 4, 5)
	local flash = Kit.ball(m, { name = "StormGlow", diameter = 6, cf = CFrame.new(base + Vector3.new(0, 4, -8)), color = { 200, 180, 255 }, material = Enum.Material.Neon, transparency = 0.4, collide = false, castShadow = false })
	Kit.light(flash, { 190, 170, 255 }, 60, 2.2)
	return m
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W, L = ctx.z0, ctx.z1, ctx.width, ctx.length
	local zm = (z0 + z1) / 2
	local rng = ctx.rng
	local nest = ctx.nest
	local clearR = ctx.nestRadius + 14

	local function nearNest(x, z, pad)
		return (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude < clearR + (pad or 0)
	end

	-- the route island: grass cap at y = 0 over stepped cliffs
	local routeLen = nest.Z - z0
	local routeW = 48
	Kit.part(f, { name = "RouteGrass", size = Vector3.new(routeW, 2, routeLen), cf = CFrame.new(0, -1, z0 + routeLen / 2), color = GRASS, material = Enum.Material.Grass })
	Kit.part(f, { name = "RouteCliff", size = Vector3.new(routeW - 2, 9, routeLen - 2), cf = CFrame.new(0, -6.5, z0 + routeLen / 2 + 1), color = CLIFF, material = Enum.Material.Rock })
	Kit.part(f, { name = "RouteCliff", size = Vector3.new(routeW - 14, 10, routeLen - 16), cf = CFrame.new(1, -16, z0 + routeLen / 2 + 6), color = CLIFF_DARK, material = Enum.Material.Slate })
	Kit.part(f, { name = "RouteCliff", size = Vector3.new(routeW - 28, 9, routeLen - 50), cf = CFrame.new(-1, -25, z0 + routeLen / 2 + 14), color = CLIFF_DARK, material = Enum.Material.Slate, collide = false })
	-- grassy outcrops bulging off the island edges
	for i = 0, 7 do
		for side = -1, 1, 2 do
			local z = z0 + 10 + i * 18 + rng(-3, 3) + ((side > 0) and 8 or 0)
			if z < nest.Z - 50 then
				local w = rng(8, 13)
				local d = rng(12, 20)
				Kit.part(f, { name = "Outcrop", size = Vector3.new(w, 2, d), cf = CFrame.new(side * (routeW / 2 + w / 2 - 2), -1, z), color = (i % 2 == 0) and GRASS_DARK or GRASS, material = Enum.Material.Grass })
				Kit.part(f, { name = "OutcropRock", shape = "Wedge", size = Vector3.new(w - 1, 8, d - 2), cf = CFrame.new(side * (routeW / 2 + w / 2 - 2.5), -6, z) * CFrame.Angles(math.pi, 0, 0), color = CLIFF, material = Enum.Material.Rock })
			end
		end
	end
	-- a pale stone path down the middle of the island
	for z = z0 + 4, nest.Z - 44, 8 do
		Kit.part(f, { name = "PathStone", size = Vector3.new(rng(5, 7), 0.3, rng(4.5, 6)), cf = CFrame.new(rng(-1.5, 1.5), 0.1, z) * CFrame.Angles(0, rng(-0.3, 0.3), 0), color = { 222, 224, 232 }, material = Enum.Material.Marble })
	end

	-- the nest island, and a back terrace leading on to the next zone
	island(ctx, f, Vector3.new(nest.X, 0, nest.Z), 64, 0, true)
	Kit.part(f, { name = "BackTerrace", size = Vector3.new(44, 2, z1 - (nest.Z + 40)), cf = CFrame.new(0, -1, (z1 + nest.Z + 40) / 2), color = GRASS, material = Enum.Material.Grass })
	Kit.part(f, { name = "BackCliff", size = Vector3.new(40, 12, z1 - (nest.Z + 44)), cf = CFrame.new(0, -8, (z1 + nest.Z + 44) / 2), color = CLIFF, material = Enum.Material.Rock })
	-- marble rim around the nest island edge
	for i = 0, 19 do
		local a = i / 20 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		if math.abs(dir.X) > 0.45 then -- leave the route ends open
			local p = nest + dir * 61
			Kit.part(f, { name = "Balustrade", size = Vector3.new(1.4, 2.6, 8), cf = CFrame.lookAt(Vector3.new(p.X, 1.3, p.Z), Vector3.new(p.X, 1.3, p.Z) + Vector3.new(-dir.Z, 0, dir.X)), color = MARBLE, material = Enum.Material.Marble })
		end
	end

	-- side islands at ground level, reached by rope bridges
	island(ctx, f, Vector3.new(-50, 0, z0 + 66), 16, 0, true)
	bridge(ctx, f, -routeW / 2 + 1, -35, z0 + 66)
	island(ctx, f, Vector3.new(52, 0, z0 + 118), 14, 0, true)
	bridge(ctx, f, routeW / 2 - 1, 39, z0 + 118)
	waterfall(ctx, f, Vector3.new(-62, -0.2, z0 + 74), Vector3.new(-0.6, 0, 0.8).Unit, 5)
	waterfall(ctx, f, Vector3.new(60, -0.2, z0 + 128), Vector3.new(0.5, 0, 0.85).Unit, 4)
	windTree(ctx, f, Vector3.new(-52, 0, z0 + 60), 1.3, 1)
	windTree(ctx, f, Vector3.new(-44, 0, z0 + 74), 0.9, 1)
	windTree(ctx, f, Vector3.new(50, 0, z0 + 114), 1.1, 1)
	stormPylon(ctx, f, Vector3.new(-56, 0, z0 + 72))
	stormPylon(ctx, f, Vector3.new(56, 0, z0 + 124))

	-- islands floating at different heights, each spilling a waterfall
	local floaters = {
		{ -58, 16, 18, 12 }, { 60, 26, 52, 10 }, { -60, 34, 150, 13 }, { 62, 12, 176, 11 },
		{ -24, 48, 30, 7 }, { 34, 58, 96, 8 }, { -66, 52, 236, 9 }, { 66, 44, 238, 9 },
	}
	for i, fl in ipairs(floaters) do
		local x, y, z, r = fl[1], fl[2], z0 + fl[3], fl[4]
		local solid = not nearNest(x, z, r + 2)
		island(ctx, f, Vector3.new(x, 0, z), r, y, solid)
		if i % 2 == 1 then
			windTree(ctx, f, Vector3.new(x + rng(-2, 2), y, z + rng(-2, 2)), 0.8 + rng(0, 0.3), 1)
		end
		if i <= 4 then
			local dir = Vector3.new((x > 0) and -0.3 or 0.3, 0, -1).Unit
			waterfall(ctx, f, Vector3.new(x, y - 0.2, z) + dir * (r - 1), dir, 3.5)
		end
	end

	-- storm pylons lining the route
	for i = 0, 3 do
		local z = z0 + 20 + i * 30
		for side = -1, 1, 2 do
			stormPylon(ctx, f, Vector3.new(side * 19, 0, z + ((side > 0) and 6 or 0)))
		end
	end
	-- wind-bent trees on the outcrops
	for i, s in ipairs({ { -30, 24 }, { 31, 48 }, { -31, 96 }, { 30, 84 } }) do
		windTree(ctx, f, Vector3.new(s[1], 0, z0 + s[2]), 1 + (i % 2) * 0.2, 1)
	end
	-- trees around the nest island rim
	for _, a in ipairs({ 0.3, 2.8, 3.5, 5.9 }) do
		local p = nest + Vector3.new(math.cos(a), 0, math.sin(a)) * 56
		windTree(ctx, f, p, 1.1, 1)
	end

	-- drifting rocks
	for i = 1, 12 do
		local side = (i % 2 == 0) and 1 or -1
		floatingRock(ctx, f, Vector3.new(side * rng(28, 72), rng(8, 60), z0 + rng(10, 250)), rng(0.8, 2))
	end

	-- the cloud sea below, and fair-weather clouds above
	Kit.part(f, { name = "CloudSea", size = Vector3.new(W + 10, 4, L), cf = CFrame.new(0, -34, zm), color = CLOUD, material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
	for i = 0, 25 do
		local x = -70 + (i % 6) * 28 + rng(-6, 6)
		local z = z0 + 10 + math.floor(i / 6) * 58 + rng(-10, 10)
		Kit.ball(f, { name = "CloudSeaPuff", diameter = rng(16, 30), cf = CFrame.new(x, rng(-30, -22), z), color = (i % 3 == 0) and CLOUD_SHADE or CLOUD, material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
	end
	for _, c in ipairs({ { -60, 70, 20 }, { 54, 84, 70 }, { -44, 92, 120 }, { 66, 66, 150 }, { -66, 78, 200 }, { 40, 100, 30 } }) do
		cloud(ctx, f, Vector3.new(c[1], c[2], z0 + c[3]), 1 + rng(0, 0.6))
	end

	-- hero: the sky temple beneath the anvil thunderhead
	local templePos = Vector3.new(0, 42, z1 - 14)
	local _, rod = skyTemple(ctx, f, templePos)
	anvilCloud(ctx, f, Vector3.new(0, 80, z1 - 8), rod.Position + Vector3.new(0, 4, 0))

	-- wind streaks blowing across the route
	-- (emitter's top face turned to blow toward +X)
	local wind = Kit.part(f, { name = "Wind", size = Vector3.new(4, 30, L - 20), cf = CFrame.new(-70, 15, zm) * CFrame.Angles(0, 0, -math.pi / 2), transparency = 1, collide = false, castShadow = false })
	wind.CanQuery = false
	Kit.particles(wind, { color = { 255, 255, 255 }, size = 0.3, sizeEnd = 0.1, rate = 14, lifetime = 5, speed = 28, spread = 4, emission = 0.6, transparency = 0.5 })

	return {
		palette = {
			accent = { 170, 210, 255 },
			gate = MARBLE,
			gateMaterial = Enum.Material.Marble,
			nest = { 206, 212, 230 },
			nestMaterial = Enum.Material.Marble,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">Suburb</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 1 — Suburb. A quiet cul-de-sac that's clearly been through some
	weather: pastel houses, picket fences, a road that loops around the core
	nest, a tornado-flattened backyard behind it.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local GRASS = { 108, 178, 78 }
local GRASS_DARK = { 92, 160, 66 }
local ASPHALT = { 64, 66, 74 }
local SIDEWALK = { 205, 205, 200 }
local WHITE = { 245, 245, 240 }
local HOUSE_COLORS = { { 245, 214, 170 }, { 170, 210, 235 }, { 240, 180, 180 }, { 200, 230, 180 }, { 230, 220, 250 }, { 250, 235, 160 } }
local ROOF_COLORS = { { 150, 70, 60 }, { 70, 80, 100 }, { 110, 60, 50 }, { 60, 90, 70 } }

local function house(ctx, parent, pos, facing, colorIdx)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "House")
	local wallColor = HOUSE_COLORS[(colorIdx - 1) % #HOUSE_COLORS + 1]
	local roofColor = ROOF_COLORS[(colorIdx - 1) % #ROOF_COLORS + 1]
	-- local frame: front of the house faces the road (`facing` = +1 means front toward -X)
	local base = CFrame.new(pos) * CFrame.Angles(0, facing > 0 and math.pi / 2 or -math.pi / 2, 0)
	local w, d, h = 20, 14, 10
	Kit.part(m, { name = "Foundation", size = Vector3.new(w + 1, 1, d + 1), cf = base * CFrame.new(0, 0.5, 0), color = { 150, 150, 150 }, material = Enum.Material.Concrete })
	Kit.part(m, { name = "Walls", size = Vector3.new(w, h, d), cf = base * CFrame.new(0, 1 + h / 2, 0), color = wallColor, material = Enum.Material.WoodPlanks })
	-- gabled roof from two wedges
	local roofH = 6
	Kit.part(m, { name = "Roof", shape = "Wedge", size = Vector3.new(w + 2, roofH, d / 2 + 1), cf = base * CFrame.new(0, 1 + h + roofH / 2, -(d / 4 + 0.5)) * CFrame.Angles(0, math.pi, 0), color = roofColor, material = Enum.Material.Slate })
	Kit.part(m, { name = "Roof", shape = "Wedge", size = Vector3.new(w + 2, roofH, d / 2 + 1), cf = base * CFrame.new(0, 1 + h + roofH / 2, d / 4 + 0.5), color = roofColor, material = Enum.Material.Slate })
	Kit.part(m, { name = "Chimney", size = Vector3.new(2.2, 5, 2.2), cf = base * CFrame.new(w / 2 - 4, 1 + h + 4, 2), color = { 160, 80, 60 }, material = Enum.Material.Brick })
	-- front (local -Z) details
	local front = -d / 2 - 0.1
	Kit.part(m, { name = "Door", size = Vector3.new(3.4, 6.4, 0.4), cf = base * CFrame.new(-3, 4.2, front), color = { 120, 70, 50 }, material = Enum.Material.Wood })
	Kit.ball(m, { name = "Knob", diameter = 0.4, cf = base * CFrame.new(-1.8, 4.2, front - 0.3), color = { 230, 190, 60 }, material = Enum.Material.Metal })
	for _, x in ipairs({ 3.5, 7 }) do
		local win = Kit.part(m, { name = "Window", size = Vector3.new(2.8, 3, 0.3), cf = base * CFrame.new(x, 6, front), color = { 170, 220, 255 }, material = Enum.Material.Glass, transparency = 0.15, reflectance = 0.2 })
		Kit.part(m, { name = "Frame", size = Vector3.new(3.4, 0.4, 0.5), cf = base * CFrame.new(x, 7.6, front), color = WHITE, material = Enum.Material.SmoothPlastic })
		Kit.part(m, { name = "Frame", size = Vector3.new(3.4, 0.4, 0.5), cf = base * CFrame.new(x, 4.4, front), color = WHITE, material = Enum.Material.SmoothPlastic })
	end
	-- porch light
	local lamp = Kit.part(m, { name = "PorchLight", size = Vector3.new(0.6, 0.8, 0.6), cf = base * CFrame.new(-5.4, 7.4, front - 0.3), color = { 255, 230, 170 }, material = Enum.Material.Neon })
	Kit.light(lamp, { 255, 220, 160 }, 14, 0.9)
	return m, base
end

local function picketFence(ctx, parent, from, to)
	local Kit = ctx.Kit
	local dir = (to - from)
	local len = dir.Magnitude
	local n = math.floor(len / 2.2)
	local cf = CFrame.lookAt(from, to)
	Kit.part(parent, { name = "Rail", size = Vector3.new(0.3, 0.4, len), cf = cf * CFrame.new(0, 2.2, -len / 2), color = WHITE, material = Enum.Material.WoodPlanks })
	Kit.part(parent, { name = "Rail", size = Vector3.new(0.3, 0.4, len), cf = cf * CFrame.new(0, 1.2, -len / 2), color = WHITE, material = Enum.Material.WoodPlanks })
	for i = 0, n do
		Kit.part(parent, { name = "Picket", size = Vector3.new(0.4, 3, 0.9), cf = cf * CFrame.new(0, 1.5, -i * (len / math.max(1, n))), color = WHITE, material = Enum.Material.WoodPlanks })
	end
end

local function mailbox(ctx, parent, pos, color)
	local Kit = ctx.Kit
	Kit.part(parent, { name = "MailPost", size = Vector3.new(0.4, 3.4, 0.4), cf = CFrame.new(pos + Vector3.new(0, 1.7, 0)), color = { 120, 85, 55 }, material = Enum.Material.Wood })
	Kit.part(parent, { name = "Mailbox", size = Vector3.new(1.2, 1.1, 2), cf = CFrame.new(pos + Vector3.new(0, 3.8, 0)), color = color, material = Enum.Material.Metal })
	Kit.part(parent, { name = "Flag", size = Vector3.new(0.1, 0.9, 0.3), cf = CFrame.new(pos + Vector3.new(0.65, 4.2, 0.4)), color = { 220, 50, 50 }, material = Enum.Material.SmoothPlastic })
end

local function streetLamp(ctx, parent, pos, armDir)
	local Kit = ctx.Kit
	Kit.cylinder(parent, { name = "LampPost", height = 13, diameter = 0.6, cf = CFrame.new(pos + Vector3.new(0, 6.5, 0)), color = { 50, 55, 65 }, material = Enum.Material.Metal })
	Kit.part(parent, { name = "LampArm", size = Vector3.new(3.5, 0.4, 0.4), cf = CFrame.new(pos + Vector3.new(armDir * 1.75, 13, 0)), color = { 50, 55, 65 }, material = Enum.Material.Metal })
	local bulb = Kit.part(parent, { name = "LampHead", size = Vector3.new(1.6, 0.6, 1.2), cf = CFrame.new(pos + Vector3.new(armDir * 3.3, 12.7, 0)), color = { 255, 240, 200 }, material = Enum.Material.Neon })
	Kit.light(bulb, { 255, 230, 190 }, 24, 1.2)
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W = ctx.z0, ctx.z1, ctx.width
	local zm = (z0 + z1) / 2
	local rng = ctx.rng
	local nest = ctx.nest
	local road = ctx.pathWidth

	-- ground: two-tone lawn stripes (mowed look)
	for i = 0, 12 do
		Kit.part(f, {
			name = "Lawn",
			size = Vector3.new(W, 4, ctx.length / 13),
			cf = CFrame.new(0, -2, z0 + (i + 0.5) * ctx.length / 13),
			color = (i % 2 == 0) and GRASS or GRASS_DARK,
			material = Enum.Material.Grass,
		})
	end

	-- road up to the cul-de-sac, with curbs, sidewalks and a dashed center line
	local roadEnd = nest.Z - 20
	local roadLen = roadEnd - z0
	Kit.part(f, { name = "Road", size = Vector3.new(road, 0.3, roadLen), cf = CFrame.new(0, 0.15, z0 + roadLen / 2), color = ASPHALT, material = Enum.Material.Asphalt })
	Kit.cylinder(f, { name = "CulDeSac", height = 0.3, diameter = ctx.nestRadius * 2 + 34, cf = CFrame.new(nest.X, 0.15, nest.Z), color = ASPHALT, material = Enum.Material.Asphalt })
	for i = 0, math.floor((nest.Z - (ctx.nestRadius + 17) - z0) / 10) - 1 do
		Kit.part(f, { name = "Dash", size = Vector3.new(0.6, 0.32, 5), cf = CFrame.new(0, 0.16, z0 + 5 + i * 10), color = { 250, 210, 60 }, material = Enum.Material.SmoothPlastic })
	end
	-- sidewalks stop where the cul-de-sac circle begins
	local culR = ctx.nestRadius + 17
	local walkLen = (nest.Z - math.sqrt(culR * culR - (road / 2 + 6) ^ 2)) - z0
	for side = -1, 1, 2 do
		local x = side * (road / 2 + 3)
		Kit.part(f, { name = "Sidewalk", size = Vector3.new(6, 0.6, walkLen), cf = CFrame.new(x, 0.3, z0 + walkLen / 2), color = SIDEWALK, material = Enum.Material.Concrete })
		Kit.part(f, { name = "Curb", size = Vector3.new(0.6, 0.7, walkLen), cf = CFrame.new(side * (road / 2 + 0.3), 0.35, z0 + walkLen / 2), color = { 170, 170, 165 }, material = Enum.Material.Concrete })
	end

	-- houses along both sides, facing the road
	local houseZ = { z0 + 22, z0 + 62, z0 + 100 }
	local colorIdx = 1
	for side = -1, 1, 2 do
		for i, hz in ipairs(houseZ) do
			local hx = side * 46
			house(ctx, f, Vector3.new(hx, 0, hz), side, colorIdx)
			colorIdx = colorIdx + 1
			-- driveway & mailbox
			Kit.part(f, { name = "Driveway", size = Vector3.new(22, 0.35, 7), cf = CFrame.new(side * (road / 2 + 14), 0.18, hz + 9), color = { 150, 150, 150 }, material = Enum.Material.Concrete })
			mailbox(ctx, f, Vector3.new(side * (road / 2 + 6.5), 0, hz + 4), HOUSE_COLORS[(colorIdx % #HOUSE_COLORS) + 1])
			-- front-yard picket fence segment (leaves the driveway open)
			picketFence(ctx, f, Vector3.new(side * (road / 2 + 7), 0, hz - 18), Vector3.new(side * (road / 2 + 7), 0, hz + 4))
			-- yard tree
			ctx.tree(f, Vector3.new(side * 66, 0, hz - 12 + rng(-3, 3)), 1.1 + rng(0, 0.3))
			if i < #houseZ then
				streetLamp(ctx, f, Vector3.new(side * (road / 2 + 4.5), 0.6, hz + 24), -side)
			end
		end
	end

	-- hydrant + trash cans for scale
	for side = -1, 1, 2 do
		local hz = z0 + 50
		Kit.cylinder(f, { name = "Hydrant", height = 2.4, diameter = 1.2, cf = CFrame.new(side * (road / 2 + 5), 1.8, hz), color = { 220, 50, 40 }, material = Enum.Material.Metal })
		Kit.ball(f, { name = "HydrantCap", diameter = 1.2, cf = CFrame.new(side * (road / 2 + 5), 3, hz), color = { 220, 50, 40 }, material = Enum.Material.Metal })
		Kit.cylinder(f, { name = "Bin", height = 3.2, diameter = 2.2, cf = CFrame.new(side * (road / 2 + 5.4), 2.2, z0 + 96), color = { 60, 120, 70 }, material = Enum.Material.SmoothPlastic })
	end

	-- hedge ring around the cul-de-sac (gaps left for the road and escape)
	local ringR = ctx.nestRadius + 26
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local p = nest + dir * ringR
		-- leave gaps where the road arrives and where the route continues to the next zone
		if dir.Z > -0.75 and not (dir.Z > 0 and math.abs(p.X) < 18) then
			Kit.part(f, { name = "Hedge", size = Vector3.new(11, 5, 3.2), cf = CFrame.lookAt(Vector3.new(p.X, 2.5, p.Z), Vector3.new(nest.X, 2.5, nest.Z)), color = { 60, 130, 55 }, material = Enum.Material.Grass })
		end
	end

	-- the flattened backyard: proof something passed through
	local by = z1 - 18
	Kit.part(f, { name = "Shingle", size = Vector3.new(4, 0.3, 3), cf = CFrame.new(-20, 0.3, by) * CFrame.Angles(0.1, 0.6, 0.15), color = { 150, 70, 60 }, material = Enum.Material.Slate })
	Kit.part(f, { name = "Shingle", size = Vector3.new(3, 0.3, 2.5), cf = CFrame.new(-14, 0.2, by + 4) * CFrame.Angles(-0.1, 1.4, 0.05), color = { 150, 70, 60 }, material = Enum.Material.Slate })
	Kit.part(f, { name = "Plank", size = Vector3.new(0.4, 0.4, 6), cf = CFrame.new(16, 0.4, by - 2) * CFrame.Angles(0, 0.4, 0.2), color = WHITE, material = Enum.Material.WoodPlanks })
	-- fallen tree
	Kit.cylinder(f, { name = "FallenTrunk", height = 14, diameter = 1.6, cf = CFrame.new(30, 1, by + 2) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(0.3, 0, 0), color = { 110, 75, 50 }, material = Enum.Material.Wood })
	Kit.ball(f, { name = "FallenLeaves", diameter = 7, cf = CFrame.new(37, 3, by + 4), color = { 90, 150, 60 }, material = Enum.Material.Grass })
	-- overturned trampoline
	Kit.cylinder(f, { name = "Trampoline", height = 0.4, diameter = 12, cf = CFrame.new(-36, 3, by + 6) * CFrame.Angles(0.9, 0, 0.2), color = { 30, 30, 40 }, material = Enum.Material.Fabric })
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2
		Kit.ball(f, { name = "Debris", diameter = 0.8 + rng(0, 0.6), cf = CFrame.new(rng(-55, 55), 0.4, by + rng(-6, 10)), color = { 120, 110, 100 }, material = Enum.Material.Slate })
	end
	-- back tree line
	for i = 0, 8 do
		local x = -64 + i * 16 + rng(-3, 3)
		if math.abs(x) > 24 then -- keep the route to the next zone open
			ctx.tree(f, Vector3.new(x, 0, z1 - 5 + rng(-2, 2)), 1.2 + rng(0, 0.4))
		end
	end
	-- side tree lines along the boundaries
	for i = 0, 6 do
		for side = -1, 1, 2 do
			ctx.tree(f, Vector3.new(side * 71, 0, z0 + 15 + i * 36 + rng(-4, 4)), 0.9 + rng(0, 0.3), { 70, 150, 60 })
		end
	end

	return {
		palette = {
			accent = { 120, 200, 255 },
			gate = { 175, 90, 70 },
			gateMaterial = Enum.Material.Brick,
			nest = { 90, 92, 100 },
			nestMaterial = Enum.Material.Concrete,
		},
	}
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">VoidRealm</string><ProtectedString name="Source"><![CDATA[--[[
	Zone 9 — Void Realm. The end of the route, where disasters go to die: a
	black obsidian plain split by glowing purple fissures, monoliths humming
	with light, vertical rifts torn in the air, and shattered fragments of
	every earlier zone (a house roof, a frozen spire, a coral, a lava chunk,
	an uprooted tree) drifting overhead. Behind the nest stands a colossal
	cracked portal ring, still swirling.

	Zone builder contract (see docs/ZONE_CONTRACT.md):
	  build(ctx) -> { palette = { accent, gate, gateMaterial, nest, nestMaterial } }
	  ctx: folder, index, zone, z0, z1, length, width, pathWidth, nest (Vector3),
	       nestRadius, rng(a,b), Kit, tree(parent, pos, scale, leafColor)
]]

local VOID_GROUND = { 16, 12, 24 }
local OBSIDIAN = { 30, 22, 46 }
local OBSIDIAN_DARK = { 20, 15, 32 }
local MONOLITH = { 22, 18, 34 }
local PURPLE = { 190, 90, 255 }
local PURPLE_HOT = { 230, 160, 255 }
local MAGENTA = { 255, 90, 220 }

-- Fragment of an earlier zone: a chunk of its ground with a bit of rock under it.
local function chunk(ctx, parent, pos, size, topColor, topMat, tilt)
	local Kit = ctx.Kit
	local cf = CFrame.new(pos) * CFrame.Angles(tilt.X, tilt.Y, tilt.Z)
	Kit.part(parent, { name = "FragmentGround", size = Vector3.new(size.X, 1.2, size.Z), cf = cf, color = topColor, material = topMat, collide = false })
	Kit.part(parent, { name = "FragmentRock", shape = "Wedge", size = Vector3.new(size.X * 0.9, size.Y, size.Z * 0.8), cf = cf * CFrame.new(0, -0.6 - size.Y / 2, 0) * CFrame.Angles(math.pi, 0, 0), color = { 60, 50, 70 }, material = Enum.Material.Slate, collide = false })
	return cf
end

local function brokenRoof(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "FragmentHouse")
	local cf = chunk(ctx, m, pos, Vector3.new(16, 6, 12), { 108, 178, 78 }, Enum.Material.Grass, Vector3.new(0.25, 0.5, -0.2))
	local wallCf = cf * CFrame.new(-1, 3.4, 0)
	Kit.part(m, { name = "Wall", size = Vector3.new(12, 5.6, 8), cf = wallCf, color = { 240, 180, 180 }, material = Enum.Material.WoodPlanks, collide = false })
	Kit.part(m, { name = "Window", size = Vector3.new(2.6, 2.6, 0.3), cf = wallCf * CFrame.new(2.5, 0.6, -4.05), color = { 170, 220, 255 }, material = Enum.Material.Glass, collide = false })
	Kit.part(m, { name = "Roof", shape = "Wedge", size = Vector3.new(13, 4, 5), cf = wallCf * CFrame.new(0, 4.8, -2.3) * CFrame.Angles(0, math.pi, 0), color = { 150, 70, 60 }, material = Enum.Material.Slate, collide = false })
	Kit.part(m, { name = "Roof", shape = "Wedge", size = Vector3.new(9, 4, 5), cf = wallCf * CFrame.new(-2, 4.8, 2.3) * CFrame.Angles(0, 0, 0.15), color = { 150, 70, 60 }, material = Enum.Material.Slate, collide = false })
	Kit.part(m, { name = "Chimney", size = Vector3.new(1.6, 4, 1.6), cf = wallCf * CFrame.new(4, 6, 1), color = { 160, 80, 60 }, material = Enum.Material.Brick, collide = false })
	-- a loose shingle peeling away
	Kit.part(m, { name = "Shingle", size = Vector3.new(3, 0.3, 2), cf = wallCf * CFrame.new(9, 9, -2) * CFrame.Angles(0.6, 0.4, 0.9), color = { 150, 70, 60 }, material = Enum.Material.Slate, collide = false })
end

local function frozenSpire(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "FragmentFrost")
	local cf = chunk(ctx, m, pos, Vector3.new(11, 5, 11), { 235, 242, 255 }, Enum.Material.Snow, Vector3.new(-0.2, 0, 0.3))
	local y = 0.6
	for i = 0, 4 do
		local h = 4
		Kit.cylinder(m, { name = "IceSpire", height = h, diameter = 5 - i * 0.9, cf = cf * CFrame.new(0, y + h / 2, 0), color = Kit.mix({ 170, 225, 255 }, { 225, 245, 255 }, i / 4), material = Enum.Material.Ice, transparency = 0.15, collide = false })
		y = y + h
	end
	Kit.part(m, { name = "IceShard", size = Vector3.new(1.4, 7, 1.4), cf = cf * CFrame.new(3, 3.6, 1) * CFrame.Angles(0.2, 0, -0.45), color = { 190, 235, 255 }, material = Enum.Material.Glacier, collide = false })
	Kit.part(m, { name = "IceShard", size = Vector3.new(1.1, 5, 1.1), cf = cf * CFrame.new(-2.6, 3, -2) * CFrame.Angles(-0.3, 0, 0.4), color = { 190, 235, 255 }, material = Enum.Material.Glacier, collide = false })
end

local function coralFragment(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "FragmentCoral")
	local cf = chunk(ctx, m, pos, Vector3.new(10, 4, 9), { 46, 56, 74 }, Enum.Material.Sand, Vector3.new(0.3, 1.2, 0.15))
	local pink = { 255, 110, 150 }
	Kit.cylinder(m, { name = "Coral", height = 5, diameter = 1.4, cf = cf * CFrame.new(0, 3, 0), color = pink, material = Enum.Material.Pebble, collide = false })
	for k, a in ipairs({ 0.4, 2.4, 4.3 }) do
		local arm = cf * CFrame.new(0, 5, 0) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, 0.6) * CFrame.new(0, 2.4, 0)
		Kit.cylinder(m, { name = "Coral", height = 4.6, diameter = 1, cf = arm, color = pink, material = Enum.Material.Pebble, collide = false })
		Kit.ball(m, { name = "CoralTip", diameter = 1.3, cf = arm * CFrame.new(0, 2.4, 0), color = (k == 2) and { 120, 255, 230 } or { 255, 160, 190 }, material = (k == 2) and Enum.Material.Neon or Enum.Material.Pebble, collide = false })
	end
end

local function lavaChunk(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "FragmentMagma")
	local cf = chunk(ctx, m, pos, Vector3.new(10, 6, 8), { 50, 40, 40 }, Enum.Material.Basalt, Vector3.new(-0.35, 0.8, -0.25))
	Kit.part(m, { name = "LavaCrack", size = Vector3.new(7, 0.2, 0.7), cf = cf * CFrame.new(0, 0.62, 0) * CFrame.Angles(0, 0.5, 0), color = { 255, 120, 40 }, material = Enum.Material.Neon, collide = false })
	Kit.part(m, { name = "LavaCrack", size = Vector3.new(4, 0.2, 0.5), cf = cf * CFrame.new(-1.5, 0.62, 1.4) * CFrame.Angles(0, -0.6, 0), color = { 255, 120, 40 }, material = Enum.Material.Neon, collide = false })
	Kit.part(m, { name = "MagmaRock", size = Vector3.new(3.4, 3, 3), cf = cf * CFrame.new(2.4, 2, -1.4) * CFrame.Angles(0.3, 0.7, 0.2), color = { 40, 32, 32 }, material = Enum.Material.CrackedLava, collide = false })
end

local function uprootedTree(ctx, parent, pos)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "FragmentTree")
	local cf = CFrame.new(pos) * CFrame.Angles(0.4, 0.3, 2.3)
	Kit.cylinder(m, { name = "Trunk", height = 9, diameter = 1.4, cf = cf, color = { 110, 75, 50 }, material = Enum.Material.Wood, collide = false })
	Kit.ball(m, { name = "RootBall", diameter = 4.4, cf = cf * CFrame.new(0, -5, 0), color = { 90, 70, 50 }, material = Enum.Material.Ground, collide = false })
	Kit.ball(m, { name = "Leaves", diameter = 7, cf = cf * CFrame.new(0, 6, 0), color = { 80, 170, 70 }, material = Enum.Material.Grass, collide = false })
	Kit.ball(m, { name = "Leaves", diameter = 4.6, cf = cf * CFrame.new(1.8, 4.4, 1), color = { 70, 150, 60 }, material = Enum.Material.Grass, collide = false })
end

-- Monolith: a tall obsidian slab with glowing inlays and a hovering capstone.
local function monolith(ctx, parent, pos, h, yaw)
	local Kit = ctx.Kit
	local m = Kit.model(parent, "Monolith")
	local base = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	Kit.part(m, { name = "MonolithBase", size = Vector3.new(8, 1.2, 5), cf = base * CFrame.new(0, 0.6, 0), color = OBSIDIAN_DARK, material = Enum.Material.Slate })
	Kit.part(m, { name = "Monolith", size = Vector3.new(5, h, 2.6), cf = base * CFrame.new(0, 1.2 + h / 2, 0), color = MONOLITH, material = Enum.Material.Glass, reflectance = 0.15 })
	Kit.part(m, { name = "Inlay", size = Vector3.new(0.35, h * 0.7, 0.2), cf = base * CFrame.new(-0.9, 1.2 + h * 0.45, -1.35), color = PURPLE, material = Enum.Material.Neon, collide = false })
	Kit.part(m, { name = "Inlay", size = Vector3.new(0.35, h * 0.45, 0.2), cf = base * CFrame.new(1.0, 1.2 + h * 0.6, -1.35), color = PURPLE, material = Enum.Material.Neon, collide = false })
	Kit.part(m, { name = "Capstone", size = Vector3.new(4, 2.4, 2.2), cf = base * CFrame.new(0, 1.2 + h + 3.4, 0) * CFrame.Angles(0, 0.4, 0.2), color = OBSIDIAN, material = Enum.Material.Glass, collide = false })
	return m
end

-- Rift: a vertical tear in the air, glowing from inside.
local function rift(ctx, parent, pos, h, yaw)
	local Kit = ctx.Kit
	local base = CFrame.new(pos + Vector3.new(0, h / 2 + 2, 0)) * CFrame.Angles(0, yaw, 0)
	Kit.part(parent, { name = "RiftEdge", size = Vector3.new(3.2, h, 0.4), cf = base * CFrame.Angles(0, 0, 0.06), color = { 10, 5, 18 }, material = Enum.Material.Glass, collide = false })
	Kit.part(parent, { name = "RiftEdge", size = Vector3.new(2.4, h * 0.7, 0.45), cf = base * CFrame.new(0.4, -h * 0.1, 0) * CFrame.Angles(0, 0, -0.09), color = { 40, 10, 60 }, material = Enum.Material.Glass, collide = false })
	local core = Kit.part(parent, { name = "RiftCore", size = Vector3.new(0.7, h * 0.9, 0.5), cf = base * CFrame.Angles(0, 0, 0.03), color = PURPLE_HOT, material = Enum.Material.Neon, collide = false })
	Kit.part(parent, { name = "RiftCore", size = Vector3.new(0.4, h * 0.5, 0.55), cf = base * CFrame.new(0.3, h * 0.15, 0) * CFrame.Angles(0, 0, -0.05), color = MAGENTA, material = Enum.Material.Neon, collide = false })
	Kit.light(core, PURPLE, 20, 1.4)
	Kit.particles(core, { color = PURPLE_HOT, color2 = { 80, 30, 160 }, size = 0.4, sizeEnd = 0, rate = 6, lifetime = 2, speed = 1.5, emission = 1, accel = Vector3.new(0, -0.5, 0) })
end

-- Obsidian shard drifting in the air.
local function shard(ctx, parent, pos, s)
	local Kit, rng = ctx.Kit, ctx.rng
	local p = Kit.part(parent, {
		name = "VoidShard",
		shape = (rng() < 0.5) and "Wedge" or "Block",
		size = Vector3.new(1.4 * s, 4 * s, 2 * s),
		cf = CFrame.new(pos) * CFrame.Angles(rng(0, 3), rng(0, 3), rng(0, 3)),
		color = OBSIDIAN,
		material = Enum.Material.Glass,
		reflectance = 0.2,
		collide = false,
	})
	if s > 1.4 then
		Kit.part(parent, { name = "ShardEdge", size = Vector3.new(0.2, 4 * s, 0.2), cf = p.CFrame * CFrame.new(0.7 * s, 0, -1 * s), color = PURPLE, material = Enum.Material.Neon, collide = false })
	end
end

-- The hero: a colossal cracked portal ring on a stepped dais.
local function portal(ctx, parent, center)
	local Kit, rng = ctx.Kit, ctx.rng
	local m = Kit.model(parent, "RiftPortal")
	local R = 30
	local segs = 28
	local missing = { [4] = true, [5] = true }
	for i = 0, segs - 1 do
		local a = i / segs * math.pi * 2
		local radial = Vector3.new(math.cos(a), math.sin(a), 0)
		if missing[i] then
			-- the broken section, its pieces flung outward
			local p = center + radial * (R + 9 + i * 2)
			Kit.part(m, { name = "RingShard", size = Vector3.new(5, 7, 6), cf = CFrame.new(p) * CFrame.Angles(rng(-0.6, 0.6), rng(-0.6, 0.6), a + rng(-0.8, 0.8)), color = OBSIDIAN, material = Enum.Material.Slate, collide = false })
		else
			local wobble = (i % 5 == 2) and 0.12 or 0
			Kit.part(m, {
				name = "RingStone",
				size = Vector3.new(5.5, 7.4, 6),
				cf = CFrame.new(center + radial * (R + 2.75)) * CFrame.Angles(0, 0, a) * CFrame.Angles(wobble, 0, 0),
				color = (i % 2 == 0) and OBSIDIAN or OBSIDIAN_DARK,
				material = Enum.Material.Slate,
			})
			Kit.part(m, {
				name = "RingGlow",
				size = Vector3.new(0.8, 7.0, 6.4),
				cf = CFrame.new(center + radial * (R - 0.2)) * CFrame.Angles(0, 0, a),
				color = (i % 3 == 0) and MAGENTA or PURPLE,
				material = Enum.Material.Neon,
				collide = false,
			})
		end
	end
	-- the swirling surface: layered discs facing the route
	local face = CFrame.new(center) * CFrame.Angles(0, math.pi / 2, 0)
	Kit.part(m, { name = "PortalVeil", shape = "Cylinder", size = Vector3.new(0.4, R * 2, R * 2), cf = face, color = { 120, 40, 200 }, material = Enum.Material.ForceField, transparency = 0.15, collide = false, castShadow = false })
	Kit.part(m, { name = "PortalSwirl", shape = "Cylinder", size = Vector3.new(0.6, R * 1.4, R * 1.4), cf = face * CFrame.new(0.4, 0, 0), color = { 90, 20, 160 }, material = Enum.Material.Neon, transparency = 0.45, collide = false, castShadow = false })
	Kit.part(m, { name = "EventHorizon", shape = "Cylinder", size = Vector3.new(0.8, R * 0.8, R * 0.8), cf = face * CFrame.new(0.8, 0, 0), color = { 8, 0, 18 }, material = Enum.Material.SmoothPlastic, collide = false, castShadow = false })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * R * 0.55, math.sin(a) * R * 0.55, -1)
		Kit.part(m, { name = "SwirlArm", size = Vector3.new(R * 0.6, 0.6, 0.3), cf = CFrame.new(p) * CFrame.Angles(0, 0, a + 1.1), color = PURPLE_HOT, material = Enum.Material.Neon, transparency = 0.2, collide = false, castShadow = false })
	end
	local heart = Kit.ball(m, { name = "Singularity", diameter = 4, cf = CFrame.new(center + Vector3.new(0, 0, -1.4)), color = { 255, 230, 255 }, material = Enum.Material.Neon, collide = false })
	Kit.light(heart, PURPLE, 60, 2.5)
	Kit.particles(heart, { color = PURPLE_HOT, color2 = { 60, 20, 120 }, size = 1.2, sizeEnd = 0, rate = 14, lifetime = 3, speed = 10, spread = 180, emission = 1 })
	-- stepped dais and the pedestal the ring stands on
	local floorZ = center.Z
	for i = 0, 2 do
		Kit.part(m, { name = "DaisStep", size = Vector3.new(64 - i * 10, 1, 22 - i * 4), cf = CFrame.new(center.X, 0.5 + i, floorZ + i * 1.5), color = (i % 2 == 0) and OBSIDIAN_DARK or OBSIDIAN, material = Enum.Material.Glass, reflectance = 0.15 })
		Kit.part(m, { name = "DaisGlow", size = Vector3.new(64 - i * 10, 0.2, 0.4), cf = CFrame.new(center.X, 1.02 + i, floorZ + i * 1.5 - (11 - i * 2) + 0.2), color = PURPLE, material = Enum.Material.Neon, collide = false })
	end
	Kit.part(m, { name = "RingPedestal", size = Vector3.new(14, center.Y - R - 3.5, 8), cf = CFrame.new(center.X, 3 + (center.Y - R - 6.5) / 2, center.Z), color = OBSIDIAN_DARK, material = Enum.Material.Slate })
	-- flanking obelisks holding the ring with chains of light
	for _, s in ipairs({ -1, 1 }) do
		local x = center.X + s * (R + 16)
		Kit.part(m, { name = "Obelisk", size = Vector3.new(6, 48, 6), cf = CFrame.new(x, 24, center.Z), color = MONOLITH, material = Enum.Material.Glass, reflectance = 0.15 })
		Kit.part(m, { name = "ObeliskTip", shape = "Wedge", size = Vector3.new(6, 8, 6), cf = CFrame.new(x, 52, center.Z) * CFrame.Angles(0, s > 0 and math.pi / 2 or -math.pi / 2, 0), color = MONOLITH, material = Enum.Material.Glass })
		local a = Vector3.new(x - s * 3, 40, center.Z)
		local b = center + Vector3.new(s * (R + 4), 10, 0)
		Kit.part(m, { name = "Tether", size = Vector3.new(0.5, 0.5, (b - a).Magnitude), cf = CFrame.lookAt((a + b) / 2, b), color = PURPLE, material = Enum.Material.Neon, collide = false })
	end
	return m
end

return function(ctx)
	local Kit = ctx.Kit
	local f = ctx.folder
	local z0, z1, W, L = ctx.z0, ctx.z1, ctx.width, ctx.length
	local zm = (z0 + z1) / 2
	local rng = ctx.rng
	local nest = ctx.nest
	local clearR = ctx.nestRadius + 14

	local function nearNest(x, z, pad)
		return (Vector3.new(x, 0, z) - Vector3.new(nest.X, 0, nest.Z)).Magnitude < clearR + (pad or 0)
	end

	-- ground: black slate bedrock under glassy obsidian plates
	Kit.part(f, { name = "Bedrock", size = Vector3.new(W, 4, L), cf = CFrame.new(0, -2, zm), color = VOID_GROUND, material = Enum.Material.Slate })
	for i = 1, 20 do
		Kit.part(f, {
			name = "ObsidianPlate",
			size = Vector3.new(rng(14, 30), 0.3, rng(12, 26)),
			cf = CFrame.new(rng(-62, 62), 0.0, z0 + (i - 0.5) * L / 20 + rng(-5, 5)) * CFrame.Angles(0, rng(0, math.pi), 0),
			color = (i % 2 == 0) and OBSIDIAN or OBSIDIAN_DARK,
			material = Enum.Material.Glass,
			reflectance = 0.2,
		})
	end

	-- the causeway: polished tiles edged with light
	local causeEnd = nest.Z - (ctx.nestRadius + 6)
	local tileLen = 10
	for i = 0, math.floor((causeEnd - z0) / tileLen) - 1 do
		Kit.part(f, { name = "CausewayTile", size = Vector3.new(22, 0.4, tileLen - 0.4), cf = CFrame.new(0, 0.1, z0 + (i + 0.5) * tileLen), color = (i % 2 == 0) and { 38, 30, 58 } or { 28, 22, 44 }, material = Enum.Material.Glass, reflectance = 0.25 })
	end
	for side = -1, 1, 2 do
		local len = causeEnd - z0
		Kit.part(f, { name = "CausewayEdge", size = Vector3.new(0.5, 0.2, len), cf = CFrame.new(side * 11.4, 0.32, z0 + len / 2), color = PURPLE, material = Enum.Material.Neon, collide = false })
	end

	-- fissures: jagged glowing cracks crawling across the plain
	for i = 1, 11 do
		local side = (i % 2 == 0) and 1 or -1
		local p = Vector3.new(side * rng(14, 30), 0.26, z0 + rng(8, 250))
		local heading = rng(0, math.pi * 2)
		for s = 1, 5 do
			heading = heading + rng(-0.9, 0.9)
			local len = rng(4, 9)
			local q = p + Vector3.new(math.cos(heading) * len, 0, math.sin(heading) * len)
			if math.abs(q.X) > 72 or q.Z < z0 + 3 or q.Z > z1 - 3 or nearNest(q.X, q.Z, -6) then
				break
			end
			Kit.part(f, { name = "Fissure", size = Vector3.new(0.5 + (5 - s) * 0.12, 0.12, len + 0.4), cf = CFrame.lookAt((p + q) / 2, q), color = (s == 1) and PURPLE_HOT or PURPLE, material = Enum.Material.Neon, collide = false, castShadow = false })
			p = q
		end
		if i % 4 == 1 then
			local glow = Kit.part(f, { name = "FissureGlow", size = Vector3.new(0.4, 0.2, 0.4), cf = CFrame.new(p), transparency = 1, collide = false, castShadow = false })
			glow.CanQuery = false
			Kit.light(glow, PURPLE, 16, 1)
		end
	end

	-- monoliths along the walls
	for side = -1, 1, 2 do
		for i = 0, 4 do
			local x = side * rng(46, 66)
			local z = z0 + 18 + i * 52 + rng(-6, 6) + ((side > 0) and 20 or 0)
			if not nearNest(x, z, 6) and z < z1 - 8 then
				monolith(ctx, f, Vector3.new(x, 0, z), rng(22, 38), rng(-0.4, 0.4) + (side > 0 and math.pi / 2 or -math.pi / 2))
			end
		end
	end

	-- rifts torn open beside the route
	for _, r in ipairs({ { -28, 30, 0.4 }, { 30, 76, -0.3 }, { -34, 120, 0.2 }, { 64, 196, 1.2 }, { -62, 214, -1.1 } }) do
		rift(ctx, f, Vector3.new(r[1], 0, z0 + r[2]), rng(12, 18), r[3])
	end

	-- debris of earlier zones drifting overhead
	brokenRoof(ctx, f, Vector3.new(-40, 34, z0 + 70))
	frozenSpire(ctx, f, Vector3.new(44, 42, z0 + 40))
	coralFragment(ctx, f, Vector3.new(-54, 48, z0 + 160))
	lavaChunk(ctx, f, Vector3.new(50, 30, z0 + 140))
	uprootedTree(ctx, f, Vector3.new(26, 58, z0 + 100))
	for i = 1, 22 do
		local side = (i % 2 == 0) and 1 or -1
		shard(ctx, f, Vector3.new(side * rng(16, 72), rng(14, 70), z0 + rng(10, 250)), rng(0.6, 2.2))
	end
	-- low shards half-sunk into the ground near the walls
	for i = 1, 8 do
		local side = (i % 2 == 0) and 1 or -1
		local x, z = side * rng(30, 60), z0 + rng(10, 250)
		if not nearNest(x, z, 4) then
			Kit.part(f, { name = "GroundShard", shape = "Wedge", size = Vector3.new(rng(2, 4), rng(4, 9), rng(3, 6)), cf = CFrame.new(x, 2, z) * CFrame.Angles(rng(-0.3, 0.3), rng(0, 3), rng(-0.3, 0.3)), color = OBSIDIAN, material = Enum.Material.Glass, reflectance = 0.2 })
		end
	end

	-- hero: the cracked portal behind the nest
	portal(ctx, f, Vector3.new(0, 38, z1 - 14))

	-- starfield: a few fixed stars plus slow glittering dust
	for i = 1, 24 do
		Kit.ball(f, { name = "Star", diameter = rng(0.4, 1.1), cf = CFrame.new(rng(-76, 76), rng(90, 118), z0 + rng(4, 256)), color = (i % 4 == 0) and PURPLE_HOT or { 255, 255, 255 }, material = Enum.Material.Neon, collide = false, castShadow = false })
	end
	local dust = Kit.part(f, { name = "StarDust", size = Vector3.new(W - 10, 40, L - 10), cf = CFrame.new(0, 40, zm), transparency = 1, collide = false, castShadow = false })
	dust.CanQuery = false
	Kit.particles(dust, { color = { 255, 255, 255 }, color2 = PURPLE_HOT, size = 0.3, sizeEnd = 0, rate = 20, lifetime = 6, speed = 0.3, emission = 1, transparency = 0.1, texture = "rbxasset://textures/particles/sparkles_main.dds" })

	return {
		palette = {
			accent = { 200, 100, 255 },
			gate = { 30, 24, 46 },
			gateMaterial = Enum.Material.Basalt,
			nest = { 32, 24, 50 },
			nestMaterial = Enum.Material.Glass,
		},
	}
end
]]></ProtectedString></Properties></Item></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX0000004B"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000004A"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000049"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000003F"><Properties><string name="Name">Main</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[--[[
	Client bootstrap: HUD, panels, announcer, world presentation.
	The client only renders state and sends intents; all logic is on the server.
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Client = script.Parent
local State = require(Client:WaitForChild("State"))
local Hud = require(Client:WaitForChild("UI"):WaitForChild("Hud"))
local Panels = require(Client.UI:WaitForChild("Panels"))
local Announcer = require(Client.UI:WaitForChild("Announcer"))
local QuickTravel = require(Client.UI:WaitForChild("QuickTravel"))
local WorldFx = require(Client:WaitForChild("World"):WaitForChild("WorldFx"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local screen = Instance.new("ScreenGui")
screen.Name = "StealADisasterHud"
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = playerGui

-- scale the whole HUD for small (mobile) and large screens
local uiScale = Instance.new("UIScale")
uiScale.Parent = screen
local function rescale()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local s = math.clamp(math.min(vp.X / 1280, vp.Y / 760), 0.55, 1.2)
	if UserInputService.TouchEnabled and vp.Y < 500 then
		s = math.max(0.55, s * 0.9)
	end
	uiScale.Scale = s
end
rescale()
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
end

Remotes.get("Sync").OnClientEvent:Connect(function(snapshot)
	State.set(snapshot)
end)

Hud.mount(screen)
Panels.mount(screen)
QuickTravel.mount(screen, Panels)
Announcer.mount(screen)
WorldFx.mount()

-- hub kiosks open panels locally (ProximityPrompt.Triggered also fires on the client)
local function hookKiosk(prompt)
	local panel = prompt:GetAttribute("Panel")
	if panel then
		prompt.Triggered:Connect(function()
			Panels.openPanel(panel)
		end)
	end
end
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("ProximityPrompt") then
		hookKiosk(d)
	end
end
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("ProximityPrompt") then
		task.defer(hookKiosk, d)
	end
end)

-- server-requested effects on our own character (we own its physics)
Remotes.get("Effect").OnClientEvent:Connect(function(kind, value)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	if kind == "knockback" and typeof(value) == "Vector3" and value.Magnitude < 300 then
		hrp.AssemblyLinearVelocity = value
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end
end)

-- keyboard shortcuts
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		Panels.toggle("Shop")
	elseif input.KeyCode == Enum.KeyCode.B then
		Panels.toggle("Index")
	elseif input.KeyCode == Enum.KeyCode.M then
		Panels.toggle("Zones")
	end
end)

_G.StealADisasterClient = { State = State, Panels = Panels, Screen = screen }
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--[[
	State — the latest server snapshot for the local player.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))

local State = {
	snapshot = nil,
	Changed = Signal.new(),
}

function State.set(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	State.snapshot = snapshot
	State.Changed:Fire(snapshot)
end

function State.get()
	return State.snapshot
end

return State
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000046"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">Announcer</string><ProtectedString name="Source"><![CDATA[--[[
	Announcer — big center banners (zone entry, run home, delivered, hatches,
	events, breaches) and small toasts for notifications.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Announcer = {}

local queue = {}
local showing = false
local banner, title, subtitle
local toastHolder

local PRIORITY = { alarm = 3, frenzy = 3, warning = 2, hatch = 2, unlock = 2, delivered = 2, carry = 1, zone = 0, info = 0 }

local function showNext()
	if showing or #queue == 0 then
		return
	end
	showing = true
	local item = table.remove(queue, 1)
	title.Text = item.title or ""
	subtitle.Text = item.subtitle or ""
	local col = item.color and Theme.rgb(item.color) or Theme.White
	title.TextColor3 = col
	banner.Visible = true
	title.TextTransparency = 0
	subtitle.TextTransparency = 0
	Theme.pop(banner, 0.5)
	local hold = item.hold or 2.4
	task.delay(hold, function()
		local t1 = TweenService:Create(title, TweenInfo.new(0.3), { TextTransparency = 1 })
		local t2 = TweenService:Create(subtitle, TweenInfo.new(0.3), { TextTransparency = 1 })
		t1:Play()
		t2:Play()
		task.wait(0.32)
		banner.Visible = false
		showing = false
		showNext()
	end)
end

function Announcer.announce(item)
	if type(item) ~= "table" then
		return
	end
	local p = PRIORITY[item.kind or "info"] or 0
	-- high-priority banners jump the queue; zone banners don't pile up
	if item.kind == "zone" then
		for i = #queue, 1, -1 do
			if queue[i].kind == "zone" then
				table.remove(queue, i)
			end
		end
	end
	if p >= 2 then
		table.insert(queue, 1, item)
	else
		table.insert(queue, item)
	end
	while #queue > 4 do
		table.remove(queue)
	end
	showNext()
end

local TOAST_COLORS = {
	error = Color3.fromRGB(230, 60, 70),
	success = Color3.fromRGB(60, 190, 90),
	info = Color3.fromRGB(70, 110, 220),
}

function Announcer.toast(text, kind)
	if type(text) ~= "string" or text == "" then
		return
	end
	local t = Theme.frame(toastHolder, { name = "Toast", size = UDim2.new(1, 0, 0, 40), color = TOAST_COLORS[kind] or TOAST_COLORS.info, corner = 10, z = 20 })
	Theme.label(t, { name = "Text", text = text, size = UDim2.new(1, -16, 1, -8), position = UDim2.new(0, 8, 0, 4), z = 21, strokeThickness = 2 })
	Theme.pop(t, 0.8)
	local items = toastHolder:GetChildren()
	local count = 0
	for _, c in ipairs(items) do
		if c:IsA("Frame") then
			count = count + 1
		end
	end
	if count > 3 then
		for _, c in ipairs(items) do
			if c:IsA("Frame") and c ~= t then
				c:Destroy()
				break
			end
		end
	end
	task.delay(3.2, function()
		if t.Parent then
			t:Destroy()
		end
	end)
end

function Announcer.mount(screen)
	banner = Instance.new("Frame")
	banner.Name = "Banner"
	banner.BackgroundTransparency = 1
	banner.Size = UDim2.new(0.9, 0, 0, 130)
	banner.Position = UDim2.new(0.5, 0, 0.2, 0)
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Visible = false
	-- above panels (ZIndex 10+): with Sibling ordering a lower container hides behind an open panel
	banner.ZIndex = 35
	banner.Parent = screen
	local maxW = Instance.new("UISizeConstraint")
	maxW.MaxSize = Vector2.new(820, 130)
	maxW.Parent = banner
	title = Theme.label(banner, { name = "Title", text = "", size = UDim2.new(1, 0, 0.62, 0), font = Theme.FontDisplay, strokeThickness = 4.5, z = 30 })
	subtitle = Theme.label(banner, { name = "Subtitle", text = "", size = UDim2.new(1, 0, 0.32, 0), position = UDim2.new(0, 0, 0.64, 0), strokeThickness = 2.5, z = 30 })

	toastHolder = Instance.new("Frame")
	toastHolder.Name = "Toasts"
	toastHolder.BackgroundTransparency = 1
	toastHolder.Size = UDim2.new(0, 420, 0, 180)
	toastHolder.Position = UDim2.new(0.5, 0, 1, -190)
	toastHolder.AnchorPoint = Vector2.new(0.5, 1)
	-- purchase/upgrade feedback must stay visible while the shop is open
	toastHolder.ZIndex = 40
	toastHolder.Parent = screen
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = toastHolder

	Remotes.get("Announce").OnClientEvent:Connect(function(payload)
		Announcer.announce(payload)
	end)
	Remotes.get("Notify").OnClientEvent:Connect(function(text, kind)
		Announcer.toast(text, kind)
	end)

	-- zone entry banners
	local player = Players.LocalPlayer
	local lastZone = 0
	player:GetAttributeChangedSignal("Zone"):Connect(function()
		local z = player:GetAttribute("Zone") or 0
		if z == lastZone then
			return
		end
		local prev = lastZone
		lastZone = z
		if z >= 1 then
			local zone = Config.Zones[z]
			local snap = State.get()
			local speed = snap and snap.speed or 0
			local sub = zone.tagline
			if zone.speedReq > speed then
				sub = "🔒 Need ⚡" .. Util.formatNumber(zone.speedReq) .. " Speed to steal here"
			elseif zone.speedReq > 0 then
				sub = zone.tagline .. "  •  ✅ You can steal here"
			end
			Announcer.announce({ kind = "zone", title = string.upper(zone.name), subtitle = sub, color = { 255, 255, 255 }, hold = 2 })
		elseif z == 0 and prev >= 1 then
			Announcer.announce({ kind = "zone", title = "SAFE ZONE", subtitle = "Home sweet storm shelter", color = { 140, 230, 255 }, hold = 1.6 })
		end
	end)
	return { banner = banner, toasts = toastHolder }
end

return Announcer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000042"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	Hud — minimal always-on HUD.

	top-center    money + income/s
	top-right     event pill (time to Chaos Frenzy / frenzy countdown)
	bottom-center speed + progress to the next zone, or the RUN HOME objective
	              with distance while carrying
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local Util = require(Shared.Util)
local WorldLayout = require(Shared.Logic.WorldLayout)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Hud = {}

function Hud.mount(screen)
	local player = Players.LocalPlayer

	-- money ----------------------------------------------------------------
	local moneyBox = Instance.new("Frame")
	moneyBox.Name = "Money"
	moneyBox.BackgroundTransparency = 1
	moneyBox.Size = UDim2.new(0, 360, 0, 86)
	moneyBox.Position = UDim2.new(0.5, 0, 0, 6)
	moneyBox.AnchorPoint = Vector2.new(0.5, 0)
	moneyBox.Parent = screen
	local money = Theme.label(moneyBox, { name = "Amount", text = "$0", size = UDim2.new(1, 0, 0.66, 0), color = Theme.Money, font = Theme.FontDisplay, strokeThickness = 3.5 })
	local income = Theme.label(moneyBox, { name = "Income", text = "+$0/s", size = UDim2.new(1, 0, 0.32, 0), position = UDim2.new(0, 0, 0.66, 0), color = Theme.White, strokeThickness = 2.5 })

	-- event pill -------------------------------------------------------------
	local pill = Theme.frame(screen, { name = "EventPill", size = UDim2.new(0, 250, 0, 40), position = UDim2.new(0.5, 0, 0, 96), anchor = Vector2.new(0.5, 0), color = Color3.fromRGB(60, 40, 90), corner = 12 })
	local pillText = Theme.label(pill, { name = "Text", text = "🌪 FRENZY IN 5:00", size = UDim2.new(1, -16, 1, -10), position = UDim2.new(0, 8, 0, 5) })

	-- speed bar ------------------------------------------------------------------
	local speedBox = Instance.new("Frame")
	speedBox.Name = "SpeedBox"
	speedBox.BackgroundTransparency = 1
	speedBox.Size = UDim2.new(0, 380, 0, 74)
	speedBox.Position = UDim2.new(0.5, 0, 1, -10)
	speedBox.AnchorPoint = Vector2.new(0.5, 1)
	speedBox.Parent = screen
	local speedText = Theme.label(speedBox, { name = "Speed", text = "⚡ 0 SPEED", size = UDim2.new(1, 0, 0.5, 0), color = Theme.Speed, font = Theme.FontDisplay, strokeThickness = 3 })
	local barBg = Theme.frame(speedBox, { name = "BarBg", size = UDim2.new(1, 0, 0, 22), position = UDim2.new(0, 0, 0.56, 0), color = Color3.fromRGB(40, 36, 56), corner = 11 })
	local bar = Theme.frame(barBg, { name = "Bar", size = UDim2.new(0, 0, 1, 0), color = Theme.Speed, corner = 11, outline = false })
	local barText = Theme.label(barBg, { name = "Next", text = "", size = UDim2.new(1, -10, 1, -4), position = UDim2.new(0, 5, 0, 2), z = 4, strokeThickness = 2 })

	-- carry objective (replaces the speed bar while carrying) ---------------------
	local carry = Theme.frame(screen, { name = "CarryBanner", size = UDim2.new(0, 420, 0, 80), position = UDim2.new(0.5, 0, 1, -94), anchor = Vector2.new(0.5, 1), color = Theme.Orange, corner = 14, visible = false })
	local carryTitle = Theme.label(carry, { name = "Title", text = "🏠 RUN HOME!", size = UDim2.new(1, -16, 0.58, 0), position = UDim2.new(0, 8, 0.04, 0), font = Theme.FontDisplay, strokeThickness = 3 })
	local carrySub = Theme.label(carry, { name = "Sub", text = "", size = UDim2.new(1, -16, 0.34, 0), position = UDim2.new(0, 8, 0.6, 0), strokeThickness = 2 })

	local function refresh(snap)
		money.Text = Util.formatMoney(snap.money)
		income.Text = "+" .. Util.formatMoney(snap.income) .. "/s"
		speedText.Text = "⚡ " .. Util.formatNumber(snap.speed) .. " SPEED"
		if snap.nextZone ~= "" then
			local zone = Config.ZoneById[snap.nextZone]
			local prevReq = 0
			if zone.index > 1 then
				prevReq = Config.Zones[zone.index - 1].speedReq
			end
			local frac = math.clamp((snap.speed - prevReq) / math.max(1, zone.speedReq - prevReq), 0, 1)
			bar.Size = UDim2.new(frac, 0, 1, 0)
			barText.Text = "NEXT: " .. string.upper(zone.name) .. "  " .. Util.formatNumber(snap.speed) .. " / " .. Util.formatNumber(zone.speedReq)
		else
			bar.Size = UDim2.new(1, 0, 1, 0)
			barText.Text = "ALL ZONES UNLOCKED!"
		end
		local carrying = #snap.carried > 0
		carry.Visible = carrying
		if carrying then
			local names = {}
			for _, c in ipairs(snap.carried) do
				local def = Config.Cores[c.c]
				table.insert(names, def and def.name or "Core")
			end
			carryTitle.Text = "🏠 RUN HOME!"
			carrySub.Text = table.concat(names, " + ")
			Theme.pop(carry, 0.85)
		end
	end
	State.Changed:Connect(refresh)
	if State.get() then
		refresh(State.get())
	end

	-- timers & distance -------------------------------------------------------------
	local acc = 0
	local flash = 0
	RunService.RenderStepped:Connect(function(dt)
		acc = acc + dt
		flash = flash + dt
		if acc < 0.15 then
			return
		end
		acc = 0
		local phase = ReplicatedStorage:GetAttribute("EventPhase") or "Normal"
		local now = workspace:GetServerTimeNow()
		if phase == "Frenzy" then
			local left = math.max(0, (ReplicatedStorage:GetAttribute("FrenzyEndsAt") or now) - now)
			pillText.Text = "⚡ CHAOS FRENZY " .. Util.formatTime(left)
			pill.BackgroundColor3 = (math.floor(flash * 4) % 2 == 0) and Theme.Frenzy or Color3.fromRGB(150, 30, 140)
		else
			local left = math.max(0, (ReplicatedStorage:GetAttribute("NextRefreshAt") or now) - now)
			pillText.Text = "🌪 FRENZY IN " .. Util.formatTime(left)
			pill.BackgroundColor3 = (phase == "Warning") and Color3.fromRGB(200, 40, 160) or Color3.fromRGB(60, 40, 90)
		end
		local snap = State.get()
		if snap and #snap.carried > 0 and snap.baseSlot > 0 then
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local s = Config.Bases.Slots[snap.baseSlot]
				local d = (Vector3.new(s.x, 0, s.z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
				carryTitle.Text = "🏠 RUN HOME!  " .. math.floor(d) .. "m"
				carry.BackgroundColor3 = (math.floor(flash * 3) % 2 == 0) and Theme.Orange or Color3.fromRGB(255, 110, 40)
			end
		end
	end)
	return { money = money, income = income, pill = pillText, speed = speedText, carry = carry }
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[--[[
	Panels — the left navigation and the two modal panels (Shop, Index).

	Compact left column of chunky square buttons; one centered panel at a time
	with a colored title bar, solid cream body and a big red close button.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local Util = require(Shared.Util)
local SpeedLogic = require(Shared.Logic.SpeedLogic)
local EconomyLogic = require(Shared.Logic.EconomyLogic)
local UpgradeLogic = require(Shared.Logic.UpgradeLogic)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Panels = {}

local open = nil
local panels = {}

local ARCH_ICON = {
	Vortex = "🌪",
	Cloud = "☁",
	StormCloud = "⛈",
	Golem = "🗿",
	Serpent = "🐍",
	Beast = "🐾",
	Wisp = "✨",
	Maw = "🕳",
	Volcano = "🌋",
	Meteor = "☄",
	Wave = "🌊",
	Bird = "🐦",
	Entity = "👁",
	BlackHole = "⚫",
}
Panels.ARCH_ICON = ARCH_ICON

local okModels, DisasterModels = pcall(function()
	return require(Shared.Models.DisasterModels)
end)

-- 3D preview of a disaster inside an index cell (built lazily)
local function makePreview(cell, disasterId)
	if not okModels then
		return nil
	end
	local ok, model = pcall(DisasterModels.build, disasterId, nil)
	if not ok or not model then
		return nil
	end
	local vp = Instance.new("ViewportFrame")
	vp.Name = "Preview"
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.new(1, -8, 0.56, 0)
	vp.Position = UDim2.new(0, 4, 0.02, 0)
	vp.Ambient = Color3.fromRGB(190, 190, 200)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-1, -1.5, 1)
	vp.ZIndex = 13
	vp.Parent = cell
	model.Parent = vp
	local cf, size = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	local dist = math.max(size.X, size.Y, size.Z) * 1.7 + 2
	local center = cf.Position
	-- disasters face -Z, so look at them from the -Z side
	cam.CFrame = CFrame.lookAt(center + Vector3.new(dist * 0.35, size.Y * 0.2, -dist), center)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp
end

local UPGRADE_ICON = { Treadmill = "🏃", Carry = "🎒", Pods = "🥚", Pedestals = "🏛", Shield = "🛡" }

local function makePanel(screen, name, title, color)
	local p = Theme.frame(screen, { name = name, size = UDim2.new(0, 560, 0, 440), position = UDim2.new(0.5, 0, 0.5, 0), anchor = Vector2.new(0.5, 0.5), color = Theme.Cream, corner = 14, visible = false, z = 10 })
	local sizeC = Instance.new("UISizeConstraint")
	sizeC.MaxSize = Vector2.new(560, 440)
	sizeC.Parent = p
	local header = Theme.frame(p, { name = "Header", size = UDim2.new(1, 0, 0, 58), color = color, corner = 14, z = 11 })
	Theme.label(header, { name = "Title", text = title, size = UDim2.new(1, -90, 1, -12), position = UDim2.new(0, 16, 0, 6), font = Theme.FontDisplay, xAlign = Enum.TextXAlignment.Left, z = 12, strokeThickness = 3 })
	Theme.button(header, {
		name = "Close",
		text = "X",
		color = Theme.Danger,
		size = UDim2.new(0, 46, 0, 46),
		position = UDim2.new(1, -8, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		z = 13,
		onClick = function()
			Panels.close()
		end,
	})
	local body = Instance.new("ScrollingFrame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Size = UDim2.new(1, -24, 1, -78)
	body.Position = UDim2.new(0, 12, 0, 68)
	body.ScrollBarThickness = 8
	body.ScrollBarImageColor3 = Theme.Ink
	body.CanvasSize = UDim2.new(0, 0, 0, 0)
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.ScrollingDirection = Enum.ScrollingDirection.Y
	body.ZIndex = 11
	body.Parent = p
	return p, body
end

-- Shop ---------------------------------------------------------------------------
local function effectText(id, snap)
	local lvl = snap.upgrades[id]
	if id == "Treadmill" then
		return "+" .. Util.formatNumber(SpeedLogic.gainPerStep(lvl)) .. " → +" .. Util.formatNumber(SpeedLogic.gainPerStep(lvl + 1)) .. " Speed per step"
	elseif id == "Carry" then
		return "Carry " .. lvl .. " → " .. (lvl + 1) .. " cores at once"
	elseif id == "Pods" then
		return lvl .. " → " .. (lvl + 1) .. " incubator pods"
	elseif id == "Pedestals" then
		return lvl .. " → " .. (lvl + 1) .. " display pedestals"
	elseif id == "Shield" then
		return UpgradeLogic.shieldDuration(lvl) .. "s → " .. UpgradeLogic.shieldDuration(lvl + 1) .. "s base lock"
	end
	return ""
end

-- shop layout: category headers and the row order inside them
local SHOP_HEADERS = {
	{ name = "SpeedHeader", text = "⚡ SPEED", color = Theme.Orange, order = 10 },
	{ name = "BaseHeader", text = "🏠 BASE & CARRY", color = Theme.Blue, order = 20 },
	{ name = "IncubatorHeader", text = "🥚 INCUBATOR", color = Theme.Purple, order = 30 },
}
local SHOP_ORDER = { Treadmill = 11, Carry = 21, Pedestals = 22, Shield = 23, Pods = 31 }

local function buildShop(screen)
	local p, body = makePanel(screen, "ShopPanel", "🛒 SHOP", Theme.Green)
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 10)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = body
	-- categories: headers sit just before their rows (LayoutOrder)
	for _, h in ipairs(SHOP_HEADERS) do
		Theme.label(body, { name = h.name, text = h.text, size = UDim2.new(1, -12, 0, 32), font = Theme.FontDisplay, color = h.color, order = h.order, z = 12, strokeThickness = 2, xAlign = Enum.TextXAlignment.Left })
	end
	local rows = {}
	for i, id in ipairs(Config.UpgradeOrder) do
		local def = Config.Upgrades[id]
		local row = Theme.frame(body, { name = id, size = UDim2.new(1, -12, 0, 76), color = Theme.White, corner = 10, order = SHOP_ORDER[id] or i, z = 12 })
		Theme.label(row, { name = "Icon", text = UPGRADE_ICON[id] or "⬆", size = UDim2.new(0, 56, 0, 56), position = UDim2.new(0, 10, 0.5, 0), anchor = Vector2.new(0, 0.5), stroke = false, z = 13 })
		local name = Theme.label(row, { name = "UpgradeName", text = def.name, size = UDim2.new(0.5, 0, 0.44, 0), position = UDim2.new(0, 76, 0.08, 0), xAlign = Enum.TextXAlignment.Left, color = Theme.Ink, stroke = false, z = 13 })
		local effect = Theme.label(row, { name = "Effect", text = "", size = UDim2.new(0.55, 0, 0.34, 0), position = UDim2.new(0, 76, 0.56, 0), xAlign = Enum.TextXAlignment.Left, color = Color3.fromRGB(90, 90, 110), stroke = false, z = 13 })
		local buy = Theme.button(row, {
			name = "Buy",
			text = "$0",
			color = Theme.Green,
			size = UDim2.new(0, 130, 0, 52),
			position = UDim2.new(1, -10, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			z = 14,
			onClick = function()
				Remotes.get("RequestUpgrade"):FireServer(id)
			end,
		})
		rows[id] = { name = name, effect = effect, buy = buy }
	end
	local function refresh(snap)
		for id, r in pairs(rows) do
			local def = Config.Upgrades[id]
			local lvl = snap.upgrades[id] or def.startLevel
			r.name.Text = def.name .. "  Lv " .. lvl
			local cost = snap.costs[id]
			if not cost or cost < 0 then
				r.effect.Text = "Fully upgraded!"
				Theme.setButtonText(r.buy, "MAX")
				r.buy.BackgroundColor3 = Theme.Gray
			else
				r.effect.Text = effectText(id, snap)
				Theme.setButtonText(r.buy, Util.formatMoney(cost))
				r.buy.BackgroundColor3 = (snap.money >= cost) and Theme.Green or Color3.fromRGB(170, 170, 180)
			end
		end
	end
	State.Changed:Connect(refresh)
	if State.get() then
		refresh(State.get())
	end
	Panels._buildBoosts(body)
	return p
end

-- Boosts (Robux) ------------------------------------------------------------------
-- Rows below the upgrades. Prices come from Roblox (GetProductInfo); the configured
-- intendedPrice is shown only for Studio mock items. Buttons only ask the server to
-- open Roblox's purchase prompt.
function Panels._buildBoosts(body)
	local MConfig = require(Shared.Config.MonetizationConfig)
	local MarketplaceService = game:GetService("MarketplaceService")
	local RunService = game:GetService("RunService")
	Theme.label(body, { name = "BoostsHeader", text = "💎 GAME PASSES — permanent", size = UDim2.new(1, -12, 0, 32), font = Theme.FontDisplay, color = Theme.Orange, order = 100, z = 12, strokeThickness = 2, xAlign = Enum.TextXAlignment.Left })
	Theme.label(body, { name = "ProductsHeader", text = "🎁 BOOSTS — one-time", size = UDim2.new(1, -12, 0, 32), font = Theme.FontDisplay, color = Theme.Frenzy, order = 110, z = 12, strokeThickness = 2, xAlign = Enum.TextXAlignment.Left })
	local rows = {}
	for j, key in ipairs(MConfig.BoostsOrder) do
		local item = MConfig.Items[key]
		local order = (item.type == "GamePass") and (100 + j) or (110 + j)
		local row = Theme.frame(body, { name = "Boost_" .. key, size = UDim2.new(1, -12, 0, 76), color = Theme.White, corner = 10, order = order, z = 12 })
		Theme.label(row, { name = "Icon", text = item.icon, size = UDim2.new(0, 56, 0, 56), position = UDim2.new(0, 10, 0.5, 0), anchor = Vector2.new(0, 0.5), stroke = false, z = 13 })
		Theme.label(row, { name = "BoostName", text = item.name, size = UDim2.new(0.5, 0, 0.44, 0), position = UDim2.new(0, 76, 0.08, 0), xAlign = Enum.TextXAlignment.Left, color = Theme.Ink, stroke = false, z = 13 })
		local effect = Theme.label(row, { name = "Effect", text = item.benefit, size = UDim2.new(0.55, 0, 0.34, 0), position = UDim2.new(0, 76, 0.56, 0), xAlign = Enum.TextXAlignment.Left, color = Color3.fromRGB(90, 90, 110), stroke = false, z = 13 })
		local buy = Theme.button(row, {
			name = "Buy",
			text = "…",
			color = Theme.Orange,
			size = UDim2.new(0, 130, 0, 52),
			position = UDim2.new(1, -10, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			z = 14,
			onClick = function()
				Remotes.get("RequestPurchase"):FireServer(key)
			end,
		})
		rows[key] = { row = row, buy = buy, effect = effect, price = "…" }
	end
	local function refresh(snap)
		for key, r in pairs(rows) do
			local item = MConfig.Items[key]
			local owned = snap and snap.passes and snap.passes[key]
			if owned then
				Theme.setButtonText(r.buy, "OWNED ✓")
				r.buy.BackgroundColor3 = Theme.Gray
				r.buy.Active = false
			else
				Theme.setButtonText(r.buy, r.price)
				r.buy.BackgroundColor3 = Theme.Orange
				r.buy.Active = true
			end
			if key == "CashPack" and snap and snap.cashPack then
				r.effect.Text = "+" .. Util.formatMoney(snap.cashPack) .. " now (≈10 min of income)"
			elseif key == "SpeedBoost" and snap and (snap.boostSpeed or 0) > 0 then
				r.effect.Text = "Active: x" .. (snap.speedMult or 2) .. " • " .. Util.formatTime(snap.boostSpeed) .. " left (buy to add 15 min)"
			elseif key == "InstantHatch" and snap and (snap.hatchCredits or 0) > 0 then
				r.effect.Text = snap.hatchCredits .. " free hatch(es) saved — use on a pod"
			elseif item.type == "GamePass" and snap and owned then
				r.effect.Text = item.benefit .. " — active"
			end
		end
	end
	State.Changed:Connect(refresh)
	task.spawn(function()
		for key, r in pairs(rows) do
			local item = MConfig.Items[key]
			if item.id > 0 then
				local ok, info = pcall(function()
					local infoType = (item.type == "GamePass") and Enum.InfoType.GamePass or Enum.InfoType.Product
					return MarketplaceService:GetProductInfo(item.id, infoType)
				end)
				if ok and type(info) == "table" and info.PriceInRobux then
					r.price = "R$ " .. tostring(info.PriceInRobux)
				else
					r.price = "BUY" -- Roblox's own dialog shows the real price
				end
			elseif MConfig.MockInStudio and RunService:IsStudio() then
				r.price = "R$ " .. item.intendedPrice .. " (test)"
			else
				r.row.Visible = false -- not created on Roblox yet: never sell it
			end
		end
		refresh(State.get())
	end)
	refresh(State.get())
end

-- Index ----------------------------------------------------------------------------
local function buildIndex(screen)
	local p, body = makePanel(screen, "IndexPanel", "📖 DISASTER INDEX", Theme.Purple)
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 8)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = body
	local progress = Theme.label(body, { name = "Progress", text = "", size = UDim2.new(1, -12, 0, 26), color = Theme.Ink, stroke = false, order = -3, z = 12 })
	local barBg = Theme.frame(body, { name = "ProgressBar", size = UDim2.new(1, -12, 0, 12), color = Color3.fromRGB(60, 56, 80), corner = 6, order = -2, z = 12 })
	local bar = Theme.frame(barBg, { name = "Fill", size = UDim2.new(0, 0, 1, 0), color = Theme.Purple, corner = 6, z = 13 })
	-- toolbar: search, rarity chips, owned-only toggle, sort
	local tools = Instance.new("Frame")
	tools.Name = "Toolbar"
	tools.BackgroundTransparency = 1
	tools.Size = UDim2.new(1, -12, 0, 84)
	tools.LayoutOrder = -1
	tools.Parent = body
	local search = Instance.new("TextBox")
	search.Name = "Search"
	search.PlaceholderText = "🔍 Search discovered disasters"
	search.Text = ""
	search.ClearTextOnFocus = false
	search.Font = Theme.FontBold
	search.TextScaled = true
	search.TextColor3 = Theme.Ink
	search.PlaceholderColor3 = Color3.fromRGB(130, 128, 150)
	search.BackgroundColor3 = Theme.White
	search.Size = UDim2.new(1, -250, 0, 36)
	search.ZIndex = 13
	search.Parent = tools
	Theme.corner(search, 8)
	Theme.outline(search, 2)
	local filter = { rarity = nil, owned = false, sort = 1, text = "" }
	local SORTS = { "ZONE", "RARITY", "INCOME" }
	local applyFilters
	local ownedBtn = Theme.button(tools, { name = "OwnedOnly", text = "SHOW: ALL", color = Theme.Blue, size = UDim2.new(0, 116, 0, 36), position = UDim2.new(1, -124, 0, 0), z = 13, onClick = function(b)
		filter.owned = not filter.owned
		Theme.setButtonText(b, filter.owned and "SHOW: OWNED" or "SHOW: ALL")
		applyFilters()
	end })
	local sortBtn = Theme.button(tools, { name = "Sort", text = "SORT: ZONE", color = Theme.Orange, size = UDim2.new(0, 116, 0, 36), position = UDim2.new(1, -244, 0, 0), z = 13, onClick = function(b)
		filter.sort = filter.sort % #SORTS + 1
		Theme.setButtonText(b, "SORT: " .. SORTS[filter.sort])
		applyFilters()
	end })
	local chips = {}
	local CHIP_LIST = { "All", "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Chaos" }
	for ci, r in ipairs(CHIP_LIST) do
		local col = (r == "All") and Theme.Ink or Theme.rgb(Config.Rarities[r].color)
		chips[r] = Theme.button(tools, { name = "Chip_" .. r, text = (r == "All") and "ALL" or string.upper(string.sub(r, 1, 4)), color = col, size = UDim2.new(1 / #CHIP_LIST, -6, 0, 34), position = UDim2.new((ci - 1) / #CHIP_LIST, 3, 0, 46), z = 13, onClick = function()
			filter.rarity = (r ~= "All") and r or nil
			for name, b in pairs(chips) do
				b.BackgroundTransparency = ((filter.rarity or "All") == name) and 0 or 0.55
			end
			applyFilters()
		end })
		chips[r].BackgroundTransparency = (r == "All") and 0 or 0.55
	end
	search:GetPropertyChangedSignal("Text"):Connect(function()
		filter.text = string.lower(search.Text)
		applyFilters()
	end)
	local groups = {}
	local cells = {}
	local order = 1
	local zones = {}
	for _, z in ipairs(Config.Zones) do
		table.insert(zones, z)
	end
	for _, zone in ipairs(zones) do
		local header = Theme.label(body, { name = zone.id .. "Header", text = string.upper(zone.name) .. "  •  ⚡ " .. Util.formatNumber(zone.speedReq), size = UDim2.new(1, -12, 0, 28), color = Theme.White, order = order, z = 12, xAlign = Enum.TextXAlignment.Left })
		order = order + 1
		local grid = Instance.new("Frame")
		grid.Name = zone.id .. "Grid"
		grid.BackgroundTransparency = 1
		grid.Size = UDim2.new(1, -12, 0, 112)
		grid.LayoutOrder = order
		grid.Parent = body
		order = order + 1
		local gl = Instance.new("UIGridLayout")
		gl.CellSize = UDim2.new(0.24, -6, 0, 108)
		gl.CellPadding = UDim2.new(0, 8, 0, 8)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = grid
		local group = { header = header, grid = grid, ids = {} }
		table.insert(groups, group)
		for ci, coreId in ipairs(zone.cores) do
			local core = Config.Cores[coreId]
			local d = Config.Disasters[core.disaster]
			local rarity = Config.Rarities[d.rarity]
			local cell = Theme.frame(grid, { name = core.disaster, color = Color3.fromRGB(50, 46, 70), corner = 10, order = ci, z = 12 })
			local stroke = cell:FindFirstChildOfClass("UIStroke")
			stroke.Color = Theme.rgb(rarity.color)
			stroke.Thickness = 3
			local icon = Theme.label(cell, { name = "Icon", text = "❔", size = UDim2.new(1, 0, 0.5, 0), position = UDim2.new(0, 0, 0.06, 0), stroke = false, z = 13 })
			local nm = Theme.label(cell, { name = "DisasterName", text = "???", size = UDim2.new(1, -8, 0.22, 0), position = UDim2.new(0, 4, 0.56, 0), z = 13, strokeThickness = 1.5 })
			local info = Theme.label(cell, { name = "Info", text = d.rarity, size = UDim2.new(1, -8, 0.18, 0), position = UDim2.new(0, 4, 0.79, 0), color = Theme.rgb(rarity.color), z = 13, strokeThickness = 1.5 })
			cells[core.disaster] = { cell = cell, icon = icon, name = nm, info = info, def = d, base = ci }
			table.insert(group.ids, core.disaster)
		end
	end
	-- the event-only Chaos Storm
	do
		local header = Theme.label(body, { name = "ChaosHeader", text = "CHAOS FRENZY EXCLUSIVE", size = UDim2.new(1, -12, 0, 28), color = Theme.Frenzy, order = order, z = 12, xAlign = Enum.TextXAlignment.Left })
		order = order + 1
		local grid = Instance.new("Frame")
		grid.Name = "ChaosGrid"
		grid.BackgroundTransparency = 1
		grid.Size = UDim2.new(1, -12, 0, 112)
		grid.LayoutOrder = order
		grid.Parent = body
		local gl = Instance.new("UIGridLayout")
		gl.CellSize = UDim2.new(0.24, -6, 0, 108)
		gl.Parent = grid
		local d = Config.Disasters.ChaosStorm
		local cell = Theme.frame(grid, { name = "ChaosStorm", color = Color3.fromRGB(70, 30, 80), corner = 10, z = 12 })
		local icon = Theme.label(cell, { name = "Icon", text = "❔", size = UDim2.new(1, 0, 0.5, 0), position = UDim2.new(0, 0, 0.06, 0), stroke = false, z = 13 })
		local nm = Theme.label(cell, { name = "DisasterName", text = "???", size = UDim2.new(1, -8, 0.22, 0), position = UDim2.new(0, 4, 0.56, 0), z = 13, strokeThickness = 1.5 })
		local info = Theme.label(cell, { name = "Info", text = "Chaos", size = UDim2.new(1, -8, 0.18, 0), position = UDim2.new(0, 4, 0.79, 0), color = Theme.Frenzy, z = 13, strokeThickness = 1.5 })
		cells.ChaosStorm = { cell = cell, icon = icon, name = nm, info = info, def = d, base = 1 }
		table.insert(groups, { header = header, grid = grid, ids = { "ChaosStorm" } })
	end
	-- owned-count badge on every cell (from the server snapshot)
	for _, c in pairs(cells) do
		c.badge = Theme.label(c.cell, { name = "Owned", text = "", size = UDim2.new(0.5, 0, 0.18, 0), position = UDim2.new(0.5, -4, 0, 4), xAlign = Enum.TextXAlignment.Right, color = Theme.Money, z = 14, strokeThickness = 1.5 })
	end
	local lastSnap = nil
	applyFilters = function()
		local snap = lastSnap
		if not snap then
			return
		end
		local owned = {}
		for _, e in ipairs(snap.disasters or {}) do
			owned[e.d] = (owned[e.d] or 0) + 1
		end
		for _, g in ipairs(groups) do
			local any = false
			for _, id in ipairs(g.ids) do
				local c = cells[id]
				local known = snap.index[id] == true
				local show = true
				if filter.rarity and c.def.rarity ~= filter.rarity then
					show = false
				end
				if filter.owned and not owned[id] then
					show = false
				end
				-- search only matches discovered names, so it never reveals secrets
				if filter.text ~= "" and (not known or not string.find(string.lower(c.def.name), filter.text, 1, true)) then
					show = false
				end
				c.cell.Visible = show
				any = any or show
				c.badge.Text = owned[id] and ("×" .. owned[id]) or ""
				if filter.sort == 2 then
					c.cell.LayoutOrder = Config.Rarities[c.def.rarity].rank * 10 + c.base
				elseif filter.sort == 3 then
					c.cell.LayoutOrder = -math.floor(EconomyLogic.incomeFor({ d = id, z = 1 }) * 10)
				else
					c.cell.LayoutOrder = c.base
				end
			end
			g.header.Visible = any
			g.grid.Visible = any
		end
	end
	local total = 0
	for _ in pairs(cells) do
		total = total + 1
	end
	local function refresh(snap)
		local found = 0
		for id, c in pairs(cells) do
			if p.Visible and not c.preview then
				c.preview = makePreview(c.cell, id) or false
			end
			if c.preview then
				local known = snap.index[id] == true
				c.preview.ImageColor3 = known and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
				c.preview.ImageTransparency = known and 0 or 0.25
				c.icon.Visible = false
			end
			if snap.index[id] then
				found = found + 1
				c.icon.Text = ARCH_ICON[c.def.archetype] or "🌪"
				c.name.Text = c.def.name
				local inc = EconomyLogic.incomeFor({ d = id, z = 1 })
				c.info.Text = c.def.rarity .. " • " .. Util.formatMoney(inc) .. "/s"
			else
				c.icon.Text = "❔"
				c.name.Text = "???"
				c.info.Text = c.def.rarity
			end
		end
		progress.Text = "Discovered " .. found .. " / " .. total .. "  (" .. math.floor(found / total * 100 + 0.5) .. "%)"
		bar.Size = UDim2.new(found / total, 0, 1, 0)
		lastSnap = snap
		applyFilters()
	end
	State.Changed:Connect(refresh)
	if State.get() then
		refresh(State.get())
	end
	-- previews are built the first time the panel is opened
	p:GetPropertyChangedSignal("Visible"):Connect(function()
		if p.Visible and State.get() then
			refresh(State.get())
		end
	end)
	return p
end

-- Zones --------------------------------------------------------------------------
-- One row per zone, built from GameConfig. Travel buttons only ask the server;
-- TravelService re-checks the Speed requirement.
local RARITY_SHORT = { Common = "C", Uncommon = "U", Rare = "R", Epic = "E", Legendary = "L", Mythic = "M" }

local function rarityText(zone)
	local parts = {}
	for _, r in ipairs(Config.RarityOrder) do
		if zone.rarityWeights[r] and zone.rarityWeights[r] > 0 then
			table.insert(parts, r)
		end
	end
	-- e.g. "Common → Epic" keeps the row short
	if #parts > 2 then
		return parts[1] .. " → " .. parts[#parts] .. " cores"
	end
	return table.concat(parts, ", ") .. " cores"
end

local function buildZones(screen)
	local p, body = makePanel(screen, "ZonesPanel", "🗺 ZONES", Theme.Purple)
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 8)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = body
	local rows = {}
	for i, zone in ipairs(Config.Zones) do
		local row = Theme.frame(body, { name = "Zone" .. i, size = UDim2.new(1, -12, 0, 78), color = Theme.White, corner = 10, order = i, z = 12 })
		local swatch = Theme.frame(row, { name = "Swatch", size = UDim2.new(0, 58, 0, 58), position = UDim2.new(0, 10, 0.5, 0), anchor = Vector2.new(0, 0.5), color = Theme.rgb(zone.sky.fog), corner = 10, z = 13 })
		Theme.label(swatch, { name = "Num", text = tostring(i), size = UDim2.new(1, 0, 1, 0), font = Theme.FontDisplay, z = 14, strokeThickness = 2.5 })
		local name = Theme.label(row, { name = "ZoneName", text = zone.name, size = UDim2.new(1, -214, 0.4, 0), position = UDim2.new(0, 78, 0.06, 0), xAlign = Enum.TextXAlignment.Left, color = Theme.Ink, stroke = false, font = Theme.FontDisplay, z = 13 })
		local req = zone.speedReq > 0 and ("⚡ " .. Util.formatNumber(zone.speedReq) .. " Speed") or "⚡ No Speed needed"
		local info = Theme.label(row, { name = "Info", text = req .. "  •  " .. rarityText(zone), size = UDim2.new(1, -214, 0.28, 0), position = UDim2.new(0, 78, 0.46, 0), xAlign = Enum.TextXAlignment.Left, color = Color3.fromRGB(90, 90, 110), stroke = false, z = 13 })
		local status = Theme.label(row, { name = "Status", text = "", size = UDim2.new(1, -214, 0.24, 0), position = UDim2.new(0, 78, 0.72, 0), xAlign = Enum.TextXAlignment.Left, color = Theme.Green, stroke = false, z = 13 })
		local travel = Theme.button(row, {
			name = "Travel",
			text = "TRAVEL",
			color = Theme.Purple,
			size = UDim2.new(0, 116, 0, 50),
			position = UDim2.new(1, -10, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			z = 14,
			onClick = function(b)
				if b.Active then
					Remotes.get("RequestTravel"):FireServer("Zone", i)
					Panels.close()
				end
			end,
		})
		rows[i] = { row = row, name = name, info = info, status = status, travel = travel, swatch = swatch }
	end
	local function refresh(snap)
		local speed = snap and snap.speed or 0
		local highest = SpeedLogic.highestUnlockedZone(speed)
		local carrying = snap and snap.carried and #snap.carried > 0
		for i, r in ipairs(rows) do
			local zone = Config.Zones[i]
			local unlocked = speed >= zone.speedReq
			r.row.BackgroundColor3 = unlocked and Theme.White or Color3.fromRGB(225, 222, 230)
			r.swatch.BackgroundTransparency = unlocked and 0 or 0.55
			if i == highest then
				r.status.Text = "★ YOUR BEST ZONE"
				r.status.TextColor3 = Theme.Orange
			elseif unlocked then
				r.status.Text = "✓ Unlocked"
				r.status.TextColor3 = Theme.Green
			else
				r.status.Text = "🔒 Need " .. Util.formatNumber(zone.speedReq - speed) .. " more Speed — train!"
				r.status.TextColor3 = Theme.Danger
			end
			local canGo = unlocked and not carrying
			r.travel.Active = canGo
			r.travel.AutoButtonColor = false
			r.travel.BackgroundColor3 = canGo and Theme.Purple or Theme.Gray
			Theme.setButtonText(r.travel, unlocked and (carrying and "CARRYING" or "TRAVEL") or "LOCKED")
		end
	end
	State.Changed:Connect(refresh)
	refresh(State.get())
	return p
end

-- Stats ------------------------------------------------------------------------------
-- Everything comes from the server snapshot; nothing here is computed from client state.
local function buildStats(screen)
	local p, body = makePanel(screen, "StatsPanel", "📊 STATS", Theme.Blue)
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = body
	local order = 0
	local values = {}
	local function section(text, color)
		order = order + 1
		Theme.label(body, { name = "S" .. order, text = text, size = UDim2.new(1, -12, 0, 30), font = Theme.FontDisplay, color = color, order = order, z = 12, strokeThickness = 2, xAlign = Enum.TextXAlignment.Left })
	end
	local function row(key, title)
		order = order + 1
		local r = Theme.frame(body, { name = key, size = UDim2.new(1, -12, 0, 34), color = Theme.White, corner = 8, order = order, z = 12 })
		Theme.label(r, { name = "Title", text = title, size = UDim2.new(0.5, -10, 1, -8), position = UDim2.new(0, 10, 0, 4), xAlign = Enum.TextXAlignment.Left, color = Color3.fromRGB(90, 90, 110), stroke = false, z = 13 })
		values[key] = Theme.label(r, { name = "Value", text = "—", size = UDim2.new(0.5, -10, 1, -8), position = UDim2.new(0.5, 0, 0, 4), xAlign = Enum.TextXAlignment.Right, color = Theme.Ink, stroke = false, z = 13 })
	end
	section("⚡ PROGRESS", Theme.Orange)
	row("Speed", "Speed")
	row("Walk", "Walk speed")
	row("Zone", "Best zone")
	row("Next", "Next zone")
	section("💰 INCOME", Theme.Green)
	row("Money", "Money")
	row("Income", "Income")
	section("🏠 BASE", Theme.Blue)
	row("Disasters", "Disasters on display")
	row("Collection", "Collection")
	row("Pods", "Incubating")
	row("Upgrades", "Upgrade levels")
	section("🎁 BOOSTS", Theme.Frenzy)
	row("Passes", "Game Passes")
	row("Boost", "Speed Boost")
	row("Hatches", "Saved Instant Hatches")
	section("🏆 CAREER", Theme.Purple)
	row("Hatched", "Disasters hatched")
	row("Stolen", "Cores stolen")
	row("Robbed", "Stolen from players")

	local totalDisasters = 0
	for _ in pairs(Config.Disasters) do
		totalDisasters = totalDisasters + 1
	end
	local function refresh(snap)
		if not snap then
			return
		end
		local zi = SpeedLogic.highestUnlockedZone(snap.speed or 0)
		values.Speed.Text = "⚡ " .. Util.formatNumber(snap.speed or 0) .. ((snap.speedMult or 1) > 1 and ("  (x" .. snap.speedMult .. " training)") or "")
		values.Walk.Text = string.format("%.1f", snap.walk or 16)
		values.Zone.Text = zi .. ". " .. Config.Zones[zi].name
		if snap.nextZone ~= "" and Config.ZoneById[snap.nextZone] then
			local left = (snap.nextZoneReq or 0) - (snap.speed or 0)
			values.Next.Text = Config.ZoneById[snap.nextZone].name .. " — " .. Util.formatNumber(math.max(0, left)) .. " more"
		else
			values.Next.Text = "All zones unlocked!"
		end
		values.Money.Text = Util.formatMoney(snap.money or 0)
		values.Income.Text = Util.formatMoney(snap.income or 0) .. "/s" .. ((snap.incomeMult or 1) > 1 and ("  (x" .. snap.incomeMult .. ")") or "")
		values.Disasters.Text = #(snap.disasters or {}) .. " / " .. ((snap.upgrades and snap.upgrades.Pedestals) or 0)
		local found = 0
		for _ in pairs(snap.index or {}) do
			found = found + 1
		end
		values.Collection.Text = found .. " / " .. totalDisasters .. "  (" .. math.floor(found / totalDisasters * 100 + 0.5) .. "%)"
		values.Pods.Text = (snap.podsUsed or 0) .. " / " .. ((snap.upgrades and snap.upgrades.Pods) or 0) .. ((snap.storage or 0) > 0 and ("  (+" .. snap.storage .. " waiting)") or "")
		local u = snap.upgrades or {}
		values.Upgrades.Text = "Tread " .. (u.Treadmill or 1) .. " • Pack " .. (u.Carry or 1) .. " • Shield " .. (u.Shield or 1)
		local passes = {}
		for key, owned in pairs(snap.passes or {}) do
			if owned then
				table.insert(passes, key == "TurboTreadmill" and "Turbo" or (key == "DoubleCash" and "2x Cash" or key))
			end
		end
		table.sort(passes)
		values.Passes.Text = (#passes > 0) and table.concat(passes, ", ") or "None"
		values.Boost.Text = ((snap.boostSpeed or 0) > 0) and (Util.formatTime(snap.boostSpeed) .. " left") or "Off"
		values.Hatches.Text = tostring(snap.hatchCredits or 0)
		local st = snap.stats or {}
		values.Hatched.Text = tostring(st.hatched or 0)
		values.Stolen.Text = tostring(st.stolen or 0)
		values.Robbed.Text = tostring(st.robbed or 0)
	end
	State.Changed:Connect(refresh)
	refresh(State.get())
	return p
end

function Panels.toggle(name)
	if open == name then
		Panels.close()
		return
	end
	Panels.close()
	local p = panels[name]
	if p then
		p.Visible = true
		open = name
		Theme.pop(p, 0.7)
	end
end

function Panels.openPanel(name)
	if open ~= name then
		Panels.toggle(name)
	end
end

function Panels.close()
	if open and panels[open] then
		panels[open].Visible = false
	end
	open = nil
end

function Panels.isOpen(name)
	return open == name
end

function Panels.mount(screen)
	panels.Shop = buildShop(screen)
	panels.Index = buildIndex(screen)
	panels.Zones = buildZones(screen)
	panels.Stats = buildStats(screen)

	-- compact left nav
	local nav = Instance.new("Frame")
	nav.Name = "LeftNav"
	nav.BackgroundTransparency = 1
	nav.Size = UDim2.new(0, 84, 0, 4 * 88)
	nav.Position = UDim2.new(0, 10, 0.5, 0)
	nav.AnchorPoint = Vector2.new(0, 0.5)
	nav.Parent = screen
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 10)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = nav
	local buttons = {}
	buttons.Shop = Theme.button(nav, { name = "ShopButton", icon = "🛒", text = "SHOP", color = Theme.Green, size = UDim2.new(0, 78, 0, 78), order = 1, onClick = function()
		Panels.toggle("Shop")
	end })
	buttons.Index = Theme.button(nav, { name = "IndexButton", icon = "📖", text = "INDEX", color = Theme.Purple, size = UDim2.new(0, 78, 0, 78), order = 2, onClick = function()
		Panels.toggle("Index")
	end })
	buttons.Lock = Theme.button(nav, { name = "LockButton", icon = "🛡", text = "LOCK", color = Theme.Blue, size = UDim2.new(0, 78, 0, 78), order = 3, onClick = function()
		Remotes.get("RequestShield"):FireServer()
	end })
	buttons.Stats = Theme.button(nav, { name = "StatsButton", icon = "📊", text = "STATS", color = Theme.Orange, size = UDim2.new(0, 78, 0, 78), order = 4, onClick = function()
		Panels.toggle("Stats")
	end })

	-- lock button shows the remaining shield time
	local RunService = game:GetService("RunService")
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc = acc + dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local untilT = Players.LocalPlayer:GetAttribute("ShieldUntil") or 0
		local left = untilT - workspace:GetServerTimeNow()
		if left > 0 then
			Theme.setButtonText(buttons.Lock, math.ceil(left) .. "s")
			buttons.Lock.BackgroundColor3 = Color3.fromRGB(40, 120, 220)
		else
			Theme.setButtonText(buttons.Lock, "LOCK")
			buttons.Lock.BackgroundColor3 = Theme.Blue
		end
	end)

	Remotes.get("OpenPanel").OnClientEvent:Connect(function(name)
		if type(name) == "string" and panels[name] then
			Panels.openPanel(name)
		end
	end)
	return { nav = nav, buttons = buttons, panels = panels }
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">QuickTravel</string><ProtectedString name="Source"><![CDATA[--[[
	QuickTravel — the right-hand shortcut column: HOME, STEAL, SHOP, TRAIN, ZONES.

	HOME / STEAL / TRAIN send a RequestTravel intent; the server validates the
	destination, cooldown and carrying state (see TravelService). SHOP and ZONES
	open panels. Travel buttons grey out while you carry a core and count down
	during the cooldown. On small touch screens the column starts collapsed behind
	a TRAVEL toggle so it never covers the jump button.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local SpeedLogic = require(Shared.Logic.SpeedLogic)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local QuickTravel = {}

local BUTTONS = {
	{ key = "Home", icon = "🏠", text = "HOME", color = Theme.Blue, travel = true },
	{ key = "Steal", icon = "🎯", text = "STEAL", color = Theme.Danger, travel = true },
	{ key = "Shop", icon = "🛒", text = "SHOP", color = Theme.Green },
	{ key = "Train", icon = "🏃", text = "TRAIN", color = Theme.Orange, travel = true },
	{ key = "Zones", icon = "🗺", text = "ZONES", color = Theme.Purple },
}
local SIZE = 66
local GAP = 8

function QuickTravel.mount(screen, Panels)
	local player = Players.LocalPlayer
	local col = Instance.new("Frame")
	col.Name = "QuickTravel"
	col.BackgroundTransparency = 1
	col.Size = UDim2.new(0, SIZE + 6, 0, 30 + GAP + #BUTTONS * (SIZE + GAP))
	col.Position = UDim2.new(1, -10, 0.5, 0)
	col.AnchorPoint = Vector2.new(1, 0.5)
	col.Parent = screen
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, GAP)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.HorizontalAlignment = Enum.HorizontalAlignment.Right
	list.Parent = col

	local buttons = {}
	local expanded = true
	local function setExpanded(on)
		expanded = on
		for _, b in pairs(buttons) do
			b.Visible = on
		end
	end
	local toggle = Theme.button(col, {
		name = "Toggle",
		text = "✈ TRAVEL",
		color = Theme.Ink,
		size = UDim2.new(0, SIZE + 6, 0, 30),
		order = 0,
		onClick = function()
			setExpanded(not expanded)
		end,
	})

	for i, def in ipairs(BUTTONS) do
		buttons[def.key] = Theme.button(col, {
			name = def.key .. "Button",
			icon = def.icon,
			text = def.text,
			color = def.color,
			size = UDim2.new(0, SIZE, 0, SIZE),
			order = i,
			onClick = function(b)
				if def.travel then
					if b.Active then
						Remotes.get("RequestTravel"):FireServer(def.key)
					end
				else
					Panels.toggle(def.key)
				end
			end,
		})
	end

	-- phones: a 2-column grid in the top-right corner, always visible. A single
	-- column there would overlap the touch jump button (found in the device simulator).
	local cam = workspace.CurrentCamera
	if UserInputService.TouchEnabled and cam and cam.ViewportSize.Y < 500 then
		local cell = SIZE + 8
		list:Destroy()
		toggle.Visible = false
		local grid = Instance.new("UIGridLayout")
		grid.CellSize = UDim2.new(0, cell, 0, cell)
		grid.CellPadding = UDim2.new(0, GAP, 0, GAP)
		grid.FillDirectionMaxCells = 2
		grid.SortOrder = Enum.SortOrder.LayoutOrder
		grid.HorizontalAlignment = Enum.HorizontalAlignment.Right
		grid.Parent = col
		for _, b in pairs(buttons) do
			b.Size = UDim2.new(0, cell, 0, cell)
		end
		col.Size = UDim2.new(0, 2 * cell + GAP, 0, 3 * (cell + GAP))
		col.Position = UDim2.new(1, -10, 0, 40)
		col.AnchorPoint = Vector2.new(1, 0)
	end

	-- after a trip, put the camera behind the character so you arrive facing forward
	player:GetAttributeChangedSignal("TravelReadyAt"):Connect(function()
		task.wait()
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera
		if hrp and camera then
			local eye = (hrp.CFrame * CFrame.new(0, 6, 14)).Position
			camera.CFrame = CFrame.lookAt(eye, hrp.Position + Vector3.new(0, 2, 0))
		end
	end)

	-- live state: carrying, cooldown, steal target
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc = acc + dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local carrying = (player:GetAttribute("Carrying") or 0) > 0
		local left = (player:GetAttribute("TravelReadyAt") or 0) - workspace:GetServerTimeNow()
		local snap = State.get()
		for _, def in ipairs(BUTTONS) do
			if def.travel then
				local b = buttons[def.key]
				local ok = not carrying and left <= 0
				b.Active = ok
				b.BackgroundColor3 = ok and def.color or Theme.Gray
				if carrying then
					Theme.setButtonText(b, "CARRY")
				elseif left > 0 then
					Theme.setButtonText(b, math.ceil(left) .. "s")
				elseif def.key == "Steal" and snap then
					-- show which zone STEAL goes to, e.g. "Z3"
					Theme.setButtonText(b, "STEAL " .. SpeedLogic.highestUnlockedZone(snap.speed or 0))
				else
					Theme.setButtonText(b, def.text)
				end
			end
		end
	end)

	return { frame = col, buttons = buttons, toggle = toggle, setExpanded = setExpanded, zones = #Config.Zones }
end

return QuickTravel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--[[
	Theme — the visual language of the HUD.

	Bold cartoon typography with thick ink outlines, solid saturated fills,
	small corner radii, chunky square buttons. No glass, no gradients, no
	dashboard cards.
]]

local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.Ink = Color3.fromRGB(22, 20, 34)
Theme.White = Color3.fromRGB(255, 255, 255)
Theme.Cream = Color3.fromRGB(255, 247, 228)
Theme.CreamDark = Color3.fromRGB(240, 226, 196)
Theme.Money = Color3.fromRGB(110, 240, 90)
Theme.Speed = Color3.fromRGB(255, 220, 60)
Theme.Danger = Color3.fromRGB(255, 70, 80)
Theme.Frenzy = Color3.fromRGB(255, 60, 220)
Theme.Green = Color3.fromRGB(70, 200, 90)
Theme.Blue = Color3.fromRGB(60, 160, 255)
Theme.Purple = Color3.fromRGB(150, 80, 240)
Theme.Orange = Color3.fromRGB(255, 150, 40)
Theme.Gray = Color3.fromRGB(150, 150, 160)

Theme.FontBold = Enum.Font.FredokaOne
Theme.FontDisplay = Enum.Font.LuckiestGuy

function Theme.rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function Theme.corner(parent, px)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, px or 8)
	c.Parent = parent
	return c
end

-- outline for frames/buttons (border)
function Theme.outline(parent, thickness, color)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 3
	s.Color = color or Theme.Ink
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = parent
	return s
end

-- outline for text glyphs
function Theme.textStroke(label, thickness, color)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 2.5
	s.Color = color or Theme.Ink
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = label
	return s
end

function Theme.label(parent, o)
	local t = Instance.new("TextLabel")
	t.Name = o.name or "Label"
	t.BackgroundTransparency = 1
	t.Size = o.size or UDim2.new(1, 0, 1, 0)
	t.Position = o.position or UDim2.new(0, 0, 0, 0)
	t.AnchorPoint = o.anchor or Vector2.new(0, 0)
	t.Font = o.font or Theme.FontBold
	t.Text = o.text or ""
	t.TextColor3 = o.color or Theme.White
	-- TextWrapped must be set before TextScaled: in Roblox, TextWrapped = false turns TextScaled off.
	t.TextWrapped = o.wrapped == true
	t.TextScaled = o.scaled ~= false
	t.TextSize = o.textSize or 24
	t.TextXAlignment = o.xAlign or Enum.TextXAlignment.Center
	t.TextYAlignment = o.yAlign or Enum.TextYAlignment.Center
	t.RichText = o.rich == true
	t.ZIndex = o.z or 2
	t.LayoutOrder = o.order or 0
	t.Parent = parent
	if o.stroke ~= false then
		Theme.textStroke(t, o.strokeThickness or 2.5, o.strokeColor)
	end
	if o.maxText then
		local c = Instance.new("UITextSizeConstraint")
		c.MaxTextSize = o.maxText
		c.Parent = t
	end
	return t
end

function Theme.frame(parent, o)
	local f = Instance.new("Frame")
	f.Name = o.name or "Frame"
	f.Size = o.size or UDim2.new(1, 0, 1, 0)
	f.Position = o.position or UDim2.new(0, 0, 0, 0)
	f.AnchorPoint = o.anchor or Vector2.new(0, 0)
	f.BackgroundColor3 = o.color or Theme.Cream
	f.BackgroundTransparency = o.transparency or 0
	f.BorderSizePixel = 0
	f.ZIndex = o.z or 1
	f.LayoutOrder = o.order or 0
	f.Visible = o.visible ~= false
	f.Parent = parent
	if o.corner ~= false then
		Theme.corner(f, o.corner or 8)
	end
	if o.outline ~= false then
		Theme.outline(f, o.outline or 3)
	end
	return f
end

-- Pressable chunky button. o = { text, icon, color, size, position, anchor, onClick, textColor, name }
function Theme.button(parent, o)
	local b = Instance.new("TextButton")
	b.Name = o.name or "Button"
	b.Size = o.size or UDim2.new(0, 120, 0, 44)
	b.Position = o.position or UDim2.new(0, 0, 0, 0)
	b.AnchorPoint = o.anchor or Vector2.new(0, 0)
	b.BackgroundColor3 = o.color or Theme.Green
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Text = ""
	b.ZIndex = o.z or 3
	b.LayoutOrder = o.order or 0
	b.Parent = parent
	Theme.corner(b, o.corner or 10)
	Theme.outline(b, 3)
	-- lower lip for a chunky, pressable look
	local lip = Instance.new("Frame")
	lip.Name = "Lip"
	lip.BackgroundColor3 = Color3.new(0, 0, 0)
	lip.BackgroundTransparency = 0.75
	lip.BorderSizePixel = 0
	lip.Size = UDim2.new(1, 0, 0, 5)
	lip.Position = UDim2.new(0, 0, 1, -5)
	lip.ZIndex = b.ZIndex
	lip.Parent = b
	Theme.corner(lip, 6)
	local scale = Instance.new("UIScale")
	scale.Parent = b
	if o.icon then
		Theme.label(b, { name = "Icon", text = o.icon, size = UDim2.new(1, 0, 0.62, 0), position = UDim2.new(0, 0, 0.04, 0), z = b.ZIndex + 1, stroke = false })
		Theme.label(b, { name = "Label", text = o.text or "", size = UDim2.new(1, -6, 0.3, 0), position = UDim2.new(0, 3, 0.64, 0), color = o.textColor or Theme.White, z = b.ZIndex + 1, strokeThickness = 2 })
	else
		Theme.label(b, { name = "Label", text = o.text or "", size = UDim2.new(1, -12, 1, -10), position = UDim2.new(0, 6, 0, 4), color = o.textColor or Theme.White, z = b.ZIndex + 1, strokeThickness = 2 })
	end
	local function press(to)
		TweenService:Create(scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = to }):Play()
	end
	b.MouseButton1Down:Connect(function()
		press(0.92)
	end)
	b.MouseButton1Up:Connect(function()
		press(1)
	end)
	b.MouseLeave:Connect(function()
		press(1)
	end)
	b.MouseEnter:Connect(function()
		press(1.05)
	end)
	if o.onClick then
		b.Activated:Connect(function()
			o.onClick(b)
		end)
	end
	return b
end

function Theme.setButtonText(b, text)
	local t = b:FindFirstChild("Label")
	if t then
		t.Text = text
	end
end

function Theme.pop(guiObject, from)
	local s = guiObject:FindFirstChildOfClass("UIScale")
	if not s then
		s = Instance.new("UIScale")
		s.Parent = guiObject
	end
	s.Scale = from or 0.6
	TweenService:Create(s, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

return Theme
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000048"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source"><![CDATA[--[[
	WorldFx — client-only world presentation:
	  * Animator: bob/spin/orbit for models tagged "Animated" (cores, disasters,
	    the storm tower anemometer). Only animates what's near the camera.
	  * Atmosphere: per-zone lighting mood + Chaos Frenzy tint.
	  * Prompt filter: hide Steal prompts on your own base and Sell prompts on
	    other players' bases; mark cores you can't steal yet.
	  * Waypoint: a beam and a HOME marker pointing to your base while carrying.
	  * Event screens: countdown text on the storm tower.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config.GameConfig)
local Util = require(Shared.Util)
local Kit = require(Shared.Models.Kit)

local State = require(script.Parent.Parent.State)

local WorldFx = {}

local ANIM_RANGE = 170

---------------------------------------------------------------------------
-- Animator
---------------------------------------------------------------------------
local animated = {} -- [model] = rec

local function register(model)
	if animated[model] or not model:IsA("Model") then
		return
	end
	local root = model.PrimaryPart
	local pivot = model:GetPivot()
	local rec = {
		model = model,
		pivot = pivot,
		bob = model:GetAttribute("AnimBob") or 0,
		spin = model:GetAttribute("AnimSpin") or 0,
		phase = (pivot.Position.X * 0.37 + pivot.Position.Z * 0.11) % 6.28,
		parts = {},
		cframes = {},
	}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(rec.parts, {
				part = d,
				offset = pivot:ToObjectSpace(d.CFrame),
				orbit = d:GetAttribute("Orbit") or 0,
				selfSpin = d:GetAttribute("SelfSpin") or 0,
			})
		end
	end
	if rec.bob == 0 and rec.spin == 0 then
		local any = false
		for _, p in ipairs(rec.parts) do
			if p.orbit ~= 0 or p.selfSpin ~= 0 then
				any = true
			end
		end
		if not any then
			return
		end
	end
	animated[model] = rec
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			animated[model] = nil
		end
	end)
	if root == nil then
		return
	end
end

local function animate(t, camPos)
	local parts, cframes = {}, {}
	for model, rec in pairs(animated) do
		if (rec.pivot.Position - camPos).Magnitude < ANIM_RANGE then
			local base = rec.pivot * CFrame.new(0, math.sin(t * 2 + rec.phase) * rec.bob, 0) * CFrame.Angles(0, t * rec.spin, 0)
			for _, p in ipairs(rec.parts) do
				local cf = base
				if p.orbit ~= 0 then
					cf = cf * CFrame.Angles(0, t * p.orbit, 0)
				end
				cf = cf * p.offset
				if p.selfSpin ~= 0 then
					cf = cf * CFrame.Angles(0, t * p.selfSpin, 0)
				end
				table.insert(parts, p.part)
				table.insert(cframes, cf)
			end
		end
	end
	if #parts > 0 then
		local ok = pcall(function()
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if not ok then
			for i, part in ipairs(parts) do
				part.CFrame = cframes[i]
			end
		end
	end
end

---------------------------------------------------------------------------
-- Atmosphere
---------------------------------------------------------------------------
local HUB_SKY = { ambient = { 120, 120, 135 }, fog = { 190, 215, 255 }, fogEnd = 1200, tint = { 255, 255, 255 }, clock = 14.2 }

local function applySky(sky, frenzy)
	local info = TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, info, {
		Ambient = Util.rgb(sky.ambient),
		OutdoorAmbient = Util.rgb(sky.ambient):Lerp(Color3.new(1, 1, 1), 0.25),
		FogColor = Util.rgb(sky.fog),
		FogEnd = sky.fogEnd,
		ClockTime = sky.clock,
	}):Play()
	local grade = Lighting:FindFirstChild("ZoneGrade")
	if grade then
		local tint = Util.rgb(sky.tint)
		if frenzy then
			tint = tint:Lerp(Color3.fromRGB(255, 120, 240), 0.45)
		end
		TweenService:Create(grade, info, { TintColor = tint, Saturation = frenzy and 0.45 or 0.18 }):Play()
	end
	local atm = Lighting:FindFirstChild("Atmosphere")
	if atm then
		TweenService:Create(atm, info, { Color = Util.rgb(sky.fog), Density = math.clamp(260 / sky.fogEnd, 0.2, 0.6) }):Play()
	end
end

---------------------------------------------------------------------------
-- Prompt filter
---------------------------------------------------------------------------
local function filterPrompt(prompt, player)
	local function apply()
		local mySlot = player:GetAttribute("BaseSlot")
		if prompt.Name == "PodStealPrompt" then
			if prompt:GetAttribute("BaseSlot") == mySlot and prompt.Enabled then
				prompt.Enabled = false
			end
		elseif prompt:GetAttribute("OwnerOnly") == true then
			-- purchase prompts (Speed Boost, Instant Hatch) appear only on your own base;
			-- range (not Enabled, which the server drives) hides them elsewhere
			local mine = mySlot ~= nil and prompt:GetAttribute("BaseSlot") == mySlot
			prompt.MaxActivationDistance = mine and (prompt:GetAttribute("Range") or 8) or 0
		elseif prompt.Name == "SellPrompt" then
			if prompt:GetAttribute("OwnerOnly") ~= player.UserId and prompt.Enabled then
				prompt.Enabled = false
			end
		elseif prompt.Name == "StealPrompt" then
			local req = prompt:GetAttribute("ReqSpeed") or 0
			local snap = State.get()
			local speed = snap and snap.speed or 0
			if speed < req then
				prompt.ActionText = "🔒 Need ⚡" .. Util.formatNumber(req)
			else
				prompt.ActionText = "Steal"
			end
		end
	end
	apply()
	prompt:GetPropertyChangedSignal("Enabled"):Connect(apply)
	return apply
end

local function colorCoreLabel(bb)
	local req = bb:GetAttribute("ReqSpeed")
	local label = bb:FindFirstChild("Requirement")
	if not req or not label then
		return
	end
	local snap = State.get()
	local speed = snap and snap.speed or 0
	if req <= 0 then
		label.Text = ""
	elseif speed >= req then
		label.Text = "✅ You can steal this"
		label.TextColor3 = Color3.fromRGB(120, 255, 120)
	else
		label.Text = "🔒 Need ⚡" .. Util.formatNumber(req)
		label.TextColor3 = Color3.fromRGB(255, 110, 110)
	end
end

---------------------------------------------------------------------------
function WorldFx.mount()
	local player = Players.LocalPlayer

	-- animator
	for _, m in ipairs(CollectionService:GetTagged("Animated")) do
		register(m)
	end
	CollectionService:GetInstanceAddedSignal("Animated"):Connect(function(m)
		task.defer(register, m)
	end)

	-- prompts and labels
	local filters = {}
	local function onDescendant(d)
		if d:IsA("ProximityPrompt") then
			filters[d] = filterPrompt(d, player)
		elseif d:IsA("BillboardGui") and d.Name == "CoreLabel" then
			task.defer(colorCoreLabel, d)
		end
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		onDescendant(d)
	end
	workspace.DescendantAdded:Connect(onDescendant)
	workspace.DescendantRemoving:Connect(function(d)
		filters[d] = nil
	end)
	local lastSpeed = -1
	State.Changed:Connect(function(snap)
		if snap.speed ~= lastSpeed then
			lastSpeed = snap.speed
			for prompt, apply in pairs(filters) do
				if prompt.Name == "StealPrompt" then
					apply()
				end
			end
			local cores = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Cores")
			if cores then
				for _, d in ipairs(cores:GetDescendants()) do
					if d:IsA("BillboardGui") and d.Name == "CoreLabel" then
						colorCoreLabel(d)
					end
				end
			end
		end
	end)
	player:GetAttributeChangedSignal("BaseSlot"):Connect(function()
		for prompt, apply in pairs(filters) do
			apply()
		end
	end)

	-- atmosphere
	local currentZone = 0
	local frenzy = false
	local function refreshSky()
		local sky = HUB_SKY
		if currentZone >= 1 and Config.Zones[currentZone] then
			sky = Config.Zones[currentZone].sky
		end
		applySky(sky, frenzy)
	end
	player:GetAttributeChangedSignal("Zone"):Connect(function()
		currentZone = player:GetAttribute("Zone") or 0
		refreshSky()
	end)
	ReplicatedStorage:GetAttributeChangedSignal("EventPhase"):Connect(function()
		local f = ReplicatedStorage:GetAttribute("EventPhase") == "Frenzy"
		if f ~= frenzy then
			frenzy = f
			refreshSky()
		end
	end)

	-- waypoint home
	local beam, homeMarker, a0, a1, anchorPart
	local function clearWaypoint()
		if beam then
			beam:Destroy()
			beam = nil
		end
		if a0 then
			a0:Destroy()
			a0 = nil
		end
		if anchorPart then
			anchorPart:Destroy()
			anchorPart = nil
		end
	end
	local function setWaypoint(snap)
		local carrying = #snap.carried > 0
		if not carrying or snap.baseSlot <= 0 then
			clearWaypoint()
			return
		end
		if beam then
			return
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		local s = Config.Bases.Slots[snap.baseSlot]
		anchorPart = Kit.part(workspace, { name = "HomeWaypoint", size = Vector3.new(1, 1, 1), cf = CFrame.new(s.x, 6, s.z), transparency = 1, collide = false, query = false })
		a1 = Instance.new("Attachment")
		a1.Parent = anchorPart
		a0 = Instance.new("Attachment")
		a0.Name = "WaypointAttachment"
		a0.Parent = hrp
		beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Color = ColorSequence.new(Color3.fromRGB(120, 255, 140))
		beam.Transparency = NumberSequence.new(0.35)
		beam.Width0 = 0.8
		beam.Width1 = 0.8
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Segments = 1
		beam.Parent = anchorPart
		homeMarker = Kit.billboard(anchorPart, { name = "HomeMarker", size = UDim2.new(0, 120, 0, 50), offset = Vector3.new(0, 8, 0), alwaysOnTop = true, maxDistance = 5000 })
		Kit.text(homeMarker, { name = "Text", text = "🏠 HOME", color = { 120, 255, 140 }, font = Enum.Font.LuckiestGuy })
	end
	State.Changed:Connect(setWaypoint)

	-- frame loop
	local t = 0
	local screenAcc = 0
	RunService.RenderStepped:Connect(function(dt)
		t = t + dt
		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		animate(t, camPos)
		screenAcc = screenAcc + dt
		if screenAcc >= 0.25 then
			screenAcc = 0
			local now = workspace:GetServerTimeNow()
			local phase = ReplicatedStorage:GetAttribute("EventPhase") or "Normal"
			local text
			if phase == "Frenzy" then
				text = "NOW! " .. Util.formatTime(math.max(0, (ReplicatedStorage:GetAttribute("FrenzyEndsAt") or now) - now))
			else
				text = Util.formatTime(math.max(0, (ReplicatedStorage:GetAttribute("NextRefreshAt") or now) - now))
			end
			for _, screen in ipairs(CollectionService:GetTagged("EventScreen")) do
				for _, gui in ipairs(screen:GetChildren()) do
					if gui:IsA("SurfaceGui") then
						local timer = gui:FindFirstChild("Timer")
						if timer then
							timer.Text = text
						end
					end
				end
			end
		end
	end)
	return { animated = animated }
end

-- test hook
function WorldFx._animated()
	return animated
end

return WorldFx
]]></ProtectedString></Properties></Item></Item></Item></Item></Item>
